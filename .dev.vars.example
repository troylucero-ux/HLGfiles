# Copy this file to .dev.vars (gitignored) to test the chat and CRM routes locally with `wrangler dev`.
# In production, set these as encrypted environment variables / secrets on the Cloudflare Worker
# (dashboard → hlgfiles → Settings → Variables and Secrets), not in a committed file.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Pipedrive — Settings > Personal Preferences > API in your Pipedrive account.
# PIPEDRIVE_DOMAIN is just the subdomain, e.g. "highlightreg" for https://highlightreg.pipedrive.com
PIPEDRIVE_API_TOKEN=your-pipedrive-api-token-here
PIPEDRIVE_DOMAIN=your-company-domain
