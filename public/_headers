/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Offering Memorandum PDFs are reached only through the listing-page form: keep them out of search results and caches.
/om/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store

# Basic security headers for every page (no effect on how pages look or rank; browsers and scanners like to see them).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
