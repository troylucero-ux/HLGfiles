---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import ChatWidget from '../components/ChatWidget.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	image?: string;
}

const { title, description, noindex = false, image = '/images/hero/453-s-gramercy-pl-hero.webp' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Append the brand name only when the full title still fits in a search result (~60 chars). Long,
// keyword-rich titles (listings, articles) get truncated by Google if the suffix pushes them over,
// and the descriptive part matters more than the brand on those pages.
const BRAND = 'Highlight Multifamily Group';
const withBrand = `${title} | ${BRAND}`;
const pageTitle = title.includes(BRAND) ? title : withBrand.length <= 60 ? withBrand : title;
const socialImageURL = new URL(image, Astro.site);
// Stamped into every page so a deploy can be confirmed from the live HTML.
const builtAt = new Date().toISOString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="built-at" content={builtAt} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- Font requests need to be discovered by the browser's preload scanner as early as
		     possible in <head> -- moved above lower-priority tags for that reason. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- The font stylesheet loads without blocking first paint: the page renders with fallback fonts and swaps when it arrives. -->
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" /></noscript>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="google-site-verification" content="hsxewppcefAc91ZixapYclSrucJfjXxVKxZ-KProFRs" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Highlight Multifamily Group" />
		<meta property="og:image" content={socialImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<Schema />
		<slot name="head" />

		<!-- Google Analytics (GA4) -->
		<!-- The gtag.js library (about 180 KB) loads on the visitor's first scroll, click, key press, or touch, or after 4 seconds, whichever comes first,
		     so it never competes with the first paint. The commands below are queued until it arrives. A visitor who leaves within 4 seconds without moving, scrolling, or clicking is not counted. -->
		<script is:inline>
			(function () {
				var loaded = false;
				var events = ['scroll', 'click', 'keydown', 'touchstart', 'mousemove'];
				function loadAnalytics() {
					if (loaded) return;
					loaded = true;
					events.forEach(function (name) {
						window.removeEventListener(name, loadAnalytics);
					});
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtag/js?id=G-P4GNC7QLNX';
					document.head.appendChild(s);
				}
				events.forEach(function (name) {
					window.addEventListener(name, loadAnalytics, { passive: true, once: true });
				});
				window.addEventListener('load', function () {
					window.setTimeout(loadAnalytics, 4000);
				});
			})();
		</script>
		<script>
			window.dataLayer = window.dataLayer || [];
			// gtag.js only acts on commands pushed as the built-in `arguments` object. Pushing a
			// rest-parameter array (the previous version) made it silently ignore every command.
			function gtag(..._args: unknown[]) {
				window.dataLayer.push(arguments);
			}
			// @ts-expect-error — gtag's own global signature isn't declared in this project
			window.gtag = gtag;
			gtag('js', new Date());
			gtag('config', 'G-P4GNC7QLNX');
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to main content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<ChatWidget />
	</body>
</html>
