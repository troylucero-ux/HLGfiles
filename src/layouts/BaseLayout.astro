---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import ChatWidget from '../components/ChatWidget.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	image?: string;
}

const { title, description, noindex = false, image = '/images/hero/453-s-gramercy-pl-hero.webp' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Append the brand name only when the full title still fits in a search result (~65 chars). Long,
// keyword-rich titles (listings, articles) get truncated by Google if the suffix pushes them over,
// and the descriptive part matters more than the brand on those pages.
const BRAND = 'Highlight Multifamily Group';
const withBrand = `${title} | ${BRAND}`;
const pageTitle = title.includes(BRAND) ? title : withBrand.length <= 65 ? withBrand : title;
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- Font requests need to be discovered by the browser's preload scanner as early as
		     possible in <head> -- moved above lower-priority tags for that reason. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
		/>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="google-site-verification" content="hsxewppcefAc91ZixapYclSrucJfjXxVKxZ-KProFRs" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Highlight Multifamily Group" />
		<meta property="og:image" content={socialImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<Schema />
		<slot name="head" />

		<!-- Google Analytics (GA4) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-P4GNC7QLNX"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(...args: unknown[]) {
				window.dataLayer.push(args);
			}
			// @ts-expect-error — gtag's own global signature isn't declared in this project
			window.gtag = gtag;
			gtag('js', new Date());
			gtag('config', 'G-P4GNC7QLNX');
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to main content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<ChatWidget />
	</body>
</html>
