---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import ChatWidget from '../components/ChatWidget.astro';
import StickyCta from '../components/StickyCta.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	image?: string;
	lang?: 'en' | 'es';
	// Pages that carry their own bottom call-to-action bar (the listing pages) switch the sitewide one off.
	hideStickyCta?: boolean;
}

const { title, description, noindex = false, image = '/images/hero/453-s-gramercy-pl-hero.webp', lang = 'en', hideStickyCta = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Append the brand name only when the full title still fits in a search result (~60 chars). Long,
// keyword-rich titles (listings, articles) get truncated by Google if the suffix pushes them over,
// and the descriptive part matters more than the brand on those pages.
const BRAND = 'Highlight Multifamily Group';
const withBrand = `${title} | ${BRAND}`;
const pageTitle = title.includes(BRAND) ? title : withBrand.length <= 60 ? withBrand : title;
const socialImageURL = new URL(image, Astro.site);
// Stamped into every page so a deploy can be confirmed from the live HTML.
const builtAt = new Date().toISOString();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="built-at" content={builtAt} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- Fonts are hosted on this site (public/fonts, declared in global.css). The two used above the fold are preloaded so the
		     headline does not wait on a stylesheet from another site; the italic is only fetched on pages that use it. -->
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="google-site-verification" content="hsxewppcefAc91ZixapYclSrucJfjXxVKxZ-KProFRs" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Highlight Multifamily Group" />
		<meta property="og:image" content={socialImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<Schema />
		<slot name="head" />

		<!-- Google Analytics (GA4) -->
		<!-- The gtag.js library (about 180 KB) loads on the visitor's first scroll, click, key press, or touch, or after 4 seconds, whichever comes first,
		     so it never competes with the first paint. The commands below are queued until it arrives. A visitor who leaves within 4 seconds without moving, scrolling, or clicking is not counted. -->
		<script is:inline>
			(function () {
				var loaded = false;
				var events = ['scroll', 'click', 'keydown', 'touchstart', 'mousemove'];
				function loadAnalytics() {
					if (loaded) return;
					loaded = true;
					events.forEach(function (name) {
						window.removeEventListener(name, loadAnalytics);
					});
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtag/js?id=G-P4GNC7QLNX';
					document.head.appendChild(s);
				}
				events.forEach(function (name) {
					window.addEventListener(name, loadAnalytics, { passive: true, once: true });
				});
				window.addEventListener('load', function () {
					window.setTimeout(loadAnalytics, 4000);
				});
			})();
		</script>
		<script>
			window.dataLayer = window.dataLayer || [];
			// gtag.js only acts on commands pushed as the built-in `arguments` object. Pushing a
			// rest-parameter array (the previous version) made it silently ignore every command.
			function gtag(..._args: unknown[]) {
				window.dataLayer.push(arguments);
			}
			// @ts-expect-error — gtag's own global signature isn't declared in this project
			window.gtag = gtag;
			gtag('js', new Date());
			gtag('config', 'G-P4GNC7QLNX');

			// ---- Source tracking -------------------------------------------------------------------------------
			// 1) First touch: where this visit came from (the Facebook post tags, or the referring site), kept for the visit.
			// 2) Button clicks: which button on which page was used, sent to Google Analytics as `cta_click`.
			// 3) Forms add hlgSource() to what they send, so each lead in Pipedrive says which post, page and button produced it.
			// Nothing here changes any web address, and no personal details are ever stored or sent.
			const FIRST_TOUCH = 'hlg_first_touch';
			const LAST_CTA = 'hlg_last_cta';
			const read = (key: string) => {
				try {
					return JSON.parse(sessionStorage.getItem(key) || 'null');
				} catch {
					return null;
				}
			};
			const write = (key: string, value: unknown) => {
				try {
					sessionStorage.setItem(key, JSON.stringify(value));
				} catch {
					/* storage can be blocked; tracking just becomes page-only */
				}
			};
			(function captureFirstTouch() {
				const p = new URLSearchParams(window.location.search);
				// Paid-ad click IDs (Google, Meta, Microsoft) let a lead be matched to the exact ad later.
				const clickKeys = ['gclid', 'gbraid', 'wbraid', 'fbclid', 'msclkid'];
				const clickKey = clickKeys.find((k) => p.get(k)) || '';
				const hasUtm = Boolean(p.get('utm_source')) || Boolean(clickKey);
				const stored = read(FIRST_TOUCH);
				if (stored && !(hasUtm && !stored.utm_source && !stored.click_id)) return;
				let referrer = '';
				try {
					referrer = document.referrer ? new URL(document.referrer).hostname : '';
				} catch {
					/* ignore */
				}
				if (referrer === window.location.hostname) referrer = '';
				write(FIRST_TOUCH, {
					landing: window.location.pathname,
					referrer,
					utm_source: p.get('utm_source') || '',
					utm_medium: p.get('utm_medium') || '',
					utm_campaign: p.get('utm_campaign') || '',
					utm_content: p.get('utm_content') || '',
					utm_term: p.get('utm_term') || '',
					click_id_type: clickKey,
					click_id: clickKey ? (p.get(clickKey) || '').slice(0, 200) : '',
				});
			})();
			// @ts-expect-error — attached for the forms' scripts; not declared on Window in this project
			window.hlgSource = () => {
				const first = read(FIRST_TOUCH) || {};
				const cta = read(LAST_CTA) || {};
				return { ...first, page: window.location.pathname, cta: cta.name || '', ctaPage: cta.page || '' };
			};

			// Names a button for reporting: an explicit data-cta wins; otherwise any link into a lead page is named from where it sits.
			const LEAD_PAGES = /^\/(es\/)?(contact|property-value|broker-opinion-of-value|1031-exchanges|market-report|listings|vender-edificio)/;
			const nameFor = (el: HTMLElement): string => {
				const explicit = el.closest<HTMLElement>('[data-cta]')?.dataset.cta;
				if (explicit) return explicit;
				const href = (el as HTMLAnchorElement).getAttribute?.('href') || '';
				if (!LEAD_PAGES.test(href.split('?')[0])) return '';
				const zone = el.closest('header')
					? 'header'
					: el.closest('footer')
						? 'footer'
						: el.closest<HTMLElement>('[data-cta-zone]')?.dataset.ctaZone || 'page';
				return `${zone}:${href.split('?')[0].replace(/^\//, '').replace(/\/$/, '') || 'home'}`;
			};

			document.addEventListener('click', (event) => {
				const target = event.target as Element | null;
				const el = target?.closest<HTMLElement>('a, button');
				if (!el) return;
				const name = nameFor(el);
				if (name) {
					write(LAST_CTA, { name, page: window.location.pathname });
					gtag('event', 'cta_click', { cta_name: name, page_path: window.location.pathname });
				}
				// Phone and email clicks are recorded as events. The page stays open when a tel: or mailto: link is used, so the event is not lost.
				const link = el.closest<HTMLAnchorElement>('a[href^="tel:"], a[href^="mailto:"]');
				if (!link) return;
				const isPhone = link.href.startsWith('tel:');
				gtag('event', isPhone ? 'click_to_call' : 'click_email', { page_path: window.location.pathname, cta_name: name || 'unlabeled' });
			});
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to main content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		{!hideStickyCta && <StickyCta lang={lang} />}
		<ChatWidget />
	</body>
</html>
