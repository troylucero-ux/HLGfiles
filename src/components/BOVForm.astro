---
import { site } from '../data/site';

interface Props {
	heading?: string;
	subheading?: string;
	// 'es' shows the form in Spanish and tags every submission as Spanish. showLanguage adds an English/Spanish choice to the English form.
	lang?: 'en' | 'es';
	showLanguage?: boolean;
}

const { heading = 'Get a Free, Confidential Broker Opinion of Value', subheading = 'No pressure. Just data.', lang = 'en', showLanguage = false } = Astro.props;

const text = {
	en: {
		name: 'Name',
		email: 'Email',
		phone: 'Phone',
		address: 'Property Address',
		rents: 'Monthly Gross Rents (optional)',
		language: 'Preferred language',
		submit: 'Get My Free Valuation',
		badge: 'Free Broker Opinion of Value',
		perks: ['Free and confidential', 'Built on your building’s real rents and recent sales', 'No pressure, just data'],
		call: 'Prefer to talk? Call',
		ph: { name: 'Your name', email: 'you@example.com', phone: '(310) 555-0123', address: '123 Main St, Los Angeles, CA', rents: 'For example, 18,000' },
		checking: 'Checking the address...',
		notFound:
			"We couldn't confirm that address. Please check the street number and street name, and include the city and ZIP code (for example, 123 Main St, Los Angeles, CA 90001). If it is correct, click the button again to send it as typed.",
		thanks: "Thanks! We'll be in touch shortly.",
		failed: 'Something went wrong. Please try again or contact us directly.',
		error: 'Something went wrong. Please try again.',
	},
	es: {
		name: 'Nombre',
		email: 'Correo electrónico',
		phone: 'Teléfono',
		address: 'Dirección de la propiedad',
		rents: 'Renta bruta mensual (opcional)',
		language: 'Idioma preferido',
		submit: 'Obtener mi valuación gratis',
		badge: 'Opinión de valor gratuita',
		perks: ['Gratis y confidencial', 'Basada en las rentas reales de su edificio y ventas recientes', 'Sin presión, solo datos'],
		call: '¿Prefiere hablar? Llame al',
		ph: { name: 'Su nombre', email: 'usted@ejemplo.com', phone: '(310) 555-0123', address: '123 Main St, Los Angeles, CA', rents: 'Por ejemplo, 18,000' },
		checking: 'Verificando la dirección...',
		notFound:
			'No pudimos confirmar esa dirección. Por favor revise el número y el nombre de la calle, e incluya la ciudad y el código postal (por ejemplo, 123 Main St, Los Angeles, CA 90001). Si es correcta, haga clic en el botón otra vez para mandarla tal como la escribió.',
		thanks: '¡Gracias! Nos pondremos en contacto con usted pronto.',
		failed: 'Algo salió mal. Por favor inténtelo de nuevo o comuníquese con nosotros directamente.',
		error: 'Algo salió mal. Por favor inténtelo de nuevo.',
	},
}[lang];
---

<div class="bov-form-wrap">
<div class="bov-form">
	<div class="bov-form__intro">
		<span class="bov-form__badge">{text.badge}</span>
		<h2>{heading}</h2>
		<p class="bov-form__sub">{subheading}</p>
		<ul class="bov-form__perks" role="list">
			{text.perks.map((p) => <li>{p}</li>)}
		</ul>
		<p class="bov-form__call">
			{text.call}{' '}
			<a href={`tel:+1${site.phone.replace(/\D/g, '')}`}>{site.phone}</a>
		</p>
	</div>
	<form
		class="js-bov-form"
		data-endpoint="/api/bov-lead"
		data-msg-checking={text.checking}
		data-msg-notfound={text.notFound}
		data-msg-thanks={text.thanks}
		data-msg-failed={text.failed}
		data-msg-error={text.error}
	>
		{lang === 'es' && <input type="hidden" name="language" value="Spanish" />}
		<div class="bov-form__row">
			<div class="bov-field">
				<label for="bov-name">{text.name}</label>
				<input id="bov-name" name="name" type="text" placeholder={text.ph.name} autocomplete="name" required />
			</div>
			<div class="bov-field">
				<label for="bov-email">{text.email}</label>
				<input id="bov-email" name="email" type="email" placeholder={text.ph.email} autocomplete="email" required />
			</div>
			<div class="bov-field">
				<label for="bov-phone">{text.phone}</label>
				<input id="bov-phone" name="phone" type="tel" placeholder={text.ph.phone} autocomplete="tel" required />
			</div>
		</div>
		<div class="bov-form__row bov-form__row--property">
			<div class="bov-field">
				<label for="bov-address">{text.address}</label>
				<input id="bov-address" name="address" type="text" placeholder={text.ph.address} autocomplete="off" required />
			</div>
			<div class="bov-field">
				<label for="bov-rents">{text.rents}</label>
				<input id="bov-rents" name="monthlyGrossRents" type="text" inputmode="numeric" placeholder={text.ph.rents} />
			</div>
		</div>
		{
			showLanguage && lang === 'en' && (
				<div class="bov-form__language">
					<label for="bov-language">{text.language}</label>
					<select id="bov-language" name="language">
						<option value="English">English</option>
						<option value="Spanish">Español (Spanish)</option>
					</select>
				</div>
			)
		}
		<label class="bov-form__consent">
			<input type="checkbox" name="privacyConsent" required />
			{
				lang === 'es' ? (
					<span>
						Acepto la <a href="/privacy-policy/">Política de Privacidad</a> (en inglés) y autorizo recibir correos de marketing. Puede cancelar la suscripción en cualquier momento.
					</span>
				) : (
					<span>
						I agree to the <a href="/privacy-policy/">Privacy Policy</a> and consent to receiving marketing emails. You can unsubscribe at any time.
					</span>
				)
			}
		</label>
		<button type="submit" class="bov-form__submit">{text.submit}</button>
		<p class="bov-form__status" role="status" hidden></p>
	</form>
</div>
</div>

<script>
	document.querySelectorAll<HTMLFormElement>('.js-bov-form').forEach((form) => {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const status = form.querySelector<HTMLParagraphElement>('.bov-form__status');
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const endpoint = form.dataset.endpoint!;
			const data = Object.fromEntries(new FormData(form).entries());
			data.privacyConsent = (form.querySelector('input[name="privacyConsent"]') as HTMLInputElement)?.checked as unknown as string;
			(data as Record<string, unknown>).source = (window as unknown as { hlgSource?: () => unknown }).hlgSource?.();

			// Check the property address before sending. If it cannot be found, ask the visitor to look again once. A second
			// click on the button with the same address sends it as typed, so a real but unlisted building is never blocked.
			const typedAddress = String(data.address ?? '').trim();
			const fromGoogle = form.dataset.googleAddress === typedAddress && typedAddress !== '';
			if (fromGoogle) data.addressSource = 'google';
			if (!fromGoogle && form.dataset.warnedAddress !== typedAddress) {
				if (button) button.disabled = true;
				if (status) {
					status.hidden = false;
					status.style.color = 'var(--ink-light)';
					status.textContent = form.dataset.msgChecking ?? 'Checking the address...';
				}
				let addressStatus = 'unchecked';
				try {
					const check = await fetch('/api/verify-address?address=' + encodeURIComponent(typedAddress), { signal: AbortSignal.timeout(5000) });
					addressStatus = ((await check.json()) as { status?: string }).status ?? 'unchecked';
				} catch {
					// The check could not run; carry on and send the form.
				}
				if (addressStatus === 'not_found') {
					form.dataset.warnedAddress = typedAddress;
					if (status) {
						status.style.color = '#8a5a00';
						status.textContent =
							form.dataset.msgNotfound ??
							"We couldn't confirm that address. Please check the street number and street name, and include the city and ZIP code (for example, 123 Main St, Los Angeles, CA 90001). If it is correct, click the button again to send it as typed.";
					}
					if (button) button.disabled = false;
					return;
				}
			}

			if (button) button.disabled = true;
			try {
				const res = await fetch(endpoint, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				const result = await res.json();
				if (status) {
					status.hidden = false;
					if (res.ok) {
						status.textContent = form.dataset.msgThanks ?? "Thanks! We'll be in touch shortly.";
						// Counts as a lead in Google Analytics. Only the page and the form's purpose are sent, never the visitor's details.
						(window as unknown as { gtag?: (...args: unknown[]) => void }).gtag?.('event', 'generate_lead', {
							form_name: 'broker_opinion_of_value',
							page_path: window.location.pathname,
							intent: new URLSearchParams(window.location.search).get('intent') ?? 'none',
							language: String(data.language ?? 'English'),
						});
						status.style.color = 'var(--success)';
						form.reset();
					} else {
						status.textContent = result.error ?? form.dataset.msgError ?? 'Something went wrong. Please try again.';
						status.style.color = '#b3261e';
					}
				}
			} catch {
				if (status) {
					status.hidden = false;
					status.textContent = form.dataset.msgFailed ?? 'Something went wrong. Please try again or contact us directly.';
					status.style.color = '#b3261e';
				}
			} finally {
				if (button) button.disabled = false;
			}
		});
	});

	// Fill in the address typed into the homepage hero box, if the visitor came from there.
	try {
		const savedAddress = sessionStorage.getItem('hlg_bov_address');
		if (savedAddress) {
			// The homepage box notes when the address was picked from Google's suggestions, so the lead keeps that flag.
			const fromGoogle = sessionStorage.getItem('hlg_bov_address_google') === '1';
			document.querySelectorAll<HTMLInputElement>('.js-bov-form input[name="address"]').forEach((input) => {
				if (input.value) return;
				input.value = savedAddress;
				if (fromGoogle && input.form) input.form.dataset.googleAddress = savedAddress;
			});
			sessionStorage.removeItem('hlg_bov_address');
			sessionStorage.removeItem('hlg_bov_address_google');
		}
	} catch {
		// Session storage can be unavailable; the field simply stays empty.
	}
</script>

<script define:vars={{ placesKey: site.googleMapsApiKey }}>
	// Address suggestions from Google Places API (New), shown under the Property Address box. The key only works from
	// highlightreg.com. No-op if no key is set; the field then works as a plain text box. Choosing a suggestion closes
	// Google's billing session with a free "IDs only" lookup, so each completed search costs nothing at our volume.
	if (placesKey) {
		const API = 'https://places.googleapis.com/v1/';
		document.querySelectorAll('.js-bov-form input[name="address"], #val-address, #hero-address').forEach((input, index) => {
			const form = input.closest('form');
			const californiaOnly = input.dataset.californiaOnly === 'true';
			const wrap = document.createElement('div');
			wrap.className = 'bov-address' + (input.id === 'hero-address' ? ' bov-address--hero' : '');
			// Browser address autofill would stack its own list on top of ours.
			input.setAttribute('autocomplete', 'off');
			input.parentNode.insertBefore(wrap, input);
			wrap.appendChild(input);
			const list = document.createElement('ul');
			list.className = 'bov-address__list';
			list.id = 'address-suggestions-' + index;
			list.setAttribute('role', 'listbox');
			list.hidden = true;
			wrap.appendChild(list);
			input.setAttribute('role', 'combobox');
			input.setAttribute('aria-autocomplete', 'list');
			input.setAttribute('aria-controls', list.id);
			input.setAttribute('aria-expanded', 'false');

			let token = crypto.randomUUID();
			let timer = null;
			let controller = null;
			let items = [];
			let active = -1;

			const hide = () => {
				list.hidden = true;
				input.setAttribute('aria-expanded', 'false');
				active = -1;
			};
			const highlight = () => {
				[...list.querySelectorAll('[role="option"]')].forEach((li, i) => li.classList.toggle('is-active', i === active));
			};
			const choose = (i) => {
				const item = items[i];
				if (!item) return;
				input.value = item.text;
				form.dataset.googleAddress = item.text;
				hide();
				// Ends the session. Only the place id is requested, which Google does not charge for.
				fetch(API + 'places/' + encodeURIComponent(item.placeId) + '?sessionToken=' + token, {
					headers: { 'X-Goog-Api-Key': placesKey, 'X-Goog-FieldMask': 'id' },
				}).catch(() => {});
				token = crypto.randomUUID();
			};
			const render = () => {
				list.textContent = '';
				items.forEach((item, i) => {
					const li = document.createElement('li');
					li.setAttribute('role', 'option');
					li.textContent = item.text;
					li.addEventListener('mousedown', (e) => {
						e.preventDefault();
						choose(i);
					});
					list.appendChild(li);
				});
				if (items.length) {
					const credit = document.createElement('li');
					credit.className = 'bov-address__credit';
					credit.setAttribute('aria-hidden', 'true');
					credit.textContent = 'Powered by Google';
					list.appendChild(credit);
				}
				list.hidden = items.length === 0;
				input.setAttribute('aria-expanded', String(items.length > 0));
			};

			input.addEventListener('input', () => {
				delete form.dataset.googleAddress;
				clearTimeout(timer);
				const query = input.value.trim();
				if (query.length < 4) {
					items = [];
					render();
					return;
				}
				timer = setTimeout(async () => {
					if (controller) controller.abort();
					controller = new AbortController();
					try {
						const res = await fetch(API + 'places:autocomplete', {
							method: 'POST',
							signal: controller.signal,
							headers: { 'Content-Type': 'application/json', 'X-Goog-Api-Key': placesKey },
							body: JSON.stringify({
								input: query,
								sessionToken: token,
								includedRegionCodes: ['us'],
								includedPrimaryTypes: ['street_address', 'premise', 'subpremise'],
								...(californiaOnly
									? { locationRestriction: { rectangle: { low: { latitude: 32.5, longitude: -124.5 }, high: { latitude: 42.1, longitude: -114.1 } } } }
									: { locationBias: { circle: { center: { latitude: 34.05, longitude: -118.24 }, radius: 50000 } } }),
							}),
						});
						if (!res.ok) throw new Error('suggestions unavailable');
						const data = await res.json();
						items = (data.suggestions || [])
							.filter((s) => s.placePrediction && (!californiaOnly || /, CA, USA$/.test(s.placePrediction.text.text)))
							.slice(0, 5)
							.map((s) => ({ text: s.placePrediction.text.text.replace(/, USA$/, ''), placeId: s.placePrediction.placeId }));
						active = -1;
						render();
					} catch (err) {
						if (err && err.name === 'AbortError') return;
						items = [];
						render();
					}
				}, 250);
			});
			input.addEventListener('keydown', (e) => {
				if (list.hidden || !items.length) return;
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					active = (active + 1) % items.length;
					highlight();
				} else if (e.key === 'ArrowUp') {
					e.preventDefault();
					active = (active - 1 + items.length) % items.length;
					highlight();
				} else if (e.key === 'Enter' && active >= 0) {
					e.preventDefault();
					choose(active);
				} else if (e.key === 'Escape') {
					hide();
				}
			});
			input.addEventListener('blur', () => setTimeout(hide, 150));
		});
	}
</script>

<style>
	:global(.bov-address) {
		position: relative;
	}

	:global(.bov-address__list) {
		position: absolute;
		z-index: 20;
		top: calc(100% + 2px);
		left: 0;
		right: 0;
		margin: 0;
		padding: 0.25rem 0;
		list-style: none;
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 10px;
		overflow: hidden;
		box-shadow: 0 14px 30px -16px rgba(12, 46, 80, 0.4);
	}

	:global(.bov-address__list [role='option']) {
		padding: 0.6rem 0.9rem;
		font-size: 0.92rem;
		color: var(--ink);
		cursor: pointer;
	}

	:global(.bov-address__list [role='option']:hover),
	:global(.bov-address__list [role='option'].is-active) {
		background: var(--navy-tint);
		color: var(--navy-dark);
	}

	:global(.bov-address__credit) {
		padding: 0.3rem 0.9rem 0.2rem;
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		text-align: right;
		color: var(--ink-light);
	}

	.bov-form-wrap {
		container-type: inline-size;
		width: 100%;
	}

	.bov-form {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.6fr);
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 24px 60px -28px rgb(12 46 80 / 0.38), 0 2px 6px rgb(12 46 80 / 0.05);
	}

	/* Left panel */
	.bov-form__intro {
		position: relative;
		color: #d7e0ea;
		background: radial-gradient(120% 120% at 0% 0%, #1c5b99 0%, var(--navy) 45%, var(--navy-dark) 100%);
		padding: clamp(1.75rem, 3.5vw, 2.75rem);
		overflow: hidden;
	}

	.bov-form__intro::after {
		content: '';
		position: absolute;
		right: -90px;
		bottom: -90px;
		width: 260px;
		height: 260px;
		border-radius: 50%;
		border: 36px solid rgb(255 255 255 / 0.05);
		pointer-events: none;
	}

	.bov-form__badge {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--gold-light);
		border: 1px solid rgb(255 255 255 / 0.25);
		border-radius: 999px;
		padding: 0.3rem 0.8rem;
		margin-bottom: 1.1rem;
	}

	.bov-form__intro h2 {
		color: #fff;
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		line-height: 1.2;
		margin: 0 0 0.75rem;
	}

	.bov-form__sub {
		color: #d7e0ea;
		line-height: 1.6;
		margin: 0 0 1.5rem;
	}

	.bov-form__perks {
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
		display: grid;
		gap: 0.7rem;
	}

	.bov-form__perks li {
		position: relative;
		padding-left: 1.7rem;
		font-size: 0.92rem;
		line-height: 1.45;
		color: #fff;
	}

	.bov-form__perks li::before {
		content: '';
		position: absolute;
		left: 0.1rem;
		top: 0.28rem;
		width: 0.7rem;
		height: 0.4rem;
		border-left: 2px solid var(--gold-light);
		border-bottom: 2px solid var(--gold-light);
		transform: rotate(-45deg);
	}

	.bov-form__call {
		position: relative;
		margin: 0;
		font-size: 0.9rem;
		color: #d7e0ea;
	}

	.bov-form__call a {
		color: #fff;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Right panel */
	.bov-form form {
		padding: clamp(1.5rem, 3.5vw, 2.5rem);
	}

	.bov-form__row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
		gap: 1rem;
		margin-bottom: 1.1rem;
	}

	.bov-form__row--property {
		grid-template-columns: 2fr 1fr;
	}

	.bov-field label {
		display: block;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--navy-dark);
		margin-bottom: 0.4rem;
	}

	.bov-form input[type='text'],
	.bov-form input[type='email'],
	.bov-form input[type='tel'] {
		width: 100%;
		padding: 0.85rem 1rem;
		border: 1px solid #cfd8e3;
		border-radius: 10px;
		font-size: 0.98rem;
		font-family: var(--font-sans);
		color: var(--ink);
		background: #fbfcfe;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
	}

	.bov-form input[type='text']:hover,
	.bov-form input[type='email']:hover,
	.bov-form input[type='tel']:hover {
		border-color: #a9b8ca;
	}

	.bov-form input:focus {
		outline: none;
		border-color: var(--navy);
		background: #fff;
		box-shadow: 0 0 0 4px rgb(20 70 122 / 0.14);
	}

	.bov-form input::placeholder {
		color: #8b98a8;
	}

	.bov-form__language {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.1rem;
		font-size: 0.9rem;
		color: var(--ink-light);
	}

	.bov-form__language select {
		padding: 0.6rem 0.8rem;
		border: 1px solid #cfd8e3;
		border-radius: 10px;
		font-size: 0.95rem;
		font-family: var(--font-sans);
		background: #fbfcfe;
		color: var(--ink);
	}

	.bov-form__consent {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		font-size: 0.78rem;
		line-height: 1.5;
		color: var(--ink-light);
		margin: 0.25rem 0 1.25rem;
	}

	.bov-form__consent input {
		margin-top: 0.2rem;
		accent-color: var(--navy);
	}

	.bov-form__submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 14rem;
		font-family: var(--font-sans);
		font-size: 0.88rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #fff;
		background: linear-gradient(180deg, #1b5a9a 0%, var(--navy) 100%);
		border: 0;
		border-radius: 10px;
		padding: 1rem 2rem;
		cursor: pointer;
		box-shadow: 0 10px 22px -10px rgb(20 70 122 / 0.7);
		transition: transform 0.15s ease, box-shadow 0.2s ease, filter 0.2s ease;
	}

	.bov-form__submit:hover {
		transform: translateY(-1px);
		filter: brightness(1.08);
		box-shadow: 0 14px 26px -10px rgb(20 70 122 / 0.75);
	}

	.bov-form__submit:disabled {
		opacity: 0.75;
		cursor: progress;
