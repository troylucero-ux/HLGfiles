---
import { site } from '../data/site';

interface Props {
	heading?: string;
	subheading?: string;
}

const { heading = 'Get a Free, Confidential Broker Opinion of Value', subheading = 'No pressure. Just data.' } = Astro.props;
---

<div class="bov-form">
	<h2>{heading}</h2>
	<p class="bov-form__sub">{subheading}</p>
	<form class="js-bov-form" data-endpoint="/api/bov-lead">
		<div class="bov-form__row">
			<label for="bov-name" class="visually-hidden">Name</label>
			<input id="bov-name" name="name" type="text" placeholder="Name" required />
			<label for="bov-email" class="visually-hidden">Email</label>
			<input id="bov-email" name="email" type="email" placeholder="Email" required />
			<label for="bov-phone" class="visually-hidden">Phone</label>
			<input id="bov-phone" name="phone" type="tel" placeholder="Phone" required />
		</div>
		<div class="bov-form__row bov-form__row--property">
			<label for="bov-address" class="visually-hidden">Property Address</label>
			<input id="bov-address" name="address" type="text" placeholder="Property Address" autocomplete="off" required />
			<label for="bov-rents" class="visually-hidden">Monthly Gross Rents</label>
			<input id="bov-rents" name="monthlyGrossRents" type="text" inputmode="numeric" placeholder="Monthly Gross Rents (optional)" />
		</div>
		<label class="bov-form__consent">
			<input type="checkbox" name="privacyConsent" required />
			<span>
				I agree to the <a href="/privacy-policy/">Privacy Policy</a> and consent to receiving marketing emails. You can unsubscribe at any time.
			</span>
		</label>
		<button type="submit" class="btn btn-gold">Submit</button>
		<p class="bov-form__status" role="status" hidden></p>
	</form>
</div>

<script>
	document.querySelectorAll<HTMLFormElement>('.js-bov-form').forEach((form) => {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const status = form.querySelector<HTMLParagraphElement>('.bov-form__status');
			const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			const endpoint = form.dataset.endpoint!;
			const data = Object.fromEntries(new FormData(form).entries());
			data.privacyConsent = (form.querySelector('input[name="privacyConsent"]') as HTMLInputElement)?.checked as unknown as string;

			// Check the property address before sending. If it cannot be found, ask the visitor to look again once. A second
			// click on Submit with the same address sends it as typed, so a real but unlisted building is never blocked.
			const typedAddress = String(data.address ?? '').trim();
			const fromGoogle = form.dataset.googleAddress === typedAddress && typedAddress !== '';
			if (fromGoogle) data.addressSource = 'google';
			if (!fromGoogle && form.dataset.warnedAddress !== typedAddress) {
				if (button) button.disabled = true;
				if (status) {
					status.hidden = false;
					status.style.color = 'var(--ink-light)';
					status.textContent = 'Checking the address...';
				}
				let addressStatus = 'unchecked';
				try {
					const check = await fetch('/api/verify-address?address=' + encodeURIComponent(typedAddress), { signal: AbortSignal.timeout(5000) });
					addressStatus = ((await check.json()) as { status?: string }).status ?? 'unchecked';
				} catch {
					// The check could not run; carry on and send the form.
				}
				if (addressStatus === 'not_found') {
					form.dataset.warnedAddress = typedAddress;
					if (status) {
						status.style.color = '#8a5a00';
						status.textContent =
							"We couldn't confirm that address. Please check the street number and street name, and include the city and ZIP code (for example, 123 Main St, Los Angeles, CA 90001). If it is correct, click Submit again to send it as typed.";
					}
					if (button) button.disabled = false;
					return;
				}
			}

			if (button) button.disabled = true;
			try {
				const res = await fetch(endpoint, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				const result = await res.json();
				if (status) {
					status.hidden = false;
					if (res.ok) {
						status.textContent = "Thanks! We'll be in touch shortly.";
						// Counts as a lead in Google Analytics. Only the page and the form's purpose are sent, never the visitor's details.
						(window as unknown as { gtag?: (...args: unknown[]) => void }).gtag?.('event', 'generate_lead', {
							form_name: 'broker_opinion_of_value',
							page_path: window.location.pathname,
							intent: new URLSearchParams(window.location.search).get('intent') ?? 'none',
						});
						status.style.color = 'var(--success)';
						form.reset();
					} else {
						status.textContent = result.error ?? 'Something went wrong. Please try again.';
						status.style.color = '#b3261e';
					}
				}
			} catch {
				if (status) {
					status.hidden = false;
					status.textContent = 'Something went wrong. Please try again or contact us directly.';
					status.style.color = '#b3261e';
				}
			} finally {
				if (button) button.disabled = false;
			}
		});
	});

	// Fill in the address typed into the homepage hero box, if the visitor came from there.
	try {
		const savedAddress = sessionStorage.getItem('hlg_bov_address');
		if (savedAddress) {
			document.querySelectorAll<HTMLInputElement>('.js-bov-form input[name="address"]').forEach((input) => {
				if (!input.value) input.value = savedAddress;
			});
			sessionStorage.removeItem('hlg_bov_address');
		}
	} catch {
		// Session storage can be unavailable; the field simply stays empty.
	}
</script>

<script define:vars={{ placesKey: site.googleMapsApiKey }}>
	// Address suggestions from Google Places API (New), shown under the Property Address box. The key only works from
	// highlightreg.com. No-op if no key is set; the field then works as a plain text box. Choosing a suggestion closes
	// Google's billing session with a free "IDs only" lookup, so each completed search costs nothing at our volume.
	if (placesKey) {
		const API = 'https://places.googleapis.com/v1/';
		document.querySelectorAll('.js-bov-form input[name="address"], #val-address').forEach((input, index) => {
			const form = input.closest('form');
			const californiaOnly = input.dataset.californiaOnly === 'true';
			const wrap = document.createElement('div');
			wrap.className = 'bov-address';
			input.parentNode.insertBefore(wrap, input);
			wrap.appendChild(input);
			const list = document.createElement('ul');
			list.className = 'bov-address__list';
			list.id = 'address-suggestions-' + index;
			list.setAttribute('role', 'listbox');
			list.hidden = true;
			wrap.appendChild(list);
			input.setAttribute('role', 'combobox');
			input.setAttribute('aria-autocomplete', 'list');
			input.setAttribute('aria-controls', list.id);
			input.setAttribute('aria-expanded', 'false');

			let token = crypto.randomUUID();
			let timer = null;
			let controller = null;
			let items = [];
			let active = -1;

			const hide = () => {
				list.hidden = true;
				input.setAttribute('aria-expanded', 'false');
				active = -1;
			};
			const highlight = () => {
				[...list.querySelectorAll('[role="option"]')].forEach((li, i) => li.classList.toggle('is-active', i === active));
			};
			const choose = (i) => {
				const item = items[i];
				if (!item) return;
				input.value = item.text;
				form.dataset.googleAddress = item.text;
				hide();
				// Ends the session. Only the place id is requested, which Google does not charge for.
				fetch(API + 'places/' + encodeURIComponent(item.placeId) + '?sessionToken=' + token, {
					headers: { 'X-Goog-Api-Key': placesKey, 'X-Goog-FieldMask': 'id' },
				}).catch(() => {});
				token = crypto.randomUUID();
			};
			const render = () => {
				list.textContent = '';
				items.forEach((item, i) => {
					const li = document.createElement('li');
					li.setAttribute('role', 'option');
					li.textContent = item.text;
					li.addEventListener('mousedown', (e) => {
						e.preventDefault();
						choose(i);
					});
					list.appendChild(li);
				});
				if (items.length) {
					const credit = document.createElement('li');
					credit.className = 'bov-address__credit';
					credit.setAttribute('aria-hidden', 'true');
					credit.textContent = 'Powered by Google';
					list.appendChild(credit);
				}
				list.hidden = items.length === 0;
				input.setAttribute('aria-expanded', String(items.length > 0));
			};

			input.addEventListener('input', () => {
				delete form.dataset.googleAddress;
				clearTimeout(timer);
				const query = input.value.trim();
				if (query.length < 4) {
					items = [];
					render();
					return;
				}
				timer = setTimeout(async () => {
					if (controller) controller.abort();
					controller = new AbortController();
					try {
						const res = await fetch(API + 'places:autocomplete', {
							method: 'POST',
							signal: controller.signal,
							headers: { 'Content-Type': 'application/json', 'X-Goog-Api-Key': placesKey },
							body: JSON.stringify({
								input: query,
								sessionToken: token,
								includedRegionCodes: ['us'],
								includedPrimaryTypes: ['street_address', 'premise', 'subpremise'],
								...(californiaOnly
									? { locationRestriction: { rectangle: { low: { latitude: 32.5, longitude: -124.5 }, high: { latitude: 42.1, longitude: -114.1 } } } }
									: { locationBias: { circle: { center: { latitude: 34.05, longitude: -118.24 }, radius: 50000 } } }),
							}),
						});
						if (!res.ok) throw new Error('suggestions unavailable');
						const data = await res.json();
						items = (data.suggestions || [])
							.filter((s) => s.placePrediction && (!californiaOnly || /, CA, USA$/.test(s.placePrediction.text.text)))
							.slice(0, 5)
							.map((s) => ({ text: s.placePrediction.text.text.replace(/, USA$/, ''), placeId: s.placePrediction.placeId }));
						active = -1;
						render();
					} catch (err) {
						if (err && err.name === 'AbortError') return;
						items = [];
						render();
					}
				}, 250);
			});
			input.addEventListener('keydown', (e) => {
				if (list.hidden || !items.length) return;
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					active = (active + 1) % items.length;
					highlight();
				} else if (e.key === 'ArrowUp') {
					e.preventDefault();
					active = (active - 1 + items.length) % items.length;
					highlight();
				} else if (e.key === 'Enter' && active >= 0) {
					e.preventDefault();
					choose(active);
				} else if (e.key === 'Escape') {
					hide();
				}
			});
			input.addEventListener('blur', () => setTimeout(hide, 150));
		});
	}
</script>

<style>
	:global(.bov-address) {
		position: relative;
	}

	:global(.bov-address__list) {
		position: absolute;
		z-index: 20;
		top: calc(100% + 2px);
		left: 0;
		right: 0;
		margin: 0;
		padding: 0.25rem 0;
		list-style: none;
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 2px;
		box-shadow: 0 14px 30px -16px rgba(12, 46, 80, 0.4);
	}

	:global(.bov-address__list [role='option']) {
		padding: 0.6rem 0.9rem;
		font-size: 0.92rem;
		color: var(--ink);
		cursor: pointer;
	}

	:global(.bov-address__list [role='option']:hover),
	:global(.bov-address__list [role='option'].is-active) {
		background: var(--navy-tint);
		color: var(--navy-dark);
	}

	:global(.bov-address__credit) {
		padding: 0.3rem 0.9rem 0.2rem;
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		text-align: right;
		color: var(--ink-light);
	}

	.bov-form {
		background: var(--paper);
		border: 1px solid var(--border);
		border-top: 3px solid var(--gold);
		border-radius: 2px;
		padding: clamp(2rem, 4vw, 3rem);
	}

	.bov-form h2 {
		font-size: clamp(1.5rem, 2.6vw, 1.9rem);
	}

	.bov-form__sub {
		color: var(--ink-light);
	}

	.bov-form__row {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.bov-form__row--property {
		grid-template-columns: 2fr 1fr;
	}

	.bov-form input[type='text'],
	.bov-form input[type='email'],
	.bov-form input[type='tel'] {
		width: 100%;
		padding: 0.75rem 0.9rem;
		border: 1px solid var(--border);
		border-radius: 1px;
		font-size: 0.95rem;
		font-family: var(--font-sans);
		background: var(--paper);
	}

	.bov-form input:focus {
		outline: none;
		border-color: var(--gold);
	}

	.bov-form__consent {
		display: flex;
		gap: 0.5rem;
		align-items: flex-start;
		font-size: 0.75rem;
		color: var(--ink-light);
		margin-bottom: 1.25rem;
	}

	.bov-form__consent input {
		margin-top: 0.2rem;
	}

	.bov-form__status {
		margin-top: 0.75rem;
		font-weight: 600;
		font-size: 0.9rem;
	}

	@media (max-width: 640px) {
		.bov-form__row {
			grid-template-columns: 1fr;
		}
	}

	/* Google injects its address-suggestion dropdown at the document body level, outside this
	   component, so it needs :global to be reachable from a scoped Astro stylesheet. */
	:global(.pac-container) {
		font-family: var(--font-sans);
	}
</style>
