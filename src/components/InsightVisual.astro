---
// One illustration block for an Insights article (see src/data/articleVisuals.ts for the kinds and the data).
import type { Visual, IconName } from '../data/articleVisuals';

interface Props {
	visual: Visual;
}
const { visual } = Astro.props;

// 24 x 24 stroke icons.
const ICON: Record<IconName, string> = {
	ruler: '<path d="M3 17L17 3l4 4L7 21z"/><path d="M7 13l2 2M10 10l2 2M13 7l2 2"/>',
	building: '<path d="M4 21V3h10v18M14 9h6v12M8 7h2M8 11h2M8 15h2M2 21h20"/>',
	wrench: '<path d="M14.5 6a4 4 0 00-5 5L3 17.5 6.5 21 13 14.5a4 4 0 005-5l-2.5 2.5-2.5-.5-.5-2.5z"/>',
	clipboard: '<path d="M9 4h6v3H9zM7 5H5v16h14V5h-2M9 14l2 2 4-4"/>',
	search: '<circle cx="10" cy="10" r="6"/><path d="M15 15l5 5"/>',
	doc: '<path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6"/>',
	arrow: '<path d="M4 12h14M13 7l5 5-5 5"/>',
	shield: '<path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	warning: '<path d="M12 3l10 18H2zM12 10v5M12 18v.5"/>',
	check: '<path d="M5 12l5 5 9-10"/>',
	users: '<circle cx="9" cy="8" r="3"/><path d="M3 20v-1a5 5 0 0110 0v1M16 11a3 3 0 100-6M21 20v-1a5 5 0 00-4-4.9"/>',
	home: '<path d="M3 11l9-8 9 8M5 10v10h14V10"/>',
	key: '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M16 7l3 3M14 9l2 2"/>',
};
---

{
	visual.kind === 'stats' && (
		<figure class="av av-stats">
			{visual.caption && <figcaption>{visual.caption}</figcaption>}
			<ul role="list">
				{visual.items.map((i) => (
					<li>
						<strong>{i.value}</strong>
						<span>{i.label}</span>
					</li>
				))}
			</ul>
		</figure>
	)
}

{
	visual.kind === 'timeline' && (
		<figure class="av av-timeline">
			{visual.caption && <figcaption>{visual.caption}</figcaption>}
			<ol role="list">
				{visual.steps.map((s, n) => (
					<li class={s.tone === 'warn' ? 'is-warn' : ''}>
						<span class="av-timeline__dot" aria-hidden="true">
							{s.tone === 'warn' ? '!' : visual.steps.slice(0, n).filter((x) => x.tone !== 'warn').length + 1}
						</span>
						<div>
							<strong>{s.label}</strong>
							<p>{s.detail}</p>
						</div>
					</li>
				))}
			</ol>
		</figure>
	)
}

{
	(visual.kind === 'cards' || visual.kind === 'steps') && (
		<figure class={`av av-cards${visual.kind === 'steps' ? ' av-cards--steps' : ''}`}>
			{visual.caption && <figcaption>{visual.caption}</figcaption>}
			<ul role="list">
				{visual.items.map((i, n) => (
					<li>
						<span class="av-cards__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" set:html={ICON[i.icon]} />
						</span>
						<div>
							<strong>{visual.kind === 'steps' ? `${n + 1}. ${i.title}` : i.title}</strong>
							<p>{i.text}</p>
						</div>
					</li>
				))}
			</ul>
		</figure>
	)
}

{
	visual.kind === 'compare' && (
		<figure class="av av-compare">
			{visual.caption && <figcaption>{visual.caption}</figcaption>}
			<div class="av-compare__grid">
				<div class="av-compare__col av-compare__col--yes">
					<h3>
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.check} />
						{visual.yes.title}
					</h3>
					<ul role="list">
						{visual.yes.items.map((t) => (
							<li>{t}</li>
						))}
					</ul>
				</div>
				<div class="av-compare__col av-compare__col--no">
					<h3>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M6 6l12 12M18 6L6 18" />
						</svg>
						{visual.no.title}
					</h3>
					<ul role="list">
						{visual.no.items.map((t) => (
							<li>{t}</li>
						))}
					</ul>
				</div>
			</div>
		</figure>
	)
}

{
	visual.kind === 'balcony' && (
		<figure class="av av-balcony">
			<figcaption>What counts as an exterior elevated element</figcaption>
			<svg viewBox="0 0 680 300" role="img" aria-labelledby="av-balcony-title av-balcony-desc">
				<title id="av-balcony-title">Side view of a wood-frame apartment building with an elevated balcony and exterior stair</title>
				<desc id="av-balcony-desc">
					A two-story building with a wood balcony and an exterior stair. The balcony walking surface is more than six feet above the ground, so it is covered by SB 721. A concrete patio at ground level is not covered.
				</desc>
				<rect x="0" y="262" width="680" height="38" fill="#d8d3c4" />
				<line x1="0" y1="262" x2="680" y2="262" stroke="#0c2e50" stroke-width="2" />
				<rect x="150" y="60" width="250" height="202" fill="#efe9d8" stroke="#0c2e50" stroke-width="2" />
				<rect x="180" y="95" width="40" height="46" fill="#cfe0ef" stroke="#0c2e50" />
				<rect x="250" y="95" width="40" height="46" fill="#cfe0ef" stroke="#0c2e50" />
				<rect x="180" y="200" width="40" height="62" fill="#cfe0ef" stroke="#0c2e50" />
				<rect x="250" y="200" width="40" height="62" fill="#cfe0ef" stroke="#0c2e50" />
				<rect x="320" y="200" width="46" height="62" fill="#b6944a" opacity="0.35" stroke="#0c2e50" />
				<rect x="400" y="140" width="130" height="9" fill="#b6944a" stroke="#0c2e50" />
				<rect x="518" y="149" width="9" height="113" fill="#b6944a" stroke="#0c2e50" />
				<line x1="400" y1="110" x2="530" y2="110" stroke="#0c2e50" stroke-width="2" />
				<line x1="420" y1="110" x2="420" y2="140" stroke="#0c2e50" stroke-width="2" />
				<line x1="460" y1="110" x2="460" y2="140" stroke="#0c2e50" stroke-width="2" />
				<line x1="500" y1="110" x2="500" y2="140" stroke="#0c2e50" stroke-width="2" />
				<line x1="530" y1="110" x2="530" y2="140" stroke="#0c2e50" stroke-width="2" />
				<path d="M530 149 L600 262 L612 262 L541 149 Z" fill="#b6944a" stroke="#0c2e50" />
				<line x1="530" y1="140" x2="606" y2="258" stroke="#0c2e50" stroke-width="2" />
				<rect x="40" y="250" width="100" height="12" fill="#aeb7c2" stroke="#0c2e50" />
				<line x1="0" y1="196" x2="680" y2="196" stroke="#a32d2d" stroke-width="1.5" stroke-dasharray="6 5" />
				<text x="12" y="188" class="av-balcony__t av-balcony__t--red">6 feet above the ground</text>
				<rect x="396" y="40" width="148" height="52" fill="#fff" stroke="#b6944a" />
				<text x="470" y="62" text-anchor="middle" class="av-balcony__t av-balcony__t--b">Wood balcony</text>
				<text x="470" y="80" text-anchor="middle" class="av-balcony__t">Covered</text>
				<rect x="596" y="196" width="76" height="46" fill="#fff" stroke="#b6944a" />
				<text x="634" y="215" text-anchor="middle" class="av-balcony__t av-balcony__t--b">Exterior</text>
				<text x="634" y="231" text-anchor="middle" class="av-balcony__t av-balcony__t--b">stair</text>
				<rect x="24" y="206" width="124" height="38" fill="#fff" stroke="#8a97a6" />
				<text x="86" y="222" text-anchor="middle" class="av-balcony__t av-balcony__t--b">Ground patio</text>
				<text x="86" y="238" text-anchor="middle" class="av-balcony__t">Not covered</text>
			</svg>
			<p class="av-balcony__note">The picture is an illustration, not a drawing of a specific building. What counts under the law is a walking surface more than six feet above the ground.</p>
		</figure>
	)
}

<style>
	.av {
		margin: 1.75rem 0 2rem;
		padding: 1.25rem 1.4rem;
		background: #fff;
		border: 1px solid var(--border);
		border-top: 3px solid var(--gold);
		border-radius: 2px;
		font-size: 1rem;
		line-height: 1.5;
	}

	.av figcaption {
		margin: 0 0 1rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--gold-dark, #8a6b2d);
	}

	.av ul,
	.av ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* Stats */
	.av-stats ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
		gap: 0.75rem;
	}

	.av-stats li {
		background: var(--navy-tint);
		padding: 0.9rem 0.8rem;
		text-align: center;
	}

	.av-stats strong {
		display: block;
		font-family: var(--font-serif);
		font-size: 1.9rem;
		line-height: 1.1;
		color: var(--navy-dark);
	}

	.av-stats span {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.85rem;
		color: var(--ink-light);
	}

	/* Timeline */
	.av-timeline ol {
		position: relative;
		display: grid;
		gap: 0.9rem;
	}

	.av-timeline ol::before {
		content: '';
		position: absolute;
		left: 0.95rem;
		top: 0.6rem;
		bottom: 0.6rem;
		width: 2px;
		background: var(--border);
	}

	.av-timeline li {
		position: relative;
		display: flex;
		gap: 0.9rem;
		align-items: flex-start;
	}

	.av-timeline__dot {
		position: relative;
		flex: none;
		width: 1.9rem;
		height: 1.9rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--navy);
		color: #fff;
		font-weight: 700;
		font-size: 0.85rem;
	}

	.av-timeline li.is-warn .av-timeline__dot {
		background: #a32d2d;
	}

	.av-timeline strong {
		display: block;
		color: var(--navy-dark);
	}

	.av-timeline p {
		margin: 0.15rem 0 0;
		font-size: 0.92rem;
		color: var(--ink-light);
	}

	/* Cards and steps */
	.av-cards ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 0.8rem;
	}

	.av-cards li {
		display: flex;
		gap: 0.8rem;
		align-items: flex-start;
		background: var(--paper);
		border: 1px solid var(--border);
		padding: 0.9rem;
	}

	.av-cards__icon {
		flex: none;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--navy);
	}

	.av-cards__icon svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: #fff;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.av-cards--steps .av-cards__icon {
		background: var(--gold);
	}

	.av-cards--steps .av-cards__icon svg {
		stroke: var(--navy-dark);
	}

	.av-cards strong {
		display: block;
		color: var(--navy-dark);
		font-size: 0.98rem;
	}

	.av-cards p {
		margin: 0.15rem 0 0;
		font-size: 0.88rem;
		color: var(--ink-light);
	}

	/* Compare */
	.av-compare__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 0.9rem;
	}

	.av-compare__col {
		padding: 0.9rem 1rem;
		border: 1px solid var(--border);
	}

	.av-compare__col--yes {
		background: #eef6e6;
		border-color: #b9d79a;
	}

	.av-compare__col--no {
		background: #f5f2ec;
	}

	.av-compare h3 {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0 0 0.6rem;
		font-size: 1rem;
	}

	.av-compare h3 svg {
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.av-compare__col--yes h3 {
		color: #27500a;
	}

	.av-compare__col--yes h3 svg {
		stroke: #27500a;
	}

	.av-compare__col--no h3 {
		color: #5b6b7d;
	}

	.av-compare__col--no h3 svg {
		stroke: #5b6b7d;
	}

	.av-compare li {
		position: relative;
		padding-left: 1rem;
		margin-bottom: 0.4rem;
		font-size: 0.92rem;
	}

	.av-compare li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.5;
	}

	/* Balcony diagram */
	.av-balcony svg {
		display: block;
		width: 100%;
		height: auto;
	}

	.av-balcony__t {
		font-family: var(--font-sans);
		font-size: 12.5px;
		fill: #0c2e50;
	}

	.av-balcony__t--b {
		font-weight: 700;
	}

	.av-balcony__t--red {
		fill: #a32d2d;
		font-weight: 700;
	}

	.av-balcony__note {
		margin: 0.75rem 0 0;
		font-size: 0.8rem;
		color: var(--ink-light);
	}
</style>
