---
// Short 1031 exchange consult request. The three questions tell us how urgent the exchange is before we call.
// Posts to /api/1031-lead (worker/exchange-lead.ts), which creates a Pipedrive lead.
// lang="es" shows the form in Spanish and tags the lead as Spanish. Option values stay English because the worker checks them.
interface Props {
	heading?: string;
	subheading?: string;
	lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const text = {
	en: {
		heading: 'Talk Through Your 1031 Exchange',
		subheading: 'Tell us where you are and we will call you to plan the exchange. Free and confidential.',
		name: 'Name',
		email: 'Email',
		phone: 'Phone',
		optional: '(optional)',
		stage: 'Where are you in the sale?',
		interest: 'What might you buy?',
		timing: 'When do you expect to close the sale?',
		select: 'Select one',
		stages: ['Just exploring', 'Preparing to list', 'Listed or in escrow', 'Sale closed (the 45 days are running)'],
		interests: ['Apartments', 'Triple-net (NNN) property', 'Delaware Statutory Trust (DST)', 'Not sure yet'],
		timings: ['Within 60 days', 'In 2 to 6 months', 'In 6 to 12 months', 'Not sure yet'],
		consentPre: 'I agree to the ',
		privacy: 'Privacy Policy',
		consentPost: ' and to be contacted about my exchange. You can unsubscribe at any time.',
		submit: 'Request My Exchange Call',
	},
	es: {
		heading: 'Hablemos de su intercambio 1031',
		subheading: 'Cuéntenos en qué punto está y lo llamaremos para planear el intercambio, en español. Gratis y confidencial.',
		name: 'Nombre',
		email: 'Correo electrónico',
		phone: 'Teléfono',
		optional: '(opcional)',
		stage: '¿En qué punto está de la venta?',
		interest: '¿Qué podría comprar?',
		timing: '¿Cuándo espera cerrar la venta?',
		select: 'Elija una',
		stages: ['Solo estoy explorando', 'Preparándome para listar', 'Listado o en depósito en garantía (escrow)', 'La venta ya cerró (los 45 días están corriendo)'],
		interests: ['Apartamentos', 'Propiedad triple net (NNN)', 'Fideicomiso Estatutario de Delaware (DST)', 'Todavía no estoy seguro'],
		timings: ['En los próximos 60 días', 'En 2 a 6 meses', 'En 6 a 12 meses', 'Todavía no estoy seguro'],
		consentPre: 'Acepto la ',
		privacy: 'Política de Privacidad',
		consentPost: ' (en inglés) y que me contacten sobre mi intercambio. Puedo cancelar en cualquier momento.',
		submit: 'Solicitar mi llamada sobre el intercambio',
	},
}[lang];
// Values sent to the worker, in the same order as the labels above.
const stageValues = ['Just exploring', 'Preparing to list', 'Listed or in escrow', 'Sale closed (the 45 days are running)'];
const interestValues = ['Apartments', 'Triple-net (NNN) property', 'Delaware Statutory Trust (DST)', 'Not sure yet'];
const timingValues = ['Within 60 days', 'In 2 to 6 months', 'In 6 to 12 months', 'Not sure yet'];

const { heading = text.heading, subheading = text.subheading } = Astro.props;
const privacyHref = '/privacy-policy/';
---

<section class="xc" id="exchange-consult">
	<h2>{heading}</h2>
	<p class="xc__sub">{subheading}</p>
	<form class="js-xc-form" data-lang={lang} novalidate>
		{lang === 'es' && <input type="hidden" name="language" value="Spanish" />}
		<div class="xc__grid">
			<div>
				<label for="xc-name">{text.name}</label>
				<input id="xc-name" name="name" type="text" autocomplete="name" required />
			</div>
			<div>
				<label for="xc-email">{text.email}</label>
				<input id="xc-email" name="email" type="email" autocomplete="email" required />
			</div>
			<div class="xc__wide">
				<label for="xc-phone">{text.phone} <span class="xc__opt">{text.optional}</span></label>
				<input id="xc-phone" name="phone" type="tel" autocomplete="tel" />
			</div>
			<div>
				<label for="xc-stage">{text.stage}</label>
				<select id="xc-stage" name="stage" required>
					<option value="">{text.select}</option>
					{text.stages.map((o, i) => <option value={stageValues[i]}>{o}</option>)}
				</select>
			</div>
			<div>
				<label for="xc-interest">{text.interest}</label>
				<select id="xc-interest" name="interest" required>
					<option value="">{text.select}</option>
					{text.interests.map((o, i) => <option value={interestValues[i]}>{o}</option>)}
				</select>
			</div>
			<div class="xc__wide">
				<label for="xc-timing">{text.timing}</label>
				<select id="xc-timing" name="timing" required>
					<option value="">{text.select}</option>
					{text.timings.map((o, i) => <option value={timingValues[i]}>{o}</option>)}
				</select>
			</div>
		</div>
		<label class="xc__consent">
			<input type="checkbox" name="privacyConsent" required />
			<span>{text.consentPre}<a href={privacyHref}>{text.privacy}</a>{text.consentPost}</span>
		</label>
		<button type="submit" class="btn btn-gold">{text.submit}</button>
		<p class="xc__status" role="status" hidden></p>
	</form>
</section>

<script>
	const MSG = {
		en: {
			incomplete: 'Please complete the required fields and accept the privacy policy.',
			sending: 'Sending...',
			thanks: "Thank you. We'll call you shortly to plan your exchange.",
			wrong: 'Something went wrong. Please try again.',
			wrongCall: 'Something went wrong. Please try again or call us directly.',
		},
		es: {
			incomplete: 'Por favor complete los campos obligatorios y acepte la política de privacidad.',
			sending: 'Enviando...',
			thanks: 'Gracias. Lo llamaremos pronto para planear su intercambio.',
			wrong: 'Algo salió mal. Por favor intente de nuevo.',
			wrongCall: 'Algo salió mal. Por favor intente de nuevo o llámenos directamente.',
		},
	};
	document.querySelectorAll<HTMLFormElement>('.js-xc-form').forEach((form) => {
		const m = MSG[form.dataset.lang === 'es' ? 'es' : 'en'];
		const status = form.querySelector<HTMLParagraphElement>('.xc__status')!;
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			status.hidden = false;
			if (!form.checkValidity()) {
				status.style.color = '#b3261e';
				status.textContent = m.incomplete;
				form.reportValidity();
				return;
			}
			const data = Object.fromEntries(new FormData(form).entries()) as Record<string, unknown>;
			data.privacyConsent = (form.querySelector('input[name="privacyConsent"]') as HTMLInputElement).checked;
			data.source = (window as unknown as { hlgSource?: () => unknown }).hlgSource?.();
			button.disabled = true;
			status.style.color = '';
			status.textContent = m.sending;
			try {
				const res = await fetch('/api/1031-lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
				const result = await res.json();
				if (res.ok) {
					status.style.color = 'var(--success)';
					status.textContent = m.thanks;
					// Counts as a lead in Google Analytics. Only the page and the form's purpose are sent, never the visitor's details.
					(window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.('event', 'generate_lead', {
						form_name: 'consult_1031',
						page_path: window.location.pathname,
					});
					form.reset();
				} else {
					status.style.color = '#b3261e';
					status.textContent = m.wrong;
				}
			} catch {
				status.style.color = '#b3261e';
				status.textContent = m.wrongCall;
			} finally {
				button.disabled = false;
			}
		});
	});
</script>

<style>
	.xc {
		background: var(--paper);
		border: 1px solid var(--border);
		border-top: 3px solid var(--gold);
		border-radius: 2px;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		scroll-margin-top: 8rem;
	}

	.xc h2 {
		margin-top: 0;
		font-size: clamp(1.4rem, 2.6vw, 1.8rem);
	}

	.xc__sub {
		color: var(--ink-light);
	}

	.xc__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.9rem;
		margin-bottom: 1.1rem;
	}

	.xc__wide {
		grid-column: 1 / -1;
	}

	.xc label {
		display: block;
		font-size: 0.8rem;
		font-weight: 600;
		margin-bottom: 0.25rem;
	}

	.xc__opt {
		font-weight: 400;
		color: var(--ink-light);
	}

	.xc input[type='text'],
	.xc input[type='email'],
	.xc input[type='tel'],
	.xc select {
		width: 100%;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--border);
		border-radius: 1px;
		font-size: 1rem;
		font-family: var(--font-sans);
		background: var(--paper);
	}

	.xc input:focus,
	.xc select:focus {
		outline: none;
		border-color: var(--gold);
	}

	.xc .xc__consent {
		display: flex;
		gap: 0.5rem;
		align-items: flex-start;
		font-size: 0.78rem;
		font-weight: 400;
		color: var(--ink-light);
		margin-bottom: 1.1rem;
	}

	.xc__consent input {
		margin-top: 0.2rem;
	}

	.xc__status {
		margin-top: 0.75rem;
		font-weight: 600;
		font-size: 0.9rem;
	}

	@media (max-width: 640px) {
		.xc__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
