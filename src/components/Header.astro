---
import { site } from '../data/site';
import { BOV, PAGES_ES } from '../data/esSlugs';

interface Props {
	lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
const es = lang === 'es';

// The English page that matches the Spanish page the visitor is on, for the language switch. Anything else goes to the English homepage.
const englishCounterpart: Record<string, string> = {
	'/es/': '/',
	'/es/intercambios-1031/': '/1031-exchanges/',
	'/es/ventas-de-fideicomisos-y-herencias/': '/trust-and-estate-sales/',
	'/es/triple-net-dst/': '/triple-net-dst/',
	'/es/preguntas-frecuentes/': '/faqs/',
	'/es/insights/': '/insights/',
};
const englishHref = englishCounterpart[Astro.url.pathname] ?? '/';

// Spanish menu: Spanish pages where they exist; the rest link to the English page and say so.
const navGroupsEs = [
	{
		label: 'Servicios',
		links: [
			{ href: BOV, label: 'Opinión de valor gratis' },
			{ href: '/es/vender-edificio-de-apartamentos-los-angeles/', label: 'Vender su edificio' },
			{ href: PAGES_ES.intercambios, label: 'Intercambios 1031' },
			{ href: PAGES_ES.fideicomisos, label: 'Fideicomisos y herencias' },
			{ href: PAGES_ES.tripleNet, label: 'Triple net (NNN) y DST' },
		],
	},
	{
		label: 'Propiedades',
		links: [
			{ href: '/closed-sales/', label: 'Ventas cerradas (en inglés)' },
			{ href: '/listings/', label: 'Propiedades en venta (en inglés)' },
			{ href: '/land-for-development/', label: 'Terrenos para desarrollo (en inglés)' },
		],
	},
	{
		label: 'Nosotros',
		links: [
			{ href: '/about/', label: 'Nuestro equipo (en inglés)' },
			{ href: '/testimonials/', label: 'Testimonios (en inglés)' },
			{ href: '/case-studies/', label: 'Casos de éxito (en inglés)' },
		],
	},
];

const simpleLinksEs = [
	{ href: '/es/insights/', label: 'Artículos' },
	{ href: '/es/preguntas-frecuentes/', label: 'Preguntas frecuentes' },
	{ href: '/es/#formulario', label: 'Contacto' },
];

const text = es
	? {
			utility: 'Reciba análisis del mercado multifamiliar de Los Ángeles en su correo.',
			emailLabel: 'Correo electrónico',
			emailPlaceholder: 'Correo electrónico',
			subscribe: 'Suscribirse',
			logoHref: '/es/',
			menu: 'Menú',
			navLabel: 'Principal',
			social: 'Redes sociales',
			switchLabel: 'English',
			switchLang: 'en',
			switchHref: englishHref,
			cta: '¿Cuánto vale mi propiedad?',
			ctaHref: BOV,
			ok: '¡Suscrito!',
			fail: 'Algo salió mal. Revise su correo e intente de nuevo.',
		}
	: {
			utility: 'Get LA multifamily market insights in your inbox.',
			emailLabel: 'Email address',
			emailPlaceholder: 'Email address',
			subscribe: 'Subscribe',
			logoHref: '/',
			menu: 'Menu',
			navLabel: 'Primary',
			social: 'Social media',
			switchLabel: 'Español',
			switchLang: 'es',
			switchHref: '/es/',
			cta: "What's My Property Worth?",
			ctaHref: '/property-value/',
			ok: 'Subscribed!',
			fail: 'Something went wrong.',
		};

const navGroups = es ? navGroupsEs : [
	{
		label: 'About',
		links: [
			{ href: '/about/', label: 'Our Team' },
			{ href: '/testimonials/', label: 'Testimonials' },
		],
	},
	{
		label: 'Properties',
		links: [
			{ href: '/listings/', label: 'Listings' },
			{ href: '/closed-sales/', label: 'Closed Sales' },
			{ href: '/land-for-development/', label: 'Land for Development' },
		],
	},
	{
		label: 'Services',
		links: [
			{ href: '/broker-opinion-of-value/', label: 'Free Broker Opinion of Value' },
			{ href: '/1031-exchanges/', label: '1031 Exchanges' },
			{ href: '/trust-and-estate-sales/', label: 'Trust & Estate Sales' },
			{ href: '/triple-net-dst/', label: 'Triple Net (NNN) & DSTs' },
			{ href: '/case-studies/', label: 'Case Studies' },
		],
	},
	{
		label: 'Submarkets',
		links: [
			{ href: '/submarkets/', label: 'All Submarkets' },
			{ href: '/market-report/', label: 'Market Report' },
		],
	},
];

const simpleLinks = es
	? simpleLinksEs
	: [
			{ href: '/insights/', label: 'Insights' },
			{ href: '/faqs/', label: 'FAQs' },
			{ href: '/contact/', label: 'Contact' },
		];
---

<div class="utility-bar">
	<div class="container utility-bar__inner">
		<p class="utility-bar__text">{text.utility}</p>
		<form class="utility-bar__form" id="newsletter-form">
			<label for="newsletter-email" class="visually-hidden">{text.emailLabel}</label>
			<input id="newsletter-email" type="email" name="email" placeholder={text.emailPlaceholder} required />
			<button type="submit" class="btn btn-gold utility-bar__btn">{text.subscribe}</button>
			<span id="newsletter-status" role="status" data-ok={text.ok} data-fail={text.fail}></span>
		</form>
	</div>
</div>

<header class="site-header">
	<div class="container site-header__inner">
		<a href={text.logoHref} class="site-header__logo">
			<picture>
				<source media="(min-width: 1240px)" srcset="/images/brand/hlg-eu-logo-light.svg" width="189" height="48" />
				<img src="/images/brand/hlg-logo-light.svg" alt="Highlight Multifamily Group, Equity Union Commercial" width="81" height="48" />
			</picture>
		</a>

		<nav class={es ? 'main-nav main-nav--es' : 'main-nav'} aria-label={text.navLabel}>
			<button class="main-nav__toggle" id="nav-toggle" aria-expanded="false" aria-controls="main-nav-list">
				<span class="visually-hidden">{text.menu}</span>
				<span class="main-nav__toggle-bar"></span>
				<span class="main-nav__toggle-bar"></span>
				<span class="main-nav__toggle-bar"></span>
			</button>
			<ul class="main-nav__list" id="main-nav-list">
				{
					navGroups.map((group) => (
						<li class="main-nav__group">
							<span class="main-nav__group-label">{group.label}</span>
							<ul class="main-nav__submenu">
								{group.links.map((link) => (
									<li>
										<a href={link.href}>{link.label}</a>
									</li>
								))}
							</ul>
						</li>
					))
				}
				{
					simpleLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="site-header__actions">
			<a href={text.switchHref} class="site-header__lang" hreflang={text.switchLang} lang={text.switchLang}>{text.switchLabel}</a>
			<ul class="social-icons" aria-label={text.social}>
				{site.social.linkedin && (
					<li>
						<a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0z"/></svg>
						</a>
					</li>
				)}
				{site.social.instagram && (
					<li>
						<a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.56-.79.31-1.46.72-2.13 1.38C1.35 2.67.94 3.34.63 4.13c-.3.76-.5 1.63-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13.67.66 1.34 1.07 2.13 1.38.76.3 1.63.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.66-.67 1.07-1.34 1.38-2.13.3-.76.5-1.63.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13C21.33 1.35 20.66.94 19.87.63c-.76-.3-1.63-.5-2.91-.56C15.67.01 15.26 0 12 0z"/><path d="M12 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zM18.41 4.6a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z"/></svg>
						</a>
					</li>
				)}
				{site.social.facebook && (
					<li>
						<a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.23 22 17.08 22 12.06z"/></svg>
						</a>
					</li>
				)}
				{site.social.x && (
					<li>
						<a href={site.social.x} target="_blank" rel="noopener noreferrer" aria-label="X (formerly Twitter)">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
						</a>
					</li>
				)}
			</ul>
			<a href={text.ctaHref} class="btn btn-navy site-header__cta">{text.cta}</a>
		</div>
	</div>
</header>

<style>
	.utility-bar {
		background: var(--paper-alt);
		color: var(--navy-dark);
		font-size: 0.78rem;
		border-bottom: 1px solid var(--border);
	}

	.utility-bar__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding-block: 0.55rem;
	}

	.utility-bar__text {
		margin: 0;
		letter-spacing: 0.02em;
	}

	.utility-bar__form {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.utility-bar__form input {
		border-radius: 1px;
		border: 1px solid var(--border);
		background: var(--paper);
		padding: 0.4rem 0.65rem;
		font-size: 0.82rem;
		font-family: var(--font-sans);
		min-width: 200px;
	}

	.utility-bar__btn {
		padding: 0.5rem 1rem;
		font-size: 0.68rem;
	}

	#newsletter-status {
		font-size: 0.72rem;
		align-self: center;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--paper);
		border-bottom: 1px solid var(--border);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding-block: 1.15rem;
	}

	.site-header__logo {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.site-header__logo img {
		height: 48px;
		width: auto;
	}

	.main-nav {
		flex: 1;
	}

	.main-nav__toggle {
		display: none;
		flex-direction: column;
		gap: 4px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
	}

	.main-nav__toggle-bar {
		width: 22px;
		height: 2px;
		background: var(--navy);
	}

	/* One tidy row: the menu collapses to the hamburger below 1360px instead of wrapping onto a second line. */
	.main-nav__list {
		display: flex;
		flex-wrap: nowrap;
		gap: 1.1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.main-nav__list > li > a,
	.main-nav__group-label {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--navy-dark);
		cursor: default;
		white-space: nowrap;
	}

	.main-nav__list > li > a:hover {
		color: var(--gold-dark);
	}

	.main-nav__group {
		position: relative;
	}

	.main-nav__group:hover .main-nav__submenu,
	.main-nav__group:focus-within .main-nav__submenu {
		opacity: 1;
		pointer-events: auto;
	}

	/* Spanish labels are longer, so the dropdowns are wider and "(en inglés)" stays on one line. */
	.main-nav--es .main-nav__submenu {
		min-width: 300px;
	}

	.main-nav__submenu {
		opacity: 0;
		pointer-events: none;
		position: absolute;
		top: 100%;
		left: 0;
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		box-shadow: 0 20px 40px -16px rgba(12, 46, 80, 0.2);
		list-style: none;
		margin: 0.75rem 0 0;
		padding: 0.6rem 0;
		min-width: 210px;
		transition: opacity 0.15s ease;
	}

	/* Invisible bridge over the gap above the submenu so the hover chain
	   doesn't break while the cursor travels from the nav label down to it. */
	.main-nav__submenu::before {
		content: '';
		position: absolute;
		top: -0.75rem;
		left: 0;
		right: 0;
		height: 0.75rem;
		pointer-events: auto;
	}

	.main-nav__submenu a {
		display: block;
		padding: 0.55rem 1.25rem;
		font-weight: 400;
		font-size: 0.88rem;
		font-family: var(--font-sans);
		text-transform: none;
		letter-spacing: 0;
		color: var(--ink);
	}

	.main-nav__submenu a:hover {
		background: var(--paper-alt);
		text-decoration: none;
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-shrink: 0;
	}

	.site-header__lang {
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--navy-dark);
		white-space: nowrap;
	}

	.site-header__lang:hover {
		color: var(--gold-dark);
	}

	.social-icons {
		display: flex;
		gap: 0.6rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.social-icons a {
		color: var(--navy);
		display: inline-flex;
	}

	.site-header__cta {
		white-space: nowrap;
		font-size: 0.78rem;
		letter-spacing: 0.05em;
		padding: 0.6rem 1rem;
	}

	@media (max-width: 860px) {
		.utility-bar__inner {
			justify-content: center;
			text-align: center;
		}
	}

	@media (max-width: 1359px) {
		.main-nav__toggle {
			display: flex;
		}

		.main-nav__list {
			display: none;
			position: absolute;
			left: 0;
			right: 0;
			top: 100%;
			background: #fff;
			border-bottom: 1px solid var(--border);
			flex-direction: column;
			gap: 0;
			padding: 0.5rem 1.5rem 1rem;
		}

		.main-nav__list.is-open {
			display: flex;
		}

		.main-nav__group-label {
			display: block;
			padding: 0.6rem 0;
		}

		.main-nav__submenu {
			display: block;
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
			position: static;
			border: none;
			box-shadow: none;
			padding: 0 0 0 1rem;
			margin: 0;
		}

		.main-nav__submenu a {
			padding: 0.4rem 0;
		}
	}

	/* On phones the full-size button was wider than the screen and made every page scroll sideways. */
	@media (max-width: 700px) {
		.site-header__inner {
			gap: 0.5rem;
			padding-inline: 1rem;
		}

		.site-header__actions {
			gap: 0.5rem;
			min-width: 0;
		}

		/* The social icons are repeated in the footer; dropping them here is what makes the row fit a 375px phone. */
		.site-header__actions .social-icons {
			display: none;
		}

		.site-header__cta {
			white-space: normal;
			font-size: 0.64rem;
			line-height: 1.25;
			letter-spacing: 0.04em;
			padding: 0.5rem 0.65rem;
			max-width: 8.25rem;
		}
	}

	/* Very small phones: the sticky bar at the bottom already carries the valuation button. */
	@media (max-width: 360px) {
		.site-header__cta {
			display: none;
		}

		.site-header__logo img {
			height: 42px;
		}
	}
</style>

<script>
	const toggle = document.getElementById('nav-toggle');
	const list = document.getElementById('main-nav-list');
	toggle?.addEventListener('click', () => {
		const isOpen = list?.classList.toggle('is-open');
		toggle.setAttribute('aria-expanded', String(!!isOpen));
	});

	const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
	newsletterForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const status = document.getElementById('newsletter-status');
		const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
		const button = newsletterForm.querySelector('button');
		if (button) button.disabled = true;
		try {
			const res = await fetch('/api/newsletter', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: emailInput.value }),
			});
			const result = await res.json();
			if (status) status.textContent = res.ok ? (status.dataset.ok ?? 'Subscribed!') : status.dataset.fail && document.documentElement.lang === 'es' ? status.dataset.fail : (result.error ?? status.dataset.fail ?? 'Something went wrong.');
			if (res.ok) newsletterForm.reset();
		} catch {
			if (status) status.textContent = status.dataset.fail ?? 'Something went wrong.';
		} finally {
			if (button) button.disabled = false;
		}
	});
</script>
