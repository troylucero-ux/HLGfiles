---
// Two simple "who does what, where the money goes" diagrams: one for a triple-net (NNN) property,
// one for a Delaware Statutory Trust (DST). Plain HTML and CSS so they reflow on a phone.
interface Props {
	lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
const t = {
	en: {
		opt1: 'Option 1',
		nnnTitle: 'Triple-net (NNN) property',
		tenant: 'One business tenant',
		tenantSub: 'Runs the store, office, or restaurant and signs a long lease',
		nnnFlow: 'Rent, plus taxes, insurance and upkeep',
		owner: 'You, the owner',
		ownerSub: 'Own the property directly and can sell or refinance it',
		nnnNote: 'The tenant pays the property’s costs. You keep the roof and structure if the lease says so, and you deal with the tenant if something goes wrong.',
		opt2: 'Option 2',
		dstTitle: 'Delaware Statutory Trust (DST)',
		investors: 'You and other investors',
		investorsSub: 'Each owns a share, with no landlord duties',
		dstIn: 'Your exchange money goes in',
		dstBack: 'Distributions come back',
		trust: 'The trust',
		trustSub: 'Owns the property. A sponsor buys it, manages it, and decides when to sell',
		dstNote: 'You give up control in return for simplicity. Interests are generally for accredited investors, held until the sponsor sells, and not guaranteed to pay.',
	},
	es: {
		opt1: 'Opción 1',
		nnnTitle: 'Propiedad triple net (NNN)',
		tenant: 'Un solo inquilino comercial',
		tenantSub: 'Opera la tienda, la oficina o el restaurante y firma un contrato largo',
		nnnFlow: 'La renta, más impuestos, seguro y mantenimiento',
		owner: 'Usted, el dueño',
		ownerSub: 'Es dueño directo de la propiedad y puede venderla o refinanciarla',
		nnnNote: 'El inquilino paga los costos de la propiedad. Usted conserva el techo y la estructura si así lo dice el contrato, y trata con el inquilino si algo sale mal.',
		opt2: 'Opción 2',
		dstTitle: 'Fideicomiso Estatutario de Delaware (DST)',
		investors: 'Usted y otros inversionistas',
		investorsSub: 'Cada uno es dueño de una parte, sin obligaciones de propietario',
		dstIn: 'Entra el dinero de su intercambio',
		dstBack: 'Regresan las distribuciones',
		trust: 'El fideicomiso',
		trustSub: 'Es dueño de la propiedad. Un patrocinador la compra, la administra y decide cuándo vender',
		dstNote: 'Usted cede el control a cambio de sencillez. Las participaciones generalmente son para inversionistas acreditados, se mantienen hasta que el patrocinador venda y no tienen pago garantizado.',
	},
}[lang];
---

<div class="how">
	<figure class="how__panel" aria-labelledby="how-nnn">
		<figcaption id="how-nnn">
			<span class="how__kicker">{t.opt1}</span>
			<strong>{t.nnnTitle}</strong>
		</figcaption>
		<div class="how__row">
			<div class="node node--other">
				<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 40V18l16-10 16 10v22M8 40h32M18 40V28h12v12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/></svg>
				<strong>{t.tenant}</strong>
				<span>{t.tenantSub}</span>
			</div>
			<div class="flow" aria-hidden="true">
				<span class="flow__label">{t.nnnFlow}</span>
				<span class="flow__arrow"></span>
			</div>
			<div class="node node--you">
				<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="16" r="7" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M10 40c0-8 6-13 14-13s14 5 14 13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
				<strong>{t.owner}</strong>
				<span>{t.ownerSub}</span>
			</div>
		</div>
		<p class="how__note">{t.nnnNote}</p>
	</figure>

	<figure class="how__panel" aria-labelledby="how-dst">
		<figcaption id="how-dst">
			<span class="how__kicker">{t.opt2}</span>
			<strong>{t.dstTitle}</strong>
		</figcaption>
		<div class="how__row">
			<div class="node node--you">
				<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="17" cy="17" r="6" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="33" cy="19" r="5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M5 38c0-7 5-11 12-11s12 4 12 11M31 28c6 0 12 3 12 9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
				<strong>{t.investors}</strong>
				<span>{t.investorsSub}</span>
			</div>
			<div class="flow flow--two" aria-hidden="true">
				<span class="flow__label">{t.dstIn}</span>
				<span class="flow__arrow"></span>
				<span class="flow__arrow flow__arrow--back"></span>
				<span class="flow__label">{t.dstBack}</span>
			</div>
			<div class="node node--trust">
				<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M6 20 24 8l18 12M10 20v16M20 20v16M28 20v16M38 20v16M6 40h36" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/></svg>
				<strong>{t.trust}</strong>
				<span>{t.trustSub}</span>
			</div>
		</div>
		<p class="how__note">{t.dstNote}</p>
	</figure>
</div>

<style>
	.how {
		display: grid;
		gap: 1.25rem;
		margin-top: 2rem;
	}
	.how__panel {
		margin: 0;
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 1.25rem 1.5rem 1.35rem;
	}
	figcaption {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin-bottom: 1rem;
		font-family: var(--font-serif);
		font-size: 1.2rem;
		color: var(--navy);
	}
	.how__kicker {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--gold-dark);
	}
	.how__row {
		display: grid;
		grid-template-columns: 1fr minmax(150px, 0.8fr) 1fr;
		align-items: center;
		gap: 0.75rem;
	}
	.node {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.3rem;
		padding: 1rem 0.9rem;
		border-radius: 12px;
		height: 100%;
		justify-content: center;
	}
	.node svg {
		width: 40px;
		height: 40px;
	}
	.node strong {
		font-size: 1rem;
	}
	.node span {
		font-size: 0.86rem;
		line-height: 1.4;
	}
	.node--you {
		background: var(--navy);
		color: #fff;
	}
	.node--you span {
		color: #dbe5f1;
	}
	.node--other {
		background: var(--paper-alt);
		border: 1px solid var(--border);
		color: var(--navy);
	}
	.node--other span {
		color: var(--ink-soft);
	}
	.node--trust {
		background: #f4ecda;
		border: 1px solid var(--gold-light);
		color: var(--navy-dark);
	}
	.node--trust span {
		color: var(--ink);
	}
	.flow {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		text-align: center;
	}
	.flow__label {
		font-size: 0.8rem;
		line-height: 1.3;
		color: var(--ink-soft);
		font-weight: 600;
	}
	.flow__arrow {
		display: block;
		width: 100%;
		height: 2px;
		background: var(--gold);
		position: relative;
	}
	.flow__arrow::after {
		content: '';
		position: absolute;
		right: -1px;
		top: -4px;
		border-left: 9px solid var(--gold);
		border-top: 5px solid transparent;
		border-bottom: 5px solid transparent;
	}
	.flow__arrow--back::after {
		right: auto;
		left: -1px;
		border-left: 0;
		border-right: 9px solid var(--gold);
	}
	.how__note {
		margin: 1rem 0 0;
		font-size: 0.92rem;
		color: var(--ink-soft);
	}
	@media (max-width: 700px) {
		.how__panel {
			padding: 1rem 1rem 1.15rem;
		}
		.how__row {
			grid-template-columns: 1fr;
			gap: 0.6rem;
		}
		.flow {
			flex-direction: row;
			justify-content: center;
			gap: 0.75rem;
			padding: 0.1rem 0;
		}
		.flow--two {
			flex-wrap: wrap;
		}
		.flow__arrow {
			width: 2px;
			height: 26px;
		}
		.flow__arrow::after {
			right: auto;
			left: -4px;
			top: auto;
			bottom: -1px;
			border-left: 5px solid transparent;
			border-right: 5px solid transparent;
			border-top: 9px solid var(--gold);
			border-bottom: 0;
		}
		.flow__arrow--back::after {
			bottom: auto;
			top: -1px;
			border-top: 0;
			border-bottom: 9px solid var(--gold);
			border-left: 5px solid transparent;
			border-right: 5px solid transparent;
		}
		.flow--two {
			display: grid;
			grid-template-columns: 1fr auto auto 1fr;
			align-items: center;
		}
	}
</style>
