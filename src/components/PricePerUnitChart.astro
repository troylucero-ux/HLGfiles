---
// Bar chart of median price per unit for older (pre-1978, rent-controlled) buildings across every
// submarket with enough sales, with the current page's neighborhood highlighted. Figures come from
// SALES_STATS, so they refresh with that file.
import { submarkets } from '../data/submarkets';
import { SALES_STATS, MIN_PRICE_COMPS_PAGE, VALUATION_DATA_PERIOD } from '../data/valuationAssumptions';

interface Props {
	highlight: string;
}

const { highlight } = Astro.props;
const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;

const rows = submarkets
	.map((sm) => {
		const ppu = SALES_STATS[sm.slug]?.rso?.pricePerUnit;
		return ppu && ppu.compCount >= MIN_PRICE_COMPS_PAGE ? { slug: sm.slug, name: sm.name.replace(/\s*\(.*\)/, ''), median: ppu.median } : null;
	})
	.filter((r): r is NonNullable<typeof r> => Boolean(r))
	.sort((a, b) => b.median - a.median);
const maxPrice = Math.max(...rows.map((r) => r.median));
---

<figure class="ppu" aria-labelledby="ppu-cap">
	<figcaption id="ppu-cap" class="ppu__cap">Median price per unit, buildings built before 1978, {VALUATION_DATA_PERIOD}</figcaption>
	{
		rows.map((r) => (
			<a href={`/submarkets/${r.slug}/`} class={`ppu__row${r.slug === highlight ? ' ppu__row--here' : ''}`}>
				<span class="ppu__name">{r.name}</span>
				<span class="ppu__track">
					<span class="ppu__bar" style={`width: ${(r.median / maxPrice) * 100}%`} />
				</span>
				<span class="ppu__val">{money(r.median)}</span>
			</a>
		))
	}
	<p class="ppu__source">Source: Highlight Multifamily Group analysis of CoStar sold multifamily comps. Neighborhoods with fewer than {MIN_PRICE_COMPS_PAGE} sales are left out.</p>
</figure>

<style>
	.ppu {
		margin: 2rem 0;
		max-width: 900px;
	}

	.ppu__cap {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		color: var(--navy-dark);
		margin-bottom: 1rem;
	}

	.ppu__row {
		display: grid;
		grid-template-columns: 150px 1fr 100px;
		align-items: center;
		gap: 1rem;
		padding-block: 0.35rem;
		color: var(--ink);
	}

	.ppu__row:hover {
		text-decoration: none;
	}

	.ppu__name {
		font-size: 0.92rem;
	}

	.ppu__track {
		height: 22px;
		background: var(--paper-alt);
	}

	.ppu__bar {
		display: block;
		height: 100%;
		background: var(--navy-tint);
		border: 1px solid var(--navy);
	}

	.ppu__val {
		text-align: right;
		font-variant-numeric: tabular-nums;
		font-size: 0.92rem;
	}

	.ppu__row--here .ppu__name,
	.ppu__row--here .ppu__val {
		font-weight: 700;
		color: var(--navy-dark);
	}

	.ppu__row--here .ppu__bar {
		background: var(--gold);
		border-color: var(--gold-dark);
	}

	.ppu__source {
		font-size: 0.78rem;
		color: var(--ink-light);
		margin: 0.85rem 0 0;
	}

	@media (max-width: 640px) {
		.ppu__row {
			grid-template-columns: 110px 1fr 80px;
			gap: 0.6rem;
		}
	}
</style>
