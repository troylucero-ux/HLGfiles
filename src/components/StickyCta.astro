---
// Slim bar fixed to the bottom of every page once the visitor scrolls: call us, or get a free valuation.
// Every button carries data-cta so Google Analytics records which button on which page was clicked.
import { site } from '../data/site';

interface Props {
	lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const tel = `tel:+1${site.phone.replace(/\D/g, '')}`;
const valuationHref = es ? '/es/vender-edificio-de-apartamentos-los-angeles/' : '/property-value/';
---

<div class="scta" id="scta" role="region" aria-label={es ? 'Llamar o pedir una valoración gratis' : 'Call us or get a free valuation'} data-cta-zone="sticky-bar">
	<div class="scta__inner">
		<span class="scta__msg">{es ? '¿Piensa vender su edificio?' : 'Thinking of selling your building?'}</span>
		<a class="scta__call" href={tel} data-cta="sticky-bar-call">
			{es ? 'Llamar' : 'Call'} <span class="scta__num">{site.phone}</span>
		</a>
		<a class="scta__val" href={valuationHref} data-cta="sticky-bar-free-valuation">
			{es ? 'Valoración Gratis' : 'Free Valuation'}
		</a>
	</div>
</div>

<script>
	const bar = document.getElementById('scta');
	if (bar) {
		const toggle = () => bar.classList.toggle('scta--show', window.scrollY > 400);
		window.addEventListener('scroll', toggle, { passive: true });
		toggle();
	}
</script>

<style>
	.scta {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 60;
		display: flex;
		justify-content: center;
		padding: 0 0.75rem calc(0.6rem + env(safe-area-inset-bottom));
		pointer-events: none;
		transform: translateY(130%);
		opacity: 0;
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	.scta--show {
		transform: none;
		opacity: 1;
	}

	.scta__inner {
		pointer-events: auto;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 8px;
		box-shadow: 0 6px 24px rgb(12 46 80 / 0.22);
		padding: 0.55rem 0.65rem 0.55rem 1.1rem;
	}

	.scta__msg {
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--navy-dark);
		margin-right: 0.35rem;
	}

	.scta__call,
	.scta__val {
		text-decoration: none;
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		border-radius: 4px;
		padding: 0.65rem 1.05rem;
		white-space: nowrap;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.scta__call {
		color: var(--navy-dark);
		border: 1px solid var(--navy-dark);
		background: transparent;
	}

	.scta__call:hover {
		background: var(--navy-tint);
	}

	.scta__num {
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.scta__val {
		background: var(--navy);
		color: #fff;
		border: 1px solid var(--navy);
	}

	.scta__val:hover {
		background: var(--navy-dark);
		color: #fff;
	}

	@media (max-width: 760px) {
		.scta {
			padding: 0;
		}

		.scta__inner {
			width: 100%;
			border-radius: 0;
			border-width: 1px 0 0;
			padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom));
			gap: 0.6rem;
		}

		.scta__msg,
		.scta__num {
			display: none;
		}

		.scta__call {
			flex: 1;
			text-align: center;
		}

		.scta__val {
			flex: 2;
			text-align: center;
		}

		/* Keep the footer text clear of the bar. */
		:global(body) {
			padding-bottom: 4.25rem;
		}
	}

	@media print {
		.scta {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scta {
			transition: none;
		}
	}
</style>
