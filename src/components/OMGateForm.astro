---
// Instant-download gate for a listing's Offering Memorandum. The Worker (/api/om-lead) records the
// lead in Pipedrive and answers with the PDF address, which this form then shows as a download button.
import { site } from '../data/site';

interface Props {
	property: string; // listing slug, matched against worker/om-files.ts
	propertyName: string;
}

const { property, propertyName } = Astro.props;
const phoneHref = `tel:+1${site.phone.replace(/\D/g, '')}`;
---

<div class="om-gate-wrap">
<section class="om-gate" id="offering-memorandum" data-property={property}>
	<div class="om-gate__intro">
		<span class="om-gate__icon" aria-hidden="true">
			<svg viewBox="0 0 24 24">
				<path d="M7 3h7l5 5v13H7z" />
				<path d="M14 3v5h5" />
				<path d="M10 13h6M10 16.5h6M10 9.5h2" />
			</svg>
		</span>
		<span class="om-gate__badge">Offering Memorandum</span>
		<h2>Get the Offering Memorandum</h2>
		<p class="om-gate__sub">Enter your details to download the full Offering Memorandum for {propertyName}.</p>
		<ul class="om-gate__perks" role="list">
			<li>Instant PDF download</li>
			<li>No signed agreement required</li>
			<li>Just your name and email to start</li>
		</ul>
		<p class="om-gate__call">
			Questions about the property? Call <a href={phoneHref}>{site.phone}</a>
		</p>
	</div>

	<div class="om-gate__panel">
		<form class="js-om-gate" novalidate>
			<div class="om-gate__grid">
				<div class="om-gate__field">
					<label for="omg-name">Name</label>
					<input id="omg-name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
				</div>
				<div class="om-gate__field">
					<label for="omg-email">Email</label>
					<input id="omg-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
				</div>
				<div class="om-gate__field om-gate__wide">
					<label for="omg-phone">Phone <span class="om-gate__opt">(optional)</span></label>
					<input id="omg-phone" name="phone" type="tel" placeholder="(310) 555-0123" autocomplete="tel" />
				</div>
			</div>
			<label class="om-gate__consent">
				<input type="checkbox" name="privacyConsent" required />
				<span>
					I agree to the <a href="/privacy-policy/">Privacy Policy</a> and to be contacted about this property. You can unsubscribe at any time.
				</span>
			</label>
			<button type="submit" class="om-gate__submit">
				<svg viewBox="0 0 20 20" aria-hidden="true">
					<path d="M10 3v9.5M6 9l4 4 4-4M4 16.5h12" />
				</svg>
				<span>Download Offering Memorandum</span>
			</button>
			<p class="om-gate__status" role="status" hidden></p>
		</form>
		<div class="om-gate__done" hidden>
			<span class="om-gate__check" aria-hidden="true">
				<svg viewBox="0 0 20 20"><path d="M4.5 10.5l3.7 3.7 7.3-8" /></svg>
			</span>
			<p><strong>Thank you.</strong> Your Offering Memorandum is ready.</p>
			<a class="om-gate__submit js-om-link" href="#" target="_blank" rel="noopener">
				<svg viewBox="0 0 20 20" aria-hidden="true">
					<path d="M10 3v9.5M6 9l4 4 4-4M4 16.5h12" />
				</svg>
				<span>Open the Offering Memorandum (PDF)</span>
			</a>
		</div>
	</div>
</section>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.om-gate').forEach((box) => {
		const form = box.querySelector<HTMLFormElement>('.js-om-gate')!;
		const status = box.querySelector<HTMLParagraphElement>('.om-gate__status')!;
		const done = box.querySelector<HTMLElement>('.om-gate__done')!;
		const link = box.querySelector<HTMLAnchorElement>('.js-om-link')!;
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			status.hidden = false;
			status.style.color = '#b3261e';
			if (!form.checkValidity()) {
				status.textContent = 'Please fill in your name and email and accept the privacy policy.';
				form.reportValidity();
				return;
			}
			const data = Object.fromEntries(new FormData(form).entries()) as Record<string, unknown>;
			data.privacyConsent = (form.querySelector('input[name="privacyConsent"]') as HTMLInputElement).checked;
			data.property = box.dataset.property;
			data.source = (window as unknown as { hlgSource?: () => unknown }).hlgSource?.();

			button.disabled = true;
			status.style.color = '';
			status.textContent = 'Sending...';
			try {
				const res = await fetch('/api/om-lead', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				const result = await res.json();
				if (res.ok && result.omUrl) {
					link.href = result.omUrl;
					form.hidden = true;
					done.hidden = false;
					link.focus();
				} else if (res.ok) {
					status.style.color = 'var(--success)';
					status.textContent = "Thank you. We'll email the Offering Memorandum shortly.";
					form.reset();
				} else {
					status.style.color = '#b3261e';
					status.textContent = result.error ?? 'Something went wrong. Please try again.';
				}
			} catch {
				status.style.color = '#b3261e';
				status.textContent = 'Something went wrong. Please try again or call us directly.';
			} finally {
				button.disabled = false;
			}
		});
	});
</script>

<style>
	.om-gate-wrap {
		container-type: inline-size;
	}

	.om-gate {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 24px 60px -28px rgb(12 46 80 / 0.38), 0 2px 6px rgb(12 46 80 / 0.05);
		scroll-margin-top: 10rem;
	}

	/* Left panel */
	.om-gate__intro {
		position: relative;
		color: #d7e0ea;
		background: radial-gradient(120% 120% at 0% 0%, #1c5b99 0%, var(--navy) 45%, var(--navy-dark) 100%);
		padding: clamp(1.75rem, 3.5vw, 2.5rem);
		overflow: hidden;
	}

	.om-gate__intro::after {
		content: '';
		position: absolute;
		right: -90px;
		bottom: -90px;
		width: 260px;
		height: 260px;
		border-radius: 50%;
		border: 36px solid rgb(255 255 255 / 0.05);
		pointer-events: none;
	}

	.om-gate__icon {
		display: grid;
		place-items: center;
		width: 3.2rem;
		height: 3.2rem;
		margin-bottom: 1.1rem;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.1);
		border: 1px solid rgb(255 255 255 / 0.2);
	}

	.om-gate__icon svg {
		width: 1.6rem;
		height: 1.6rem;
		fill: none;
		stroke: var(--gold-light);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.om-gate__badge {
		display: block;
		width: fit-content;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--gold-light);
		border: 1px solid rgb(255 255 255 / 0.25);
		border-radius: 999px;
		padding: 0.3rem 0.8rem;
		margin-bottom: 1rem;
	}

	.om-gate__intro h2 {
		margin: 0 0 0.7rem;
		color: #fff;
		font-size: clamp(1.4rem, 2.4vw, 1.8rem);
		line-height: 1.2;
	}

	.om-gate__sub {
		margin: 0 0 1.4rem;
		color: #d7e0ea;
		line-height: 1.6;
	}

	.om-gate__perks {
		list-style: none;
		margin: 0 0 1.4rem;
		padding: 0;
		display: grid;
		gap: 0.65rem;
	}

	.om-gate__perks li {
		position: relative;
		padding-left: 1.7rem;
		font-size: 0.92rem;
		line-height: 1.45;
		color: #fff;
	}

	.om-gate__perks li::before {
		content: '';
		position: absolute;
		left: 0.1rem;
		top: 0.28rem;
		width: 0.7rem;
		height: 0.4rem;
		border-left: 2px solid var(--gold-light);
		border-bottom: 2px solid var(--gold-light);
		transform: rotate(-45deg);
	}

	.om-gate__call {
		position: relative;
		margin: 0;
		font-size: 0.9rem;
		color: #d7e0ea;
	}

	.om-gate__call a {
		color: #fff;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Right panel */
	.om-gate__panel {
		padding: clamp(1.5rem, 3.5vw, 2.5rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.om-gate__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-bottom: 1.1rem;
	}

	.om-gate__wide {
		grid-column: 1 / -1;
	}

	.om-gate label {
		display: block;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--navy-dark);
		margin-bottom: 0.4rem;
	}

	.om-gate__opt {
		font-weight: 400;
		color: var(--ink-light);
	}

	.om-gate input[type='text'],
	.om-gate input[type='email'],
	.om-gate input[type='tel'] {
		width: 100%;
		padding: 0.85rem 1rem;
		border: 1px solid #cfd8e3;
		border-radius: 10px;
		font-size: 0.98rem;
		font-family: var(--font-sans);
		color: var(--ink);
		background: #fbfcfe;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
	}

	.om-gate input[type='text']:hover,
	.om-gate input[type='email']:hover,
	.om-gate input[type='tel']:hover {
		border-color: #a9b8ca;
	}

	.om-gate input:focus {
		outline: none;
		border-color: var(--navy);
		background: #fff;
		box-shadow: 0 0 0 4px rgb(20 70 122 / 0.14);
	}

	.om-gate input::placeholder {
		color: #8b98a8;
	}

	.om-gate .om-gate__consent {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		font-size: 0.78rem;
		font-weight: 400;
		line-height: 1.5;
		color: var(--ink-light);
		margin: 0.25rem 0 1.25rem;
	}

	.om-gate__consent input {
		margin-top: 0.2rem;
		accent-color: var(--navy);
	}

	.om-gate__submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		font-family: var(--font-sans);
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		color: #fff;
		background: linear-gradient(180deg, #1b5a9a 0%, var(--navy) 100%);
		border: 0;
		border-radius: 10px;
		padding: 1rem 1.75rem;
		cursor: pointer;
		box-shadow: 0 10px 22px -10px rgb(20 70 122 / 0.7);
		transition: transform 0.15s ease, box-shadow 0.2s ease, filter 0.2s ease;
	}

	.om-gate__submit svg {
		width: 1.15rem;
		height: 1.15rem;
		flex: none;
		fill: none;
		stroke: var(--gold-light);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.om-gate__submit:hover {
		transform: translateY(-1px);
		filter: brightness(1.08);
		box-shadow: 0 14px 26px -10px rgb(20 70 122 / 0.75);
	}

	.om-gate__submit:disabled {
		opacity: 0.75;
		cursor: progress;
		transform: none;
	}

	.om-gate__status {
		margin-top: 0.85rem;
		font-weight: 600;
		font-size: 0.9rem;
	}

	.om-gate__status[hidden],
	.om-gate__done[hidden] {
		display: none;
	}

	.om-gate__done {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.9rem;
	}

	.om-gate__done p {
		margin: 0;
		font-size: 1.1rem;
		color: var(--navy-dark);
	}

	.om-gate__check {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		background: var(--navy-tint);
	}

	.om-gate__check svg {
		width: 1.5rem;
		height: 1.5rem;
		fill: none;
		stroke: var(--navy);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Stack the two panels whenever the card itself is narrow, not just the screen. */
	@container (max-width: 880px) {
		.om-gate {
			grid-template-columns: 1fr;
		}

		.om-gate__intro h2 {
			max-width: 32rem;
		}

		.om-gate__perks {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem 1.75rem;
		}
	}

	@container (max-width: 560px) {
		.om-gate__grid {
			grid-template-columns: 1fr;
		}

		.om-gate__submit {
			width: 100%;
		}

		.om-gate__perks {
			display: grid;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.om-gate__submit,
		.om-gate input {
			transition: none;
		}
	}
</style>
