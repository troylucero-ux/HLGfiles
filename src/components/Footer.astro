---
import { site, team } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__grid">
		<div class="site-footer__col">
			<img
				class="site-footer__logo-img"
				src="/images/brand/hlg-eu-logo-dark.svg"
				alt="Highlight Multifamily Group, Equity Union Commercial"
				width="240"
				height="61"
			/>
			<p>{site.officeAddress}</p>
			<p>Office DRE #{site.officeDRE}</p>
			<ul class="site-footer__social" aria-label="Follow Highlight Multifamily Group">
				<li>
					<a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0z"/></svg>
					</a>
				</li>
				<li>
					<a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.56-.79.31-1.46.72-2.13 1.38C1.35 2.67.94 3.34.63 4.13c-.3.76-.5 1.63-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13.67.66 1.34 1.07 2.13 1.38.76.3 1.63.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.66-.67 1.07-1.34 1.38-2.13.3-.76.5-1.63.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13C21.33 1.35 20.66.94 19.87.63c-.76-.3-1.63-.5-2.91-.56C15.67.01 15.26 0 12 0z"/><path d="M12 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zM18.41 4.6a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z"/></svg>
					</a>
				</li>
				<li>
					<a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.23 22 17.08 22 12.06z"/></svg>
					</a>
				</li>
				<li>
					<a href={site.social.x} target="_blank" rel="noopener noreferrer" aria-label="X (formerly Twitter)">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
					</a>
				</li>
			</ul>
		</div>

		<div class="site-footer__col">
			<h2>Company</h2>
			<ul>
				<li><a href="/about/">Our Team</a></li>
				<li><a href="/case-studies/">Case Studies</a></li>
				<li><a href="/testimonials/">Testimonials</a></li>
				<li><a href="/insights/">Insights</a></li>
				<li><a href="/contact/">Contact</a></li>
			</ul>
		</div>

		<div class="site-footer__col">
			<h2>Properties</h2>
			<ul>
				<li><a href="/property-value/">Free Value Calculator</a></li>
				<li><a href="/measure-ula-calculator/">Measure ULA Calculator</a></li>
				<li><a href="/listings/">Listings</a></li>
				<li><a href="/closed-sales/">Closed Sales</a></li>
				<li><a href="/closed-sales/map/">Closed Sales Map</a></li>
				<li><a href="/land-for-development/">Land for Development</a></li>
				<li><a href="/submarkets/">Submarkets</a></li>
					<li><a href="/market-report/">Market Report</a></li>
			</ul>
		</div>

		<div class="site-footer__col">
			<h2>Services</h2>
			<ul>
				<li><a href="/broker-opinion-of-value/">Free Broker Opinion of Value</a></li>
					<li><a href="/1031-exchanges/">1031 Exchanges</a></li>
				<li><a href="/trust-and-estate-sales/">Trust &amp; Estate Sales</a></li>
				<li><a href="/spanish-speaking-apartment-broker-los-angeles/">Se Habla Español</a></li>
				<li><a href="/es/" lang="es">Inicio en Español</a></li>
				<li><a href="/es/insights/" lang="es">Artículos en Español</a></li>
				<li><a href="/es/preguntas-frecuentes/" lang="es">Preguntas Frecuentes en Español</a></li>
				<li><a href="/triple-net-dst/">Triple Net (NNN) &amp; DSTs</a></li>
				<li><a href="/faqs/">FAQs</a></li>
			</ul>
		</div>

		<div class="site-footer__col">
			<h2>Contact</h2>
			<ul class="site-footer__contacts">
				{
					team.map((member) => (
						<li>
							<strong>{member.name}</strong>
							<br />
							<a href={`tel:${member.phone.replace(/\D/g, '')}`}>{member.phone}</a>
							<br />
							<a href={`mailto:${member.email}`}>{member.email}</a>
							<br />
							DRE #{member.dre}
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<div class="container site-footer__bottom">
		<p>&copy; {year} {site.name}. All rights reserved.</p>
		<ul>
			<li><a href="/privacy-policy/">Privacy Policy</a></li>
			<li><a href="/terms/">Terms &amp; Conditions</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer__social {
		list-style: none;
		display: flex;
		gap: 0.9rem;
		margin: 1rem 0 0;
		padding: 0;
	}

	.site-footer__social a {
		display: inline-flex;
		padding: 0.25rem;
		color: #d7e0ea;
	}

	.site-footer__social a:hover {
		color: var(--gold-light);
	}

	.site-footer {
		background: var(--navy-dark);
		color: #bcccdc;
		font-size: 0.88rem;
	}

	.site-footer a {
		color: #d7e0ea;
	}

	.site-footer h2 {
		font-family: var(--font-sans);
		color: var(--gold-light);
		font-weight: 600;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		margin-bottom: 1.1rem;
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1fr 1.3fr;
		gap: 2.5rem;
		padding-block: 4.5rem 2.5rem;
	}

	.site-footer__logo-img {
		width: 100%;
		max-width: 240px;
		height: auto;
		display: block;
		margin-bottom: 1.25rem;
	}

	.site-footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-footer ul li {
		margin-bottom: 0.5rem;
	}

	.site-footer__contacts li {
		margin-bottom: 1rem;
		line-height: 1.5;
	}

	.site-footer__bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.25rem;
	}

	.site-footer__bottom ul {
		display: flex;
		gap: 1.5rem;
	}

	@media (max-width: 860px) {
		.site-footer__grid {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
