---
// Lightweight "click to load" YouTube embed: shows just the thumbnail and a play button until
// clicked, so a listing page with a video doesn't pay YouTube's iframe weight on every visit,
// only for visitors who actually want to watch. Loads via youtube-nocookie.com once clicked.
interface Props {
	youtubeId: string;
	title: string;
}

const { youtubeId, title } = Astro.props;
---

<div class="yt-facade" data-youtube-id={youtubeId} data-title={title}>
	<img src={`https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`} alt={title} loading="lazy" width="480" height="360" />
	<button type="button" class="yt-facade__play" aria-label={`Play video: ${title}`}>
		<svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
			<path
				d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"
				fill="#0c2e50"
				fill-opacity="0.85"
			></path>
			<path d="M45 24 27 14v20" fill="#fff"></path>
		</svg>
	</button>
</div>

<script>
	document.querySelectorAll<HTMLDivElement>('.yt-facade').forEach((facade) => {
		facade.addEventListener(
			'click',
			() => {
				const id = facade.dataset.youtubeId;
				const title = facade.dataset.title ?? 'Video';
				const iframe = document.createElement('iframe');
				iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
				iframe.title = title;
				iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
				iframe.allowFullscreen = true;
				iframe.width = '100%';
				iframe.height = '100%';
				facade.replaceWith(iframe);
			},
			{ once: true }
		);
	});
</script>

<style>
	.yt-facade {
		position: relative;
		aspect-ratio: 16 / 9;
		width: 100%;
		cursor: pointer;
		border-radius: 2px;
		overflow: hidden;
		background: #000;
	}

	.yt-facade img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.85;
	}

	.yt-facade__play {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 68px;
		height: 48px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
	}

	.yt-facade__play svg {
		width: 100%;
		height: 100%;
		filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
		transition: transform 0.15s ease;
	}

	.yt-facade:hover .yt-facade__play svg {
		transform: scale(1.08);
	}

	iframe {
		aspect-ratio: 16 / 9;
		width: 100%;
		border: 0;
		border-radius: 2px;
	}
</style>
