---
import { site } from '../data/site';

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	items: Crumb[];
	light?: boolean;
}

const { items, light = false } = Astro.props;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items.map((item, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: item.label,
		...(item.href ? { item: new URL(item.href, site.url).toString() } : {}),
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<nav class:list={['breadcrumbs', { 'breadcrumbs--light': light }]} aria-label="Breadcrumb">
	<ol>
		{
			items.map((item, i) => (
				<li>
					{item.href && i < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
					{i < items.length - 1 && (
						<span class="breadcrumbs__sep" aria-hidden="true">
							/
						</span>
					)}
				</li>
			))
		}
	</ol>
</nav>

<style>
	.breadcrumbs ol {
		display: flex;
		flex-wrap: wrap;
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
		font-size: 0.78rem;
	}

	.breadcrumbs li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.breadcrumbs a {
		color: var(--ink-light);
	}

	.breadcrumbs a:hover {
		color: var(--gold-dark);
	}

	.breadcrumbs span[aria-current] {
		color: var(--ink-light);
		font-weight: 600;
	}

	.breadcrumbs__sep {
		color: var(--border);
	}

	.breadcrumbs--light a {
		color: rgba(255, 255, 255, 0.7);
	}

	.breadcrumbs--light a:hover {
		color: var(--gold-light);
	}

	.breadcrumbs--light span[aria-current] {
		color: #fff;
	}

	.breadcrumbs--light .breadcrumbs__sep {
		color: rgba(255, 255, 255, 0.35);
	}
</style>
