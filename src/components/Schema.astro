---
import { site, team } from '../data/site';

interface Props {
	pageType?: 'home' | 'other';
}

const { pageType = 'other' } = Astro.props;

const orgSchema = {
	'@context': 'https://schema.org',
	'@type': 'RealEstateAgent',
	name: site.name,
	url: site.url,
	image: `${site.url}/images/brand/hlg-logo.png`,
	telephone: site.phone,
	address: {
		'@type': 'PostalAddress',
		streetAddress: '16820 Ventura Boulevard',
		addressLocality: 'Encino',
		addressRegion: 'CA',
		postalCode: '91436',
		addressCountry: 'US',
	},
	areaServed: {
		'@type': 'City',
		name: 'Los Angeles',
	},
	employee: team.map((member) => ({
		'@type': 'Person',
		name: member.name,
		jobTitle: member.title,
		telephone: member.phone,
		email: member.email,
		sameAs: [member.linkedin, member.instagram, member.facebook].filter(Boolean),
	})),
	parentOrganization: {
		'@type': 'RealEstateAgent',
		name: site.brokerage,
	},
	sameAs: [site.social.linkedin, site.social.instagram, site.social.facebook].filter(Boolean),
};

const localBusinessSchema = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': `${site.url}/#localbusiness`,
	name: site.name,
	url: site.url,
	telephone: site.phone,
	address: orgSchema.address,
};
---

<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
