		margin-top: 2rem;
	}

	.smg-figcap {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		color: var(--navy-dark);
		margin-bottom: 1rem;
	}

	.smg-source {
		font-size: 0.78rem;
		color: var(--ink-light);
		margin: 0.85rem 0 0;
	}

	/* Comparison table */
