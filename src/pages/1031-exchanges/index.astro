---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BOVForm from '../../components/BOVForm.astro';
import ExchangeTimeline from '../../components/ExchangeTimeline.astro';
import { caseStudies } from '../../data/caseStudies';
import { closings } from '../../data/closings';
import { formatPrice } from '../../lib/format';

const exchangeCaseStudies = caseStudies.filter((cs) => cs.dealType.includes('1031'));

// Our process, in the order we run it. Steps 3 to 7 describe how Highlight actually works an exchange.
const steps = [
	{
		title: 'Start With Your Goals',
		body: 'In our first conversation we ask what you want from the sale: your goals, your plan, and what you want to own afterward. That includes which state you want to buy in and which asset class, whether apartments, triple-net, a DST, or a shopping center.',
	},
	{
		title: 'Price and Market the Building With the Exchange in Mind',
		body: 'We prepare a Broker Opinion of Value grounded in real closed comps and market your building to get the best price, while planning around your exchange deadlines from day one.',
	},
	{
		title: 'Meet the Top Brokers for Your Replacement Property',
		body: 'Based on the state and asset class you choose, we introduce you to three of the top brokers in that market and property type. You choose the broker you want to work with.',
	},
	{
		title: 'Connect With a Qualified Intermediary',
		body: 'We connect you with a qualified intermediary, who holds your sale proceeds so you never touch them, and we coordinate with your CPA and attorney to keep the exchange inside IRS requirements.',
	},
	{
		title: 'Work Hand in Hand and Keep You Informed',
		body: 'We stay in touch at every stage of the sale, so you always know where the transaction stands and what is coming next.',
	},
	{
		title: 'Start Making Offers While Still in Escrow',
		body: 'Once contingencies are removed on your sale, we encourage you to start making offers on replacement property, even while escrow is still open. Our clients usually have a replacement deal in place before their building closes.',
	},
	{
		title: 'Build In a Buffer',
		body: 'We add an option to extend the close of escrow by 30 days to every counter offer on the sale. If you have not found your replacement property yet, we exercise it, which gives you more time before the clock starts.',
	},
	{
		title: 'Close the Sale and Complete the Exchange',
		body: 'We stay with you through identification and closing on the replacement property, working with the replacement broker, your intermediary, and your advisors until the exchange is complete.',
	},
];

const routes = [
	{
		title: 'Apartments to Apartments',
		body: 'Many owners stay in multifamily, trading for larger buildings, more units, better cash flow, newer construction, or non-rent-controlled property, in Los Angeles or in other states. One Highlight client sold a 192-unit Westlake portfolio and exchanged into two Texas multifamily properties.',
		href: '/case-studies/the-burlington-portfolio-westlake-apartments/',
		cta: 'Read the Burlington case study',
	},
	{
		title: 'Triple-Net (NNN) Properties',
		body: 'In a triple-net lease the tenant pays property taxes, insurance, and maintenance, which removes the day-to-day work of managing property. One Highlight client sold her 24-unit Los Angeles apartment building and exchanged into two separate NNN properties, one in Florida and one in Georgia.',
		href: '/insights/1031-exchange-into-triple-net-properties/',
		cta: 'Read about the NNN exchange',
	},
	{
		title: 'Delaware Statutory Trusts (DSTs)',
		body: 'A DST lets you buy a fractional interest in a larger, professionally managed property as a passive investor, and DST interests can qualify as replacement property for an exchange. We introduce you to brokers who specialize in them.',
		href: '/triple-net-dst/',
		cta: 'Learn about NNN and DST options',
	},
];

// Exchanges Highlight has handled, as described by the team. Size and price come from the closed sale itself.
const exchangeDeals = [
	{ slug: '14654-gault-st-van-nuys-ca-91405', role: 'Seller exchange', note: 'Our selling client exchanged into a newer fourplex in North Hollywood.' },
	{ slug: '707-crenshaw-blvd-los-angeles-ca-90005', role: 'Seller exchange', note: 'Our selling client exchanged into triple-net properties.' },
	{ slug: '1136-s-alvarado-st-los-angeles-ca-90006', role: 'Seller exchange', note: 'Our selling client exchanged into two triple-net properties, one in Florida and one in Georgia.' },
	{ slug: '49270-cochran-dr-indio-ca-92201', role: 'Buyer exchange', note: 'We helped our buyer client, who had sold land in Nevada, exchange into this new development.' },
]
	.map((d) => ({ ...d, sale: closings.find((c) => c.slug === d.slug) }))
	.filter((d) => d.sale);

const rules = [
	{
		label: 'What qualifies',
		text: 'Real property held for investment or business use can be exchanged for other like-kind real property. Since 2018, only real property qualifies.',
	},
	{
		label: 'The 45-day rule',
		text: 'You must identify your replacement property within 45 days after your building closes.',
	},
	{
		label: 'The 180-day rule',
		text: 'You must receive the replacement property within 180 days, or by the due date of your tax return (including extensions), whichever is earlier.',
	},
	{
		label: 'A qualified intermediary',
		text: 'You cannot touch the sale proceeds. A qualified intermediary holds them and uses them to buy your replacement property.',
	},
	{
		label: 'How much to buy',
		text: 'To defer all of the tax, you generally buy replacement property of equal or greater value and reinvest all of the net proceeds. Cash or debt relief you receive can be taxable.',
	},
	{
		label: 'Naming properties',
		text: 'You generally identify up to three properties of any value, or more if they meet certain value limits. Your intermediary and CPA will confirm which rule fits.',
	},
];

const faqs = [
	{
		q: 'What is a 1031 exchange?',
		a: 'A 1031 exchange, named for Section 1031 of the Internal Revenue Code, lets you sell an investment property and defer the capital gains tax, including depreciation recapture, by reinvesting the proceeds into other like-kind real property. It defers the tax rather than eliminating it.',
	},
	{
		q: 'How long do I have to complete a 1031 exchange?',
		a: 'You have 45 days after your sale closes to identify replacement property and 180 days, or until your tax return is due including extensions if that is earlier, to receive it. These deadlines are firm. If your sale closes late in the year, the 180 days can end early unless you file an extension, so talk to your CPA.',
	},
	{
		q: 'Do I have to buy replacement property in California?',
		a: 'No. Replacement property can be in another state, and many Los Angeles owners exchange out of state. California has its own reporting form for like-kind exchanges, and the deferred California gain generally remains taxable if you later sell the out-of-state property, so ask your CPA how it applies to you.',
	},
	{
		q: 'What if I cannot find replacement property in time?',
		a: 'If you miss a deadline, the exchange fails and the gain is generally taxable in the year of the sale. That is why we start early, encourage you to make offers while your sale is still in escrow, and build a 30-day closing extension option into every counter offer on your building.',
	},
	{
		q: 'Can I exchange into something passive?',
		a: 'Yes. Many owners exchange into triple-net properties or Delaware Statutory Trusts to stop managing tenants and property. We introduce you to brokers who specialize in those asset classes.',
	},
	{
		q: 'Does a 1031 exchange avoid the City of Los Angeles Measure ULA tax?',
		a: 'Not as far as we are aware. A 1031 exchange can defer your capital gains tax, but exchanges are not among the Measure ULA exemptions the City lists, so the transfer tax is still calculated on the sale. Confirm with your CPA or tax attorney.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
	title="1031 Exchange Broker in Los Angeles for Apartment Owners"
	description="1031 exchange help for LA apartment owners: the 45- and 180-day rules, our step-by-step process, and real exchanges into Texas, Florida, and Georgia."
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">1031 Exchanges</span>
			<h1>1031 Exchange Strategy for LA Apartment Owners</h1>
			<p>
				Selling an apartment building and want to defer capital gains? We've guided LA multifamily owners through 1031 exchanges into replacement
				properties across California and out of state. Every selling client of ours who wanted to complete a 1031 exchange has done so.
			</p>
			<a href="/contact/?intent=bov" class="btn btn-gold">Start Your Exchange Strategy</a>
		</div>
	</section>

	<section class="section">
		<div class="container narrow">
			<span class="eyebrow">The Basics</span>
			<h2>What Is a 1031 Exchange?</h2>
			<p>
				A 1031 exchange, named for Section 1031 of the Internal Revenue Code, lets you sell an investment property and defer the capital gains tax, including
				depreciation recapture, by reinvesting the proceeds into other like-kind real property. It defers the tax rather than eliminating it. For how the tax works
				and what it can cost without an exchange, read our guide to
				<a href="/insights/capital-gains-depreciation-recapture-selling-la-apartment-building/">capital gains and depreciation recapture</a>.
			</p>
			<div class="rules">
				{
					rules.map((r) => (
						<div class="rule">
							<span class="rule__label">{r.label}</span>
							<p>{r.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<span class="eyebrow">The Clock</span>
			<h2>The 45- and 180-Day Deadlines</h2>
			<p class="timeline-intro">
				Once your relinquished property closes escrow, two IRS deadlines start running in parallel. Both are hard cutoffs, not guidelines, which is why we start
				sourcing replacement options before your sale even closes.
			</p>
			<ExchangeTimeline />
			<p class="timeline-intro">
				Selling late in the year? Read how your closing date interacts with these deadlines in our article on
				<a href="/insights/selling-la-apartment-building-before-year-end/">timing a sale before year-end</a>.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="eyebrow">Where You Can Exchange</span>
			<h2>Three Common Routes for LA Apartment Owners</h2>
			<div class="routes">
				{
					routes.map((r) => (
						<div class="route">
							<h3>{r.title}</h3>
							<p>{r.body}</p>
							<a href={r.href}>{r.cta} &rarr;</a>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<span class="eyebrow">How It Works</span>
			<h2>Our 1031 Exchange Process</h2>
			<div class="steps">
				{
					steps.map((step, i) => (
						<div class="step">
							<span class="step__num">{i + 1}</span>
							<div>
								<h3>{step.title}</h3>
								<p>{step.body}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container narrow">
			<span class="eyebrow">Why It Works</span>
			<h2>Time Is the Biggest Risk, So We Buy Time Up Front</h2>
			<p>
				Most failed exchanges fail on the calendar, not on price. Two things in our approach give you room. First, we get you comfortable making offers on
				replacement property right away, so you are not rushing to find a building on the last day of your 45-day window. Second, the 30-day closing extension
				option in every counter offer lets us push your close out when you need it. Because the 45 days only start when your sale closes, an extension of 30 days
				gives you as much as 75 days from the originally scheduled closing date to identify a property.
			</p>
		</div>
	</section>

	{
		exchangeCaseStudies.length > 0 && (
			<section class="section section-alt">
				<div class="container">
					<span class="eyebrow">Case Studies</span>
					<h2>1031 Exchanges in Practice</h2>
					<div class="cs-preview-grid">
						{exchangeCaseStudies.map((cs) => (
							<a href={`/case-studies/${cs.slug}/`} class="cs-preview">
								<h3>{cs.title}</h3>
								<p>{cs.summary}</p>
								<span>Read the case study &rarr;</span>
							</a>
						))}
					</div>
					<h3 class="more-title">More Exchanges We Have Handled</h3>
					<div class="deal-grid">
						{exchangeDeals.map((d) => (
							<a href={`/closed-sales/${d.slug}/`} class="deal">
								<span class="deal__role">{d.role}</span>
								<strong>{d.sale!.name}</strong>
								<span class="deal__meta">
									{d.sale!.city}, {d.sale!.state} &middot; {d.sale!.units} units &middot; Closed at {formatPrice(d.sale!.price)}
								</span>
								<span class="deal__note">{d.note}</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="container narrow">
			<span class="eyebrow">Questions</span>
			<h2>1031 Exchange FAQs</h2>
			<div class="faq__list">
				{
					faqs.map((item) => (
						<details class="faq__item">
							<summary>{item.q}</summary>
							<p>{item.a}</p>
						</details>
					))
				}
			</div>
			<p class="sources">
				This page is general information, not tax or legal advice. Rules and thresholds change, so confirm everything with your CPA or tax attorney. Sources:
				<a href="https://www.irs.gov/instructions/i8824" target="_blank" rel="noopener noreferrer">IRS Instructions for Form 8824</a>,
				<a href="https://www.irs.gov/publications/p544" target="_blank" rel="noopener noreferrer">IRS Publication 544</a>, and the
				<a href="https://www.ftb.ca.gov/forms/2025/2025-3840.pdf" target="_blank" rel="noopener noreferrer">California Franchise Tax Board Form 3840</a>.
			</p>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container links-row">
			<a href="/insights/1031-exchange-into-triple-net-properties/" class="btn btn-outline">
				What Is a 1031 Exchange? Read the Full Guide
			</a>
			<a href="/triple-net-dst/" class="btn btn-outline">
				Exchanging Into a Passive NNN or DST Investment?
			</a>
			<a href="/insights/should-i-sell-my-la-apartment-building/" class="btn btn-outline">
				Not Sure You Should Sell? Start Here
			</a>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<BOVForm heading="Exploring a 1031 Exchange?" subheading="Get a free, confidential Broker Opinion of Value and exchange strategy conversation." />
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		background: linear-gradient(135deg, var(--navy) 0%, var(--navy-dark) 100%);
		color: #fff;
		padding-block: clamp(3rem, 7vw, 5rem);
	}

	.page-hero h1 {
		color: #fff;
	}

	.page-hero p {
		color: #d7e0ea;
		max-width: 700px;
		font-size: 1.05rem;
	}

	.page-hero .btn-gold {
		background: var(--gold);
		color: var(--navy-dark);
		border-color: var(--gold);
	}

	.page-hero .btn-gold:hover {
		background: var(--gold-light);
		border-color: var(--gold-light);
	}

	.narrow {
		max-width: 820px;
	}

	.rules {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
		margin-top: 1.75rem;
	}

	.rule {
		background: var(--paper);
		border: 1px solid var(--border);
		border-top: 3px solid var(--gold);
		border-radius: 1px;
		padding: 1.25rem 1.5rem;
	}

	.rule__label {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gold-dark);
		font-weight: 700;
	}

	.rule p {
		margin: 0.4rem 0 0;
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.routes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.route {
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
	}

	.route h3 {
		margin-bottom: 0.5rem;
	}

	.route p {
		flex: 1;
		line-height: 1.65;
	}

	.route a {
		font-weight: 600;
		font-size: 0.9rem;
	}

	.steps {
		display: grid;
		gap: 1.5rem;
		max-width: 760px;
		margin-top: 2rem;
	}

	.step {
		display: flex;
		gap: 1.25rem;
	}

	.step__num {
		flex-shrink: 0;
		width: 42px;
		height: 42px;
		border-radius: 2px;
		background: var(--navy-tint);
		color: var(--navy-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 1.1rem;
	}

	.step h3 {
		margin-bottom: 0.25rem;
	}

	.timeline-intro {
		max-width: 700px;
		margin-bottom: 1.5rem;
	}

	.links-row {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.cs-preview-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.cs-preview {
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 1.75rem;
		color: var(--ink);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.cs-preview:hover {
		border-color: var(--gold);
		transform: translateY(-2px);
		text-decoration: none;
	}

	.cs-preview span {
		font-weight: 600;
		font-size: 0.85rem;
	}

	.more-title {
		margin-top: 2.5rem;
	}

	.deal-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}

	.deal {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 1.4rem;
		color: var(--ink);
		transition: border-color 0.2s ease;
	}

	.deal:hover {
		border-color: var(--gold);
		text-decoration: none;
	}

	.deal__role {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gold-dark);
		font-weight: 700;
	}

	.deal strong {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 1.15rem;
		color: var(--navy-dark);
	}

	.deal__meta {
		font-size: 0.8rem;
		color: var(--ink-light);
	}

	.deal__note {
		font-size: 0.92rem;
		line-height: 1.55;
		margin-top: 0.3rem;
	}

	.faq__item {
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		margin-bottom: 0.75rem;
		padding: 0 1.25rem;
	}

	.faq__item summary {
		cursor: pointer;
		font-family: var(--font-serif);
		font-size: 1.1rem;
		color: var(--navy-dark);
		padding-block: 1rem;
	}

	.faq__item p {
		margin: 0 0 1rem;
		line-height: 1.7;
	}

	.sources {
		margin-top: 1.5rem;
		font-size: 0.85rem;
		color: var(--ink-light);
	}
</style>
