---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BOVForm from '../../components/BOVForm.astro';
import OMRequestForm from '../../components/OMRequestForm.astro';
import { team, site } from '../../data/site';

// This page is statically prerendered, so Astro.url has no access to the request's query string —
// the ?intent= heading swap has to happen client-side after load (see the script below).
---

<BaseLayout
	title="Contact Highlight Multifamily Group"
	description="Contact Josh Kaplan and Troy Lucero at Highlight Multifamily Group for LA apartment building sales, 1031 exchanges, and trust or probate sales."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Contact</span>
			<h1>Let's Talk About Your Property</h1>
			<p>Reach out directly, or send us your details below and we'll follow up within one business day.</p>
		</div>
	</section>

	<section class="section">
		<div class="container contact-grid">
			<div class="contact-cards">
				{
					team.map((member) => (
						<div class="contact-card">
							<h2>{member.name}</h2>
							<p class="contact-card__title">
								{member.title} | {site.name}
							</p>
							<p class="contact-card__department">{member.department}</p>
							<a href={`tel:${member.phone.replace(/\D/g, '')}`}>{member.phone}</a>
							<a href={`mailto:${member.email}`}>{member.email}</a>
							{member.languages.includes('Spanish') && <p class="contact-card__lang">Habla español · Speaks Spanish</p>}
							<p class="contact-card__dre">DRE #{member.dre}</p>
						</div>
					))
				}
				<div class="contact-card">
					<h2>Office</h2>
					<p>{site.brokerage}</p>
					<p>{site.officeAddress}</p>
					<p class="contact-card__dre">Office DRE #{site.officeDRE}</p>
				</div>
			</div>

			<div id="bov-form-wrap">
				<BOVForm showLanguage />
			</div>
			<div id="om-form-wrap" hidden>
				<OMRequestForm />
			</div>
		</div>
	</section>

	<section class="section visit-office">
		<div class="container">
			<div class="visit-office__intro">
				<h2>Visit Our Office</h2>
				<div class="visit-office__details">
					<p>{site.brokerage}<br />{site.officeAddress}</p>
					<p>Phone: {site.phone}</p>
				</div>
			</div>
			<iframe
				class="visit-office__map"
				src="https://storage.googleapis.com/maps-solutions-4ze9oqx72w/locator-plus/q0yb/locator-plus.html"
				title="Highlight Multifamily Group office location"
				width="100%"
				height="500"
				style="border:0;"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen></iframe>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		background: var(--paper-alt);
		padding-block: 3rem;
		border-bottom: 1px solid var(--border);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: 3rem;
		align-items: start;
	}

	.contact-cards {
		display: grid;
		gap: 1.5rem;
	}

	.contact-card {
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 1.75rem;
	}

	.contact-card h2 {
		font-size: 1.3rem;
	}

	.contact-card a {
		display: block;
		font-weight: 600;
	}

	.contact-card__title {
		color: var(--gold-dark);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.72rem;
		margin-bottom: 0;
	}

	.contact-card__department {
		color: var(--ink-light);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.72rem;
		margin-bottom: 0.5rem;
	}

	.contact-card__lang {
		color: var(--gold-dark);
		font-weight: 600;
		font-size: 0.85rem;
		margin-top: 0.4rem;
	}

	.contact-card__dre {
		font-size: 0.8rem;
		color: var(--ink-light);
		margin-top: 0.5rem;
	}

	.visit-office {
		border-top: 1px solid var(--border);
	}

	.visit-office__intro {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2.5rem;
		margin-bottom: 1.25rem;
	}

	.visit-office__intro h2 {
		margin: 0;
	}

	.visit-office__details {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 2rem;
	}

	.visit-office__details p {
		margin: 0;
	}

	.visit-office__map {
		display: block;
		width: 100%;
		height: 500px;
		border: 1px solid var(--border);
		border-radius: 2px;
	}

	@media (max-width: 860px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}

		.visit-office__map {
			height: 380px;
		}
	}
</style>

<script>
	const intentHeadings: Record<string, string> = {
		probate: 'Start a Confidential Conversation',
		'nnn-dst': "Let's Talk Through Your Options",
	};
	const intent = new URLSearchParams(window.location.search).get('intent');

	if (intent === 'om') {
		// A buyer requesting a specific listing's Offering Memorandum gets a dedicated, shorter
		// form instead of the seller-facing BOV form (which asks for the visitor's own property).
		document.getElementById('bov-form-wrap')?.setAttribute('hidden', '');
		document.getElementById('om-form-wrap')?.removeAttribute('hidden');
	} else {
		const heading = intent && intentHeadings[intent];
		if (heading) {
			const h2 = document.querySelector('.bov-form h2');
			if (h2) h2.textContent = heading;
		}
	}
</script>
