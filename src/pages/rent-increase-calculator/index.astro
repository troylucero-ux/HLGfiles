<script>
	// Keep in step with the rates in the header comment of this file. Checked November 17 to 18, 2026.
	// Update each year: LA RSO in July, AB 1482 in August, Santa Monica and West Hollywood in September, Pasadena in October.
	// West Hollywood: 2.75% was announced at the June 25, 2026 Rent Stabilization Commission meeting (same figure as WestHollywoodGuide.astro).
	// weho.org still showed the prior year's 2.25% on November 18, 2026, so confirm against the city's notice form when it is updated.
	const RULES = {
		rso: {
			limit: 3,
			def: 3,
			rentLabel: 'Average monthly rent per unit',
			typeHint: 'RSO buildings in the City of Los Angeles are generally those built on or before October 1, 1978. Check an address at zimas.lacity.org.',
			pctHint: 'The City of Los Angeles limit is 3% for increases effective July 1, 2026 through June 30, 2027.',
		},
		state: {
			limit: 8.7,
			def: 5,
			rentLabel: 'Average monthly rent per unit',
			typeHint: 'California’s AB 1482 limit covers most buildings that are not rent-stabilized, with exceptions such as buildings less than 15 years old.',
			pctHint:
				'The California limit is 8.7% for increases effective August 1, 2026 through July 31, 2027. A higher rent than the market will pay can push tenants out.',
		},
		pasadena: {
			limit: 2.5,
			def: 2.5,
			rentLabel: 'Average monthly rent per unit',
			typeHint: 'Measure H covers multi-unit rentals in Pasadena built before February 1, 1995.',
			pctHint: 'Pasadena’s limit is 2.5% for increases effective October 1, 2026 through September 30, 2027.',
		},
		sm: {
			limit: 2.6,
			def: 2.6,
			capDollar: 70,
			rentLabel: 'Average Maximum Allowable Rent (MAR) per unit',
			typeHint: 'Santa Monica’s limit applies to each unit’s MAR, which can differ from the rent being charged. Look up a unit’s MAR with the city’s Look Up a Rent tool.',
			pctHint: 'Santa Monica’s 2026 general adjustment is 2.6%, with a ceiling of $70 a month for MARs of $2,674 or more, for increases effective September 1, 2026.',
		},
		weho: {
			limit: 2.75,
			def: 2.75,
			rentLabel: 'Average monthly rent per unit',
			typeHint: 'West Hollywood’s rent stabilization covers multi-family rentals built before July 1, 1979.',
			pctHint:
				'West Hollywood’s limit is 2.75% for increases effective September 1, 2026 through August 31, 2027, as announced by its Rent Stabilization Commission. Confirm it against your notice form.',
		},
	};
	const LIMIT_NOTICE_PCT = 10;

	const $ = (id) => document.getElementById(id);
	const money = (n) => `$${Math.round(n).toLocaleString('en-US')}`;
	const digits = (s) => Number(String(s ?? '').replace(/[^0-9.]/g, ''));
	const num = (id) => Number($(id).value);

	let tracked = false;

	function loanFactor(ratePct) {
		const r = ratePct / 100 / 12;
		const n = 360;
		if (r <= 0) return 12 / n;
		return (r / (1 - Math.pow(1 + r, -n))) * 12;
	}

	function update() {
		const type = $('ri-type').value;
		const rule = RULES[type];
		const units = Math.max(0, Math.round(num('ri-units')) || 0);
		const rent = digits($('ri-rent').value);
		let pct = num('ri-pct');
		const cap = num('ri-cap') || 0;
		const rate = num('ri-rate') || 0;
		const dscr = num('ri-dscr') || 1.25;

		$('ri-type-hint').textContent = rule.typeHint;
		$('ri-pct-hint').textContent = rule.pctHint;
		$('ri-rent-label').textContent = rule.rentLabel;

		const flag = $('ri-flag');
		flag.hidden = true;
		if (!(pct >= 0)) pct = 0;
		if (rule.limit === null) {
			if (!$('ri-pct').value) {
				flag.hidden = false;
				flag.textContent = 'Enter the percentage from your West Hollywood increase notice to see the numbers.';
			} else if (pct > LIMIT_NOTICE_PCT) {
				flag.hidden = false;
				flag.textContent = `${pct}% is unusually high for West Hollywood. Check it with the city at (323) 848-6450.`;
			}
		} else if (pct > rule.limit) {
			flag.hidden = false;
			flag.textContent = `${pct}% is above the ${rule.limit}% limit, so the numbers below use ${rule.limit}%.`;
			pct = rule.limit;
		}

		let perUnit = (rent * pct) / 100;
		if (rule.capDollar && perUnit > rule.capDollar) {
			perUnit = rule.capDollar;
			flag.hidden = false;
			flag.textContent = `The $${rule.capDollar} monthly ceiling applies at this MAR, so each unit’s increase is $${rule.capDollar}, not ${pct}%.`;
		}
		const effPct = rent > 0 ? (perUnit / rent) * 100 : pct;
		const extraYear = perUnit * 12 * units;
		const value = cap > 0 ? extraYear / (cap / 100) : 0;
		const loan = extraYear / (dscr * loanFactor(rate));

		const pctShown = Math.round(effPct * 100) / 100;
		$('ri-extra-year').textContent = money(extraYear);
		$('ri-extra-sub').textContent = `more income every year at ${pctShown}% across ${units} units`;
		$('ri-per-unit').textContent = money(perUnit);
		$('ri-value').textContent = money(value);
		$('ri-loan').textContent = money(loan);
		$('ri-notice').textContent = effPct <= LIMIT_NOTICE_PCT ? '30 days (increase of 10% or less)' : '90 days';

		const body = $('ri-skip-body');
		body.innerHTML = '';
		let running = 0;
		for (let y = 1; y <= 5; y++) {
			const raised = rent * Math.pow(1 + effPct / 100, y);
			running += (raised - rent) * 12 * units;
			const tr = document.createElement('tr');
			tr.innerHTML = `<th scope="row">Year ${y}</th><td>${money(raised)}</td><td>${money(rent)}</td><td>${money(running)}</td>`;
			body.appendChild(tr);
		}
		const yr5 = (rent * Math.pow(1 + effPct / 100, 5) - rent) * 12 * units;
		const val5 = cap > 0 ? yr5 / (cap / 100) : 0;
		$('ri-skip-lede').textContent =
			effPct > 0
				? `Giving ${pctShown}% every year for five years, versus never raising the rent, adds ${money(running)} in rent collected, and about ${money(val5)} of building value by year five at a ${cap}% cap rate.`
				: 'Enter an increase above zero to see the five-year difference.';
		$('ri-skip-note').textContent =
			'This assumes the same percentage every year, no vacancy, and no change in expenses. The yearly limit changes, so real figures will differ. Income skipped in one year is generally not recovered later.';

		if (!tracked) {
			tracked = true;
			window.gtag?.('event', 'calculator_use', { calculator: 'rent_increase', page_path: window.location.pathname });
		}
	}

	$('ri-type').addEventListener('change', () => {
		const rule = RULES[$('ri-type').value];
		$('ri-pct').value = String(rule.def);
		update();
	});
	for (const id of ['ri-units', 'ri-pct', 'ri-cap', 'ri-rate', 'ri-dscr']) $(id).addEventListener('input', update);
	$('ri-rent').addEventListener('input', () => {
		const d = digits($('ri-rent').value);
		$('ri-rent').value = d ? Math.round(d).toLocaleString('en-US') : '';
		update();
	});
	update();
</script>

