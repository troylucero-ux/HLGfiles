---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BOVForm from '../../components/BOVForm.astro';
import { team, supportTeam, site } from '../../data/site';
---

<BaseLayout
	title="About Josh Kaplan & Troy Lucero | Highlight Multifamily Group"
	description="Meet Josh Kaplan and Troy Lucero of Highlight Multifamily Group, the team behind 1,390+ units and $345M+ closed across LA apartment building sales."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">About Us</span>
			<h1>A Seasoned Team Apartment Owners Can Rely On</h1>
			<p>
				Highlight Multifamily Group brings more than 20 years of experience as investment sales brokers, alongside principal experience in
				acquisitions, dispositions, asset management, and development. We personally understand the challenges of being a long-term owner, a
				buyer, and a seller, which helps us serve our clients through every stage of purchasing, owning, and selling multifamily property,
				including 1031 exchanges.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			{
				team.map((member) => (
					<article class="bio-card">
						{member.headshot ? (
							<img
								class="bio-card__photo"
								src={member.headshot}
								alt={`${member.name}, ${member.title}, ${member.department} at Highlight Multifamily Group`}
								width="180"
								height="180"
								loading="lazy"
							/>
						) : (
							<div class="bio-card__photo bio-card__photo--fallback" aria-hidden="true">
								{member.name
									.split(' ')
									.map((n) => n[0])
									.join('')}
							</div>
						)}
						<div class="bio-card__content">
							<h2>{member.name}</h2>
							<p class="bio-card__title">
								{member.title} | {site.name}
							</p>
							<p class="bio-card__department">
								{member.department} &middot; DRE #{member.dre}
							</p>
							{member.bio.map((p) => (
								<p>{p}</p>
							))}
							<dl class="bio-card__facts">
								<div>
									<dt>Education</dt>
									<dd>{member.education}</dd>
								</div>
								<div>
									<dt>Specialties</dt>
									<dd>{member.specialties.join(', ')}</dd>
								</div>
							</dl>
							<div class="bio-card__contact">
								<a href={`tel:${member.phone.replace(/\D/g, '')}`} class="btn btn-outline">
									{member.phone}
								</a>
								<a href={`mailto:${member.email}`} class="btn btn-outline">
									Email {member.name.split(' ')[0]}
								</a>
							</div>
							<ul class="bio-card__social">
								{member.linkedin && (
									<li>
										<a href={member.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on LinkedIn`}>
											<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
												<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0z" />
											</svg>
										</a>
									</li>
								)}
								{member.instagram && (
									<li>
										<a href={member.instagram} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on Instagram`}>
											<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
												<path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.56-.79.31-1.46.72-2.13 1.38C1.35 2.67.94 3.34.63 4.13c-.3.76-.5 1.63-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13.67.66 1.34 1.07 2.13 1.38.76.3 1.63.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.66-.67 1.07-1.34 1.38-2.13.3-.76.5-1.63.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13C21.33 1.35 20.66.94 19.87.63c-.76-.3-1.63-.5-2.91-.56C15.67.01 15.26 0 12 0z" />
												<path d="M12 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zM18.41 4.6a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z" />
											</svg>
										</a>
									</li>
								)}
								{member.facebook && (
									<li>
										<a href={member.facebook} target="_blank" rel="noopener noreferrer" aria-label={`${member.name} on Facebook`}>
											<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
												<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.23 22 17.08 22 12.06z" />
											</svg>
										</a>
									</li>
								)}
							</ul>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<span class="eyebrow">Meet Your Team of Experts</span>
			<h2>The Team Behind Every Transaction</h2>
			<div class="support-grid">
				{
					supportTeam.map((member) => (
						<div class="support-card">
							{member.headshot ? (
								<img
									class="support-card__photo"
									src={member.headshot}
									alt={`${member.name}, ${member.title} at Highlight Multifamily Group`}
									width="76"
									height="76"
									loading="lazy"
								/>
							) : (
								<div class="support-card__photo support-card__photo--fallback" aria-hidden="true">
									{member.name
										.split(' ')
										.map((n) => n[0])
										.join('')}
								</div>
							)}
							<h3>{member.name}</h3>
							<p>{member.title}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="eyebrow">Track Record</span>
			<h2>Results That Speak for Themselves</h2>
			<div class="stat-row">
				<div>
					<span class="stat-row__num">1,390+</span>
					<span class="stat-row__label">Units Closed</span>
				</div>
				<div>
					<span class="stat-row__num">$345M+</span>
					<span class="stat-row__label">In Sale Value</span>
				</div>
				<div>
					<span class="stat-row__num">135,000 SF</span>
					<span class="stat-row__label">Land for Development Closed</span>
				</div>
			</div>
			<div class="brand-lockup">
				<img src="/images/brand/hlg-logo.png" alt="Highlight Multifamily Investment Group" width="176" height="101" />
				<span class="brand-lockup__divider" aria-hidden="true"></span>
				<img src="/images/brand/equity-union-logo.png" alt={site.brokerage} width="176" height="80" />
			</div>
			<p class="office-note">
				{site.name} operates as part of {site.brokerage}, {site.officeAddress}. Office DRE #{site.officeDRE}.
			</p>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<BOVForm heading="Ready to Talk Strategy?" subheading="Get a free, confidential Broker Opinion of Value from Josh and Troy." />
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		background: var(--paper-alt);
		padding-block: 3rem;
		border-bottom: 1px solid var(--border);
	}

	.page-hero p {
		max-width: 780px;
		font-size: 1.1rem;
		color: var(--ink-soft);
	}

	.bio-card {
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 2.5rem;
		margin-bottom: 4.5rem;
	}

	.bio-card__photo {
		width: 180px;
		height: 180px;
		border-radius: 2px;
		object-fit: cover;
	}

	.bio-card__photo--fallback {
		background: var(--navy-dark);
		color: var(--gold-light);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-serif);
		font-size: 2.75rem;
		font-weight: 400;
	}

	.bio-card__title {
		font-family: var(--font-sans);
		color: var(--gold-dark);
		font-weight: 600;
		text-transform: uppercase;
		font-size: 0.72rem;
		letter-spacing: 0.1em;
	}

	.bio-card__department {
		font-family: var(--font-sans);
		color: var(--ink-light);
		font-weight: 600;
		text-transform: uppercase;
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		margin-top: 0.2rem;
	}

	.bio-card__facts {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin: 1.75rem 0;
		padding: 1.25rem 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.bio-card__facts dt {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-light);
		font-weight: 600;
	}

	.bio-card__facts dd {
		margin: 0.2rem 0 0;
	}

	.bio-card__contact {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.bio-card__social {
		display: flex;
		gap: 0.6rem;
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
	}

	.bio-card__social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 1px solid var(--border);
		color: var(--navy);
		transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
	}

	.bio-card__social a:hover {
		border-color: var(--gold);
		color: var(--gold-dark);
		background: var(--navy-tint);
	}

	.support-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.support-card {
		text-align: center;
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 2.25rem 1rem;
	}

	.support-card__photo {
		width: 76px;
		height: 76px;
		margin: 0 auto 1.25rem;
		border-radius: 2px;
		object-fit: cover;
	}

	.support-card__photo--fallback {
		background: var(--navy-tint);
		color: var(--navy-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: 1.4rem;
	}

	.support-card h3 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 1.1rem;
		margin-bottom: 0.2rem;
	}

	.support-card p {
		font-size: 0.82rem;
		color: var(--ink-light);
		margin: 0;
	}

	.stat-row {
		display: flex;
		gap: 3.5rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}

	.stat-row__num {
		display: block;
		font-family: var(--font-serif);
		font-size: 2.5rem;
		font-weight: 400;
		color: var(--navy-dark);
	}

	.stat-row__label {
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-light);
	}

	.brand-lockup {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		margin-top: 2.75rem;
	}

	.brand-lockup img {
		height: 56px;
		width: auto;
	}

	.brand-lockup__divider {
		width: 1px;
		height: 40px;
		background: var(--border);
	}

	.office-note {
		margin-top: 1rem;
		font-size: 0.85rem;
		color: var(--ink-light);
	}

	@media (max-width: 640px) {
		.bio-card {
			grid-template-columns: 1fr;
		}

		.bio-card__facts {
			grid-template-columns: 1fr;
		}
	}
</style>
