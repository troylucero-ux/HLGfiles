---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BOVForm from '../../components/BOVForm.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import sharp from 'sharp';
import { closings } from '../../data/closings';
import { caseStudies } from '../../data/caseStudies';
import { submarkets } from '../../data/submarkets';
import { listings } from '../../data/listings';
import { closingCoordinates } from '../../data/closingCoordinates';
import { site } from '../../data/site';
import { youtubeMeta } from '../../data/youtubeMeta';
import { formatPrice, formatPriceFull, formatSoldDate, soldWhen } from '../../lib/format';

export function getStaticPaths() {
	return closings.map((sale) => ({
		params: { slug: sale.slug },
		props: { sale },
	}));
}

const { sale } = Astro.props;
const isLand = sale.type === 'development-site';
const submarket = sale.submarket ? submarkets.find((s) => s.slug === sale.submarket) : null;
const caseStudy = sale.caseStudySlug ? caseStudies.find((c) => c.slug === sale.caseStudySlug) : null;
// Photo sizes are read at build time. A full-width hero needs a sharp photo (1000px+ wide): the first photo is used when it is big enough,
// otherwise the widest one that is. Sales whose photos are all small get a compact header with the photo shown as a framed picture instead.
const allImages = sale.images ?? [];
const imageWidths = await Promise.all(
	allImages.map(async (src) => {
		try {
			return (await sharp(`public${src}`).metadata()).width ?? 0;
		} catch (e) {
			console.warn("[closed-sales] could not read photo size for", src, String(e).slice(0,160));
			return 0;
		}
	}),
);
const widest = imageWidths.length ? Math.max(...imageWidths) : 0;
const heroIdx = imageWidths[0] >= 1000 ? 0 : widest >= 1000 ? imageWidths.indexOf(widest) : 0;
const heroWide = allImages.length > 0 && imageWidths[heroIdx] >= 1000;
const image = allImages[heroIdx];
const heroNaturalWidth = imageWidths[heroIdx] || 400;
// Natural height of the hero photo, so the browser can reserve its space (avoids layout shift).
const heroNaturalHeight = image ? ((await sharp(`public${image}`).metadata().catch(() => ({ height: 0 }))).height ?? 0) || 300 : 300;
// A building that sold more than once with us gets the sale year after its name; a recorded year (or a year in the slug) tells the pages apart.
const hasSibling = closings.some((c) => c.name === sale.name && c.slug !== sale.slug);
const saleYear = sale.soldDate && hasSibling ? sale.soldDate.slice(0, 4) : /-20\d\d$/.test(sale.slug) ? sale.slug.slice(-4) : null;

// The blurb is plain text, with [link text](/internal-path/) links supported (same format as Insights posts).
const linkPattern = /\[([^\]]+)\]\((\/[^)\s]*)\)/g;
const blurbParts: { text: string; href?: string }[] = [];
if (sale.blurb) {
	let last = 0;
	for (const m of sale.blurb.matchAll(linkPattern)) {
		if (m.index! > last) blurbParts.push({ text: sale.blurb.slice(last, m.index) });
		blurbParts.push({ text: m[1], href: m[2] });
		last = m.index! + m[0].length;
	}
	if (last < sale.blurb.length) blurbParts.push({ text: sale.blurb.slice(last) });
}

// Derived from the sale's own recorded figures only; anything that can't be computed is omitted.
const pricePerUnit = sale.units ? Math.round(sale.price / sale.units) : null;
const pricePerSf = sale.sqft ? Math.round(sale.price / sale.sqft) : null;

const kind = isLand ? 'development site' : sale.units ? `${sale.units}-unit apartment building` : 'apartment building';
const article = /^(8|11|18)(\D|$)/.test(kind) || /^[aeiou]/i.test(kind) ? 'an' : 'a';
const place = [sale.city + ',', sale.state, sale.zip].filter(Boolean).join(' ');
const summary = [
	`${sale.name} is ${article} ${kind} in ${place}, closed ${sale.soldDate ? `${soldWhen(sale.soldDate)} ` : ''}for ${formatPriceFull(sale.price)}.`,
	pricePerUnit && pricePerSf
		? `That works out to ${formatPriceFull(pricePerUnit)} per unit and $${pricePerSf.toLocaleString('en-US')} per square foot of building area.`
		: pricePerSf
			? `That works out to $${pricePerSf.toLocaleString('en-US')} per square foot${isLand ? ' of land' : ''}.`
			: pricePerUnit
				? `That works out to ${formatPriceFull(pricePerUnit)} per unit.`
				: '',
]
	.filter(Boolean)
	.join(' ');

// Related sales: same submarket first, then the closest by price within the same property type.
const others = closings.filter((c) => c.slug !== sale.slug);
const sameSubmarket = sale.submarket ? others.filter((c) => c.submarket === sale.submarket) : [];
const byPriceProximity = others
	.filter((c) => c.type === sale.type && !sameSubmarket.includes(c))
	.sort((a, b) => Math.abs(a.price - sale.price) - Math.abs(b.price - sale.price));
const related = [...sameSubmarket.sort((a, b) => Math.abs(a.price - sale.price) - Math.abs(b.price - sale.price)), ...byPriceProximity].slice(0, 3);

const activeListings = sale.submarket ? listings.filter((l) => l.submarket === sale.submarket && l.status === 'active').slice(0, 2) : [];

const soldLabel = isLand
	? `Development Site Sold for ${formatPrice(sale.price)}`
	: `${sale.units ? `${sale.units}-Unit ` : ''}Apartment Sold for ${formatPrice(sale.price)}`;
const fullTitle = `${sale.name}, ${sale.city} | ${soldLabel}`;
// Drop the city when a long property name would push the title past what Google displays.
const noCityTitle = `${sale.name} | ${soldLabel}`;
const seoTitle = fullTitle.length <= 60 ? fullTitle : noCityTitle.length <= 60 ? noCityTitle : `${sale.name} | Sold for ${formatPrice(sale.price)}`;
const seoDescription = `${sale.name} in ${sale.city}, ${sale.state}: ${kind} sold for ${formatPriceFull(sale.price)}. See the price per ${isLand ? 'square foot' : 'unit'} and Highlight's track record.`;

const videoSchema = sale.youtubeId
	? {
			'@context': 'https://schema.org',
			'@type': 'VideoObject',
			name: `${sale.name} Video Tour`,
			description: summary,
			thumbnailUrl: `https://img.youtube.com/vi/${sale.youtubeId}/hqdefault.jpg`,
			embedUrl: `https://www.youtube-nocookie.com/embed/${sale.youtubeId}`,
			...youtubeMeta[sale.youtubeId],
		}
	: null;

// Key figures shown as big cards. Only figures that exist for this sale are shown.
const roleLabel = sale.role === 'buyer' ? 'The Buyer' : sale.role === 'seller' ? 'The Seller' : sale.role === 'both' ? 'Buyer and Seller' : null;
const stats: { label: string; value: string; featured?: boolean }[] = [
	{ label: 'Sale Price', value: formatPriceFull(sale.price), featured: true },
	...(sale.soldDate ? [{ label: 'Sale Date', value: formatSoldDate(sale.soldDate) }] : []),
	...(sale.units ? [{ label: 'Units', value: String(sale.units) }] : []),
	...(sale.sqft ? [{ label: isLand ? 'Land Area' : 'Building Size', value: `${sale.sqft.toLocaleString('en-US')} SF` }] : []),
	...(sale.acres ? [{ label: 'Acres', value: String(sale.acres) }] : []),
	...(pricePerUnit ? [{ label: 'Price Per Unit', value: formatPriceFull(pricePerUnit) }] : []),
	...(pricePerSf ? [{ label: isLand ? 'Price Per Land SF' : 'Price Per SF', value: `$${pricePerSf.toLocaleString('en-US')}` }] : []),
	...(roleLabel ? [{ label: 'We Represented', value: roleLabel }] : []),
];
// Photo grid: everything except the hero, and when there are at least two sharp photos, without the small low-resolution ones.
const galleryAll = allImages.map((src, i) => ({ src, w: imageWidths[i] })).filter((_, i) => i !== heroIdx);
const gallerySharp = galleryAll.filter((g) => g.w >= 600);
const gallery = (gallerySharp.length >= 2 ? gallerySharp : galleryAll).map((g) => g.src);
const imageAlt = `${sale.name}, ${sale.city}, ${sale.state}: ${kind} (closed sale)`;
const phoneHref = `tel:${site.phone.replace(/\D/g, '')}`;
---

<BaseLayout title={seoTitle} description={seoDescription} image={image}>
	{videoSchema && <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />}

	<header class={heroWide ? 'sold-hero' : 'sold-hero sold-hero--compact'}>
		{
			heroWide && image && (
				<>
					<img class="sold-hero__img" src={image} alt={imageAlt} width="1200" height="800" loading="eager" fetchpriority="high" />
					<div class="sold-hero__shade" />
				</>
			)
		}
		<div class="container sold-hero__inner">
			<div class="sold-hero__text">
				<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Closed Sales', href: '/closed-sales/' }, { label: sale.name }]} />
				<div class="sold-hero__badge">
					<span class="sold-hero__badge-tag">Sold</span>
					{sale.soldDate && <span class="sold-hero__badge-date">{formatSoldDate(sale.soldDate)}</span>}
				</div>
				<h1>{sale.name}{saleYear ? ` (${saleYear})` : ''}</h1>
				<p class="sold-hero__location">
					{place}
					{
						submarket && (
							<>
								{' '}
								&middot; <a href={`/submarkets/${submarket.slug}/`}>{submarket.name}</a>
							</>
						)
					}
				</p>
			</div>
			{!heroWide && image && <img class="sold-hero__thumb" style={`--thumb-w:${heroNaturalWidth}px`} src={image} alt={imageAlt} width={heroNaturalWidth} height={heroNaturalHeight} loading="eager" fetchpriority="high" />}
		</div>
	</header>

	<section class="sold-stats" aria-label="Key figures">
		<div class="container">
			<dl class="sold-stats__grid">
				{
					stats.map((st) => (
						<div class={st.featured ? 'sold-stats__card sold-stats__card--featured' : 'sold-stats__card'}>
							<dt>{st.label}</dt>
							<dd>{st.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<article class="section">
		<div class="container sold-layout">
			<div class="sold-main">
				{sale.youtubeId && <YouTubeFacade youtubeId={sale.youtubeId} title={`${sale.name} Video Tour`} />}

				<div class="sale-detail__body">
					<h2>Sale Summary</h2>
					<p>{summary}</p>
					{sale.blurb && <p>{blurbParts.map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</p>}
					{
						submarket && (
							<p>
								The property sits in the <a href={`/submarkets/${submarket.slug}/`}>{submarket.name}</a> submarket ({submarket.region}){submarket.walkScore !== undefined ? `, which scores ${submarket.walkScore} for Walk Score${submarket.transitScore !== undefined ? ` and ${submarket.transitScore} for Transit Score` : ''}` : ''}.
							</p>
						)
					}
					<p>
						This sale is part of the <a href="/closed-sales/">Highlight Multifamily Group track record</a>.
						{closingCoordinates[sale.slug] && (
							<>
								{' '}
								<a href={`/closed-sales/map/?sale=${sale.slug}`}>See it on our closed sales map</a>.
							</>
						)}
					</p>
				</div>

				{
					sale.story && sale.story.length > 0 && (
						<div class="sold-story">
							<span class="sold-story__label">The Story</span>
							<h2>The story behind this sale</h2>
							{sale.story.map((para) => (
								<p>{para}</p>
							))}
						</div>
					)
				}

				{
					gallery.length > 0 && (
						<div class="sold-gallery">
							<h2>Photos</h2>
							<div class="sold-gallery__grid">
								{gallery.map((src, i) => {
									// A file name with "-staged" marks a virtually staged photo, which is labelled as such.
									const staged = /-staged\./.test(src);
									const cls = gallery.length % 2 === 1 && i === 0 ? 'sold-gallery__wide' : undefined;
									const img = <img class={cls} src={src} alt={`${sale.name}, ${sale.city}: photo ${i + 2}${staged ? ' (virtually staged)' : ''}`} width="800" height="600" loading="lazy" />;
									return staged ? (
										<figure class={`sold-gallery__staged${cls ? ' sold-gallery__staged--wide' : ''}`}>
											{img}
											<figcaption>Virtually staged</figcaption>
										</figure>
									) : (
										img
									);
								})}
							</div>
						</div>
					)
				}

				{
					caseStudy && (
						<a href={`/case-studies/${caseStudy.slug}/`} class="sale-detail__casestudy">
							<span class="eyebrow">Case Study</span>
							<strong>{caseStudy.title}</strong>
							<span>{caseStudy.summary}</span>
							<span class="sale-detail__casestudy-cta">Read the full case study &rarr;</span>
						</a>
					)
				}
			</div>

			<aside class="sold-aside">
				<div class="sold-cta">
					<span class="sold-cta__label">Own a building like this?</span>
					<h2>See what yours could sell for</h2>
					<p>A free estimate takes about 60 seconds, built on real closed sales near you. No sign-up to see your range.</p>
					<a href="/property-value/" class="sold-cta__btn" data-cta="sold-page-estimate">Get my free estimate</a>
					<a href={phoneHref} class="sold-cta__call" data-cta="sold-page-call">Or call {site.phone}</a>
				</div>
			</aside>
		</div>

		<div class="container sold-more">
			{
				related.length > 0 && (
					<div class="sale-detail__related">
						<h2>{sameSubmarket.length >= 3 && submarket ? `More Sales in ${submarket.name}` : 'Related Closed Sales'}</h2>
						<ul class="sold-cards">
							{related.map((r) => (
								<li>
									<a href={`/closed-sales/${r.slug}/`}>
										{r.images?.[0] ? <img src={r.images[0]} alt="" width="400" height="260" loading="lazy" /> : <span class="sold-cards__ph" aria-hidden="true">SOLD</span>}
										<span class="sold-cards__name">{r.name}</span>
										<span class="sale-detail__related-meta">
											{r.city}, {r.state} &middot; {r.units ? `${r.units} Units` : 'Development Site'} &middot; Sold for {formatPrice(r.price)}
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}

			{
				activeListings.length > 0 && (
					<div class="sale-detail__related">
						<h2>Available Now{submarket ? ` in ${submarket.name}` : ''}</h2>
						<ul>
							{activeListings.map((l) => (
								<li>
									<a href={`/listings/${l.slug}/`}>
										<span>{l.name}</span>
										<span class="sale-detail__related-meta">
											{l.units ? `${l.units} Units` : 'Development Site'} &middot; {l.askingPrice ? formatPrice(l.askingPrice) : 'Contact for Pricing'}
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</div>
	</article>

	<section class="section section-alt">
		<div class="container">
			<BOVForm heading="Own a Similar Building?" subheading="Get a free, confidential Broker Opinion of Value grounded in real closed comps." />
		</div>
	</section>
</BaseLayout>

<style>
	.sold-hero {
		position: relative;
		color: #fff;
		min-height: clamp(380px, 52vw, 560px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--navy-dark);
		padding-block: clamp(2rem, 6vw, 4.5rem) clamp(4.5rem, 8vw, 6.5rem);
	}

	.sold-hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.sold-hero__shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgb(12 46 80 / 0.5) 0%, rgb(12 46 80 / 0.25) 38%, rgb(12 46 80 / 0.92) 100%);
	}

	.sold-hero__inner {
		position: relative;
		width: 100%;
	}

	.sold-hero :global(.breadcrumbs),
	.sold-hero :global(.breadcrumbs a),
	.sold-hero :global(.breadcrumbs li:last-child),
	.sold-hero :global(.breadcrumbs li:last-child *) {
		color: rgb(255 255 255 / 0.9);
	}

	/* Flat "SOLD" label with the closing date, above the property name. */
	.sold-hero__badge {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin: 1.1rem 0 0.6rem;
	}

	.sold-hero__badge-tag {
		background: var(--gold);
		color: var(--navy-dark);
		font-weight: 700;
		font-size: 0.8rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		padding: 0.4rem 0.85rem 0.4rem 1rem;
	}

	.sold-hero__badge-date {
		border-left: 2px solid rgb(217 196 145 / 0.7);
		padding-left: 0.9rem;
		font-weight: 700;
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--gold-light);
	}

	.sold-hero h1 {
		color: #fff;
		margin: 0.3rem 0 0.3rem;
		text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
	}

	.sold-hero__location {
		margin: 0;
		font-weight: 600;
		color: rgb(255 255 255 / 0.92);
	}

	.sold-hero__location a {
		color: var(--gold-light);
	}

	/* Compact header for sales whose photos are too small to run full width without looking blurry. */
	.sold-hero--compact {
		min-height: 0;
		background: linear-gradient(160deg, var(--navy) 0%, var(--navy-dark) 100%);
		padding-block: clamp(2rem, 5vw, 3.5rem) clamp(4.5rem, 8vw, 6rem);
		align-items: center;
	}

	.sold-hero--compact .sold-hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: end;
	}

	.sold-hero__thumb {
		justify-self: end;
		width: 100%;
		max-width: clamp(240px, calc(var(--thumb-w) * 1.4), 520px);
		max-height: 340px;
		object-fit: cover;
		border: 3px solid var(--gold);
		border-radius: 3px;
		box-shadow: 0 14px 34px rgb(0 0 0 / 0.35);
	}

	.sold-stats {
		position: relative;
		z-index: 3;
		margin-top: -3.25rem;
	}

	.sold-stats__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 0.75rem;
		margin: 0;
	}

	.sold-stats__card {
		background: var(--navy-dark);
		color: #fff;
		padding: 1.1rem 1.2rem;
		border-radius: 3px;
		border-top: 3px solid var(--gold);
		box-shadow: 0 12px 30px rgb(12 46 80 / 0.22);
	}

	.sold-stats__card--featured {
		background: var(--gold);
		border-top-color: var(--navy-dark);
		color: var(--navy-dark);
	}

	.sold-stats__card dt {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		font-weight: 700;
		opacity: 0.8;
	}

	/* Full-strength label on the gold card: at 80% opacity navy on gold falls below the 4.5:1 contrast minimum. */
	.sold-stats__card--featured dt {
		opacity: 1;
	}

	.sold-stats__card dd {
		margin: 0.3rem 0 0;
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.6vw, 1.85rem);
		line-height: 1.15;
		color: var(--gold-light);
	}

	.sold-stats__card--featured dd {
		color: var(--navy-dark);
	}

	.sold-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: start;
	}

	.sold-main :global(.yt-facade) {
		margin-bottom: 2rem;
	}

	.sale-detail__body {
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.sale-detail__body h2 {
		font-size: 1.5rem;
	}

	.sold-story {
		margin: 2.5rem 0;
		padding: 1.75rem 1.75rem 1.25rem;
		background: var(--paper-alt);
		border-left: 4px solid var(--gold);
		border-radius: 2px;
		font-size: 1.08rem;
		line-height: 1.75;
	}

	.sold-story__label {
		display: block;
		text-transform: uppercase;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--gold-dark);
	}

	.sold-story h2 {
		margin-top: 0.3rem;
		font-size: 1.5rem;
	}

	.sold-gallery {
		margin: 2.5rem 0;
	}

	.sold-gallery h2 {
		font-size: 1.35rem;
	}

	.sold-gallery__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
	}

	.sold-gallery__grid img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 2px;
	}

	.sold-gallery__staged {
		position: relative;
		margin: 0;
	}

	.sold-gallery__staged--wide {
		grid-column: span 2;
	}

	.sold-gallery__staged figcaption {
		position: absolute;
		left: 0.6rem;
		bottom: 0.6rem;
		background: rgb(12 46 80 / 0.85);
		color: #fff;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		padding: 0.2rem 0.55rem;
		border-radius: 2px;
	}

	.sold-gallery__grid .sold-gallery__wide {
		grid-column: span 2;
		aspect-ratio: 16 / 9;
	}

	.sold-aside {
		position: sticky;
		top: 1.5rem;
	}

	.sold-cta {
		background: linear-gradient(160deg, var(--navy) 0%, var(--navy-dark) 100%);
		color: #fff;
		padding: 1.75rem;
		border-radius: 3px;
		border-top: 4px solid var(--gold);
		box-shadow: 0 14px 34px rgb(12 46 80 / 0.25);
	}

	.sold-cta__label {
		display: block;
		text-transform: uppercase;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--gold-light);
	}

	.sold-cta h2 {
		color: #fff;
		font-size: 1.5rem;
		margin: 0.4rem 0 0.6rem;
	}

	.sold-cta p {
		color: rgb(255 255 255 / 0.88);
		font-size: 0.98rem;
		margin: 0 0 1.25rem;
	}

	.sold-cta__btn {
		display: block;
