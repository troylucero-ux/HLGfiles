<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Count-up for the headline numbers. The final text stays in the page, so it is correct with scripts off and for crawlers.
	function countUp(el: HTMLElement) {
		const original = el.textContent?.trim() ?? '';
		const match = original.match(/^(\D*)([\d,]*\.?\d+)(.*)$/s);
		if (!match) return;
		const [, prefix, numText, suffix] = match;
		const target = parseFloat(numText.replace(/,/g, ''));
		if (!isFinite(target)) return;
		const decimals = (numText.split('.')[1] ?? '').length;
		const grouped = numText.includes(',');
		const format = (n: number) =>
			prefix + n.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals, useGrouping: grouped }) + suffix;
		const duration = 1400;
		const start = performance.now();
		const tick = (now: number) => {
			const t = Math.min(1, (now - start) / duration);
			const eased = 1 - Math.pow(1 - t, 3);
			el.textContent = t < 1 ? format(target * eased) : original;
			if (t < 1) requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
	}

	if (!reduceMotion && 'IntersectionObserver' in window) {
		const countObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						countUp(entry.target as HTMLElement);
						countObserver.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.6 },
		);
		document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => countObserver.observe(el));

		// Fade-and-rise for blocks that start below the fold. Groups are staggered.
		const groups = [
			'.stat-bar__grid > *',
			'.who-we-are > *',
			'.services-grid > *',
			'.article-grid > *',
			'.sales-grid > *',
			'.testimonial-grid > *',
			'.ceo-quote',
			'.press-strip',
			'main .section > .container > .eyebrow',
			'main .section > .container > h2',
		];
		const seen = new Set<Element>();
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					const el = entry.target as HTMLElement;
					el.classList.add('is-in');
					revealObserver.unobserve(el);
					// Once it has settled, drop the helper classes so hover effects on the same element work normally.
					window.setTimeout(() => {
						el.classList.remove('reveal', 'is-in');
						el.style.transitionDelay = '';
					}, 1700);
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
		);
		const setUpReveal = () => {
			const candidates: { el: HTMLElement; i: number }[] = [];
			groups.forEach((selector) => {
				document.querySelectorAll<HTMLElement>(selector).forEach((el, i) => {
					if (!seen.has(el)) {
						seen.add(el);
						candidates.push({ el, i });
					}
				});
			});
			candidates
				.filter(({ el }) => el.getBoundingClientRect().top >= window.innerHeight)
				.forEach(({ el, i }) => {
					el.style.transitionDelay = `${Math.min(i, 5) * 90}ms`;
					el.classList.add('reveal');
					revealObserver.observe(el);
				});
		};
		if ('requestIdleCallback' in window) window.requestIdleCallback(setUpReveal, { timeout: 1500 });
		else window.setTimeout(setUpReveal, 300);

		// The Who We Are photo drifts a little slower than the page while it is on screen.
		const whoPhoto = document.querySelector<HTMLElement>('.who-we-are__photo img');
		if (whoPhoto) {
			let ticking = false;
			let visible = false;
			const drift = () => {
				ticking = false;
				if (!visible || window.innerWidth <= 800) {
					whoPhoto.style.removeProperty('--py');
					return;
				}
				const r = whoPhoto.getBoundingClientRect();
				const progress = Math.max(-1, Math.min(1, (r.top + r.height / 2 - window.innerHeight / 2) / window.innerHeight));
				whoPhoto.style.setProperty('--py', `${(progress * -26).toFixed(1)}px`);
			};
			const onScroll = () => {
				if (!ticking) {
					ticking = true;
					window.requestAnimationFrame(drift);
				}
			};
			new IntersectionObserver((entries) => {
				visible = entries[0].isIntersecting;
				onScroll();
			}).observe(whoPhoto);
			window.addEventListener('scroll', onScroll, { passive: true });
		}
	}
</script>
