---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BOVForm from '../../components/BOVForm.astro';
import { site, team, press, ceoQuote } from '../../data/site';
import { closings } from '../../data/closings';
import { submarkets } from '../../data/submarkets';
import fs from 'node:fs';
import { postsEs, formatTrimestre } from '../../data/postsEs';
import { formatPrice } from '../../lib/format';
import { PAGES_ES } from '../../data/esSlugs';

const troy = team.find((m) => m.slug === 'troy-lucero')!;
const en = `${site.url}/`;
const es = `${site.url}/es/`;

// The six deals featured on the homepage, highest price first (same list as the English homepage).
const featuredSaleSlugs = [
	'131-171-s-burlington-ave-los-angeles-ca-90057',
	'236-s-bonnie-brae-st-los-angeles-ca-90057',
	'728-734-s-manhattan-pl-los-angeles-ca-90005',
	'1136-s-alvarado-st-los-angeles-ca-90006',
	'11747-mayfield-ave-los-angeles-ca-90049',
	'453-s-gramercy-pl-los-angeles-ca-90020',
];
const notableSales = featuredSaleSlugs
	.map((slug) => closings.find((c) => c.slug === slug))
	.filter((c): c is (typeof closings)[number] => Boolean(c))
	.sort((a, b) => b.price - a.price);

// Small thumbnails for the cards; falls back to the full-size photo if none exists.
const cardImage = (sale: (typeof closings)[number]) =>
	fs.existsSync(`public/images/home-cards/${sale.slug}.webp`) ? `/images/home-cards/${sale.slug}.webp` : sale.images?.[0];

const stats = [
	{ num: site.stats.unitsSold, label: 'Unidades vendidas' },
	{ num: site.stats.closedSalesVolume, label: 'En ventas cerradas' },
	{ num: site.stats.landSqFtSold, label: 'Pies cuadrados de terreno para desarrollo vendidos' },
	{ num: site.stats.listToSaleRatio, label: 'Precio de venta como porcentaje del precio pedido' },
];

// Line icons (24x24, drawn with a stroke) for the service cards.
const serviceIcons: Record<string, string> = {
	bov: '<circle cx="12" cy="12" r="9"/><path d="M14.5 9.2c-.6-.8-1.5-1.2-2.5-1.2-1.4 0-2.5.8-2.5 2s1 1.7 2.5 2 2.5.8 2.5 2-1.1 2-2.5 2c-1 0-1.9-.4-2.5-1.2M12 6v2M12 16v2"/>',
	sales: '<path d="M4 21V7l8-4 8 4v14"/><path d="M3 21h18"/><path d="M9.5 21v-5h5v5"/><path d="M8 10h2M14 10h2M8 13h2M14 13h2"/>',
	exchange: '<path d="M4 8h14l-3-3"/><path d="M20 16H6l3 3"/>',
	trust: '<path d="M7 3h8l4 4v14H7z"/><path d="M15 3v4h4"/><path d="M10 12h6M10 15h6M10 18h4"/>',
	land: '<path d="M3 7l6-3 6 3 6-3v13l-6 3-6-3-6 3z"/><path d="M9 4v13M15 7v13"/>',
	nnn: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
};

// La opinión de valor va primero y destacada: es lo principal que queremos que pida un dueño.
const services = [
	{
		title: 'Opinión de valor (Broker Opinion of Value)',
		body: 'Una opinión de valor gratis y sin presión, basada en ventas cerradas reales y no en suposiciones.',
		href: '#formulario',
		more: 'Pida mi opinión gratis',
		icon: 'bov',
		featured: true,
	},
	{
		title: 'Venta de edificios multifamiliares',
		body: 'Representación completa para vendedores y compradores de edificios de apartamentos en el área metropolitana de Los Ángeles, desde la estrategia de precio hasta el cierre del escrow (el proceso en que un tercero neutral guarda el dinero y los documentos hasta cerrar la venta).',
		href: '/es/vender-edificio-de-apartamentos-los-angeles/',
		more: 'Cómo vendemos su edificio',
		icon: 'sales',
	},
	{
		title: 'Intercambios 1031',
		body: 'Planeamos su intercambio antes de que anuncie la venta, le presentamos a un corredor con experiencia si va a comprar fuera de California, y agregamos a cada contraoferta una opción de extender el escrow por 30 días. Casi todos nuestros clientes de intercambio encuentran su propiedad de reemplazo antes de que cierre su venta.',
		href: PAGES_ES.intercambios,
		more: 'Más sobre intercambios 1031',
		icon: 'exchange',
	},
	{
		title: 'Ventas de fideicomisos y herencias',
		body: 'Orientación tranquila e informada para fideicomisarios, albaceas y familias que venden un edificio de apartamentos heredado.',
		href: PAGES_ES.fideicomisos,
		more: 'Más sobre fideicomisos y herencias',
		icon: 'trust',
	},
	{
		title: 'Terrenos para desarrollo',
		body: 'Promoción y mercadeo de terrenos para desarrollo, respaldados por análisis de zonificación y de su mejor uso.',
		href: '/land-for-development/',
		more: 'Más información (en inglés)',
		icon: 'land',
	},
	{
		title: 'Triple net (NNN) y DST',
		body: 'Presentaciones a corredores de NNN y profesionales de DST de confianza para dueños que hacen un intercambio hacia una inversión pasiva, sin administración.',
		href: PAGES_ES.tripleNet,
		more: 'Más sobre triple net y DST',
		icon: 'nnn',
	},
];

// Spanish translations of three client testimonials (the originals are in English; see src/data/site.ts) and of the Equity Union CEO's quote.
const reviewsEs = [
	{
		quote:
			'He hecho negocios con otras agencias en el pasado, pero ninguna se les compara. Le doy el crédito a Josh y a Troy por ayudarme a escoger el momento perfecto para poner mi propiedad en venta y por hacer de la venta un éxito total.',
		name: 'Martine M.',
		who: 'Vendedora de 6938 Coldwater Canyon Ave',
		caseStudySlug: '6938-coldwater-canyon-ave-north-hollywood-apartments',
	},
	{
		quote: 'Agradecí mucho los consejos de Troy y Josh sobre el mercado de apartamentos de Los Ángeles. Se los recomiendo a quien quiera un corredor que de verdad escuche.',
		name: 'Jorge M.',
		who: 'Reseña de Google',
	},
	{
		quote:
			'Josh Kaplan y Troy Lucero, de Highlight Real Estate Group, nos ayudaron a cerrar la compra de un edificio de 9 unidades en Arlington Heights, Los Ángeles. Recomiendo mucho a este equipo para quien quiera comprar o vender un edificio de apartamentos en Los Ángeles.',
		name: 'Eman D.',
		who: 'Reseña de Google',
		caseStudySlug: '1513-arlington-ave-arlington-heights-apartments',
	},
];
const ceoQuoteEs =
	'Josh y Troy son sumamente respetados en la industria y la comunidad de bienes raíces comerciales. Transmiten fortaleza, inteligencia y una gran agudeza para los negocios.';

const webPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	inLanguage: 'es',
	name: 'Corredor de edificios de apartamentos en Los Ángeles, en español',
	url: es,
	about: { '@type': 'RealEstateAgent', name: site.name, url: en },
};
---

<BaseLayout
	lang="es"
	title="Corredor de Apartamentos en Los Ángeles, en Español"
	description="Corredores de edificios de apartamentos en Los Ángeles. Troy Lucero le explica la venta en español: opinión de valor gratis, intercambios 1031 y herencias."
>
	<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} slot="head" />
	<link rel="alternate" hreflang="es" href={es} slot="head" />
	<link rel="alternate" hreflang="en" href={en} slot="head" />
	<link rel="alternate" hreflang="x-default" href={en} slot="head" />

	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Área metropolitana de Los Ángeles · En español</span>
			<h1>Venta de edificios de apartamentos en Los Ángeles, con un corredor que habla su idioma</h1>
			<p>
				Los dueños de edificios de apartamentos en Los Ángeles nos contratan para fijar el precio, promover y vender sus propiedades. Troy Lucero habla
				español con fluidez y le explica cada paso, a usted y a su familia. Empiece con una opinión de valor gratis, basada en ventas cerradas reales.
			</p>
			<div class="hero-actions">
				<a href="#formulario" class="btn btn-gold">Pida una opinión de valor gratis</a>
				<a href={`tel:${troy.phone.replace(/\D/g, '')}`} class="btn btn-outline">Llame a Troy: {troy.phone}</a>
			</div>
		</div>
	</section>

	<section class="stat-bar">
		<div class="container stat-bar__grid">
			{
				stats.map((s) => (
					<div class="stat-bar__item">
						<span class="stat-bar__num" data-count>{s.num}</span>
						<span class="stat-bar__label">{s.label}</span>
					</div>
				))
			}
		</div>
	</section>

	<section class="section who-section">
		<div class="container who-we-are">
			<div>
				<span class="eyebrow">Quiénes somos</span>
				<h2>Un equipo con experiencia en el que los dueños pueden confiar</h2>
				<p>
					Highlight Multifamily Group aporta más de 20 años de experiencia como corredores de ventas de inversión, junto con experiencia como
					inversionistas en compras, ventas, administración de activos y desarrollo. Conocemos de primera mano los retos de ser dueño a largo plazo,
					comprador y vendedor, y eso nos ayuda a servir a nuestros clientes en cada etapa de la compra, la propiedad y la venta de propiedades
					multifamiliares, incluidos los intercambios 1031.
				</p>
				<p>
					Troy Lucero creció en un hogar de habla hispana y trabaja con dueños y sus familias en español o en inglés. Josh Kaplan, su socio, también
					entiende español y participa en la conversación. Conozca más sobre <a href="/troy-lucero/">Troy</a> y <a href="/josh-kaplan/">Josh</a> (en inglés).
				</p>
				<a href="/es/vender-edificio-de-apartamentos-los-angeles/" class="btn btn-outline">Vender con un corredor que habla español</a>
			</div>
			<div class="who-we-are__photo">
				<img
					src="/images/bio/josh-kaplan-troy-lucero-together.webp"
					srcset="/images/bio/josh-kaplan-troy-lucero-together-480.webp 480w, /images/bio/josh-kaplan-troy-lucero-together.webp 860w"
					sizes="(max-width: 800px) 260px, 340px"
					alt="Josh Kaplan y Troy Lucero, cofundadores de Highlight Multifamily Group"
					width="860"
					height="860"
					loading="lazy"
				/>
			</div>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<span class="eyebrow">Nuestros servicios</span>
			<h2>Cómo ayudamos a los dueños de apartamentos en Los Ángeles</h2>
			<div class="services-grid">
				{
					services.map((s) => (
						<a href={s.href} class={`service-card${s.featured ? ' service-card--featured' : ''}`}>
							<span class="service-card__icon">
								<svg viewBox="0 0 24 24" aria-hidden="true" set:html={serviceIcons[s.icon]} />
							</span>
							<h3>{s.title}</h3>
							<p>{s.body}</p>
							<span class="service-card__cta">{s.more} &rarr;</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container narrow">
			<span class="eyebrow">Lo que le explicamos en español</span>
			<h2>Todo el proceso, en palabras sencillas</h2>
			<ul class="check-list">
				<li>Cuánto vale su edificio, con una opinión de valor gratis y confidencial.</li>
				<li>Cómo funciona una venta de principio a fin: el precio, las ofertas, el escrow y el día del cierre.</li>
				<li>El control de rentas de Los Ángeles (RSO) y cómo afecta el precio y a sus inquilinos.</li>
				<li>Los impuestos de una venta: ganancias de capital, recuperación de la depreciación y cómo un intercambio 1031 puede diferirlos.</li>
				<li>La Medida ULA, el impuesto de transferencia de la Ciudad de Los Ángeles, y si aplica a su venta.</li>
				<li>Cada documento, línea por línea. Los contratos están escritos en inglés, y los revisamos con usted en español antes de que firme.</li>
			</ul>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<span class="eyebrow">Artículos en español</span>
			<h2>Lo que los dueños de edificios en Los Ángeles necesitan saber</h2>
			<div class="article-grid">
				{
					postsEs.slice(0, 6).map((post) => (
						<a href={`/es/insights/${post.slug}/`} class="article-card">
							<span class="article-card__date">{formatTrimestre(post.date)}</span>
							<h3>{post.title}</h3>
							<span class="article-card__cta">Leer el artículo &rarr;</span>
						</a>
					))
				}
			</div>
			<p class="more-link">
				<a href="/es/insights/">Ver todos los artículos en español</a> · <a href="/es/preguntas-frecuentes/">Preguntas frecuentes</a>
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="eyebrow">Ventas cerradas</span>
			<h2>Ventas cerradas en Los Ángeles</h2>
			<div class="sales-grid">
				{
					notableSales.map((sale) => {
						const hood = submarkets.find((sm) => sm.slug === sale.submarket);
						return (
							<a class="sale-card" href={`/closed-sales/${sale.slug}/`}>
								<span class="sale-card__photo">
									{cardImage(sale) && (
										<img
											src={cardImage(sale)}
											alt={`${sale.name}, Los Ángeles, ${sale.units ? `edificio de apartamentos de ${sale.units} unidades` : 'terreno para desarrollo'}, vendido por Highlight Multifamily Group`}
											width="560"
											height="350"
											loading="lazy"
										/>
									)}
									<span class="sale-card__tag">Vendido</span>
									<span class="sale-card__price">{formatPrice(sale.price)}</span>
								</span>
								<span class="sale-card__body">
									<span class="sale-card__location">{hood ? hood.name : `${sale.city}, ${sale.state} ${sale.zip}`}</span>
									<span class="sale-card__name">{sale.name}</span>
									<span class="sale-card__meta">
										{sale.units ? `${sale.units} unidades` : 'Terreno para desarrollo'}
										{sale.sqft ? ` • ${sale.sqft.toLocaleString('en-US')} pies²` : ''}
									</span>
								</span>
							</a>
						);
					})
				}
			</div>
			<p class="more-link"><a href="/closed-sales/">Ver todas nuestras ventas cerradas (en inglés)</a></p>
		</div>
	</section>

	<section class="section reviews-band">
		<div class="container">
			<span class="eyebrow">Lo que dicen los dueños</span>
			<h2>Dueños de apartamentos en Los Ángeles confían en nosotros</h2>
			<p class="reviews-badge">
				<span class="reviews-badge__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
				<span>5 estrellas en Google</span>
			</p>
			<div class="testimonial-grid">
				{
					reviewsEs.map((t) => (
						<figure class="testimonial-card">
							<span class="testimonial-card__mark" aria-hidden="true">&ldquo;</span>
							<blockquote>{t.quote}</blockquote>
							<figcaption>
								<span class="testimonial-card__avatar" aria-hidden="true">{t.name.charAt(0)}</span>
								<span class="testimonial-card__who">
									<strong>{t.name}</strong>
									<span>{t.who}</span>
									{t.caseStudySlug && <a href={`/case-studies/${t.caseStudySlug}/`}>Lea el caso (en inglés) &rarr;</a>}
								</span>
							</figcaption>
						</figure>
					))
				}
			</div>
			<p class="reviews-note">Traducido del inglés. Los testimonios originales están en inglés.</p>
			<div class="reviews-actions">
				<a href="#formulario" class="btn reviews-actions__primary">Pida una opinión de valor gratis</a>
				<a href="/testimonials/" class="btn reviews-actions__secondary">Ver todas las reseñas (en inglés)</a>
			</div>
		</div>
	</section>

	<section class="section press-section">
		<div class="container">
			<span class="eyebrow">En las noticias</span>
			<h2>Nuestras ventas son noticia</h2>
			<figure class="ceo-quote">
				<blockquote>&ldquo;{ceoQuoteEs}&rdquo;</blockquote>
				<figcaption>
					<strong>{ceoQuote.name}</strong>, CEO de Equity Union
					<span class="ceo-quote__via">
						según <a href={ceoQuote.url} target="_blank" rel="noopener noreferrer">{ceoQuote.source}</a> (en inglés)
					</span>
				</figcaption>
			</figure>
			<div class="press-strip">
				{
					press.map((p) => (
						<a href={p.url} target="_blank" rel="noopener noreferrer" class={`press-logo press-logo--${p.name.toLowerCase().replace(/\s+/g, '-')}`}>
							{p.name}
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section-alt" id="formulario">
		<div class="container">
			<BOVForm
				lang="es"
				heading="Pida una opinión de valor gratis"
				subheading="Vender un edificio no tiene que ser difícil. Empezamos con una conversación, no con una venta: le mostramos ventas reales, plazos reales y una estrategia hecha a la medida de sus metas."
			/>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		background: var(--paper-alt);
		padding-block: clamp(3rem, 7vw, 5rem);
	}

	.page-hero p {
		max-width: 700px;
		font-size: 1.1rem;
		line-height: 1.7;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.stat-bar {
		background: var(--navy);
		color: #fff;
		padding-block: 2rem;
	}

	.stat-bar__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
		text-align: center;
	}

	.stat-bar__item {
		display: grid;
		gap: 0.35rem;
	}

	.stat-bar__num {
		font-family: var(--font-serif, inherit);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		color: var(--gold-light, #fff);
		line-height: 1.1;
	}

	.stat-bar__label {
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		opacity: 0.85;
	}

	/* The photo starts 42px to the side before it slides in; clip that so it never causes a sideways scroll. */
	.who-section {
		overflow-x: clip;
	}

	.who-we-are {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.who-we-are p {
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.who-we-are__photo {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* A soft halo behind the cut-out photo gives it depth on the cream page. */
	.who-we-are__photo::before {
		content: '';
		position: absolute;
		top: 2%;
		left: 50%;
		width: 112%;
		aspect-ratio: 1;
		transform: translateX(-50%);
		border-radius: 50%;
		background: radial-gradient(circle, var(--navy-tint) 0%, rgba(238, 242, 247, 0.55) 45%, rgba(238, 242, 247, 0) 70%);
	}

	.who-we-are__photo img {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 340px;
		height: auto;
		display: block;
		filter: drop-shadow(0 20px 28px rgba(12, 46, 80, 0.16));
		transform: translateY(var(--py, 0px));
		will-change: transform;
	}

	.who-we-are__photo::after {
		content: '';
		position: relative;
		z-index: 1;
		width: 110px;
		height: 2px;
		margin-top: 1.5rem;
		background: linear-gradient(90deg, transparent, var(--gold) 50%, transparent);
		transition: transform 0.9s ease 0.6s;
	}

	/* On the way in: the text slides in from the left, the photo from the right, and the gold line draws out from the middle. */
	.who-we-are > .reveal {
		transform: translateX(-42px);
		transition-duration: 0.9s;
	}

	.who-we-are > .who-we-are__photo.reveal {
		transform: translateX(42px);
	}

	.who-we-are > .reveal.is-in {
		transform: none;
	}

	.who-we-are__photo.reveal:not(.is-in)::after {
		transform: scaleX(0);
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.service-card {
		display: flex;
		flex-direction: column;
		padding: 1.75rem;
		background: #fff;
		border: 1px solid var(--border);
		border-top: 2px solid var(--gold);
		color: var(--ink);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.service-card:hover {
		text-decoration: none;
		transform: translateY(-3px);
		box-shadow: 0 18px 30px -22px rgba(12, 46, 80, 0.5);
	}

	.service-card__icon {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		margin-bottom: 1.1rem;
		border-radius: 50%;
		background: var(--navy-tint);
		color: var(--gold-dark);
	}

	.service-card__icon svg {
		width: 1.55rem;
		height: 1.55rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.service-card h3 {
		font-size: 1.3rem;
		margin: 0 0 0.5rem;
		color: var(--navy-dark);
	}

	.service-card p {
		flex: 1;
		margin: 0 0 1.25rem;
		line-height: 1.65;
	}

