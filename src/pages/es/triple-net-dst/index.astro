const glossary = [
	{ term: 'Triple net (NNN)', def: 'Un contrato en el que el inquilino paga la renta más los impuestos a la propiedad, el seguro y el mantenimiento.' },
	{ term: 'Net absoluto', def: 'Un contrato NNN que además pone el techo y la estructura a cargo del inquilino. Los términos varían de contrato en contrato.' },
	{ term: 'Tasa de capitalización (cap rate)', def: 'El ingreso operativo neto de un año dividido entre el precio. Una propiedad que genera $180,000 y se vende en $3,000,000 tiene una tasa de capitalización de 6.0%.' },
	{ term: 'Ingreso operativo neto (NOI)', def: 'La renta que gana una propiedad después de los gastos de operación, antes de los pagos de deuda y del impuesto sobre la renta. En un contrato NNN, la renta base se acerca al NOI.' },
	{ term: 'Fideicomiso Estatutario de Delaware (DST)', def: 'Un fideicomiso que es dueño de bienes raíces y vende participaciones beneficiarias a inversionistas. El IRS trata una participación en un DST bien estructurado como bienes raíces para un intercambio 1031.' },
	{ term: 'Patrocinador (sponsor)', def: 'La empresa que compra la propiedad, crea el DST y lo administra para los inversionistas.' },
	{ term: 'Inversionista acreditado', def: 'Por lo general, una persona con ingresos de más de $200,000 ($300,000 con su cónyuge) en cada uno de los últimos dos años, o un patrimonio neto de más de $1 millón sin contar su vivienda, o ciertas licencias de valores.' },
	{ term: 'Memorando de colocación privada (PPM)', def: 'El documento de la oferta de un DST. Describe la propiedad, el plan, los honorarios y los riesgos.' },
	{ term: 'Intercambio 1031', def: 'Una manera de diferir el impuesto sobre ganancias de capital reinvirtiendo lo que se obtiene de una propiedad de inversión en otros bienes raíces de tipo similar, dentro de plazos estrictos.' },
	{ term: 'Intermediario calificado (QI)', def: 'La empresa neutral que guarda el dinero de su venta durante un intercambio para que usted nunca lo toque.' },
	{ term: 'Boot', def: 'Efectivo o alivio de deuda que usted recibe en un intercambio. Puede estar sujeto a impuestos aunque el resto de la ganancia se difiera.' },
	{ term: 'Reemplazo de deuda', def: 'Reemplazar la hipoteca que usted pagó con deuda nueva, deuda dentro del fideicomiso en un DST, o efectivo adicional, para que el intercambio no produzca boot.' },
	{ term: 'Aumento de renta programado', def: 'Un aumento previsto en la renta de un contrato, ya sea un porcentaje cada año o un escalón más grande cada pocos años.' },
	{ term: 'Riesgo de renovación', def: 'El riesgo de que un inquilino no renueve, dejando el espacio vacío y al propietario pagando por un contrato nuevo.' },
];

