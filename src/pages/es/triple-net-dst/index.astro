// ---- Ejemplo 2: dos maneras de aumentar la renta en el mismo contrato ----
const projectRent = (price: number, capPct: number, years: number, annualPct: number, stepPct: number) => {
	const base = price * (capPct / 100);
	const annual: number[] = [];
	const stepped: number[] = [];
	for (let y = 0; y < years; y++) {
		annual.push(base * Math.pow(1 + annualPct / 100, y));
		stepped.push(base * Math.pow(1 + stepPct / 100, Math.floor(y / 5)));
	}
	return { annual, stepped };
};
const ex2 = projectRent(3_000_000, 6, 15, 1.5, 10);
