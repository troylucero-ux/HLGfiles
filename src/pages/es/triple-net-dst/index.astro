</style>

<script>
	// Tres calculadoras sencillas. Funcionan por completo en el navegador y no envían nada a ningún lado, salvo un conteo de que se usó una calculadora.
	const fmtMoney = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
	const fmtPct = (n: number, d = 1) => `${n.toFixed(d)}%`;
	const num = (s: string | undefined | null) => {
		const v = parseFloat(String(s ?? '').replace(/[^0-9.]/g, ''));
		return isFinite(v) ? v : 0;
	};
	const field = (id: string) => document.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-id="${id}"]`)!;
	const out = (name: string) => document.querySelector<HTMLElement>(`[data-out="${name}"]`)!;

	// Muestra separadores de miles en las casillas de dólares cuando el visitante sale de ellas.
	document.querySelectorAll<HTMLInputElement>('input.money').forEach((el) => {
		el.addEventListener('blur', () => {
			el.value = num(el.value).toLocaleString('en-US');
		});
	});

	const used = new Set<string>();
	let ready = false; // se queda en falso mientras la página se prepara, para que cargarla no cuente como usar una calculadora
	const track = (tool: string) => {
		if (!ready || used.has(tool)) return;
		used.add(tool);
		(window as unknown as { gtag?: (...args: unknown[]) => void }).gtag?.('event', 'calculator_use', {
			calculator: tool,
			page_path: window.location.pathname,
		});
	};

	// ---- 1. Planificador de intercambio ----
	function planner() {
		const price = num(field('p-price').value);
		const payoff = num(field('p-payoff').value);
		const costPct = num(field('p-costs').value);
		const cash = num(field('p-cash').value);
		const box = out('planner');
		if (price <= 0) {
			box.innerHTML = '<p class="out-warn">Escriba un precio de venta esperado.</p>';
			return;
		}
		const costs = price * (costPct / 100);
		const netPrice = price - costs;
		const equity = netPrice - payoff - cash;
		if (equity < 0) {
			box.innerHTML = '<p class="out-warn">La hipoteca y el efectivo que retira son más que su precio de venta neto. Baje uno de los dos.</p>';
			return;
		}
		const debtNeeded = payoff + cash;
		const ltv = netPrice > 0 ? (debtNeeded / netPrice) * 100 : 0;
		const short = netPrice - equity;
		box.innerHTML = `
			<span class="out-label">Para diferir toda la ganancia, compre al menos</span>
			<span class="out-big">${fmtMoney(netPrice)}</span>
			<span class="out-label">Capital para reinvertir</span>
			<span class="out-big">${fmtMoney(equity)}</span>
			<span class="out-label">Deuda o efectivo adicional por reemplazar</span>
			<span class="out-big">${fmtMoney(debtNeeded)}</span>
			<p class="out-note">
				Costos de venta: ${fmtMoney(costs)}. ${debtNeeded > 0 ? `Si compra al precio mínimo, eso es un préstamo de cerca de ${fmtPct(ltv, 0)} del precio, o la misma cantidad en efectivo adicional, o deuda dentro de un DST.` : 'Sin hipoteca y sin retirar efectivo, no necesita deuda de reemplazo.'}
			</p>
			<p class="out-note">
				${short > 0 ? `<strong>Una compra al contado solo con su capital</strong> sería de ${fmtMoney(equity)}, que es ${fmtMoney(short)} de menos. Ese faltante puede ser boot sujeto a impuestos.${cash > 0 ? ` Los ${fmtMoney(cash)} que retira también son boot sujeto a impuestos.` : ''}` : `<strong>Una compra al contado</strong> de ${fmtMoney(equity)} cumpliría el mínimo, porque no tiene hipoteca que reemplazar.`}
			</p>`;
		track('exchange_planner');
	}

	// ---- 2. Proyector de renta NNN ----
	function projector() {
		const price = num(field('r-price').value);
		const cap = num(field('r-cap').value);
		const years = parseInt((field('r-years') as HTMLSelectElement).value, 10) || 15;
		const annualPct = num(field('r-annual').value);
		const stepPct = num(field('r-step').value);
		const box = out('projector');
		if (price <= 0 || cap <= 0) {
			box.innerHTML = '<p class="out-warn">Escriba un precio y una tasa de capitalización.</p>';
			return;
		}
		const base = price * (cap / 100);
		const rowsA: number[] = [];
		const rowsB: number[] = [];
		for (let y = 0; y < years; y++) {
			rowsA.push(base * Math.pow(1 + annualPct / 100, y));
			rowsB.push(base * Math.pow(1 + stepPct / 100, Math.floor(y / 5)));
		}
		const sum = (a: number[]) => a.reduce((s, n) => s + n, 0);
		const totalA = sum(rowsA);
		const totalB = sum(rowsB);
		const body = rowsA
			.map((a, i) => `<tr><td>Año ${i + 1}</td><td>${fmtMoney(a)}</td><td>${fmtMoney(rowsB[i])}</td></tr>`)
			.join('');
		box.innerHTML = `
			<span class="out-label">Renta del año 1</span>
			<span class="out-big">${fmtMoney(base)} <small style="font-size:0.9rem;font-family:inherit">(${fmtMoney(base / 12)} al mes)</small></span>
			<div class="out-scroll">
				<table class="out-table">
					<thead><tr><th>Año del contrato</th><th>${fmtPct(annualPct, 1)} cada año</th><th>${fmtPct(stepPct, 1)} cada 5 años</th></tr></thead>
					<tbody>${body}</tbody>
					<tfoot><tr><td>Total, ${years} años</td><td>${fmtMoney(totalA)}</td><td>${fmtMoney(totalB)}</td></tr>
					<tr><td>Rendimiento anual promedio sobre el precio</td><td>${fmtPct((totalA / years / price) * 100, 2)}</td><td>${fmtPct((totalB / years / price) * 100, 2)}</td></tr></tfoot>
				</table>
			</div>
			<p class="out-note">
				Esto muestra solo la renta base, antes de pagos de préstamo, de la vacante al final del contrato o del impuesto sobre la renta. Si el inquilino no
				renueva, la renta se detiene hasta que firme un inquilino nuevo.
			</p>`;
		track('nnn_projector');
	}

	// ---- 3. Ingreso equivalente ----
	function incomeMatch() {
		const equity = num(field('m-equity').value);
		const income = num(field('m-income').value);
		const nnn = num(field('m-nnn').value);
		const dst = num(field('m-dst').value);
		const box = out('match');
		if (equity <= 0) {
			box.innerHTML = '<p class="out-warn">Escriba el capital que piensa reinvertir.</p>';
			return;
		}
		const need = (income / equity) * 100;
		const nnnIncome = equity * (nnn / 100);
		const dstIncome = equity * (dst / 100);
		const row = (label: string, value: number) => {
			const diff = value - income;
			return `<tr><td>${label}</td><td>${fmtMoney(value)}</td><td>${diff >= 0 ? '+' : '−'}${fmtMoney(Math.abs(diff))}</td></tr>`;
		};
		const needNnn = nnn > 0 ? income / (nnn / 100) : 0;
		const needDst = dst > 0 ? income / (dst / 100) : 0;
		box.innerHTML = `
			<span class="out-label">Rendimiento necesario para igualar su ingreso</span>
			<span class="out-big">${fmtPct(need, 2)}</span>
			<table class="out-table">
				<thead><tr><th>Opción</th><th>Ingreso al año</th><th>frente a hoy</th></tr></thead>
				<tbody>
					${row(`NNN al ${fmtPct(nnn, 2)}`, nnnIncome)}
					${row(`DST al ${fmtPct(dst, 2)}`, dstIncome)}
				</tbody>
			</table>
			<p class="out-note">
				Para igualar ${fmtMoney(income)} al año necesitaría invertir cerca de ${nnn > 0 ? fmtMoney(needNnn) : 'n/d'} a la tasa NNN, o cerca de
				${dst > 0 ? fmtMoney(needDst) : 'n/d'} a la tasa del DST. ${need > Math.max(nnn, dst) ? 'Puede que su edificio esté pagando más que estas tasas pasivas, así que el cambio normalmente es entre ingreso y esfuerzo, no solo ingreso.' : ''}
			</p>`;
		track('income_match');
	}

	const wire = (ids: string[], fn: () => void) => {
		ids.forEach((id) => {
			const el = field(id);
			el.addEventListener('input', fn);
			el.addEventListener('change', fn);
		});
		fn();
	};
	wire(['p-price', 'p-payoff', 'p-costs', 'p-cash'], planner);
	wire(['r-price', 'r-cap', 'r-years', 'r-annual', 'r-step'], projector);
	wire(['m-equity', 'm-income', 'm-nnn', 'm-dst'], incomeMatch);
	ready = true;
</script>
