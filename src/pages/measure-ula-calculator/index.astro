---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BOVForm from '../../components/BOVForm.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import { stripLinks } from '../../lib/inlineLinks';
import { site } from '../../data/site';

// Rates and thresholds, checked October 27, 2026:
// - City of Los Angeles Office of Finance (https://finance.lacity.gov/faq/measure-ula): for closings after
//   June 30, 2026 the ULA tax is 4% above $5,400,000 and under $10,900,000 and 5.5% at $10,900,000 or more,
//   applied to the whole price (ULA is figured on gross value, including any loan the buyer assumes). The
//   City's regular tax is $2.25 per $500 or part of $500 (0.45%). The thresholds are adjusted every year.
// - LA County Registrar-Recorder: documentary transfer tax of $1.10 per $1,000 everywhere in the county.
// - Santa Monica (Measure GS): $3 per $1,000 under $5M, $6 per $1,000 from $5M to just under $8M, $56 per
//   $1,000 at $8M and up, each rate applied to the whole price. Same figures as MeasureGsCliff.astro.
// - Culver City (Municipal Code 3.08.400, Measure RE, effective April 1, 2021): marginal brackets, 0.45% up to
//   $1,499,999, 1.5% from $1.5M to $2,999,999, 3.0% from $3M to $9,999,999, 4.0% from $10M, each rate on the slice of
//   the price in that bracket (no cliff). The base also counts any lien the buyer assumes; this calculator assumes the
//   loan is paid off. Bracket amounts may be adjusted for inflation no more than once every five years; none had been
//   published as of November 6, 2026.
// - Pomona (City Code Sec. 50-251) and Redondo Beach (Municipal Code Sec. 8-7.02): a flat $1.10 per $500 or fraction
//   of $500 ($2.20 per $1,000) on the whole price, no tiers.
// - LA County Registrar-Recorder (lavote.gov, documentary transfer taxes): for Culver City, Los Angeles, Pomona,
//   Redondo Beach, and Santa Monica the county tax is the full $1.10 per $1,000 on top of the city tax.
// The script below must stay in step with these numbers.
const faqs = [
	{
		q: 'How do I calculate the Measure ULA tax on my apartment building?',
		a: 'Multiply the sale price by the ULA rate that applies to it: nothing at or below $5,400,000, 4% above $5,400,000 and below $10,900,000, and 5.5% at $10,900,000 or more. The rate applies to the whole price, not only the part above the line. The calculator above also adds the City of Los Angeles base transfer tax and the LA County tax.',
	},
	{
		q: 'Who pays the Measure ULA tax, the buyer or the seller?',
		a: 'Contracts usually put it on the seller, and this calculator assumes that. Who pays is a term of the purchase agreement, so it can be negotiated, and your escrow officer will show it on the settlement statement. Ask your broker and attorney how it is allocated in your deal.',
	},
	{
		q: 'Does this calculator include capital gains tax?',
		a: 'No. It stops at what you would have left after transfer taxes, commission and closing costs, and your loan payoff, before federal and California income tax. Your gain depends on your basis and depreciation, so ask your CPA. Our guide to [capital gains and depreciation recapture](/insights/capital-gains-depreciation-recapture-selling-la-apartment-building/) explains what comes out of a sale.',
	},
	{
		q: 'Why does a higher price sometimes leave me with less money?',
		a: 'Because the ULA tax is not marginal. At $5,400,000 no ULA tax is owed, but at $5,500,000 it is 4% of the full price, or $220,000. The calculator flags this range and shows the price you would need to reach to come out even. We explain it in our [Measure ULA guide](/insights/measure-ula-2026-thresholds-selling-la-apartment-building/).',
	},
	{
		q: 'Do Culver City, Pomona, and Redondo Beach have their own transfer taxes?',
		a: 'Yes. Culver City charges a tiered tax: 0.45% on the part of the price up to $1,500,000, 1.5% from $1,500,000 to $3,000,000, 3% from $3,000,000 to $10,000,000, and 4% above $10,000,000, each rate applying only to the slice in its bracket. Pomona and Redondo Beach each charge a flat $1.10 per $500, or $2.20 per $1,000, on the whole price. In all three, the LA County tax of $1.10 per $1,000 is charged on top. Rates change, so confirm them with your escrow officer.',
	},
	{
		q: 'Do the ULA thresholds change?',
		a: 'Yes. The City adjusts them every year for inflation, and the current figures apply to sales closing after June 30, 2026. Rates can also change if the law changes, so confirm the figures with the City of Los Angeles Office of Finance before you price a building near a line.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: stripLinks(f.a) },
	})),
};
---

<BaseLayout
	title="Measure ULA Calculator: Net Proceeds From an LA Sale"
	description="Free Measure ULA calculator for LA apartment owners. See your transfer taxes and net proceeds at any price, and whether a higher price leaves you with less."
	image="/images/social/og-measure-ula-calculator.webp"
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

	<section class="ula-hero">
		<svg class="ula-hero__skyline" viewBox="0 0 1200 200" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
			<path d="M0 200V150h40v-30h50v30h30V90h60v60h40v-40h55v40h35V60h70v90h40v-50h50v50h45V80h65v70h40v-35h60v35h35V45h80v105h40v-60h55v60h45v-30h60v30h40V100h55v50h40v-25h50v25H1200v50z" />
		</svg>
		<div class="container ula-hero__inner">
			<span class="ula-hero__eyebrow">Free Tool</span>
			<h1>Measure ULA and Net Proceeds Calculator</h1>
			<p class="ula-hero__lede">
				See what you would pay in transfer taxes, including the Measure ULA &ldquo;mansion tax,&rdquo; and what you would have left from the sale of an
				apartment building. It also shows when a higher price would leave you with less.
			</p>
			<ul class="ula-hero__chips" role="list">
				<li>Rates for closings after June 30, 2026</li>
				<li>Flags the price lines that cost you</li>
				<li>Free, nothing to sign up for</li>
			</ul>
		</div>
	</section>

	<section class="ula-main">
		<div class="container ula-grid">
			<div class="ula-card">
				<div class="ula-card__head">
					<h2>Calculate Your Net Proceeds</h2>
					<p>Enter a price and see the taxes and your cash. Everything else is optional.</p>
				</div>
				<form id="ula-form" novalidate>
					<div class="ula-field">
						<label for="ula-price"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2l7 7-8 8-7-7V2z" /><circle cx="6.5" cy="6.5" r="1.3" /></svg> Sale Price</label>
						<div class="ula-money">
							<span aria-hidden="true">$</span>
							<input id="ula-price" name="price" type="text" inputmode="numeric" autocomplete="off" placeholder="5,500,000" required />
						</div>
						<p id="ula-error" class="ula-error" role="alert" hidden></p>
					</div>

					<div class="ula-field">
						<label for="ula-where"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 18s6-5.2 6-10a6 6 0 10-12 0c0 4.8 6 10 6 10z" /><circle cx="10" cy="8" r="2.2" /></svg> Where Is the Building?</label>
						<select id="ula-where" name="where">
							<option value="la" selected>City of Los Angeles (Measure ULA applies)</option>
							<option value="sm">Santa Monica (Measure GS applies)</option>
							<option value="cc">Culver City (tiered city transfer tax, Measure RE)</option>
							<option value="pomona">Pomona (city transfer tax)</option>
							<option value="rb">Redondo Beach (city transfer tax)</option>
							<option value="other">West Hollywood, Beverly Hills, or another LA County city with no city transfer tax</option>
						</select>
						<span class="ula-field__hint">Los Angeles, Santa Monica, Culver City, Pomona, and Redondo Beach each have their own city transfer tax. Everywhere else in LA County, the county&rsquo;s $1.10 per $1,000 applies.</span>
					</div>

					<div class="ula-row">
						<div class="ula-field">
							<label for="ula-costs"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16L16 4" /><circle cx="6" cy="6" r="2" /><circle cx="14" cy="14" r="2" /></svg> Commission and Closing Costs <span class="ula-field__optional">(optional)</span></label>
							<input id="ula-costs" name="costs" type="number" inputmode="decimal" min="0" max="20" step="0.1" placeholder="4% of price" />
							<span class="ula-field__hint">Your commission is negotiable. Enter the total you expect, as a percent of the price.</span>
						</div>
						<div class="ula-field">
							<label for="ula-loan"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 8l7-5 7 5v1H3zM5 10v6M9 10v6M13 10v6M3 17h14" /></svg> Loan Payoff <span class="ula-field__optional">(optional)</span></label>
							<div class="ula-money">
								<span aria-hidden="true">$</span>
								<input id="ula-loan" name="loan" type="text" inputmode="numeric" autocomplete="off" placeholder="2,000,000" />
							</div>
							<span class="ula-field__hint">What you owe the lender. The buyer is assumed to pay it off, not assume it.</span>
						</div>
					</div>

					<button type="submit" class="ula-submit">Calculate My Net Proceeds</button>
					<p class="ula-disclaimer">
						Informational estimate only, not tax or legal advice. Rates and thresholds are those published for closings after June 30, 2026 and are
						adjusted every year. It assumes the seller pays the transfer taxes, which is negotiable, and it stops before federal and California income tax.
					</p>
				</form>

				<div id="ula-loading" class="ula-loading" hidden role="status" aria-live="polite">
					<span class="eyebrow">Working on it</span>
					<p class="ula-loading__step" id="ula-loading-step">Checking your sale price</p>
					<div class="ula-loading__bar" aria-hidden="true"><span id="ula-loading-bar"></span></div>
					<ul class="ula-loading__done" id="ula-loading-done" aria-hidden="true"></ul>
				</div>

				<div id="ula-result" class="ula-result" hidden aria-live="polite">
					<span class="eyebrow">Estimated Transfer Taxes</span>
					<p class="ula-result__big" id="ula-total-tax"></p>
					<p class="ula-result__sub" id="ula-total-sub"></p>

					<div id="ula-flag" class="ula-flag" hidden></div>

					<table class="ula-breakdown">
						<caption>Where the money goes</caption>
						<tbody id="ula-breakdown-body"></tbody>
					</table>

					<table class="ula-whatif">
						<caption>What if the price were different?</caption>
						<thead>
							<tr>
								<th scope="col">Sale Price</th>
								<th scope="col">Transfer Taxes</th>
								<th scope="col" id="ula-whatif-net-head">Cash After Taxes</th>
							</tr>
						</thead>
						<tbody id="ula-whatif-body"></tbody>
					</table>

					<a href="#bov-form" class="ula-submit ula-result__cta">Have Us Model Your Exact Numbers &rarr;</a>
				</div>
			</div>

			<aside class="ula-aside" aria-label="About Measure ULA">
				<div class="ula-panel">
					<h2>The ULA Lines</h2>
					<ul class="ula-levels" role="list">
						<li>
							<strong>$5.4M or less</strong>
							<span>No ULA tax</span>
						</li>
						<li>
							<strong>Above $5.4M</strong>
							<span>4% of the <em>full</em> price</span>
						</li>
						<li>
							<strong>$10.9M or more</strong>
							<span>5.5% of the <em>full</em> price</span>
						</li>
					</ul>
					<p class="ula-panel__note">For closings after June 30, 2026. The rate applies to the whole price, which is why a price just over a line can leave you with less cash.</p>
				</div>

				<div class="ula-panel ula-panel--dark">
					<h2>Want Your Exact Numbers?</h2>
					<p>A calculator can't see your tax basis, loan terms, or timing. A free Broker Opinion of Value can.</p>
					<a href="/broker-opinion-of-value/" class="ula-panel__btn">See How a Broker Opinion Works</a>
					<a class="ula-panel__call" href={`tel:+1${site.phone.replace(/\D/g, '')}`}>Or call {site.phone}</a>
				</div>
			</aside>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container ula-notes">
			<h2>How Measure ULA Works</h2>
			<p>
				Measure ULA is the City of Los Angeles transfer tax on sales above a set price. For closings after June 30, 2026, a sale of
				$5,400,000 or less owes no ULA tax, a sale above $5,400,000 and under $10,900,000 owes 4%, and a sale at $10,900,000 or more owes 5.5%. The rate
				applies to the <strong>entire</strong> price, which is why a price just over a line can leave you with less money than a price just under it. The
				tax is on top of the City&rsquo;s regular transfer tax of 0.45% and the LA County tax of $1.10 per $1,000.
			</p>
			<p>
				Read the full explanation in our <a href="/insights/measure-ula-2026-thresholds-selling-la-apartment-building/">Measure ULA guide</a>, and see
				whether it is smarter to <a href="/insights/measure-ula-hold-or-sell-la-apartment-building/">hold or sell</a> if your building sits near a line.
				Owners in <a href="/submarkets/west-hollywood/">West Hollywood</a> and <a href="/submarkets/santa-monica/">Santa Monica</a> are outside
				Measure ULA.
			</p>
			<details class="ula-more">
				<summary>Culver City, Pomona, and Redondo Beach: how their city taxes work</summary>
				<p>
				Culver City, Pomona, and Redondo Beach each charge their own city transfer tax on top of the county&rsquo;s $1.10 per $1,000. Culver City
				uses marginal brackets (0.45% up to $1.5 million, 1.5% from $1.5 to $3 million, 3% from $3 to $10 million, and 4% above $10 million, each applied to the
				slice of the price in that bracket), so it has no price cliff like Measure ULA. Its bracket amounts can be adjusted for inflation no more than once every
				five years, and none had been published when we checked on November 6, 2026. Pomona and Redondo Beach charge a flat $1.10 per $500, or $2.20 per $1,000.
				Culver City&rsquo;s tax is figured on the price plus any loan the buyer assumes; this calculator assumes your loan is paid off at closing.
				</p>
			</details>
			<p class="ula-notes__source">
				Source for rates and thresholds: <a href="https://finance.lacity.gov/faq/measure-ula" target="_blank" rel="noopener noreferrer">City of Los Angeles
				Office of Finance</a>. Santa Monica and LA County rates from the LA County Registrar-Recorder. Culver City: Municipal Code 3.08.400 (Measure RE). Pomona: City Code
				Sec. 50-251. Redondo Beach: Municipal Code Sec. 8-7.02. The county confirms the full $1.10 per $1,000 for each of these cities.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container ula-faq">
			<ArticleFaq faqs={faqs} />
		</div>
	</section>

	<section class="section section-alt" id="bov-form">
		<div class="container">
			<BOVForm
				heading="Want Your Exact Net Proceeds?"
				subheading="A calculator can't see your tax basis, your loan terms, or your timing. A free Broker Opinion of Value from Highlight Multifamily Group can."
			/>
		</div>
	</section>
</BaseLayout>

<script>
	const COUNTY_PER_1000 = 1.1;

	// Each line is the price where a higher tax tier begins: `start` is the lowest price in the higher tier and
	// `below` is the highest price in the lower tier.
	const LINES = {
		la: [
			{ name: '$5.4 million', at: 5400000, start: 5400000.01, below: 5400000, belowLabel: '$5,400,000' },
			{ name: '$10.9 million', at: 10900000, start: 10900000, below: 10899999, belowLabel: 'just under $10,900,000' },
		],
		sm: [
			{ name: '$5 million', at: 5000000, start: 5000000, below: 4999999, belowLabel: 'just under $5,000,000' },
			{ name: '$8 million', at: 8000000, start: 8000000, below: 7999999, belowLabel: 'just under $8,000,000' },
		],
		other: [],
	};

	const money = (n) => `$${Math.round(n).toLocaleString('en-US')}`;
	const digits = (s) => Number(String(s ?? '').replace(/[^0-9]/g, ''));

	// Tax pieces for a sale price in the chosen place. The City of LA base tax is $2.25 per $500 or part of $500.
	function taxPieces(price, where) {
		const pieces = [];
		if (where === 'la') {
			pieces.push({ label: 'City of Los Angeles transfer tax (0.45%)', amount: Math.ceil(price / 500) * 2.25 });
			const rate = price > 5400000 ? (price >= 10900000 ? 0.055 : 0.04) : 0;
			pieces.push({ label: rate ? `Measure ULA tax (${rate * 100}% of the full price)` : 'Measure ULA tax (price is at or below $5.4 million)', amount: price * rate, ula: true });
		} else if (where === 'sm') {
			const rate = price >= 8000000 ? 0.056 : price >= 5000000 ? 0.006 : 0.003;
			pieces.push({ label: `Santa Monica transfer tax (${(rate * 100).toFixed(1)}%${rate === 0.056 ? ', Measure GS' : ''})`, amount: price * rate });
		} else if (where === 'cc') {
			// Culver City Measure RE: each rate applies only to the slice of the price inside its bracket.
			const tiers =
				Math.min(price, 1500000) * 0.0045 +
				Math.min(Math.max(price - 1500000, 0), 1500000) * 0.015 +
				Math.min(Math.max(price - 3000000, 0), 7000000) * 0.03 +
				Math.max(price - 10000000, 0) * 0.04;
			pieces.push({ label: 'Culver City transfer tax (tiered, Measure RE)', amount: tiers });
		} else if (where === 'pomona') {
			pieces.push({ label: 'Pomona transfer tax ($1.10 per $500)', amount: Math.ceil(price / 500) * 1.1 });
		} else if (where === 'rb') {
			pieces.push({ label: 'Redondo Beach transfer tax ($1.10 per $500)', amount: Math.ceil(price / 500) * 1.1 });
		}
		pieces.push({ label: 'LA County transfer tax ($1.10 per $1,000)', amount: (price / 1000) * COUNTY_PER_1000 });
		return pieces;
	}

	const totalTax = (price, where) => taxPieces(price, where).reduce((s, p) => s + p.amount, 0);

	// What the seller keeps from a sale price, before any loan payoff and before income tax.
	const keepsFrom = (price, where, costsPct) => price - totalTax(price, where) - price * costsPct;

	// Lowest price above the line at which the seller keeps at least as much as at the highest price below it.
	function breakEven(line, where, costsPct) {
		const target = keepsFrom(line.below, where, costsPct);
		let lo = line.start;
		let hi = line.start * 1.25;
		for (let i = 0; i < 80; i++) {
			const mid = (lo + hi) / 2;
			if (keepsFrom(mid, where, costsPct) >= target) hi = mid;
			else lo = mid;
		}
		return Math.ceil(hi / 5000) * 5000;
	}

	const form = document.getElementById('ula-form');
	const result = document.getElementById('ula-result');
	const errorEl = document.getElementById('ula-error');
	const priceInput = document.getElementById('ula-price');
	const loanInput = document.getElementById('ula-loan');

	// Show commas while typing.
	for (const input of [priceInput, loanInput]) {
		input?.addEventListener('input', () => {
			const n = digits(input.value);
			input.value = n ? n.toLocaleString('en-US') : '';
			errorEl.hidden = true;
		});
	}

	function render(animate = false) {
		const price = digits(priceInput.value);
		const where = document.getElementById('ula-where').value;
		const costsPct = Math.max(0, Number(document.getElementById('ula-costs').value) || 0) / 100;
		const loan = digits(loanInput.value);

		if (price < 100000) {
			errorEl.textContent = 'Enter the sale price in dollars, for example 5,500,000.';
			errorEl.hidden = false;
			result.hidden = true;
			priceInput.focus();
			return;
		}
		errorEl.hidden = true;

		const pieces = taxPieces(price, where);
		const tax = pieces.reduce((s, p) => s + p.amount, 0);
		const costs = price * costsPct;
		const cash = price - tax - costs - loan;

		document.getElementById('ula-total-tax').textContent = money(tax);
		document.getElementById('ula-total-sub').textContent = `${((tax / price) * 100).toFixed(2)}% of the ${money(price)} sale price`;

		// Breakdown table
		const rows = [['Sale price', money(price), false]];
		for (const p of pieces) rows.push([p.label, `− ${money(p.amount)}`, false]);
		if (costs > 0) rows.push([`Commission and closing costs (${(costsPct * 100).toFixed(1).replace(/\.0$/, '')}%)`, `− ${money(costs)}`, false]);
		if (loan > 0) rows.push(['Loan payoff', `− ${money(loan)}`, false]);
		rows.push([loan > 0 || costs > 0 ? 'Estimated cash to you, before income tax' : 'Left after transfer taxes', money(cash), true]);
		const body = document.getElementById('ula-breakdown-body');
		body.replaceChildren();
		for (const [label, value, strong] of rows) {
			const tr = document.createElement('tr');
			if (strong) tr.className = 'is-total';
			const th = document.createElement('th');
			th.scope = 'row';
			th.textContent = label;
			const td = document.createElement('td');
			td.textContent = value;
			tr.append(th, td);
			body.append(tr);
		}

		// Threshold flag
		const flag = document.getElementById('ula-flag');
		flag.hidden = true;
		flag.className = 'ula-flag';
		const lines = LINES[where] ?? [];
		let message = '';
		let tone = '';
		for (const line of lines) {
			if (price >= line.start) {
				const be = breakEven(line, where, costsPct);
				if (price < be) {
					const gap = keepsFrom(line.below, where, costsPct) - keepsFrom(price, where, costsPct);
					message = `<strong>You are in the dead zone above the ${line.name} line.</strong> At ${money(price)} you would keep about ${money(gap)} less than from a sale at ${line.belowLabel}. The price has to reach about ${money(be)} before you come out ahead.`;
					tone = 'warn';
				}
			} else if (price >= line.start * 0.88 && !message) {
				const be = breakEven(line, where, costsPct);
				message = `<strong>You are ${money(line.at - price)} under the ${line.name} line.</strong> Pricing above that line only pays off at about ${money(be)} or more, because the higher tax applies to the whole price. Any price from the line up to about ${money(be)} would leave you with less than a sale at ${line.belowLabel}.`;
				tone = 'note';
			}
		}
		if (message) {
			flag.innerHTML = message;
			flag.classList.add(tone === 'warn' ? 'ula-flag--warn' : 'ula-flag--note');
			flag.hidden = false;
		}

		// What-if table: the price rounded, steps around it, and the nearest line if it is close.
		const net = (p) => p - totalTax(p, where) - p * costsPct - loan;
		const base = Math.round(price / 10000) * 10000 || price;
		const prices = new Set([price]);
		for (const f of [0.9, 0.95, 1.05, 1.1]) prices.add(Math.round((base * f) / 10000) * 10000);
		for (const line of lines) {
			if (line.below >= price * 0.85 && line.below <= price * 1.15) prices.add(Math.round(line.below));
		}
		document.getElementById('ula-whatif-net-head').textContent = loan > 0 || costsPct > 0 ? 'Cash to You, Before Income Tax' : 'Left After Transfer Taxes';
		const wb = document.getElementById('ula-whatif-body');
		wb.replaceChildren();
		for (const p of [...prices].sort((a, b) => a - b)) {
			const tr = document.createElement('tr');
			if (p === price) tr.className = 'is-you';
			const a = document.createElement('th');
			a.scope = 'row';
			a.textContent = money(p) + (p === price ? ' (yours)' : '');
			const b = document.createElement('td');
			b.textContent = money(totalTax(p, where));
			const c = document.createElement('td');
			c.textContent = money(net(p));
			tr.append(a, b, c);
			wb.append(tr);
		}

		// Steps shown while "working". They describe what the calculator actually does for the chosen place.
		const steps =
			where === 'la'
				? [
						'Checking your sale price',
						'Applying the City of Los Angeles and LA County transfer taxes',
						'Testing the Measure ULA thresholds near your price',
						'Calculating what you would keep',
					]
				: where === 'cc'
					? ['Checking your sale price', 'Applying the Culver City tiered transfer tax', 'Adding the LA County transfer tax', 'Calculating what you would keep']
					: where === 'pomona' || where === 'rb'
						? ['Checking your sale price', 'Applying the ' + (where === 'rb' ? 'Redondo Beach' : 'Pomona') + ' city transfer tax', 'Adding the LA County transfer tax', 'Calculating what you would keep']
						: where === 'sm'
							? [
							'Checking your sale price',
							'Applying the Santa Monica and LA County transfer taxes',
							'Testing the Measure GS thresholds near your price',
							'Calculating what you would keep',
						]
					: ['Checking your sale price', 'Applying the LA County transfer tax', 'Calculating what you would keep'];
		showResultAfterLoading(steps, animate ? tax : null);
	}

	// A short "working" sequence, then the result with the tax figure counting up. Skipped for visitors who ask
	// their device for reduced motion, and for people who arrive from an article link (they did not click Calculate).
	const loading = document.getElementById('ula-loading');
	const loadingStep = document.getElementById('ula-loading-step');
	const loadingBar = document.getElementById('ula-loading-bar');
	const loadingDone = document.getElementById('ula-loading-done');
	const submitBtn = form?.querySelector('button[type="submit"]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const STEP_MS = 610; // 4 steps x 610 ms + 250 ms closing pause = about 2.7 seconds
	const COUNT_MS = 1300;

	function revealResult(finalTax) {
		const bigEl = document.getElementById('ula-total-tax');
		const finalText = bigEl.textContent;
		// Start the count-up from zero before the card is shown, so the final number never flashes first.
		if (finalTax != null && !reduceMotion) bigEl.textContent = '$0';
		result.hidden = false;
		result.classList.remove('ula-result--in');
		void result.offsetWidth;
		result.classList.add('ula-result--in');
		result.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
		if (submitBtn) {
			submitBtn.disabled = false;
			submitBtn.textContent = 'Calculate My Net Proceeds';
		}
		form.dataset.busy = '0';
		if (finalTax == null || reduceMotion) return;
		const start = performance.now();
		function tick(now) {
			const t = Math.min(1, (now - start) / COUNT_MS);
			bigEl.textContent = t >= 1 ? finalText : money(finalTax * (1 - Math.pow(1 - t, 3)));
			if (t < 1) requestAnimationFrame(tick);
		}
		requestAnimationFrame(tick);
		// Safety net: if the browser pauses animation frames (hidden tab), still end on the real number.
		setTimeout(() => {
			bigEl.textContent = finalText;
		}, COUNT_MS + 600);
	}

	function showResultAfterLoading(steps, finalTax) {
		if (reduceMotion || finalTax == null) {
			revealResult(null);
			return;
		}
		form.dataset.busy = '1';
		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = 'Calculating...';
		}
		result.hidden = true;
		loadingDone.innerHTML = '';
		loadingBar.style.width = '0%';
		loading.hidden = false;
		loading.scrollIntoView({ behavior: 'smooth', block: 'center' });
		let i = 0;
		function next() {
			if (i > 0) {
				const li = document.createElement('li');
				li.textContent = steps[i - 1];
				loadingDone.appendChild(li);
			}
			if (i >= steps.length) {
				loadingBar.style.width = '100%';
				setTimeout(() => {
					loading.hidden = true;
					revealResult(finalTax);
				}, 250);
				return;
			}
			loadingStep.textContent = steps[i] + '...';
			loadingBar.style.width = `${Math.round(((i + 0.6) / steps.length) * 100)}%`;
			i += 1;
			setTimeout(next, STEP_MS);
		}
		next();
	}

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (form.dataset.busy === '1') return;
		render(true);
	});

	// A link from an article can pass a price, as in /measure-ula-calculator/?price=5500000
	const fromLink = new URLSearchParams(window.location.search).get('price');
	if (fromLink && digits(fromLink) >= 100000) {
		priceInput.value = digits(fromLink).toLocaleString('en-US');
		render(false);
	}
</script>

