---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MARKET_REPORT_OCT_2026 as R } from '../../data/marketReportOct2026';
import { TREASURY, COSTAR_OCT_2026 as C } from '../../data/marketReportOct2026Context';
import { site } from '../../data/site';

// The newest report. When next month's data is generated (node scripts/market-update.mjs), point this import
// at the new data file and update `period`, `articleHref` and the dates below.
const period = 'October 2026';
const articleHref = '/insights/la-apartment-market-report-october-2026/';
const updated = 'October 30, 2026';

const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
const fmt = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const older = R.headline.older;
const newer = R.headline.newer;
const all = R.headline.all;

// ---- Chart geometry (plain SVG) ----
const W = 720;
const H = 300;
const padL = 46;
const padR = 16;
const padT = 28;
const padB = 34;
const plotW = W - padL - padR;
const plotH = H - padT - padB;

const months = R.months;
const slot = plotW / months.length;

// Monthly sales volume
const maxVol = Math.max(...months.map((m) => m.volumeMillions));
const volTop = Math.ceil(maxVol / 100) * 100;
const volTicks = [0, volTop / 2, volTop];
const peakIdx = months.findIndex((m) => m.volumeMillions === maxVol);
const barW = slot * 0.62;
const bars = months.map((m, i) => {
	const h = (m.volumeMillions / volTop) * plotH;
	return {
		i,
		label: monthNames[m.month - 1],
		v: m.volumeMillions,
		sales: m.sales,
		x: padL + slot * i + (slot - barW) / 2,
		y: padT + plotH - h,
		h,
		cx: padL + slot * i + slot / 2,
		peak: i === peakIdx,
	};
});

// Cap rate (older buildings) against the 10-year Treasury monthly average, on one shared axis
const caps = months.map((m) => m.olderCapRateMedian);
const tres = months.map((m) => (TREASURY.monthlyAverage as Record<number, number>)[m.month] ?? null);
const allRates = [...caps, ...(tres.filter((t) => t !== null) as number[])];
const yMin = Math.floor(Math.min(...allRates) * 2) / 2 - 0.5;
const yMax = Math.ceil(Math.max(...allRates) * 2) / 2 + 0.5;
const yPos = (v: number) => padT + plotH - ((v - yMin) / (yMax - yMin)) * plotH;
const rateTicks: number[] = [];
for (let t = yMin; t <= yMax + 0.001; t += 0.5) rateTicks.push(Math.round(t * 10) / 10);
const capPts = months.map((m, i) => ({ i, label: monthNames[m.month - 1], v: m.olderCapRateMedian, t: tres[i], x: padL + slot * i + slot / 2, y: yPos(m.olderCapRateMedian) }));
const trePts = capPts.filter((p) => p.t !== null).map((p) => ({ ...p, ty: yPos(p.t as number) }));
const capLine = capPts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
const treLine = trePts.map((p) => `${p.x.toFixed(1)},${p.ty.toFixed(1)}`).join(' ');
const capArea = `${capPts[0].x.toFixed(1)},${(padT + plotH).toFixed(1)} ${capLine} ${capPts[capPts.length - 1].x.toFixed(1)},${(padT + plotH).toFixed(1)}`;

// How far cap rates sit above the 10-year, first month to last
const spreadFirst = trePts.length ? trePts[0].v - (trePts[0].t as number) : null;
const spreadLast = trePts.length ? trePts[trePts.length - 1].v - (trePts[trePts.length - 1].t as number) : null;
const capMinV = Math.min(...caps);
const capMaxV = Math.max(...caps);

// Quarter and size tables get a small bar on the Sales column
const maxQ = Math.max(...R.quarters.map((q) => q.olderSales));
const maxS = Math.max(...R.sizes.map((s) => s.olderSales));
const maxBand = Math.max(...R.bands.map((b) => b.sharePct));

// Price vs. asking: four slices that add up to 100%
const askSlices = [
	{ label: 'At or above asking', pct: R.asking.atOrAbovePct, cls: 's1' },
	{ label: 'Within 5% below', pct: R.asking.within5Pct, cls: 's2' },
	{ label: '5% to 10% below', pct: R.asking.five10Pct, cls: 's3' },
	{ label: 'More than 10% below', pct: R.asking.over10Pct, cls: 's4' },
];

const tiles = [
	{ n: `${money(older.pricePerUnit)}`, l: 'median price per unit, older buildings (built before 1978)' },
	{ n: `${older.capRateMedian.toFixed(2)}%`, l: 'median cap rate, older buildings' },
	{ n: `${R.asking.medianPct}%`, l: 'of asking price: the median sale price, for sales with a known asking price' },
	{ n: `${TREASURY.close}%`, l: `10-year Treasury at the end of the period (${TREASURY.asOf.slice(5).replace('-', '/')})` },
];

const faqs = [
	{ q: 'Where does this data come from?', a: `The sales figures come from a CoStar sales export of Los Angeles County apartment sales from ${fmt(R.firstSale)} through ${fmt(R.lastSale)}. Counts leave out sales with approximate or allocated prices, portfolio sales of 100 units or more, and repeated records. Treasury yields come from the U.S. Department of the Treasury, and the vacancy and rent figures are paraphrased from CoStar's Los Angeles multifamily report.` },
	{ q: 'What is "older"?', a: 'Older buildings were built before 1978. Many of them fall under rent control where it applies, such as the City of Los Angeles Rent Stabilization Ordinance. They make up most of the sales in the county, which is why we lead with them.' },
	{ q: 'How often is this updated?', a: 'We refresh it each month with the newest sales data and publish a full written report.' },
	{ q: 'Is this a valuation of my building?', a: 'No. These are market-wide medians. Your building’s value depends on its own rents, expenses, condition, and location. A free Broker Opinion of Value applies this kind of data to your building.' },
];
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
	title="LA Apartment Market Report: Prices and Cap Rates"
	description="Los Angeles apartment market report, updated monthly: median price per unit, cap rates, sale prices versus asking, and the 10-year Treasury."
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

	<section class="mr-hero">
		<div class="container">
			<span class="eyebrow">Market Report</span>
			<h1>Los Angeles Apartment Market Report</h1>
			<p>
				Prices, cap rates, and how buyers are bidding, from {R.firstSale.slice(0, 4)} sales through {updated}. Free to read, updated every month.
			</p>
			<ul class="mr-hero__chips" role="list">
				<li><span class="mr-dot" aria-hidden="true"></span>Updated {updated}</li>
				<li>{all.sales.toLocaleString('en-US')} sales analyzed</li>
				<li>${(all.volumeMillions / 1000).toFixed(2)} billion in sales volume</li>
			</ul>
			<div class="mr-hero__cta">
				<a href="/broker-opinion-of-value/" class="btn btn-gold-fill" data-cta="market-report-hero-bov">Get a Free Opinion of Value</a>
				<a href={articleHref} class="btn btn-outline-light" data-cta="market-report-hero-article">Read the Full {period} Report</a>
			</div>
		</div>
	</section>

	<section class="mr-tiles-wrap">
		<div class="container">
			<ul class="tiles" role="list">
				{
					tiles.map((t) => (
						<li class="mr-anim">
							<span class="tiles__n">{t.n}</span>
							<span class="tiles__l">{t.l}</span>
						</li>
					))
				}
			</ul>
			<p class="fine">
				Based on {older.sales.toLocaleString('en-US')} sales of older buildings and {newer.sales.toLocaleString('en-US')} sales of newer buildings in Los Angeles County,{' '}
				{fmt(R.firstSale)} to {fmt(R.lastSale)}. Median price per unit for newer buildings: {money(newer.pricePerUnit)}; median cap rate: {newer.capRateMedian.toFixed(2)}%.
			</p>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<span class="eyebrow">By Month</span>
			<h2>What Sold: Monthly Sales Volume</h2>
			<p class="chart-note">Dollar volume of apartment sales in Los Angeles County, in millions of dollars. The last month is partial if the report ends before month-end.</p>
			<div class="mr-card mr-anim chart-card">
				<ul class="chart-stats" role="list">
					<li><strong>${(all.volumeMillions / 1000).toFixed(2)}B</strong> total volume</li>
					<li><strong>{all.sales.toLocaleString('en-US')}</strong> sales</li>
					<li><strong>{bars[peakIdx].label}</strong> was the busiest month, at ${maxVol}M</li>
				</ul>
				<figure class="chart">
					<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Bar chart of monthly apartment sales volume in millions of dollars, ${bars[0].label} to ${bars[bars.length - 1].label}`}>
						{
							volTicks.map((t) => {
								const y = padT + plotH - (t / volTop) * plotH;
								return (
									<g>
										<line x1={padL} y1={y} x2={W - padR} y2={y} class={t === 0 ? 'axis' : 'grid'} />
										<text x={padL - 8} y={y + 4} text-anchor="end" class="tick">{t === 0 ? '0' : `$${t}M`}</text>
									</g>
								);
							})
						}
						{
							bars.map((b) => (
								<g class="bar-g" tabindex="0" data-tip={`${b.label}: $${b.v.toLocaleString('en-US')} million across ${b.sales} sales`} style={`--i:${b.i}`}>
									<rect x={padL + slot * b.i} y={padT} width={slot} height={plotH} class="hit" />
									<rect x={b.x} y={b.y} width={barW} height={b.h} rx="3" class={b.peak ? 'bar bar--peak' : 'bar'} />
									<text x={b.cx} y={b.y - 7} text-anchor="middle" class={b.peak ? 'val val--peak' : 'val'}>{b.v}</text>
									<text x={b.cx} y={H - 12} text-anchor="middle" class="tick">{b.label}</text>
								</g>
							))
						}
					</svg>
				</figure>
				<details class="mr-data">
					<summary>View this chart as a table</summary>
					<div class="table-wrap">
						<table>
							<thead>
								<tr><th>Month</th><th>Sales</th><th>Volume</th></tr>
							</thead>
							<tbody>
								{months.map((m) => (
									<tr><td>{monthNames[m.month - 1]}</td><td>{m.sales}</td><td>${m.volumeMillions}M</td></tr>
								))}
							</tbody>
						</table>
					</div>
				</details>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="eyebrow">Cap Rates</span>
			<h2>Cap Rates vs. the 10-Year Treasury</h2>
			<p class="chart-note">
				Median cap rate for older buildings, by month, next to the 10-year Treasury yield on the same scale. A cap rate is a year's net income divided by the price.
				{capMinV !== capMaxV && <> Cap rates stayed between {capMinV.toFixed(2)}% and {capMaxV.toFixed(2)}% this year.</>}
				{
					spreadFirst !== null && spreadLast !== null && (
						<> The gap between cap rates and the 10-year went from {spreadFirst.toFixed(2)} points in {capPts[0].label} to {spreadLast.toFixed(2)} points in {capPts[capPts.length - 1].label}.</>
					)
				}
			</p>
			<div class="mr-card mr-anim chart-card">
				<ul class="legend" role="list">
					<li><span class="sw sw--navy" aria-hidden="true"></span>Median cap rate, older buildings</li>
					<li><span class="sw sw--gold" aria-hidden="true"></span>10-year Treasury, monthly average</li>
				</ul>
				<figure class="chart">
					<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Line chart of the monthly median cap rate for older buildings, between ${capMinV}% and ${capMaxV}%, and the 10-year Treasury monthly average`}>
						<defs>
							<linearGradient id="capFill" x1="0" y1="0" x2="0" y2="1">
								<stop offset="0%" stop-color="#14467a" stop-opacity="0.16"></stop>
								<stop offset="100%" stop-color="#14467a" stop-opacity="0"></stop>
							</linearGradient>
						</defs>
						{
							rateTicks.map((t) => (
								<g>
									<line x1={padL} y1={yPos(t)} x2={W - padR} y2={yPos(t)} class="grid" />
									<text x={padL - 8} y={yPos(t) + 4} text-anchor="end" class="tick">{t.toFixed(1)}%</text>
								</g>
							))
						}
						<polygon points={capArea} class="area"></polygon>
						{treLine && <polyline points={treLine} class="line line--gold" pathLength="1"></polyline>}
						<polyline points={capLine} class="line line--navy" pathLength="1"></polyline>
						{
							capPts.map((p) => (
								<g class="dot-g" tabindex="0" data-tip={`${p.label}: cap rate ${p.v.toFixed(2)}%${p.t !== null ? `, 10-year Treasury ${(p.t as number).toFixed(2)}%, gap ${(p.v - (p.t as number)).toFixed(2)} points` : ''}`} style={`--i:${p.i}`}>
									<rect x={padL + slot * p.i} y={padT} width={slot} height={plotH} class="hit" />
									{p.t !== null && <circle cx={p.x} cy={yPos(p.t as number)} r="4.5" class="dot dot--gold" />}
									<circle cx={p.x} cy={p.y} r="4.5" class="dot dot--navy" />
									<text x={p.x} y={p.y - 11} text-anchor="middle" class="val">{p.v.toFixed(2)}</text>
									{p.t !== null && (
										<text x={p.x} y={yPos(p.t as number) + 19} text-anchor="middle" class="val val--gold">{(p.t as number).toFixed(2)}</text>
									)}
									<text x={p.x} y={H - 12} text-anchor="middle" class="tick">{p.label}</text>
								</g>
							))
						}
					</svg>
				</figure>
				<p class="fine">10-year Treasury: monthly average of the daily par yield, from the U.S. Department of the Treasury. The last month's cap rate is partial if the report ends before month-end.</p>
				<details class="mr-data">
					<summary>View this chart as a table</summary>
					<div class="table-wrap">
						<table>
							<thead>
								<tr><th>Month</th><th>Median cap rate</th><th>10-year Treasury</th></tr>
							</thead>
							<tbody>
								{capPts.map((p) => (
									<tr><td>{p.label}</td><td>{p.v.toFixed(2)}%</td><td>{p.t !== null ? `${(p.t as number).toFixed(2)}%` : 'n/a'}</td></tr>
								))}
							</tbody>
						</table>
					</div>
				</details>
			</div>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container two-col">
			<div>
				<span class="eyebrow">By Quarter</span>
				<h2>Older Buildings, Quarter by Quarter</h2>
				<div class="mr-card mr-anim">
					<div class="table-wrap">
						<table class="rich">
							<thead>
								<tr><th>Quarter</th><th>Sales</th><th>Median $/unit</th><th>Median cap rate</th></tr>
							</thead>
							<tbody>
								{
									R.quarters.map((q) => (
										<tr>
											<td>Q{q.quarter}{q.quarter === 4 ? ' (partial)' : ''}</td>
											<td>
												<span class="cell-n">{q.olderSales}</span>
												<span class="minibar" style={`--w:${((q.olderSales / maxQ) * 100).toFixed(0)}%`}></span>
											</td>
											<td>{money(q.olderPricePerUnit)}</td>
											<td>{q.olderCapRateMedian.toFixed(2)}%</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
			<div>
				<span class="eyebrow">By Building Size</span>
				<h2>Older Buildings by Number of Units</h2>
				<div class="mr-card mr-anim">
					<div class="table-wrap">
						<table class="rich">
							<thead>
								<tr><th>Size</th><th>Sales</th><th>Median $/unit</th><th>Median cap rate</th></tr>
							</thead>
							<tbody>
								{
									R.sizes.map((s) => (
										<tr>
											<td>{s.label}</td>
											<td>
												<span class="cell-n">{s.olderSales}</span>
												<span class="minibar" style={`--w:${((s.olderSales / maxS) * 100).toFixed(0)}%`}></span>
											</td>
											<td>{money(s.olderPricePerUnit)}</td>
											<td>{s.olderCapRateMedian.toFixed(2)}%</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container two-col">
			<div>
				<span class="eyebrow">Price vs. Asking</span>
				<h2>How Far Below Asking Buildings Sold</h2>
				<div class="mr-card mr-anim ask">
					<div class="ask__big">
						<span class="ask__num">{R.asking.medianPct}%</span>
						<span class="ask__lbl">of the asking price was the median sale price, about {money(R.asking.medianDollarsBelow)} below asking.</span>
					</div>
					<div class="stack" role="img" aria-label={`Share of sales by how far below asking they sold: ${askSlices.map((s) => `${s.label} ${s.pct}%`).join(', ')}`}>
						{
							askSlices.map((s, i) => (
								<span class={`stack__seg stack__seg--${s.cls}`} style={`flex:${s.pct};--i:${i}`} data-tip={`${s.label}: ${s.pct}% of sales`} tabindex="0">
									{s.pct}%
								</span>
							))
						}
					</div>
					<ul class="stack-legend" role="list">
						{askSlices.map((s) => <li><span class={`sw sw--${s.cls}`} aria-hidden="true"></span>{s.label}</li>)}
					</ul>
				</div>
				<p class="fine">Based on {R.asking.sales.toLocaleString('en-US')} sales with a recorded asking price.</p>
			</div>
			<div>
				<span class="eyebrow">By Price Range</span>
				<h2>Where the Sales Happened</h2>
				<div class="mr-card mr-anim">
					<ul class="bands" role="list">
						{
							R.bands.map((b, i) => (
								<li style={`--i:${i}`} data-tip={`${b.label}: ${b.sales} sales, ${b.sharePct}% of the total`} tabindex="0">
									<span class="bands__label">{b.label}</span>
									<span class="bands__track"><span class="bands__fill" style={`--w:${((b.sharePct / maxBand) * 100).toFixed(1)}%`}></span></span>
									<span class="bands__val">{b.sharePct}% <small>({b.sales})</small></span>
								</li>
							))
						}
					</ul>
				</div>
				<p class="fine">Median sale price: {money(R.medianSalePrice)}. The $5.4 million line is where the City of Los Angeles transfer tax steps up; try the <a href="/measure-ula-calculator/">Measure ULA calculator</a>.</p>
			</div>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<span class="eyebrow">Market Context</span>
			<h2>Rates, Vacancy, and Rents</h2>
			<ul class="ctx" role="list">
				<li class="mr-anim">
					<span class="ctx__n">{TREASURY.close}%</span>
					<span class="ctx__l">10-year Treasury, {TREASURY.asOf.slice(5).replace('-', '/')}</span>
					<span class="ctx__s">Down from {TREASURY.septemberClose}% a month earlier; the 2026 low was {TREASURY.februaryLow}% in February.</span>
				</li>
				<li class="mr-anim">
					<span class="ctx__n">{C.vacancy}%</span>
					<span class="ctx__l">LA County apartment vacancy</span>
					<span class="ctx__s">Compared with {C.nationalVacancy}% nationally (CoStar, paraphrased).</span>
				</li>
				<li class="mr-anim">
					<span class="ctx__n">{C.askingRentGrowth12Mo}%</span>
					<span class="ctx__l">Asking rent growth, 12 months</span>
					<span class="ctx__s">Newer, higher-priced buildings carry more of the vacancy than older ones.</span>
				</li>
			</ul>
			<div class="narrow">
				<p>
					Lenders generally price apartment loans as a spread over Treasury yields, so the 10-year influences what buyers can afford to pay. Vacancy and rent figures are from
					CoStar's Los Angeles multifamily report of {C.reportDate} (paraphrased), and the Treasury figures come from the U.S. Department of the Treasury.
				</p>
				<p><a href={articleHref}>Read our full {period} report for the analysis behind these numbers &rarr;</a></p>
			</div>
		</div>
	</section>

	<section class="cta-band">
		<div class="container cta-band__inner">
			<div>
				<h2>What Does This Mean for Your Building?</h2>
				<p>These are market-wide medians. A free Broker Opinion of Value applies them to your building's real rents and expenses.</p>
			</div>
			<a href="/broker-opinion-of-value/" class="btn btn-gold-fill" data-cta="market-report-band-bov">Get Your Free Opinion of Value</a>
		</div>
	</section>

	<section class="section">
		<div class="container narrow">
			<span class="eyebrow">Questions</span>
			<h2>About This Report</h2>
			<div class="faq__list">
				{
					faqs.map((f) => (
						<details class="faq__item">
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))
				}
			</div>
			<p class="fine">
				This report is general market information, not legal, tax, or investment advice. Questions? Call {site.phone}.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	/* ---------- Hero ---------- */
	.mr-hero {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(circle at 85% 10%, rgb(182 148 74 / 0.28), transparent 45%),
			radial-gradient(circle at 10% 110%, rgb(255 255 255 / 0.08), transparent 40%),
			linear-gradient(135deg, var(--navy) 0%, var(--navy-dark) 100%);
		color: #fff;
		padding-block: clamp(3rem, 7vw, 5rem) clamp(5.5rem, 10vw, 7rem);
	}

	.mr-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
		background-size: 56px 56px;
