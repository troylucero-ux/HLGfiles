<script>
	// Hover and keyboard tooltips for the charts and bars.
	const tip = document.createElement('div');
	tip.className = 'mr-tip';
	tip.setAttribute('role', 'tooltip');
	tip.hidden = true;
	document.body.appendChild(tip);

	const show = (el: Element) => {
		tip.textContent = el.getAttribute('data-tip') ?? '';
		tip.hidden = false;
		const r = el.getBoundingClientRect();
		const w = tip.offsetWidth;
		let left = r.left + r.width / 2 - w / 2 + window.scrollX;
		left = Math.max(window.scrollX + 8, Math.min(left, window.scrollX + document.documentElement.clientWidth - w - 8));
		tip.style.left = `${left}px`;
		tip.style.top = `${r.top + window.scrollY - tip.offsetHeight - 10}px`;
	};
	document.querySelectorAll('[data-tip]').forEach((el) => {
		el.addEventListener('pointerenter', () => show(el));
		el.addEventListener('pointerleave', () => (tip.hidden = true));
		el.addEventListener('focus', () => show(el));
		el.addEventListener('blur', () => (tip.hidden = true));
	});

	// Fade-and-rise, and bars and lines that draw in, for blocks that start below the fold.
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (!reduceMotion && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					const el = entry.target as HTMLElement;
					el.classList.add('is-in');
					io.unobserve(el);
					window.setTimeout(() => {
						el.classList.remove('mr-armed', 'is-in');
						el.style.transitionDelay = '';
					}, 3200);
				});
			},
			{ threshold: 0.15, rootMargin: '0px 0px -6% 0px' },
		);
		const arm = () => {
			const items = Array.from(document.querySelectorAll<HTMLElement>('.mr-anim'));
			const below = items.filter((el) => el.getBoundingClientRect().top >= window.innerHeight);
			below.forEach((el, i) => {
				el.style.transitionDelay = `${(i % 4) * 90}ms`;
				el.classList.add('mr-armed');
				io.observe(el);
			});
		};
		if ('requestIdleCallback' in window) window.requestIdleCallback(arm, { timeout: 1200 });
		else window.setTimeout(arm, 250);
	}
</script>
