const leaseTypes = [
	{ type: 'Gross (full service)', tenant: 'Rent only.', landlord: 'Property taxes, insurance, and all maintenance.' },
	{ type: 'Single net (N)', tenant: 'Rent plus property taxes.', landlord: 'Insurance and maintenance.' },
	{ type: 'Double net (NN)', tenant: 'Rent plus property taxes and insurance.', landlord: 'Maintenance, usually including the roof and structure.' },
	{ type: 'Triple net (NNN)', tenant: 'Rent plus property taxes, insurance, and maintenance.', landlord: 'Often still the roof and structure, depending on the lease.' },
	{ type: 'Absolute net', tenant: 'Everything, including the roof and structure.', landlord: 'Almost nothing. The rent is paid whatever happens to the building.' },
];

// ---- Worked example 1: debt replacement, with the same math the planner below uses ----
const ex1 = (() => {
	const price = 4_000_000;
	const costs = price * 0.03;
	const netPrice = price - costs;
	const payoff = 1_200_000;
	const equity = netPrice - payoff;
	return { price, costs, netPrice, payoff, equity };
})();
const money = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;

const ex1Scenarios = [
	{
		name: 'All-cash NNN purchase',
		detail: `Buy a ${money(ex1.equity)} property with your equity and no loan.`,
		result: `Falls ${money(ex1.netPrice - ex1.equity)} short of the ${money(ex1.netPrice)} needed. The shortfall is the mortgage you paid off, which can be taxable.`,
		ok: false,
	},
	{
		name: 'One NNN purchase with a loan',
		detail: `Buy a ${money(ex1.netPrice)} property with ${money(ex1.equity)} down and a ${money(ex1.payoff)} loan (${Math.round((ex1.payoff / ex1.netPrice) * 100)}% of the price).`,
		result: 'Meets both tests: equal value and all equity reinvested.',
		ok: true,
	},
	{
		name: 'Two NNN properties',
		detail: `Buy a $2,000,000 property all cash, and a ${money(ex1.netPrice - 2_000_000)} property with ${money(ex1.equity - 2_000_000)} down and a ${money(ex1.payoff)} loan.`,
		result: 'Also meets both tests, and splits the money across two tenants. The loan on the second property is a high share of its price.',
		ok: true,
	},
	{
		name: 'A leveraged DST',
		detail: `Put ${money(ex1.equity)} into a DST whose property carries its own debt.`,
		result: 'The trust’s debt can count toward replacing yours, with no loan signed by you. Whether it is enough depends on the offering, so confirm with your intermediary and CPA.',
		ok: true,
	},
];

// ---- Worked example 2: two rent-increase structures on the same lease ----
const projectRent = (price: number, capPct: number, years: number, annualPct: number, stepPct: number) => {
	const base = price * (capPct / 100);
	const annual: number[] = [];
	const stepped: number[] = [];
	for (let y = 0; y < years; y++) {
		annual.push(base * Math.pow(1 + annualPct / 100, y));
		stepped.push(base * Math.pow(1 + stepPct / 100, Math.floor(y / 5)));
	}
	return { annual, stepped };
};
const ex2 = projectRent(3_000_000, 6, 15, 1.5, 10);
const sum = (a: number[]) => a.reduce((s, n) => s + n, 0);
const ex2Years = [1, 5, 6, 10, 11, 15];

// ---- Real exchanges from our own closed sales ----
const clientExamples = [
	{
		slug: '1136-s-alvarado-st-los-angeles-ca-90006',
		story: 'Our selling client sold this 24-unit Pico-Union building and used a 1031 exchange to move the proceeds into two triple-net properties, one in Florida and one in Georgia. The tax on the gain was fully deferred.',
		href: '/insights/1031-exchange-into-triple-net-properties/',
		cta: 'Read how it worked',
	},
	{
		slug: '707-crenshaw-blvd-los-angeles-ca-90005',
		story: 'Our selling client exchanged out of this 10-unit Koreatown building into triple-net properties.',
		href: '/1031-exchanges/',
		cta: 'See how we run an exchange',
	},
]
	.map((e) => ({ ...e, sale: closings.find((c) => c.slug === e.slug) }))
	.filter((e) => e.sale);

const nnnChecklist = [
	{ t: 'Tenant credit', d: 'Is the tenant a public company, a large franchisee, or one person? Is there a corporate or personal guarantee? The rent is only as safe as the tenant paying it.' },
	{ t: 'Time left on the lease', d: 'A lease with 15 years remaining is a different investment from one with 3. Ask about renewal options and what happens at the end.' },
	{ t: 'Rent increases', d: 'Fixed steps, annual percentages, or tied to inflation. See the projector below for how much this changes the total.' },
	{ t: 'What you still have to fix', d: 'Many NNN leases leave the roof and structure with the landlord. Ask for the roof’s age and condition.' },
	{ t: 'Property taxes after the sale', d: 'In California, a sale usually resets the assessed value. The tenant pays the tax in a NNN lease, so check how the lease handles a higher bill.' },
	{ t: 'How important the location is to the tenant', d: 'Does the store make money? Can the tenant stop operating but keep paying rent, or walk away? Is the site one the tenant would want to keep?' },
	{ t: 'Value if the tenant leaves', d: 'What is the land worth, and could another business use the building? This is your fallback.' },
	{ t: 'Environmental and physical condition', d: 'Gas stations, dry cleaners, and older buildings need extra care. Get inspections, title, and a survey.' },
];

const dstChecklist = [
	{ t: 'The sponsor', d: 'How many DSTs have they run, and how many have been sold and closed out? Ask how those turned out for investors.' },
	{ t: 'The offering document', d: 'The private placement memorandum (PPM) lists the risks, the fees, and the plan. Read the risk section first.' },
	{ t: 'Fees', d: 'Ask for every fee in dollars and percentages: upfront costs, ongoing management, and the fee when the property sells.' },
	{ t: 'Debt', d: 'How much does the trust borrow, at what rate, and when does the loan come due compared with the planned hold? A loan that matures early can force a sale.' },
	{ t: 'The property', d: 'Type, location, occupancy, leases coming up for renewal, and any big repairs ahead.' },
	{ t: 'Distributions', d: 'Are they covered by the property’s income, or by reserves? Past distributions do not promise future ones.' },
	{ t: 'Hold period and exit', d: 'How long does the sponsor expect to hold, and what happens if the market is weak when they want to sell?' },
	{ t: 'Timing and eligibility', d: 'Can the DST close inside your 45-day and 180-day deadlines, and will you pass the accredited-investor check?' },
];

const glossary = [
	{ term: 'Triple net (NNN)', def: 'A lease in which the tenant pays rent plus property taxes, insurance, and maintenance.' },
	{ term: 'Absolute net', def: 'A NNN lease that also puts the roof and structure on the tenant. Terms vary from lease to lease.' },
	{ term: 'Cap rate', def: 'The year’s net operating income divided by the price. A property that earns $180,000 and sells for $3,000,000 has a 6.0% cap rate.' },
	{ term: 'Net operating income (NOI)', def: 'The rent a property earns after operating expenses, before debt payments and income tax. In a NNN lease, the base rent is close to the NOI.' },
	{ term: 'Delaware Statutory Trust (DST)', def: 'A trust that owns real estate and sells beneficial interests to investors. The IRS treats a properly built DST interest as real estate for a 1031 exchange.' },
	{ term: 'Sponsor', def: 'The company that buys the property, creates the DST, and manages it for the investors.' },
	{ term: 'Accredited investor', def: 'Generally, a person with income over $200,000 ($300,000 with a spouse) in each of the last two years, or net worth over $1 million not counting their home, or certain securities licenses.' },
	{ term: 'Private placement memorandum (PPM)', def: 'The offering document for a DST. It describes the property, the plan, the fees, and the risks.' },
	{ term: '1031 exchange', def: 'A way to defer capital gains tax by reinvesting the proceeds of an investment property into other like-kind real estate within strict deadlines.' },
	{ term: 'Qualified intermediary (QI)', def: 'The neutral company that holds your sale proceeds during an exchange so you never touch them.' },
	{ term: 'Boot', def: 'Cash or debt relief you receive in an exchange. It can be taxable even though the rest of the gain is deferred.' },
	{ term: 'Debt replacement', def: 'Replacing the mortgage you paid off with new debt, trust-level debt in a DST, or extra cash, so the exchange does not produce boot.' },
	{ term: 'Rent escalation', def: 'A scheduled increase in a lease’s rent, either a percentage each year or a larger step every few years.' },
	{ term: 'Rollover risk', def: 'The risk that a tenant does not renew, leaving the space empty and the landlord paying for a new lease.' },
];

const faqs = [
	{
		q: 'Do you sell DSTs or NNN properties yourselves?',
		a: 'No. DST interests are securities, so they’re offered and sold by DST sponsors and securities-licensed professionals, not by our real estate team. We introduce you to those specialists and stay involved on our side of the transaction, particularly if you’re exchanging out of a property we’re selling for you.',
	},
	{
		q: 'Is this only for 1031 exchange clients?',
		a: 'Most owners we introduce to NNN and DST specialists are exchanging out of an apartment building, but you don’t need to be selling through us to ask for an introduction.',
	},
	{
		q: 'What is a triple-net (NNN) lease?',
		a: 'It is a lease in which the tenant pays rent plus the property taxes, insurance, and maintenance on the property. The landlord receives the rent with few or no operating bills, which is why NNN properties appeal to owners who want to stop managing a building.',
	},
	{
		q: 'Does "triple net" mean I have no responsibilities as the owner?',
		a: 'Not always. In many NNN leases the landlord is still responsible for the roof and structure, and you still enforce the lease, collect the rent, and deal with the tenant if something goes wrong. An absolute net lease puts nearly everything on the tenant. Read the lease, because the words "triple net" mean different things in different leases.',
	},
	{
		q: 'What is the difference between NNN and absolute net?',
		a: 'In a typical NNN lease the tenant pays taxes, insurance, and routine maintenance, while the landlord keeps the roof and structure. In an absolute net lease the tenant also covers the roof and structure, so the landlord’s responsibilities are close to none. Absolute net properties usually cost more for the same rent, because they carry less risk for the owner.',
	},
	{
		q: 'What is a Delaware Statutory Trust (DST)?',
		a: 'A DST is a trust that owns one or more properties. Investors buy beneficial interests in the trust, and a sponsor manages the property. You receive your share of the cash flow, and you make no decisions about the property. The trust is set up under Delaware law and sold as a security.',
	},
	{
		q: 'Why can a DST be used in a 1031 exchange?',
		a: 'In Revenue Ruling 2004-86, the IRS said that a beneficial interest in a properly structured DST can be treated as direct ownership of real estate, so it can be like-kind replacement property. The trust has to follow limits on what the trustee may do, which is why DSTs are built the way they are.',
	},
	{
		q: 'What are the "seven deadly sins" of a DST?',
		a: 'It is the common name for the limits that keep a DST within the IRS ruling. Generally, after the offering closes, the trustee cannot take new money from investors, renegotiate or refinance the debt, sign new leases or renegotiate existing ones, reinvest sale proceeds, make major capital improvements beyond maintenance and repairs, or hold cash beyond limited reserves. It must also pay out its cash flow. The sponsor’s documents spell out how the DST works within these limits.',
	},
	{
		q: 'Who can invest in a DST?',
		a: 'DST interests are generally offered only to accredited investors. For most individuals that means income over $200,000 ($300,000 with a spouse) in each of the last two years, or a net worth over $1 million not counting your primary residence, or certain securities licenses. A broker-dealer will verify your status.',
	},
	{
		q: 'How much do I need to invest in a DST?',
		a: 'Minimums vary by offering. Many start around $100,000, and some are lower or higher. Because the minimum is small compared with a whole building, many owners split their exchange money across several DSTs.',
	},
	{
		q: 'How is a DST different from buying an NNN property myself?',
		a: 'With an NNN property you choose the building, you own it directly, you control it, and you can use a loan. With a DST you own a share of a larger property, you cannot make decisions, and you cannot sell on your own schedule, but you have no landlord duties at all. A DST also lets you spread a smaller amount over several properties. NNN gives you control and DST gives you simplicity.',
	},
	{
		q: 'Can I use both an NNN property and a DST in the same exchange?',
		a: 'Often, yes. Many owners place part of their proceeds in a NNN property and the rest in one or more DSTs. Each replacement must be identified within the 45-day window, and the combined value and equity have to meet the exchange rules, so plan it with your qualified intermediary and CPA.',
	},
	{
		q: 'How long is my money tied up in a DST?',
		a: 'Usually for the sponsor’s planned hold, which is often 5 to 10 years, and sometimes longer. You generally cannot force a sale, and there is no ready market for the interests. Treat a DST as money you will not need back early.',
	},
	{
		q: 'What happens when the DST sells the property?',
		a: 'The trust sells and distributes the proceeds. You can take the cash and pay the deferred tax, or you can do another 1031 exchange with your share, including into another DST, if you follow the exchange rules again.',
	},
	{
		q: 'How fast can a DST close?',
		a: 'Often much faster than buying a building, sometimes within days, because the sponsor has already bought the property. That is why some owners keep a DST in mind as a backup when time is running short. It depends on the offering, so ask the sponsor about its closing timeline.',
	},
	{
		q: 'What cap rate should I expect on an NNN property?',
		a: 'It depends on the tenant’s credit, how long the lease has left, the rent increases, and the location. A strong national tenant on a long lease usually sells at a lower cap rate than a smaller operator on a short one. We don’t quote a number because it changes with the market. Compare the cap rate to the risk, not just to other cap rates.',
	},
	{
		q: 'What are the main risks of an NNN property?',
		a: 'The tenant could stop paying or file for bankruptcy. The lease could end and the space sit empty while you pay for a new tenant. Fixed rents lose buying power if inflation rises. Interest rates can affect what the property is worth if you sell. And one property means one tenant, so your income depends on a single business.',
	},
	{
		q: 'What are the main risks of a DST?',
		a: 'You cannot control the decisions or the timing of the sale. The interests are hard to sell early. Fees reduce your return. Debt inside the trust adds risk, especially if the loan comes due in a weak market. And distributions are not guaranteed. A good sponsor and a careful read of the offering document are the best protection.',
	},
	{
		q: 'Can I use a loan to buy an NNN property in an exchange?',
		a: 'Yes. In fact, if you had a mortgage on the building you sold, you may need new debt, or extra cash, so the exchange does not produce taxable boot. Our planner below shows how much replacement value and debt you would need.',
	},
	{
		q: 'What is boot, and why does mortgage payoff matter?',
		a: 'Boot is cash or debt relief you receive in an exchange, and it can be taxed. If your old mortgage is paid off at closing and your new property has less debt, the IRS can treat the difference as received. To defer all the tax you generally buy replacement property worth at least the net sale price and either take on at least as much debt or add the cash. Your intermediary and CPA will work out the numbers for you.',
	},
	{
		q: 'Do I have to buy outside California?',
		a: 'No. NNN properties and DSTs are available in many states, and many Los Angeles owners buy out of state because of the choices there. California has its own exchange reporting, and the deferred California gain generally stays taxable if you later sell the out-of-state property, so ask your CPA how it applies to you.',
	},
	{
		q: 'Is NNN income really passive?',
		a: 'It is much more passive than running an apartment building, but not hands-off. You still own the property, you collect the rent, you pay any landlord repairs, and you decide what to do when the lease ends. If you want no decisions at all, a DST or a property with an absolute net lease is closer to that.',
	},
	{
		q: 'What if I want to cash out instead of exchanging?',
		a: 'You can sell and pay the tax. Some owners also keep exchanging for life, because under current tax law the heirs of an owner who dies may receive a stepped-up basis that can reduce or erase the deferred gain. Whether that applies to you is a question for your CPA or estate attorney.',
	},
	{
		q: 'How do I choose an NNN broker or a DST sponsor?',
		a: 'Use the checklists on this page. For an NNN broker, look at their experience in the tenant’s industry and market. For a DST, look at the sponsor’s track record from start to finish, the fees, the debt, and the offering document. We introduce you to specialists and stay involved, but you make the choice, ideally with your CPA and attorney.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const toc = [
	{ href: '#compare', label: 'Compare the options' },
	{ href: '#examples', label: 'Worked examples' },
	{ href: '#tools', label: 'Free tools' },
	{ href: '#checklists', label: 'Checklists' },
	{ href: '#glossary', label: 'Glossary' },
	{ href: '#faq', label: 'FAQs' },
];
---

<BaseLayout
	title="Triple Net (NNN) & DST Guide for LA Apartment Owners"
	description="NNN and DST explained for LA apartment owners: how they compare, worked examples, free calculators for your 1031 exchange, due-diligence checklists, and FAQs."
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
	<link rel="alternate" hreflang="en" href={`${site.url}/triple-net-dst/`} slot="head" />
	<link rel="alternate" hreflang="es" href={`${site.url}/es/triple-net-dst/`} slot="head" />
	<link rel="alternate" hreflang="x-default" href={`${site.url}/triple-net-dst/`} slot="head" />
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Triple Net (NNN) & DSTs</span>
			<h1>Passive Investment Introductions: NNN and DSTs</h1>
			<p>
				Not every apartment owner wants to keep managing property after a sale. For clients exploring a 1031 exchange or a fresh investment, we
				connect you with trusted specialists in triple-net (NNN) commercial real estate and Delaware Statutory Trusts (DSTs), and stay involved
				so you're never navigating the process alone.
			</p>
			<p>
				This page explains how each option works, compares them side by side, walks through examples with real numbers, and gives you three free
				calculators to try with your own building.
			</p>
			<a href="/contact/?intent=nnn-dst" class="btn btn-gold">Talk Through Your Options</a>
			<p class="lang-link"><a href="/es/triple-net-dst/" hreflang="es" lang="es">Esta página en español &rarr;</a></p>
		</div>
	</section>

	<nav class="toc" aria-label="On this page">
		<div class="container toc__inner">
			{toc.map((t) => <a href={t.href}>{t.label}</a>)}
		</div>
	</nav>

	<section class="section">
		<div class="container">
			<span class="eyebrow">How We Help</span>
			<h2>Two Paths to a Passive Investment</h2>
			<div class="help-grid">
				{
					helpItems.map((item) => (
						<div class="help-card">
							<h3>{item.title}</h3>
							<p>{item.body}</p>
						</div>
					))
				}
			</div>
			<HowTheyWork />
		</div>
	</section>

	<section class="section section-alt" id="compare">
		<div class="container">
			<span class="eyebrow">Compare</span>
			<h2>Apartments, NNN, or a DST: How They Differ</h2>
			<p class="lead">
				After selling an apartment building, an owner can stay in apartments, buy a triple-net property, buy into a DST, or combine them. None is best
				for everyone. Here is how they compare on the questions owners ask most.
			</p>
			<div class="table-scroll">
				<table class="cmp">
					<thead>
						<tr>
							<th scope="col"></th>
							<th scope="col">Apartment building</th>
							<th scope="col">NNN property</th>
							<th scope="col">DST</th>
						</tr>
					</thead>
					<tbody>
						{
							compare.map((r) => (
								<tr>
									<th scope="row">{r.label}</th>
									<td data-label="Apartment building">{r.apt}</td>
									<td data-label="NNN property">{r.nnn}</td>
									<td data-label="DST">{r.dst}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>

			<h3 class="sub">What "Net" Means in a Lease</h3>
			<p class="lead">
				The word "net" tells you how many of the property’s costs the tenant pays. The more costs the tenant carries, the less work, and the less
				uncertainty, there is for the owner. Leases are written one at a time, so always read the one for the property you are buying.
			</p>
			<LeaseMatrix />
			<div class="table-scroll">
				<table class="cmp cmp--lease">
					<thead>
						<tr>
							<th scope="col">Lease type</th>
							<th scope="col">The tenant pays</th>
							<th scope="col">The landlord usually pays</th>
						</tr>
					</thead>
					<tbody>
						{
							leaseTypes.map((l) => (
								<tr>
									<th scope="row">{l.type}</th>
									<td data-label="The tenant pays">{l.tenant}</td>
									<td data-label="The landlord usually pays">{l.landlord}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section class="section" id="examples">
		<div class="container">
			<span class="eyebrow">Examples</span>
			<h2>Worked Examples</h2>
			<p class="lead">
				The numbers in the first two examples are made up to show how the math works. They are not offers, quotes, or market figures, and your own
				numbers will differ.
			</p>

			<h3 class="sub">Example 1: Replacing the Debt on Your Old Building</h3>
			<p>
				An owner sells a Los Angeles apartment building for <strong>{money(ex1.price)}</strong> and pays <strong>{money(ex1.costs)}</strong> (3%) in
				selling costs. A <strong>{money(ex1.payoff)}</strong> mortgage is paid off at closing. That leaves <strong>{money(ex1.equity)}</strong> in
				equity to reinvest. To defer all of the tax, the owner generally has to buy replacement property worth at least the
				<strong>{money(ex1.netPrice)}</strong> net sale price and reinvest every dollar of that equity. Here is how four approaches compare.
			</p>
			<DebtBars price={ex1.price} costs={ex1.costs} netPrice={ex1.netPrice} payoff={ex1.payoff} equity={ex1.equity} />
			<div class="scen-grid">
				{
					ex1Scenarios.map((s) => (
						<article class={s.ok ? 'scen scen--ok' : 'scen scen--no'}>
							<h4>{s.name}</h4>
							<p class="scen__detail">{s.detail}</p>
							<p class="scen__result">
								<span class="scen__tag">{s.ok ? 'Meets the tests' : 'Falls short'}</span> {s.result}
							</p>
						</article>
					))
				}
			</div>
			<p class="fine">The planner below runs this math on your own numbers.</p>

			<h3 class="sub">Example 2: Two Ways a Lease Can Raise the Rent</h3>
			<p>
				Two NNN leases can start at the same rent and still pay differently. Say a $3,000,000 property starts at a 6.0% cap rate, which is
				<strong>$180,000</strong> a year, with a 15-year lease. One lease raises the rent <strong>1.5% every year</strong>. The other raises it
				<strong>10% every five years</strong>.
			</p>
			<RentChart annual={ex2.annual} stepped={ex2.stepped} annualLabel="1.5% each year" steppedLabel="10% every 5 years" />
			<div class="table-scroll">
				<table class="cmp cmp--num">
					<thead>
						<tr>
							<th scope="col">Lease year</th>
							<th scope="col">1.5% each year</th>
							<th scope="col">10% every 5 years</th>
						</tr>
					</thead>
					<tbody>
						{
							ex2Years.map((y) => (
								<tr>
									<th scope="row">Year {y}</th>
									<td data-label="1.5% each year">{money(ex2.annual[y - 1])}</td>
									<td data-label="10% every 5 years">{money(ex2.stepped[y - 1])}</td>
								</tr>
							))
						}
						<tr class="cmp__total">
							<th scope="row">Total over 15 years</th>
							<td data-label="1.5% each year">{money(sum(ex2.annual))}</td>
							<td data-label="10% every 5 years">{money(sum(ex2.stepped))}</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p>
				Over 15 years the totals are within about 1% of each other, but the timing is not. The five-year steps pay more in the first year of each new
				period (years 6 and 11), and the yearly bumps pay more in the years just before the next step. If you plan to sell before the lease ends, the structure
				matters.
			</p>

			<h3 class="sub">Example 3: Real Exchanges From Our Own Sales</h3>
			<div class="real-grid">
				{
					clientExamples.map((e) => (
						<article class="real">
							<span class="real__tag">Sold by Highlight</span>
							<h4>{e.sale!.name}</h4>
							<p class="real__meta">
								Los Angeles{e.sale!.units ? `, ${e.sale!.units} units` : ''} · {formatPrice(e.sale!.price)}
							</p>
							<p>{e.story}</p>
							<a href={e.href}>{e.cta} &rarr;</a>
						</article>
					))
				}
			</div>
			<p class="fine">
				Every exchange is different. These are examples of what clients have done, not predictions of what you will get. See all
				<a href="/case-studies/">our case studies</a> or <a href="/1031-exchanges/">how we run a 1031 exchange</a>.
			</p>
		</div>
	</section>

	<section class="section section-alt" id="tools">
