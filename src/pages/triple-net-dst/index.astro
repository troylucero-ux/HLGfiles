		transform: rotate(-45deg);
	}

	.checks strong {
		color: var(--navy-dark);
	}

	.checks span {
		font-size: 0.9rem;
		color: var(--ink);
	}

	.gloss {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 0.75rem 2rem;
		margin: 1.5rem 0 0;
	}

	.gloss__item {
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--border);
	}

	.gloss dt {
		font-family: var(--font-serif);
		font-size: 1.1rem;
		color: var(--navy-dark);
	}

	.gloss dd {
		margin: 0.25rem 0 0;
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.faq-list {
		display: grid;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.faq-item {
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 1.15rem 1.5rem;
	}

	.faq-item summary {
		font-weight: 600;
		cursor: pointer;
		color: var(--navy-dark);
	}

	.faq-item p {
		margin-top: 0.75rem;
		margin-bottom: 0;
		line-height: 1.7;
	}

	.faq-cta {
		margin-top: 1.5rem;
		font-size: 0.9rem;
	}

	.disclaimer {
		margin-top: 2rem;
		max-width: 820px;
	}

	@media (max-width: 820px) {
		.tool__body {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* On a phone, the comparison tables turn into stacked cards so nothing needs sideways scrolling. */
	@media (max-width: 700px) {
		.table-scroll {
			border: none;
			background: none;
			overflow: visible;
		}

		.cmp,
		.cmp--lease {
			min-width: 0;
		}

		.cmp thead {
			display: none;
		}

		.cmp,
		.cmp tbody,
		.cmp tr,
		.cmp th,
		.cmp td {
			display: block;
			width: 100%;
		}

		.cmp tr {
			background: #fff;
			border: 1px solid var(--border);
			margin-bottom: 0.75rem;
		}

		.cmp tbody th {
			width: 100%;
			border-bottom: 1px solid var(--border);
		}

		.cmp td {
			border-bottom: 1px solid var(--border);
		}

		.cmp td::before {
			content: attr(data-label);
			display: block;
			font-size: 0.68rem;
			font-weight: 800;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--gold-dark);
			margin-bottom: 0.15rem;
		}
	}
</style>

<script>
	// Three simple calculators. They run entirely in the browser and send nothing anywhere except a count that a calculator was used.
	const fmtMoney = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
	const fmtPct = (n: number, d = 1) => `${n.toFixed(d)}%`;
	const num = (s: string | undefined | null) => {
		const v = parseFloat(String(s ?? '').replace(/[^0-9.]/g, ''));
		return isFinite(v) ? v : 0;
	};
	const field = (id: string) => document.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-id="${id}"]`)!;
	const out = (name: string) => document.querySelector<HTMLElement>(`[data-out="${name}"]`)!;

	// Show thousands separators in the dollar boxes once the visitor leaves them.
	document.querySelectorAll<HTMLInputElement>('input.money').forEach((el) => {
		el.addEventListener('blur', () => {
			el.value = num(el.value).toLocaleString('en-US');
		});
	});

	const used = new Set<string>();
	let ready = false; // stays false while the page sets up, so loading the page does not count as using a calculator
	const track = (tool: string) => {
		if (!ready || used.has(tool)) return;
		used.add(tool);
		(window as unknown as { gtag?: (...args: unknown[]) => void }).gtag?.('event', 'calculator_use', {
			calculator: tool,
			page_path: window.location.pathname,
		});
	};

	// ---- 1. Exchange planner ----
	function planner() {
		const price = num(field('p-price').value);
		const payoff = num(field('p-payoff').value);
		const costPct = num(field('p-costs').value);
		const cash = num(field('p-cash').value);
		const box = out('planner');
		if (price <= 0) {
			box.innerHTML = '<p class="out-warn">Enter an expected sale price.</p>';
			return;
		}
		const costs = price * (costPct / 100);
		const netPrice = price - costs;
		const equity = netPrice - payoff - cash;
		if (equity < 0) {
			box.innerHTML = '<p class="out-warn">The mortgage and cash out are more than your net sale price. Lower one of them.</p>';
			return;
		}
		const debtNeeded = payoff + cash;
		const ltv = netPrice > 0 ? (debtNeeded / netPrice) * 100 : 0;
		const short = netPrice - equity;
		box.innerHTML = `
			<span class="out-label">To defer all of the gain, buy at least</span>
			<span class="out-big">${fmtMoney(netPrice)}</span>
			<span class="out-label">Equity to reinvest</span>
			<span class="out-big">${fmtMoney(equity)}</span>
			<span class="out-label">Debt or added cash to replace</span>
			<span class="out-big">${fmtMoney(debtNeeded)}</span>
			<p class="out-note">
				Selling costs: ${fmtMoney(costs)}. ${debtNeeded > 0 ? `If you buy at the minimum price, that is a loan of about ${fmtPct(ltv, 0)} of the price, or the same amount in extra cash, or debt inside a DST.` : 'With no mortgage and no cash taken out, you do not need replacement debt.'}
			</p>
			<p class="out-note">
				${short > 0 ? `<strong>An all-cash purchase with your equity alone</strong> would be ${fmtMoney(equity)}, which is ${fmtMoney(short)} short. That shortfall can be taxable boot.${cash > 0 ? ` The ${fmtMoney(cash)} you take out is taxable boot too.` : ''}` : `<strong>An all-cash purchase</strong> of ${fmtMoney(equity)} would meet the minimum, because you have no mortgage to replace.`}
			</p>`;
		track('exchange_planner');
	}

	// ---- 2. NNN rent projector ----
	function projector() {
		const price = num(field('r-price').value);
		const cap = num(field('r-cap').value);
		const years = parseInt((field('r-years') as HTMLSelectElement).value, 10) || 15;
		const annualPct = num(field('r-annual').value);
		const stepPct = num(field('r-step').value);
		const box = out('projector');
		if (price <= 0 || cap <= 0) {
			box.innerHTML = '<p class="out-warn">Enter a price and a cap rate.</p>';
			return;
		}
		const base = price * (cap / 100);
		const rowsA: number[] = [];
		const rowsB: number[] = [];
		for (let y = 0; y < years; y++) {
			rowsA.push(base * Math.pow(1 + annualPct / 100, y));
			rowsB.push(base * Math.pow(1 + stepPct / 100, Math.floor(y / 5)));
		}
		const sum = (a: number[]) => a.reduce((s, n) => s + n, 0);
		const totalA = sum(rowsA);
		const totalB = sum(rowsB);
		const body = rowsA
			.map((a, i) => `<tr><td>Year ${i + 1}</td><td>${fmtMoney(a)}</td><td>${fmtMoney(rowsB[i])}</td></tr>`)
			.join('');
		box.innerHTML = `
			<span class="out-label">Year 1 rent</span>
			<span class="out-big">${fmtMoney(base)} <small style="font-size:0.9rem;font-family:inherit">(${fmtMoney(base / 12)} a month)</small></span>
			<div class="out-scroll">
				<table class="out-table">
					<thead><tr><th>Lease year</th><th>${fmtPct(annualPct, 1)} each year</th><th>${fmtPct(stepPct, 1)} every 5 years</th></tr></thead>
					<tbody>${body}</tbody>
					<tfoot><tr><td>Total, ${years} years</td><td>${fmtMoney(totalA)}</td><td>${fmtMoney(totalB)}</td></tr>
					<tr><td>Average yearly yield on price</td><td>${fmtPct((totalA / years / price) * 100, 2)}</td><td>${fmtPct((totalB / years / price) * 100, 2)}</td></tr></tfoot>
				</table>
			</div>
			<p class="out-note">
				This shows base rent only, before any loan payments, vacancy at the end of the lease, or income tax. If the tenant does not renew, rent stops
				until a new tenant signs.
			</p>`;
		track('nnn_projector');
	}

	// ---- 3. Income match ----
	function incomeMatch() {
		const equity = num(field('m-equity').value);
		const income = num(field('m-income').value);
		const nnn = num(field('m-nnn').value);
		const dst = num(field('m-dst').value);
		const box = out('match');
		if (equity <= 0) {
			box.innerHTML = '<p class="out-warn">Enter the equity you plan to reinvest.</p>';
			return;
		}
		const need = (income / equity) * 100;
		const nnnIncome = equity * (nnn / 100);
		const dstIncome = equity * (dst / 100);
		const row = (label: string, value: number) => {
			const diff = value - income;
			return `<tr><td>${label}</td><td>${fmtMoney(value)}</td><td>${diff >= 0 ? '+' : '−'}${fmtMoney(Math.abs(diff))}</td></tr>`;
		};
		const needNnn = nnn > 0 ? income / (nnn / 100) : 0;
		const needDst = dst > 0 ? income / (dst / 100) : 0;
		box.innerHTML = `
			<span class="out-label">Yield needed to match your income</span>
			<span class="out-big">${fmtPct(need, 2)}</span>
			<table class="out-table">
				<thead><tr><th>Option</th><th>Income a year</th><th>vs. today</th></tr></thead>
				<tbody>
					${row(`NNN at ${fmtPct(nnn, 2)}`, nnnIncome)}
					${row(`DST at ${fmtPct(dst, 2)}`, dstIncome)}
				</tbody>
			</table>
			<p class="out-note">
				To match ${fmtMoney(income)} a year you would need about ${nnn > 0 ? fmtMoney(needNnn) : 'n/a'} invested at the NNN rate, or about
				${dst > 0 ? fmtMoney(needDst) : 'n/a'} at the DST rate. ${need > Math.max(nnn, dst) ? 'Your building may be paying more than these passive rates, so the trade is usually between income and effort, not just income.' : ''}
			</p>`;
		track('income_match');
	}

	const wire = (ids: string[], fn: () => void) => {
		ids.forEach((id) => {
			const el = field(id);
			el.addEventListener('input', fn);
			el.addEventListener('change', fn);
		});
		fn();
	};
	wire(['p-price', 'p-payoff', 'p-costs', 'p-cash'], planner);
	wire(['r-price', 'r-cap', 'r-years', 'r-annual', 'r-step'], projector);
	wire(['m-equity', 'm-income', 'm-nnn', 'm-dst'], incomeMatch);
	ready = true;
</script>
