---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BOVForm from '../../components/BOVForm.astro';
import { site } from '../../data/site';
import { submarkets } from '../../data/submarkets';
import { SALES_STATS, AGE_BRACKETS, AGE_GROUP_LABELS, MIN_CAP_RATE_COMPS, VALUATION_DATA_AS_OF, VALUATION_DATA_PERIOD } from '../../data/valuationAssumptions';

const submarketNames = Object.fromEntries(submarkets.map((sm) => [sm.slug, sm.name]));
// Santa Monica, West Hollywood, and Beverly Hills have their own rent control, so the LA RSO wording is dropped for them.
const ownCitySlugs = submarkets.filter((sm) => sm.city).map((sm) => sm.slug);
---

<BaseLayout
	title="How Much Is My Apartment Building Worth? Free LA Calculator"
	description="How much is your LA apartment building worth? Get an estimate in seconds, based on real 2026 LA County multifamily sales, not a generic estimate."
	image="/images/social/og-property-value-v2.webp"
>
	<section class="calc-hero">
		<svg class="calc-hero__skyline" viewBox="0 0 1200 200" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
			<path
				d="M0 200V150h40v-30h50v30h30V90h60v60h40v-40h55v40h35V60h70v90h40v-50h50v50h45V80h65v70h40v-35h60v35h35V45h80v105h40v-60h55v60h45v-30h60v30h40V100h55v50h40v-25h50v25H1200v50z"
			/>
		</svg>
		<div class="container calc-hero__inner">
			<span class="calc-hero__eyebrow">Free Tool</span>
			<h1>How Much Is Your Apartment Building Worth?</h1>
			<p class="calc-hero__lede">
				Enter your rent roll and see a value range in about 30 seconds, built from real, recently closed apartment sales in your neighborhood, not a generic online guess.
			</p>
			<ul class="calc-hero__chips" role="list">
				<li>Real 2026 LA County sales</li>
				<li>{submarkets.length} neighborhoods</li>
				<li>No contact info needed</li>
			</ul>
		</div>
	</section>

	<section class="calc-main">
		<div class="container calc-grid">
			<div class="calc-card">
				<div class="calc-card__head">
					<h2>Get Your Estimate</h2>
					<p>Four quick answers. Nothing to sign up for.</p>
				</div>
				<form id="valuation-form">
					<div class="calc-field">
						<label for="val-address">
							<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 18s6-5.2 6-10a6 6 0 10-12 0c0 4.8 6 10 6 10z" /><circle cx="10" cy="8" r="2.2" /></svg>
							Property Address
						</label>
						<input id="val-address" name="address" type="text" placeholder="123 Main St, Los Angeles, CA" data-california-only="true" required />
						<p id="val-address-error" class="calc-error" role="alert" hidden></p>
					</div>

					<div class="calc-row">
						<div class="calc-field">
							<label for="val-submarket">
								<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 17V8l7-5 7 5v9h-5v-5H8v5z" /></svg>
								Neighborhood
							</label>
							<select id="val-submarket" name="submarket" required>
								<option value="" disabled selected>Select your neighborhood</option>
								{
									submarkets.map((sm) => (
										<option value={sm.slug}>{sm.name}</option>
									))
								}
								<option value="other">Other / Not Listed</option>
							</select>
						</div>
						<div class="calc-field">
							<label for="val-year">
								<svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4" width="14" height="13" rx="2" /><path d="M3 8h14M7 2v4M13 2v4" /></svg>
								Year Built
							</label>
							<input id="val-year" name="yearBuilt" type="number" inputmode="numeric" min="1880" max="2026" placeholder="1985" required />
						</div>
					</div>

					<div class="calc-row">
						<div class="calc-field">
							<label for="val-rent">
								<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5" /><path d="M10 6v8M12.2 7.6c-.6-.6-1.4-.9-2.2-.9-1.2 0-2.1.6-2.1 1.5 0 2.1 4.4.9 4.4 3 0 .9-.9 1.5-2.2 1.5-.9 0-1.7-.3-2.3-.9" /></svg>
								Total Monthly Rent Collected
							</label>
							<div class="calc-money">
								<span aria-hidden="true">$</span>
								<input id="val-rent" name="monthlyGrossRents" type="number" inputmode="numeric" min="0" placeholder="12,000" required />
							</div>
							<span class="calc-field__hint">Across all units, what you actually collect today, not asking or market rent.</span>
						</div>
						<div class="calc-field">
							<label for="val-units">
								<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 17V4h8v13M12 8h4v9M7 7h2M7 10h2M7 13h2" /></svg>
								Number of Units <span class="calc-field__optional">(optional)</span>
							</label>
							<input id="val-units" name="units" type="number" inputmode="numeric" min="1" placeholder="8" />
						</div>
					</div>

					<button type="submit" class="calc-submit">See My Estimated Value</button>
					<p class="calc-disclaimer">
						This is an automated estimate for informational purposes only. It is not an appraisal and does not account for your property's
						condition, unit mix, deferred maintenance, or upside potential.
					</p>
				</form>

				<div id="valuation-loading" class="calc-loading" hidden role="status" aria-live="polite">
					<span class="eyebrow">Working on it</span>
					<p class="calc-loading__step" id="loading-step">Checking your address</p>
					<div class="calc-loading__bar" aria-hidden="true"><span id="loading-bar"></span></div>
					<ul class="calc-loading__done" id="loading-done" aria-hidden="true"></ul>
				</div>

				<div id="valuation-result" class="calc-result" hidden>
					<span class="eyebrow" id="result-eyebrow">Estimated Value</span>
					<p class="calc-result__range" id="result-range"></p>
					<div class="calc-result__scale" aria-hidden="true"><span></span></div>
					<p class="calc-result__based-on" id="result-based-on"></p>
					<p class="calc-result__ppu" id="result-ppu" hidden></p>
					<details class="calc-result__detail" id="result-details">
						<summary>How we calculated this</summary>
						<p id="result-methodology"></p>
						<p>
							This estimate is built from your total rent and market averages. It does not take into consideration your property's unit mix,
							condition, deferred maintenance, or upside potential, and it is not an appraisal.
						</p>
					</details>
					<p class="calc-result__precise" id="result-precise">For a more precise number from a broker, click the button below.</p>
					<a href="#bov-form" class="calc-submit calc-result__cta">Get a Precise Number From a Broker &rarr;</a>
				</div>
			</div>

			<aside class="calc-aside" aria-label="About this calculator">
				<div class="calc-panel">
					<h2>How It Works</h2>
					<ol class="calc-steps">
						<li>
							<span>1</span>
							<div>
								<strong>Tell us about the building</strong>
								<p>Address, neighborhood, year built, and the rent you collect each month.</p>
							</div>
						</li>
						<li>
							<span>2</span>
							<div>
								<strong>We match real sales</strong>
								<p>We look at buildings of a similar age that closed in your neighborhood this year.</p>
							</div>
						</li>
						<li>
							<span>3</span>
							<div>
								<strong>You see a value range</strong>
								<p>Based on the cap rates those buildings sold at, with the number of sales shown.</p>
							</div>
						</li>
					</ol>
				</div>

				<div class="calc-panel calc-panel--dark">
					<h2>Want a Person, Not a Formula?</h2>
					<p>A calculator can't see your unit mix, condition, or upside. A free Broker Opinion of Value can.</p>
					<a href="/broker-opinion-of-value/" class="calc-panel__btn">See How a Broker Opinion Works</a>
					<a class="calc-panel__call" href={`tel:+1${site.phone.replace(/\D/g, '')}`}>Or call {site.phone}</a>
				</div>

				<p class="calc-aside__note">Sales data as of {VALUATION_DATA_AS_OF}. Counts shown with every estimate.</p>
			</aside>
		</div>
	</section>

	<section class="section section-alt" id="bov-form">
		<div class="container">
			<BOVForm
				heading="Want a More Precise Valuation?"
				subheading="A calculator can't see your unit mix, condition, or upside. A free Broker Opinion of Value from Highlight Multifamily Group can."
			/>
		</div>
	</section>
</BaseLayout>

<script define:vars={{ salesStats: SALES_STATS, submarketNames, ownCitySlugs, ageGroupLabels: AGE_GROUP_LABELS, ageBrackets: AGE_BRACKETS, minComps: MIN_CAP_RATE_COMPS, dataPeriod: VALUATION_DATA_PERIOD }}>
	function formatDollar(n) {
		if (n >= 1000000) return `$${(n / 1000000).toFixed(n % 1000000 === 0 ? 0 : 2)}M`;
		return `$${Math.round(n).toLocaleString('en-US')}`;
	}

	function bracketForYear(yearBuilt) {
		if (yearBuilt < 1935) return ageBrackets.pre1935;
		return yearBuilt < 1978 ? ageBrackets.rso : ageBrackets.ab1482;
	}

	// RSO (pre-1978) and 1978-or-newer buildings trade at different cap rates, so each is priced off
	// its own comps, and only from the selected submarket's own sales. There is no LA County
	// fallback: with too few cap rates reported, no estimate is shown.
	function capRateFor(submarket, group) {
		const local = submarket ? salesStats[submarket]?.[group]?.capRate : null;
		return local && local.compCount >= minComps ? local : null;
	}

	const form = document.getElementById('valuation-form');
	const result = document.getElementById('valuation-result');
	document.getElementById('val-address')?.addEventListener('input', () => {
		document.getElementById('val-address-error').hidden = true;
	});

	// Does a typed address say it is in California? California ZIP codes run from 90001 to 96162.
	function californiaStatus(address) {
		const zip = address.match(/(?:,|\s)(\d{5})(?:-\d{4})?\s*(?:,\s*(?:USA|US))?\s*$/)?.[1];
		if (zip) return zip >= '90001' && zip <= '96162' ? 'ca' : 'outside';
		if (/\bCA\b/.test(address) || /\bCalifornia\b/i.test(address)) return 'ca';
		if (new RegExp(',\\s*(AL|AK|AZ|AR|CO|CT|DE|FL|GA|HI|ID|IL|IN|IA|KS|KY|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY|DC)\\b').test(address) || new RegExp(',\\s*(Texas|Nevada|Arizona|Oregon|Washington|Florida|New York|Colorado|Utah|Idaho|Georgia|Illinois|Louisiana|Oklahoma|Tennessee|Hawaii|New Mexico|Montana)\\b', 'i').test(address)) return 'outside';
		return 'unknown';
	}

	// A short "working" sequence, then the result with the range counting up. Skipped for visitors who
	// ask their device for reduced motion.
	const loading = document.getElementById('valuation-loading');
	const loadingStep = document.getElementById('loading-step');
	const loadingBar = document.getElementById('loading-bar');
	const loadingDone = document.getElementById('loading-done');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const STEP_MS = 610; // 4 steps x 610 ms + 250 ms closing pause = about 2.7 seconds
	const COUNT_MS = 1300;

	function revealResult(range) {
		const rangeEl = document.getElementById('result-range');
		const finalText = rangeEl.textContent;
		// Start the count-up from zero before the card is shown, so the final number never flashes first.
		if (range && !reduceMotion) rangeEl.textContent = '$0 - $0';
		result.hidden = false;
		result.classList.remove('calc-result--in');
		void result.offsetWidth;
		result.classList.add('calc-result--in');
		result.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
		const submitBtn = form.querySelector('button[type="submit"]');
		if (submitBtn) {
			submitBtn.disabled = false;
			submitBtn.textContent = 'See My Estimated Value';
		}
		form.dataset.busy = '0';
		if (!range || reduceMotion) return;
		const start = performance.now();
		function tick(now) {
			const t = Math.min(1, (now - start) / COUNT_MS);
			const eased = 1 - Math.pow(1 - t, 3);
			rangeEl.textContent =
				t >= 1 ? finalText : `${formatDollar(range.valueLow * eased)} - ${formatDollar(range.valueHigh * eased)}`;
			if (t < 1) requestAnimationFrame(tick);
		}
		requestAnimationFrame(tick);
		// Safety net: if the browser pauses animation frames (hidden tab), still end on the real number.
		setTimeout(() => {
			rangeEl.textContent = finalText;
		}, COUNT_MS + 600);
	}

	function showResultAfterLoading(steps, range) {
		if (reduceMotion) {
			revealResult(null);
			return;
		}
		form.dataset.busy = '1';
		const submitBtn = form.querySelector('button[type="submit"]');
		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = 'Calculating...';
		}
		result.hidden = true;
		loadingDone.innerHTML = '';
		loadingBar.style.width = '0%';
		loading.hidden = false;
		loading.scrollIntoView({ behavior: 'smooth', block: 'center' });
		let i = 0;
		function next() {
			if (i > 0) {
				const li = document.createElement('li');
				li.textContent = steps[i - 1];
				loadingDone.appendChild(li);
			}
			if (i >= steps.length) {
				loadingBar.style.width = '100%';
				setTimeout(() => {
					loading.hidden = true;
					revealResult(range);
				}, 250);
				return;
			}
			loadingStep.textContent = steps[i] + '...';
			loadingBar.style.width = `${Math.round(((i + 0.6) / steps.length) * 100)}%`;
			i += 1;
			setTimeout(next, STEP_MS);
		}
		next();
	}

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (form.dataset.busy === '1') return;
		const data = Object.fromEntries(new FormData(form).entries());
		const address = String(data.address ?? '').trim();
		const submarketSlug = String(data.submarket ?? '');
		const yearBuilt = Number(data.yearBuilt);
		const monthlyRent = Number(data.monthlyGrossRents);
		const units = data.units ? Number(data.units) : null;

		if (!address || !yearBuilt || !monthlyRent) return;

		// The calculator only has California sales data. Ask for a California address before doing anything else.
		const caStatus = californiaStatus(address);
		const addressError = document.getElementById('val-address-error');
		if (caStatus !== 'ca') {
			addressError.textContent =
				caStatus === 'outside'
					? 'This calculator only covers properties in California. For a property in another state, request a free Broker Opinion of Value below and we will help.'
					: 'Please include the city and state in the address, for example: 123 Main St, Los Angeles, CA.';
			addressError.hidden = false;
			result.hidden = true;
			document.getElementById('val-address')?.focus();
			return;
		}
		addressError.hidden = true;

		const bracket = bracketForYear(yearBuilt);
		const ageGroup = yearBuilt < 1978 ? 'rso' : 'post1978';
		const areaName = submarketNames[submarketSlug] ?? null;
		const capRate = capRateFor(submarketSlug, ageGroup);
		const annualGrossRent = monthlyRent * 12;

		const rangeEl = document.getElementById('result-range');
		const basedOnEl = document.getElementById('result-based-on');
		const ppuEl = document.getElementById('result-ppu');
		const detailsEl = document.getElementById('result-details');
		let valueLow = null;
		let valueHigh = null;

		if (capRate) {
			// Low end pairs the higher expense ratio with the higher cap rate (the conservative case);
			// high end pairs the lower expense ratio with the lower cap rate (the optimistic case).
			const noiLow = annualGrossRent * (1 - bracket.expenseRatioHigh);
			const noiHigh = annualGrossRent * (1 - bracket.expenseRatioLow);
			valueLow = noiLow / capRate.high;
			valueHigh = noiHigh / capRate.low;

			rangeEl.textContent = `${formatDollar(valueLow)} - ${formatDollar(valueHigh)}`;
			rangeEl.classList.remove('calc-result__range--none');
			basedOnEl.textContent = `Based on ${capRate.compCount.toLocaleString('en-US')} sales of apartment buildings ${ageGroupLabels[ageGroup].short} in ${areaName} in 2026.`;

			if (units && units > 0) {
				ppuEl.textContent = `That's roughly ${formatDollar(valueLow / units)} - ${formatDollar(valueHigh / units)} per unit.`;
				ppuEl.hidden = false;
			} else {
				ppuEl.hidden = true;
			}

			document.getElementById('result-methodology').textContent =
				`We estimated a net operating income range using an expense ratio of ${Math.round(bracket.expenseRatioLow * 100)}%-${Math.round(
					bracket.expenseRatioHigh * 100
				)}% (typical for ${ownCitySlugs.includes(submarketSlug) ? bracket.label.replace(/, under .*$/, '') : bracket.label}), then capitalized it using a ${(capRate.low * 100).toFixed(2)}%-${(capRate.high * 100).toFixed(
					2
				)}% cap rate range from ${capRate.compCount} ${areaName} sales of apartment buildings ${ageGroupLabels[ageGroup].short}, ${dataPeriod}.`;
			detailsEl.hidden = false;
			document.getElementById('result-precise').textContent = 'For a more precise number from a broker, click the button below.';
		} else {
			rangeEl.textContent = 'Not enough data for an estimated range';
			rangeEl.classList.add('calc-result__range--none');
			basedOnEl.textContent = areaName
				? `We don't have enough recent ${areaName} sales of apartment buildings ${ageGroupLabels[ageGroup].short} to give you a reliable range.`
				: "We don't yet publish estimates for neighborhoods outside the ones listed.";
			ppuEl.hidden = true;
			detailsEl.hidden = true;
			document.getElementById('result-precise').textContent = 'For a value you can rely on, request a free Broker Opinion of Value from a broker below.';
		}

		// Steps shown while "working". They describe what the calculator actually does with the visitor's inputs.
		const steps = capRate
			? [
					'Checking your address',
					`Reviewing ${capRate.compCount.toLocaleString('en-US')} ${areaName} sales from 2026`,
					'Estimating your net operating income',
					'Calculating your value range',
				]
			: ['Checking your address', `Looking for recent ${areaName ?? 'neighborhood'} sales`, 'Checking whether there is enough data'];
		showResultAfterLoading(steps, capRate ? { valueLow, valueHigh } : null);

		// Prefill the BOV form below so a visitor who wants a precise number doesn't have to retype it.
		const bovAddress = document.querySelector('.js-bov-form input[name="address"]');
		const bovRent = document.querySelector('.js-bov-form input[name="monthlyGrossRents"]');
		const fromGoogle = form.dataset.googleAddress === address && address !== '';
		if (bovAddress) {
			bovAddress.value = address;
			// An address already chosen from Google's suggestions needs no second check in the form below.
			const bovForm = bovAddress.closest('form');
			if (bovForm) {
				if (fromGoogle) bovForm.dataset.googleAddress = address;
				else delete bovForm.dataset.googleAddress;
			}
		}
		if (bovRent) bovRent.value = data.monthlyGrossRents;

		// Counts as a lead in Google Analytics (and for ads). Only the page and the neighborhood group are sent, never the address or rents.
		if (typeof window.gtag === 'function') {
			window.gtag('event', 'generate_lead', {
				form_name: 'value_calculator',
				page_path: window.location.pathname,
				area: areaName || 'Other / Not Listed',
			});
		}

		// Log every submission to Pipedrive, even if the visitor never requests a full BOV, so it
		// can be followed up on directly. Fire-and-forget: never blocks or fails the visitor's result.
		fetch('/api/valuation-lead', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({
				address,
				addressSource: fromGoogle ? 'google' : undefined,
				submarket: areaName ?? 'Other / Not Listed',
				monthlyGrossRents: data.monthlyGrossRents,
				yearBuilt: String(yearBuilt),
				units: units ? String(units) : undefined,
				estimateLow: capRate ? formatDollar(valueLow) : undefined,
				estimateHigh: capRate ? formatDollar(valueHigh) : undefined,
				compCount: capRate ? String(capRate.compCount) : undefined,
				compArea: capRate ? `${areaName} (${ageGroupLabels[ageGroup].short})` : undefined,
				source: typeof window.hlgSource === "function" ? window.hlgSource() : undefined,
			}),
		}).catch(() => {});
	});
</script>

<style>
	/* ---- Hero ---- */
	.calc-hero {
		position: relative;
		overflow: hidden;
		color: #fff;
		background: radial-gradient(120% 140% at 85% 0%, #1c5b99 0%, var(--navy) 38%, var(--navy-dark) 100%);
		padding-block: clamp(3rem, 7vw, 5rem) clamp(6.5rem, 12vw, 9rem);
	}

	.calc-hero__skyline {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		width: 100%;
		height: 58%;
		fill: rgb(255 255 255 / 0.07);
		pointer-events: none;
	}

	.calc-hero__inner {
		position: relative;
	}

	.calc-hero__eyebrow {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--gold-light);
		border: 1px solid rgb(255 255 255 / 0.25);
		border-radius: 999px;
		padding: 0.35rem 0.9rem;
		margin-bottom: 1.25rem;
	}

	.calc-hero h1 {
		color: #fff;
		max-width: 820px;
		margin: 0 0 1rem;
	}

	.calc-hero__lede {
		max-width: 640px;
		font-size: clamp(1.02rem, 1.6vw, 1.2rem);
		line-height: 1.65;
		color: #d7e0ea;
		margin: 0 0 1.75rem;
	}

	.calc-hero__chips {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
	}

	.calc-hero__chips li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: #fff;
		background: rgb(255 255 255 / 0.1);
		border: 1px solid rgb(255 255 255 / 0.18);
		border-radius: 999px;
		padding: 0.45rem 1rem 0.45rem 0.8rem;
		backdrop-filter: blur(2px);
	}

	.calc-hero__chips li::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--gold);
		flex: none;
	}

	/* ---- Main: form card overlaps the hero ---- */
	.calc-main {
		position: relative;
		padding-bottom: clamp(3rem, 6vw, 5rem);
	}

	.calc-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
		gap: clamp(1.25rem, 3vw, 2.25rem);
		align-items: start;
		margin-top: calc(-1 * clamp(4rem, 8vw, 6rem));
	}

	.calc-card {
		background: #fff;
		border: 1px solid var(--border);
		border-radius: 14px;
		box-shadow: 0 24px 60px -24px rgb(12 46 80 / 0.35), 0 2px 6px rgb(12 46 80 / 0.06);
		padding: clamp(1.5rem, 3.5vw, 2.5rem);
		position: relative;
