---
import BaseLayout from '../layouts/BaseLayout.astro';
import BOVForm from '../components/BOVForm.astro';
import { site } from '../data/site';
import { closings } from '../data/closings';
import { submarkets } from '../data/submarkets';
import { testimonials, press } from '../data/site';
import fs from 'node:fs';
import { formatPrice } from '../lib/format';
import { MARKET_UPDATE as MU } from '../data/marketUpdate';
import { posts } from '../data/posts';

const notableSales = closings.filter((c) => c.city === 'Los Angeles').slice(0, 6);

// Small thumbnails for the homepage cards (the full-size photos are several times heavier). Falls back to the original if no thumbnail exists.
const cardImage = (sale: (typeof closings)[number]) =>
	fs.existsSync(`public/images/home-cards/${sale.slug}.webp`) ? `/images/home-cards/${sale.slug}.webp` : sale.images?.[0];

// Selected closings for the scrolling strip: California apartment sales, highest first.
const stripSales = closings.filter((c) => c.state === 'CA' && c.type === 'apartment' && c.units).slice(0, 14);

// Homepage market snapshot, drawn from the same generated data as the quarterly market update article.
const snapshot = [
	{ num: MU.headline.all.sales.toLocaleString('en-US'), label: 'LA County apartment sales' },
	{ num: `$${MU.headline.older.pricePerUnit.toLocaleString('en-US')}`, label: 'Median price per unit, older buildings' },
	{ num: `${MU.headline.older.capRateMedian.toFixed(2)}%`, label: 'Median cap rate, older buildings' },
	{ num: `${MU.asking.medianPct}%`, label: 'Median sale price as a share of asking' },
];

const insightSlugs = [
	'la-apartment-market-update-q3-2026',
	'sb-721-balcony-inspection-los-angeles-apartment-owners',
	'air-conditioning-law-los-angeles-apartment-owners-electrical-panel',
	'inherited-apartment-building-los-angeles-what-to-do',
];
const latestInsights = insightSlugs.map((slug) => posts.find((p) => p.slug === slug)).filter((p) => p !== undefined);

const services = [
	{
		title: 'Multifamily Sales',
		body: 'Full-cycle representation for apartment building sellers and buyers across the LA Metro Area, from pricing strategy through close of escrow.',
	},
	{
		title: '1031 Exchanges',
		body: 'Exchange strategy and execution for owners moving equity between multifamily assets, including cross-market and out-of-state replacement properties.',
	},
	{
		title: 'Trust & Estate / Probate Sales',
		body: 'Calm, informed guidance for trustees, executors, and families selling inherited apartment property.',
	},
	{
		title: 'Land for Development',
		body: 'Positioning and marketing of development sites, backed by zoning analysis and highest-and-best-use underwriting.',
	},
	{
		title: 'Broker Opinion of Value',
		body: 'A free, no-pressure BOV grounded in real closed comps, not guesswork.',
	},
	{
		title: 'Triple Net (NNN) & DSTs',
		body: 'Introductions to trusted NNN brokers and DST professionals for owners exchanging into a passive, zero-management investment.',
	},
];
---

<BaseLayout
	title="LA Multifamily Broker | Highlight Multifamily Group"
	description="Highlight Multifamily Group: LA multifamily brokers advising apartment owners on sales, 1031 exchanges, and trust sales. 1,390+ units, $345M+ closed."
>
	<link slot="head" rel="preload" as="image" href="/images/hero/453-s-gramercy-pl-hero.webp" media="(min-width: 701px)" />
	<link slot="head" rel="preload" as="image" href="/images/hero/453-s-gramercy-pl-hero-mobile.webp" media="(max-width: 700px)" />

	<section class="hero">
		<div class="hero__bg" aria-hidden="true"></div>
		<div class="container hero__inner">
			<span class="eyebrow">Los Angeles Metro Area</span>
			<h1>Apartment Building<br />Sales Experts</h1>
			<p class="hero__sub">
				Los Angeles apartment owners hire us to price, market, and sell their buildings. Start with a free Broker Opinion of Value built from real closed
				comps, not guesswork.
			</p>
			<form class="hero__form js-hero-form" action="/contact/" method="get">
				<input type="hidden" name="intent" value="bov" />
				<label for="hero-address" class="visually-hidden">Your building's address</label>
				<input id="hero-address" class="hero__input" type="text" placeholder="Your building's address" autocomplete="street-address" />
				<button type="submit" class="btn btn-gold">Get a Free Opinion of Value</button>
			</form>
			<div class="hero__actions">
				<a href="/closed-sales/" class="hero__link">See Our Closed Sales &rarr;</a>
			</div>
		</div>
		<a href="/case-studies/453-s-gramercy-pl-koreatown-apartments/" class="hero__credit">453 S Gramercy Pl, Koreatown, sold by Highlight</a>
	</section>

	<section class="stat-bar">
		<div class="container stat-bar__grid">
			<div class="stat-bar__item">
				<svg class="stat-bar__icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<rect x="7" y="6" width="18" height="24" rx="1" />
					<rect x="11" y="10" width="3" height="3" />
					<rect x="18" y="10" width="3" height="3" />
					<rect x="11" y="16" width="3" height="3" />
					<rect x="18" y="16" width="3" height="3" />
					<rect x="11" y="22" width="3" height="3" />
					<rect x="18" y="22" width="3" height="3" />
				</svg>
				<span class="stat-bar__num" data-count>{site.stats.unitsSold}</span>
				<span class="stat-bar__label">Units Sold</span>
			</div>
			<div class="stat-bar__item">
				<svg class="stat-bar__icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<path d="M5 22 L13 14 L18 19 L27 8" stroke-linecap="round" stroke-linejoin="round" />
					<path d="M20 8 H27 V15" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				<span class="stat-bar__num" data-count>{site.stats.closedSalesVolume}</span>
				<span class="stat-bar__label">In Closed Sales</span>
			</div>
			<div class="stat-bar__item">
				<svg class="stat-bar__icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<circle cx="16" cy="16" r="10" />
					<circle cx="16" cy="16" r="6" />
					<circle cx="16" cy="16" r="1.5" fill="currentColor" stroke="none" />
				</svg>
				<span class="stat-bar__num" data-count>{site.stats.listToSaleRatio}</span>
				<span class="stat-bar__label">List-to-Sale Price Ratio</span>
			</div>
			<div class="stat-bar__item">
				<svg class="stat-bar__icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
					<path d="M8 12 H24 M20 8 L24 12 L20 16" stroke-linecap="round" stroke-linejoin="round" />
					<path d="M24 20 H8 M12 16 L8 20 L12 24" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				<span class="stat-bar__num" data-count>{site.stats.exchangeSuccessRate}</span>
				<span class="stat-bar__label">Success Rate on 1031 Exchanges</span>
			</div>
		</div>
	</section>

	<section class="closing-strip" aria-label="Selected closings">
		<div class="closing-strip__track">
			{
				[0, 1].map((copy) => (
					<ul class="closing-strip__list" aria-hidden={copy === 1 ? 'true' : undefined}>
						{stripSales.map((sale) => (
							<li>
								<a href={`/closed-sales/#${sale.slug}`} tabindex={copy === 1 ? -1 : undefined}>
									<span class="closing-strip__name">{sale.name}</span>
									<span class="closing-strip__meta">
										{sale.city} &middot; {sale.units} units &middot; {formatPrice(sale.price)}
									</span>
								</a>
							</li>
						))}
					</ul>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="container who-we-are">
			<div>
				<span class="eyebrow">Who We Are</span>
				<h2>A Seasoned Team Apartment Owners Can Rely On</h2>
				<p>
					Highlight Multifamily Group brings more than 20 years of experience as investment sales brokers, alongside principal experience in
					acquisitions, dispositions, asset management, and development. We personally understand the challenges of being a long-term owner, a
					buyer, and a seller, which helps us serve our clients through every stage of purchasing, owning, and selling multifamily property,
					including 1031 exchanges.
				</p>
				<p>
					Josh Kaplan and Troy Lucero lead Highlight with a shared focus: building long-term relationships to become trusted advisors to
					apartment building owners across the Los Angeles Metro Area.
				</p>
				<a href="/about/" class="btn btn-outline">Meet the Team</a>
			</div>
			<div class="who-we-are__photo">
				<img
					src="/images/bio/josh-kaplan-troy-lucero-together.webp"
					alt="Josh Kaplan and Troy Lucero, co-founders of Highlight Multifamily Group"
					width="860"
					height="860"
					loading="lazy"
				/>
			</div>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<span class="eyebrow">Our Services</span>
			<h2>How We Help LA Apartment Owners</h2>
			<div class="services-grid">
				{
					services.map((s) => (
						<div class="service-card">
							<h3>{s.title}</h3>
							<p>{s.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<span class="eyebrow">Closed Transactions</span>
			<h2>Closed Transactions in Los Angeles</h2>
			<div class="sales-grid">
				{
					notableSales.map((sale) => (
						<a
							class="sale-card"
							href={`/closed-sales/#${sale.slug}`}
							style={cardImage(sale) ? `--sale-card-img: url(${cardImage(sale)})` : undefined}
						>
							<span class="sale-card__location">
								{sale.city}, {sale.state} {sale.zip}
							</span>
							<span class="sale-card__name">{sale.name}</span>
							<span class="sale-card__meta">
								{sale.units ? `${sale.units} Units` : 'Development Site'}
								{sale.sqft ? ` • ${sale.sqft.toLocaleString()} SF` : ''}
								{sale.acres ? ` • ${sale.acres} Acres` : ''}
							</span>
							<span class="sale-card__price">Sold for {formatPrice(sale.price)}</span>
						</a>
					))
				}
			</div>
			<a href="/closed-sales/" class="btn btn-navy" style="margin-top: 2rem;">View All Closed Sales</a>
		</div>
	</section>

	<section class="section snapshot">
		<div class="container">
			<span class="eyebrow">LA Apartment Market</span>
			<h2>What Los Angeles Apartment Buildings Are Selling For in 2026</h2>
			<div class="snapshot__grid">
				{
					snapshot.map((s) => (
						<div class="snapshot__item">
							<span class="snapshot__num" data-count>
								{s.num}
							</span>
							<span class="snapshot__label">{s.label}</span>
						</div>
					))
				}
			</div>
			<p class="snapshot__note">
				Los Angeles County apartment sales from January 2 to September 22, 2026. Older buildings are those built before 1978. Our analysis of CoStar sales data.
			</p>
			<a href="/insights/la-apartment-market-update-q3-2026/" class="btn btn-gold">Read the Q3 Market Update</a>
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<span class="eyebrow">Submarkets</span>
			<h2>Deep LA Multifamily Submarket Expertise</h2>
			<div class="submarket-strip">
				{
					submarkets.map((sm) => (
						<a href={`/submarkets/${sm.slug}/`} class="submarket-chip">
							{sm.name}
						</a>
					))
				}
			</div>
			<a href="/submarkets/" class="btn btn-outline" style="margin-top: 1.5rem;">Explore All Submarkets</a>
		</div>
	</section>

	{
		latestInsights.length > 0 && (
			<section class="section">
				<div class="container">
					<span class="eyebrow">Latest Insights</span>
					<h2>What LA Apartment Owners Need to Know Right Now</h2>
					<div class="insight-grid">
						{latestInsights.map((post) => (
							<a class="insight-card" href={`/insights/${post.slug}/`}>
								{post.image && <img src={post.image.src} alt="" width={post.image.width} height={post.image.height} loading="lazy" />}
								<span class="insight-card__title">{post.title}</span>
								<span class="insight-card__desc">{post.description}</span>
								<span class="insight-card__more">Read the guide &rarr;</span>
							</a>
						))}
					</div>
					<a href="/insights/" class="btn btn-outline insight-grid__more">
						All Insights
					</a>
				</div>
			</section>
		)
	}

	{
		testimonials.length > 0 && (
			<section class="section">
				<div class="container">
					<span class="eyebrow">What Owners Say</span>
					<h2>Trusted by LA Apartment Owners</h2>
					<div class="testimonial-grid">
						{testimonials
							.filter((t) => t.featured)
							.map((t) => (
								<figure class="testimonial-card">
									<blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
									<figcaption>
										{t.caseStudySlug ? <a href={`/case-studies/${t.caseStudySlug}/`}>{t.attribution} &rarr;</a> : t.attribution}
									</figcaption>
								</figure>
							))}
					</div>
					<a href="/testimonials/" class="btn btn-outline testimonial-grid__more">
						Read All Reviews
					</a>
				</div>
			</section>
		)
	}

	{
		press.length > 0 && (
			<section class="section press-section">
				<div class="container">
					<span class="eyebrow">In the News</span>
					<h2>Our Deals Make Headlines</h2>
					<div class="press-strip">
						{press.map((p) => (
							<a href={p.url} target="_blank" rel="noopener noreferrer" class={`press-logo press-logo--${p.name.toLowerCase().replace(/\s+/g, '-')}`}>
								{p.name}
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section section-alt strategy-section">
		<div class="container strategy-grid">
			<div>
				<span class="eyebrow">Let's Talk Strategy</span>
				<h2>Owning an Apartment Building Is Hard Enough. Selling It Shouldn't Be.</h2>
				<p>
					Whether you're weighing a sale, exploring a 1031 exchange, or navigating a trust or probate transition, we start with a conversation,
					not a pitch. We'll walk you through real comps, real timelines, and a strategy built around your goals.
				</p>
			</div>
			<BOVForm />
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		background: var(--navy-dark);
		color: #fff;
		padding-block: clamp(5rem, 12vw, 9rem);
		position: relative;
		overflow: hidden;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image: linear-gradient(180deg, rgba(12, 46, 80, 0.86), rgba(12, 46, 80, 0.78)), url('/images/hero/453-s-gramercy-pl-hero.webp');
		background-size: cover;
		background-position: center;
		/* A slow drift replaces the old fixed-background effect: it is cheap (transform only) and works on phones. */
		transform-origin: 60% 50%;
		animation: hero-drift 30s ease-in-out infinite alternate;
		will-change: transform;
	}

	@keyframes hero-drift {
		from {
			transform: scale(1);
		}
		to {
			transform: scale(1.08);
		}
	}

	@keyframes hero-rise {
		from {
			transform: translateY(18px);
		}
		to {
			transform: none;
		}
	}

	/* Transform only, no fade, so the headline is never invisible while the page loads. */
	.hero__inner > * {
		animation: hero-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	.hero__inner > :nth-child(2) {
		animation-delay: 0.08s;
	}

	.hero__inner > :nth-child(3) {
		animation-delay: 0.16s;
	}

	.hero__inner > :nth-child(4) {
		animation-delay: 0.24s;
	}

	.hero__inner > :nth-child(5) {
		animation-delay: 0.32s;
	}

	@media (max-width: 700px) {
		.hero__bg {
			background-image: linear-gradient(180deg, rgba(12, 46, 80, 0.86), rgba(12, 46, 80, 0.78)), url('/images/hero/453-s-gramercy-pl-hero-mobile.webp');
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__bg,
		.hero__inner > * {
			animation: none;
		}
	}

	.hero__form {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
		max-width: 620px;
		/* The entrance animation gives each hero block its own layer; without this the links below paint over the suggestion list. */
		position: relative;
		z-index: 2;
	}

	.hero__input {
		flex: 1 1 260px;
		min-width: 0;
		padding: 0.95rem 1.1rem;
		font: inherit;
		font-size: 1rem;
		color: var(--ink);
		background: #fff;
		border: 1px solid transparent;
		border-radius: 2px;
	}

	/* The suggestion script wraps the input in .bov-address, so the wrapper takes over the flex sizing. */
	.hero__form :global(.bov-address--hero) {
		flex: 1 1 260px;
		min-width: 0;
	}

	.hero__form :global(.bov-address--hero) .hero__input {
		width: 100%;
		box-sizing: border-box;
	}

	.hero__form :global(.bov-address__list) {
		text-align: left;
	}

	.hero__input:focus-visible {
		outline: 2px solid var(--gold-light);
		outline-offset: 2px;
	}

	.hero__form .btn {
		flex: 0 0 auto;
	}

	.hero::after {
		content: '';
		position: absolute;
		left: 2rem;
		right: 2rem;
		bottom: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--gold) 50%, transparent);
		opacity: 0.5;
		z-index: 1;
	}

	.hero__inner {
		max-width: 780px;
		position: relative;
		z-index: 1;
	}

	.hero__credit {
		position: absolute;
		right: 1.25rem;
		bottom: 0.85rem;
		z-index: 1;
		font-size: 0.68rem;
		letter-spacing: 0.02em;
		color: rgba(255, 255, 255, 0.55);
		border-bottom: 1px solid transparent;
	}

	.hero__credit:hover {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.5);
		text-decoration: none;
	}

	.hero .eyebrow {
		color: var(--gold-light);
	}

	.hero .btn-gold {
		background: var(--gold);
		color: var(--navy-dark);
		border-color: var(--gold);
	}

	.hero .btn-gold:hover {
		background: var(--gold-light);
		border-color: var(--gold-light);
	}

	.hero h1 {
		color: #fff;
		font-weight: 350;
	}

	.hero__sub {
		font-size: 1.2rem;
		color: #c3d1e0;
		max-width: 560px;
		line-height: 1.7;
	}

	.hero__actions {
		display: flex;
		align-items: center;
		gap: 2rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.hero__link {
		color: #fff;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		border-bottom: 1px solid rgba(255, 255, 255, 0.4);
		padding-bottom: 0.2rem;
	}

	.hero__link:hover {
		border-color: var(--gold-light);
		color: var(--gold-light);
		text-decoration: none;
	}

	.stat-bar {
		background: var(--paper);
		border-bottom: 1px solid var(--border);
		padding-block: 3rem;
	}

	.stat-bar__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		text-align: center;
	}

	.stat-bar__item {
		padding-inline: 1.5rem;
		border-left: 1px solid var(--border);
	}

	.stat-bar__item:first-child {
		border-left: none;
	}

	.stat-bar__icon {
		width: 34px;
		height: 34px;
		color: var(--gold);
		margin-bottom: 0.6rem;
	}

	.stat-bar__num {
		display: block;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 4vw, 2.85rem);
		font-weight: 400;
		color: var(--navy-dark);
	}

	.stat-bar__label {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-light);
	}

	.who-we-are {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.who-we-are p {
		max-width: 640px;
	}

	.who-we-are__photo {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.who-we-are__photo img {
		width: 100%;
		max-width: 340px;
		height: auto;
		display: block;
		filter: drop-shadow(0 20px 28px rgba(12, 46, 80, 0.16));
	}

	.who-we-are__photo::after {
		content: '';
		width: 110px;
		height: 2px;
		margin-top: 1.5rem;
		background: linear-gradient(90deg, transparent, var(--gold) 50%, transparent);
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 2.5rem;
		margin-top: 3rem;
	}

	.service-card {
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}

	.service-card h3 {
		font-size: 1.2rem;
	}

	.sales-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		margin-top: 3rem;
	}

	.sale-card {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 1.75rem;
		color: var(--ink);
		transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}

	.sale-card::before {
		content: '';
		position: absolute;
