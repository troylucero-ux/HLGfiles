<script>
	// Remember the address typed in the hero box so the BOV form on the contact page can fill itself in. The address is kept in
	// this tab's session storage only, never in the URL.
	const heroForm = document.querySelector<HTMLFormElement>('.js-hero-form');
	heroForm?.addEventListener('submit', () => {
		const address = (heroForm.querySelector('.hero__input') as HTMLInputElement | null)?.value.trim();
		try {
			if (address) {
				sessionStorage.setItem('hlg_bov_address', address);
				if (heroForm.dataset.googleAddress === address) sessionStorage.setItem('hlg_bov_address_google', '1');
				else sessionStorage.removeItem('hlg_bov_address_google');
			}
		} catch {
			// Storage can be blocked; the form still works, the visitor just types the address again.
		}
	});

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Count-up for the headline numbers. The final text stays in the page, so it is correct with scripts off and for crawlers.
	function countUp(el: HTMLElement) {
		const original = el.textContent?.trim() ?? '';
		const match = original.match(/^(\D*)([\d,]*\.?\d+)(.*)$/s);
		if (!match) return;
		const [, prefix, numText, suffix] = match;
		const target = parseFloat(numText.replace(/,/g, ''));
		if (!isFinite(target)) return;
		const decimals = (numText.split('.')[1] ?? '').length;
		const grouped = numText.includes(',');
		const format = (n: number) =>
			prefix + n.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals, useGrouping: grouped }) + suffix;
		const duration = 1400;
		const start = performance.now();
		const tick = (now: number) => {
			const t = Math.min(1, (now - start) / duration);
			const eased = 1 - Math.pow(1 - t, 3);
			el.textContent = t < 1 ? format(target * eased) : original;
			if (t < 1) requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
	}

	if (!reduceMotion && 'IntersectionObserver' in window) {
		const counters = document.querySelectorAll<HTMLElement>('[data-count]');
		const countObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						countUp(entry.target as HTMLElement);
						countObserver.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.6 },
		);
		counters.forEach((el) => countObserver.observe(el));

		// Fade-and-rise for blocks that start below the fold. Groups are staggered.
		const groups = [
			'.stat-bar__grid > *',
			'.who-we-are > *',
			'.services-grid > *',
			'.sales-grid > *',
			'.snapshot .container > *',
			'.snapshot__grid > *',
			'.submarket-strip',
			'.insight-grid > *',
			'.testimonial-grid > *',
			'.press-strip',
			'.strategy-grid > *',
			'main .section > .container > .eyebrow',
			'main .section > .container > h2',
		];
		const seen = new Set<Element>();
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					const el = entry.target as HTMLElement;
					el.classList.add('is-in');
					revealObserver.unobserve(el);
					// Once it has settled, drop the helper classes so hover effects on the same element work normally.
					window.setTimeout(() => {
						el.classList.remove('reveal', 'is-in');
						el.style.transitionDelay = '';
					}, 1700);
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
		);
		// Read every position first, then write, so the browser lays the page out once instead of once per element.
		const setUpReveal = () => {
			const candidates: { el: HTMLElement; i: number }[] = [];
			groups.forEach((selector) => {
				document.querySelectorAll<HTMLElement>(selector).forEach((el, i) => {
					if (!seen.has(el)) {
						seen.add(el);
						candidates.push({ el, i });
					}
				});
			});
			const belowFold = candidates.filter(({ el }) => el.getBoundingClientRect().top >= window.innerHeight);
			belowFold.forEach(({ el, i }) => {
				el.style.transitionDelay = `${Math.min(i, 5) * 90}ms`;
				el.classList.add('reveal');
				revealObserver.observe(el);
			});
		};
		// Wait until the browser is idle so this never competes with the first paint.
		if ('requestIdleCallback' in window) window.requestIdleCallback(setUpReveal, { timeout: 1500 });
		else window.setTimeout(setUpReveal, 300);
	}
</script>
