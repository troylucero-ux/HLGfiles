---
// "Link in bio" page for Instagram (and anywhere else a single link is allowed). Not indexed by search engines.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';
import { listings } from '../../data/listings';

const active = listings.filter((l) => l.status === 'active');
const usd = (n: number) => '$' + n.toLocaleString('en-US');

const tools = [
	{ href: '/property-value/', title: 'What is my apartment building worth?', sub: 'Free LA value calculator' },
	{ href: '/measure-ula-calculator/', title: 'Measure ULA calculator', sub: 'See what you would keep after the tax' },
	{ href: '/broker-opinion-of-value/', title: 'Free Broker Opinion of Value', sub: 'A real range from our team' },
	{ href: '/market-report/', title: 'LA apartment market report', sub: 'Prices, cap rates and the 10-year Treasury' },
	{ href: '/1031-exchanges/', title: '1031 exchanges', sub: 'Plan the exchange before you list' },
	{ href: '/triple-net-dst/', title: 'Triple net and DST guide', sub: 'Examples and three free calculators' },
];

const articles = [...posts].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
	title="Highlight Multifamily Group: Links"
	description="Free tools and articles for Los Angeles apartment building owners from Highlight Multifamily Group."
	noindex={true}
	hideStickyCta={true}
>
	<main class="links">
		<div class="links__wrap">
			<img class="links__avatar" src="/images/bio/josh-kaplan-troy-lucero-together-480.webp" alt="Josh Kaplan and Troy Lucero" width="120" height="120" />
			<h1>Highlight Multifamily Group</h1>
			<p class="links__lead">LA apartment building sales and 1031 exchanges. Free tools and articles for owners.</p>

			<h2>Properties for sale</h2>
			<ul class="links__list links__list--listings">
				{
					active.map((l) => (
						<li>
							<a href={`/listings/${l.slug}/`} class="links__btn links__btn--listing">
								<strong>{l.name}</strong>
								<span>
									{l.neighborhood ?? l.city}
									{l.units ? ` | ${l.units} units` : ''}
									{l.askingPrice ? ` | ${usd(l.askingPrice)}` : ''}
								</span>
							</a>
						</li>
					))
				}
			</ul>

			<h2>Free tools</h2>
			<ul class="links__list">
				{
					tools.map((t) => (
						<li>
							<a href={t.href} class="links__btn">
								<strong>{t.title}</strong>
								<span>{t.sub}</span>
							</a>
						</li>
					))
				}
			</ul>

			<h2>Articles for owners</h2>
			<ul class="links__list links__list--articles">
				{
					articles.map((p) => (
						<li>
							<a href={`/insights/${p.slug}/`} class="links__btn links__btn--article">
								<strong>{p.title}</strong>
							</a>
						</li>
					))
				}
			</ul>

			<p class="links__foot">
				<a href="/contact/">Talk to Josh and Troy</a> · Equity Union Commercial · DRE 01811831
			</p>
		</div>
	</main>
</BaseLayout>

<style>
	.links {
		background: var(--navy-tint);
		min-height: 70vh;
		padding: 2rem 1rem 3.5rem;
	}
	.links__wrap {
		max-width: 560px;
		margin: 0 auto;
		text-align: center;
	}
	.links__avatar {
		border-radius: 50%;
		border: 3px solid var(--gold);
		background: var(--navy-dark);
		object-fit: cover;
		margin: 0 auto 0.75rem;
	}
	h1 {
		font-size: clamp(1.6rem, 6vw, 2rem);
		margin: 0 0 0.4rem;
		color: var(--navy);
	}
	.links__lead {
		margin: 0 auto 1.5rem;
		color: var(--ink-soft);
		max-width: 420px;
	}
	h2 {
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--gold-dark);
		font-family: var(--font-sans);
		margin: 1.75rem 0 0.75rem;
	}
	.links__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.7rem;
	}
	.links__btn {
		display: block;
		padding: 0.95rem 1.1rem;
		background: #fff;
		border: 1px solid var(--border);
		border-left: 4px solid var(--gold);
		border-radius: 10px;
		text-align: left;
		color: var(--navy);
		text-decoration: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.links__btn:hover,
	.links__btn:focus-visible {
		transform: translateY(-1px);
		box-shadow: 0 6px 16px rgba(12, 46, 80, 0.12);
	}
	.links__btn strong {
		display: block;
		font-size: 1rem;
		line-height: 1.3;
	}
	.links__btn span {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.88rem;
		color: var(--ink-soft);
	}
	.links__list--listings .links__btn {
		background: #fff;
		border-left-color: var(--gold);
	}
	.links__list--listings .links__btn strong {
		color: var(--navy);
	}
	.links__list--listings .links__btn span {
		color: var(--ink-soft);
	}
	.links__list:not(.links__list--articles):not(.links__list--listings) .links__btn {
		background: var(--navy);
		border-left-color: var(--gold);
	}
	.links__list:not(.links__list--articles):not(.links__list--listings) .links__btn strong {
		color: #fff;
	}
	.links__list:not(.links__list--articles):not(.links__list--listings) .links__btn span {
		color: #cfdaea;
	}
	.links__btn--article strong {
		font-weight: 600;
		font-size: 0.95rem;
	}
	.links__foot {
		margin-top: 2rem;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}
</style>
