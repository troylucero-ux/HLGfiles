---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BOVForm from '../../components/BOVForm.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { submarkets } from '../../data/submarkets';
import { closings } from '../../data/closings';
import { caseStudies } from '../../data/caseStudies';
import { listings } from '../../data/listings';
import { formatPrice, formatPriceFull } from '../../lib/format';
import { SUBMARKET_CAP_RATES, SUBMARKET_SALES_STATS, COUNTY_WIDE_CAP_RATE, VALUATION_DATA_AS_OF } from '../../data/valuationAssumptions';

export function getStaticPaths() {
	return submarkets.map((sm) => ({
		params: { slug: sm.slug },
		props: { sm },
	}));
}

const { sm } = Astro.props;
const relatedClosings = closings.filter((c) => c.submarket === sm.slug);
const relatedCaseStudies = caseStudies.filter((cs) => cs.submarket === sm.slug);
const relatedListings = listings.filter((l) => l.submarket === sm.slug && l.status !== 'off-market');

// Use the submarket's highest-value closed apartment sale as the hero background — a real deal
// from that neighborhood, same approach as the homepage hero, rather than a generic stock photo.
const heroSale = relatedClosings
	.filter((c) => c.type === 'apartment' && c.images?.[0])
	.sort((a, b) => b.price - a.price)[0];

const capRate = SUBMARKET_CAP_RATES[sm.slug];
const salesStat = SUBMARKET_SALES_STATS[sm.slug];
---

<BaseLayout
	title={`${sm.name.replace(/\s*\(.*\)/, '')} Apartment Buildings | Highlight Multifamily Group`}
	description={`${sm.name} apartment building sales: Walk Score, transit, retail, and employers, plus Highlight's closed sales and case studies there.`}
	image={heroSale?.images?.[0]}
>
	<section class="page-hero" style={heroSale ? `--hero-img: url(${heroSale.images[0]})` : undefined}>
		<div class="container">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Submarkets', href: '/submarkets/' }, { label: sm.name }]} light />
			<span class="eyebrow">{sm.region}</span>
			<h1>{sm.name} Apartment Building Sales</h1>
			<p>{sm.overview}</p>
			<a href="/contact/?intent=bov" class="btn btn-gold">Get a Free Broker Opinion of Value in {sm.name}</a>
		</div>
	</section>

	<section class="section">
		<div class="container score-grid">
			<div class="score-card">
				<span class="score-card__num">{sm.walkScore}</span>
				<span class="score-card__label">Walk Score</span>
				<span class="score-card__note">{sm.walkScoreLabel}</span>
			</div>
			<div class="score-card">
				<span class="score-card__num">{sm.transitScore}</span>
				<span class="score-card__label">Transit Score</span>
			</div>
			<div class="score-card">
				<span class="score-card__num">{sm.bikeScore}</span>
				<span class="score-card__label">Bike Score</span>
			</div>
		</div>

		<div class="container detail-grid">
			<div>
				<h2>Transit Access</h2>
				<ul>
					{sm.transit.map((t) => <li>{t}</li>)}
				</ul>
			</div>
			<div>
				<h2>Local Retail</h2>
				<ul>
					{sm.retail.map((t) => <li>{t}</li>)}
				</ul>
			</div>
			<div>
				<h2>Major Employers</h2>
				<ul>
					{sm.employers.map((t) => <li>{t}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container sales-data">
			<span class="eyebrow">2026 Sales Data</span>
			<h2>{sm.name} Multifamily Sales So Far This Year</h2>
			<div class="sales-data__grid">
				{
					salesStat ? (
						<div class="sales-data__stat">
							<span class="sales-data__num">{formatPriceFull(salesStat.medianPricePerUnit)}</span>
							<span class="sales-data__label">Median Price Per Unit</span>
							<span class="sales-data__note">Based on {salesStat.compCount} confirmed {sm.name} sales through {VALUATION_DATA_AS_OF}</span>
						</div>
					) : (
						<div class="sales-data__stat">
							<span class="sales-data__num">Limited Data</span>
							<span class="sales-data__label">Median Price Per Unit</span>
							<span class="sales-data__note">Fewer than 10 confirmed {sm.name} sales through {VALUATION_DATA_AS_OF} to report a reliable median</span>
						</div>
					)
				}
				{
					capRate ? (
						<div class="sales-data__stat">
							<span class="sales-data__num">
								{(capRate.low * 100).toFixed(2)}% – {(capRate.high * 100).toFixed(2)}%
							</span>
							<span class="sales-data__label">Typical Cap Rate</span>
							<span class="sales-data__note">Based on {capRate.compCount} confirmed {sm.name} sales through {VALUATION_DATA_AS_OF}</span>
						</div>
					) : (
						<div class="sales-data__stat">
							<span class="sales-data__num">
								{(COUNTY_WIDE_CAP_RATE.low * 100).toFixed(2)}% – {(COUNTY_WIDE_CAP_RATE.high * 100).toFixed(2)}%
							</span>
							<span class="sales-data__label">Typical Cap Rate (LA County)</span>
							<span class="sales-data__note">
								Not enough {sm.name}-specific sales this year for a reliable range; shown is the Los Angeles County-wide rate across{' '}
								{COUNTY_WIDE_CAP_RATE.compCount} confirmed sales
							</span>
						</div>
					)
				}
			</div>
			<p class="sales-data__cta">
				Curious what your own {sm.name} property could be worth? <a href="/property-value/">Try our free value calculator &rarr;</a>
			</p>
		</div>
	</section>

	{
		relatedListings.length > 0 && (
			<section class="section section-alt">
				<div class="container">
					<span class="eyebrow">Active Inventory</span>
					<h2>Available Listings in {sm.name}</h2>
					<div class="closing-grid">
						{relatedListings.map((listing) => (
							<a href={`/listings/${listing.slug}/`} class="closing-card">
								<span>
									{listing.name} <span class="closing-card__status">{listing.status.replace('-', ' ')}</span>
								</span>
								<span class="closing-card__meta">
									{listing.units ? `${listing.units} Units` : 'Development Site'}
									{listing.askingPrice ? ` · ${formatPrice(listing.askingPrice)}` : ' · Contact for Pricing'}
								</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		relatedClosings.length > 0 && (
			<section class="section">
				<div class="container">
					<span class="eyebrow">Track Record</span>
					<h2>Closed Sales in {sm.name}</h2>
					<div class="closing-grid">
						{relatedClosings.map((sale) => (
							<a href={`/closed-sales/${sale.slug}/`} class="closing-card">
								<span>{sale.name}</span>
								<span class="closing-card__meta">
									{sale.units ? `${sale.units} Units` : 'Development Site'} &middot; Sold for {formatPrice(sale.price)}
								</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		relatedCaseStudies.length > 0 && (
			<section class="section">
				<div class="container">
					<span class="eyebrow">Case Studies</span>
					<h2>{sm.name} Case Studies</h2>
					<div class="closing-grid">
						{relatedCaseStudies.map((cs) => (
							<a href={`/case-studies/${cs.slug}/`} class="closing-card">
								<span>{cs.title}</span>
								<span class="closing-card__meta">{cs.summary}</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="container">
			<BOVForm heading={`Own an Apartment Building in ${sm.name}?`} subheading="Get a free, confidential Broker Opinion of Value." />
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		background:
			linear-gradient(135deg, rgba(20, 70, 122, 0.88) 0%, rgba(12, 46, 80, 0.92) 100%),
			var(--hero-img, linear-gradient(135deg, var(--navy) 0%, var(--navy-dark) 100%)) center / cover no-repeat;
		color: #fff;
		padding-block: clamp(3rem, 7vw, 5rem);
	}

	.page-hero h1 {
		color: #fff;
	}

	.page-hero p {
		color: #d7e0ea;
		max-width: 720px;
		font-size: 1.05rem;
	}

	.page-hero .btn-gold {
		background: var(--gold);
		color: var(--navy-dark);
		border-color: var(--gold);
	}

	.page-hero .btn-gold:hover {
		background: var(--gold-light);
		border-color: var(--gold-light);
	}

	.score-grid {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
		margin-bottom: 2.5rem;
	}

	.score-card {
		background: var(--paper-alt);
		border-top: 3px solid var(--gold);
		border-radius: 1px;
		padding: 1.75rem 2rem;
		text-align: center;
		flex: 1;
		min-width: 160px;
	}

	.score-card__num {
		display: block;
		font-family: var(--font-serif);
		font-size: 2.5rem;
		font-weight: 400;
		color: var(--navy-dark);
	}

	.score-card__label {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-light);
		font-weight: 600;
	}

	.score-card__note {
		display: block;
		font-size: 0.8rem;
		margin-top: 0.4rem;
		color: var(--ink-light);
	}

	.sales-data h2 {
		margin-bottom: 1.5rem;
	}

	.sales-data__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
	}

	.sales-data__stat {
		background: var(--paper);
		border: 1px solid var(--border);
		border-top: 3px solid var(--gold);
		border-radius: 1px;
		padding: 1.75rem 2rem;
	}

	.sales-data__num {
		display: block;
		font-family: var(--font-serif);
		font-size: 2rem;
		font-weight: 400;
		color: var(--navy-dark);
	}

	.sales-data__label {
		display: block;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--gold-dark);
		font-weight: 600;
		margin-top: 0.4rem;
	}

	.sales-data__note {
		display: block;
		font-size: 0.8rem;
		color: var(--ink-light);
		margin-top: 0.5rem;
	}

	.sales-data__cta {
		margin-top: 1.5rem;
		font-weight: 600;
	}

	.detail-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.detail-grid ul {
		padding-left: 1.1rem;
	}

	.detail-grid li {
		margin-bottom: 0.4rem;
	}

	.closing-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.closing-card {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 1.5rem;
		color: var(--navy-dark);
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 1.05rem;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.closing-card:hover {
		border-color: var(--gold);
		transform: translateY(-2px);
		text-decoration: none;
	}

	.closing-card__status {
		display: inline-block;
		text-transform: uppercase;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		background: var(--navy-tint);
		color: var(--navy-dark);
		padding: 0.15rem 0.5rem;
		border-radius: 1px;
		vertical-align: middle;
		margin-left: 0.4rem;
	}

	.closing-card__meta {
		font-weight: 400;
		font-size: 0.85rem;
		color: var(--ink-light);
	}

	@media (max-width: 860px) {
		.detail-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
