---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BOVForm from '../../components/BOVForm.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WestHollywoodGuide from '../../components/WestHollywoodGuide.astro';
import SantaMonicaGuide from '../../components/SantaMonicaGuide.astro';
import BeverlyHillsGuide from '../../components/BeverlyHillsGuide.astro';
import MeasureGsCliff from '../../components/MeasureGsCliff.astro';
import LaCityOwnerGuide from '../../components/LaCityOwnerGuide.astro';
import MidWilshireLocal from '../../components/MidWilshireLocal.astro';
import NeighborhoodLocal from '../../components/NeighborhoodLocal.astro';
import { neighborhoodLocal } from '../../data/neighborhoodLocal';
import { submarkets } from '../../data/submarkets';
import { closings } from '../../data/closings';
import { caseStudies } from '../../data/caseStudies';
import { listings } from '../../data/listings';
import { posts } from '../../data/posts';
import { formatPrice, formatPriceFull } from '../../lib/format';
import { SALES_STATS, AGE_GROUP_LABELS, VALUATION_DATA_AS_OF, MIN_PRICE_COMPS_PAGE, MIN_CAP_RATE_COMPS, type AgeGroup } from '../../data/valuationAssumptions';

export function getStaticPaths() {
	return submarkets.map((sm) => ({
		params: { slug: sm.slug },
		props: { sm },
	}));
}

const { sm } = Astro.props;
const relatedClosings = closings.filter((c) => c.submarket === sm.slug);
const relatedCaseStudies = caseStudies.filter((cs) => cs.submarket === sm.slug);
const relatedListings = listings.filter((l) => l.submarket === sm.slug && l.status !== 'off-market');
const isSantaMonica = sm.city === 'santa-monica';
const isWestHollywood = sm.city === 'west-hollywood';
const isBeverlyHills = sm.city === 'beverly-hills';
// Separate cities: the LA Rent Stabilization Ordinance and Measure ULA don't apply there.
const isOwnCity = Boolean(sm.city);

// Use the submarket's highest-value closed apartment sale as the hero background — a real deal
// from that neighborhood, same approach as the homepage hero, rather than a generic stock photo.
const heroSale = relatedClosings
	.filter((c) => c.type === 'apartment' && c.images?.[0])
	.sort((a, b) => b.price - a.price)[0];

// Each age group is shown separately (RSO buildings trade differently than 1978-and-newer ones), using
// this submarket's own sales only. A median price needs at least 3 sales and a cap rate at least 5 reported cap
// rates, otherwise the card says there isn't enough data.
const fmtCap = (r: { low: number; high: number }) => `${(r.low * 100).toFixed(2)}% – ${(r.high * 100).toFixed(2)}%`;
const plural = (n: number) => `${n} ${sm.name} sale${n === 1 ? '' : 's'}`;
const NOT_ENOUGH = 'Not enough data';
const salesGroups = (['rso', 'post1978'] as AgeGroup[]).map((group) => {
	const stats = SALES_STATS[sm.slug]?.[group];
	const enoughPrice = (m?: { compCount: number } | null) => (m && m.compCount >= MIN_PRICE_COMPS_PAGE ? m : null);
	const ppu = enoughPrice(stats?.pricePerUnit);
	const psf = enoughPrice(stats?.pricePerSf);
	const cap = stats?.capRate && stats.capRate.compCount >= MIN_CAP_RATE_COMPS ? stats.capRate : null;
	const noPriceNote = `Fewer than ${MIN_PRICE_COMPS_PAGE} ${sm.name} sales in this category`;
	return {
		title: isWestHollywood
			? { rso: 'Built Before 1979 (WeHo Rent Control)', post1978: 'Built 1979 or Later' }[group]
				: isBeverlyHills
					? { rso: 'Built Before 1978', post1978: 'Built 1978 or Later' }[group]
			: isSantaMonica
				? AGE_GROUP_LABELS[group].title.replace(' (RSO)', '').replace(' (AB 1482)', '')
				: AGE_GROUP_LABELS[group].title,
		rows: [
			{
				label: 'Median Price Per Unit',
				value: ppu ? formatPriceFull(ppu.median) : NOT_ENOUGH,
				note: ppu ? plural(ppu.compCount) : noPriceNote,
			},
			{
				label: 'Median Price Per SF',
				value: psf ? `$${psf.median.toLocaleString('en-US')}` : NOT_ENOUGH,
				note: psf ? plural(psf.compCount) : noPriceNote,
			},
			{
				label: 'Typical Cap Rate',
				value: cap ? fmtCap(cap) : NOT_ENOUGH,
				note: cap ? plural(cap.compCount) : `Fewer than ${MIN_CAP_RATE_COMPS} ${sm.name} sales reporting a cap rate`,
			},
		],
	};
});

// ---- Neighborhood FAQ. Every answer is built from this neighborhood's own data (2026 sales stats,
// Highlight's closed sales and listings, and the Walk/Transit scores), so the nine pages differ from
// each other and nothing is invented.
const shortName = sm.name.replace(/\s*\(.*\)/, '');
const closedHere = [...relatedClosings].sort((a, b) => b.price - a.price);
const activeHere = relatedListings.filter((l) => l.status === 'active');
const rsoStats = SALES_STATS[sm.slug]?.rso;
const rsoPpu = rsoStats?.pricePerUnit && rsoStats.pricePerUnit.compCount >= MIN_PRICE_COMPS_PAGE ? rsoStats.pricePerUnit : null;
const rsoPsf = rsoStats?.pricePerSf && rsoStats.pricePerSf.compCount >= MIN_PRICE_COMPS_PAGE ? rsoStats.pricePerSf : null;
const rsoCap = rsoStats?.capRate && rsoStats.capRate.compCount >= MIN_CAP_RATE_COMPS ? rsoStats.capRate : null;
const walkLabel = (sm.walkScoreLabel ?? '').replace(/\s*\(/, '; ').replace(/\)$/, '');
const joinList = (items: string[]) => (items.length <= 1 ? items.join('') : `${items.slice(0, -1).join(', ')}, and ${items[items.length - 1]}`);

type Faq = { q: string; a: string; links?: { label: string; href: string }[] };
const faqs: Faq[] = [];

faqs.push({
	q: `What is the price per unit for an apartment building in ${shortName}?`,
	a: rsoPpu
		? `Among buildings built before 1978 sold in ${shortName} so far in 2026, the median price per unit was ${formatPriceFull(rsoPpu.median)} across ${rsoPpu.compCount} sales${rsoPsf ? `, and the median price per square foot was $${rsoPsf.median.toLocaleString('en-US')}` : ''}. Figures are through ${VALUATION_DATA_AS_OF} and move with the market.`
		: `There are not yet enough 2026 ${shortName} sales to publish a reliable median price per unit, and we would rather say so than guess. For a number tied to your own building, use our calculator or request a Broker Opinion of Value.`,
	links: [{ label: 'Free property value calculator', href: '/property-value/' }],
});

faqs.push({
	q: `What cap rate do ${shortName} apartment buildings sell for?`,
	a: rsoCap
		? `Buildings built before 1978 sold in ${shortName} in 2026 had a typical cap rate range of ${fmtCap(rsoCap)}, based on ${rsoCap.compCount} sales that reported one (the middle half of those sales). Cap rates vary with building age, condition, and rent levels, so your building can sit above or below the range.`
		: `Fewer than ${MIN_CAP_RATE_COMPS} ${shortName} sales have reported a cap rate so far in 2026, so we do not publish a range for it. A Broker Opinion of Value will give you a cap rate grounded in your own income and expenses.`,
	links: [{ label: 'How apartment buildings are valued', href: '/insights/how-to-value-an-apartment-building-in-los-angeles/' }],
});

faqs.push({
	q: `Does rent control apply to apartment buildings in ${shortName}?`,
	a: isWestHollywood
		? 'Yes, under West Hollywood’s own Rent Stabilization Ordinance, not the City of Los Angeles rules. Buildings with a certificate of occupancy issued before July 1, 1979 are generally rent-controlled: rent can rise once a year by the city’s Annual General Adjustment, and tenants can only be evicted for reasons the ordinance allows. Newer buildings have no city rent cap but are still covered by West Hollywood’s eviction protections. Confirm your building’s status with the city or an attorney before you price or sell.'
			: isBeverlyHills
				? 'Yes, under Beverly Hills’ own Rent Stabilization Ordinance, not the City of Los Angeles rules. It is split into two chapters: Chapter 5 for older units where the tenant’s initial rent was $600 or less, and Chapter 6 for all other covered units. Each has its own yearly increase, set by the city. Units the ordinance does not cover may still fall under the statewide AB 1482 cap. Confirm your building’s status with the City of Beverly Hills before you price or sell.'
		: isSantaMonica
			? 'Santa Monica is a separate city with its own rent control law, administered by the Santa Monica Rent Control Board, so the City of Los Angeles rules do not apply there. Which rules cover a building depends on its age and registration, so confirm with the city or an attorney before you price or sell.'
			: `${shortName} is in the City of Los Angeles. Buildings with a certificate of occupancy issued before October 1, 1978 are generally covered by the Rent Stabilization Ordinance, and newer buildings typically fall under the statewide AB 1482 cap. Rent control affects value because buyers price in below-market rents, as we explain in our guides.`,
	links: isOwnCity
		? [{ label: 'Selling with rent-controlled tenants', href: '/insights/selling-la-apartment-building-with-tenants-rent-control/' }]
		: [
				{ label: '2026 AB 1482 rent cap', href: '/insights/ab-1482-rent-cap-2026/' },
				{ label: 'Selling with rent-controlled tenants', href: '/insights/selling-la-apartment-building-with-tenants-rent-control/' },
			],
});

// City-specific questions, matching the guide sections further down the page.
if (isWestHollywood) {
	faqs.push(
		{
			q: 'How much can landlords raise rent in West Hollywood in 2026?',
			a: 'For rent-controlled units, the Annual General Adjustment is 2.75% from September 1, 2026 through August 31, 2027. It is set each year at 75% of the change in LA-area inflation and can never exceed 3%. Rent can go up once every 12 months, with a 30-day notice, and only if the building’s city registration is current.',
		},
		{
			q: 'Does Measure ULA apply to West Hollywood apartment buildings?',
			a: 'No. Measure ULA applies only to property in the City of Los Angeles, and West Hollywood is a separate city. West Hollywood also has no city transfer tax of its own, so a seller pays only LA County’s documentary transfer tax of $1.10 per $1,000. On a $6 million sale, that is $6,600, compared with $273,600 in combined transfer taxes for the same price in the City of LA.',
		},
		{
			q: 'Can I raise the rent to market when a West Hollywood tenant moves out?',
			a: 'Usually, yes, if the tenant leaves voluntarily. State law (Costa-Hawkins) lets you set a new rent for the next tenant. After a no-fault eviction, West Hollywood does not reset the rent, and a no-fault move-out also requires a relocation payment, which the city adjusts every July.',
		},
		{
			q: 'Do West Hollywood apartment buildings need a soft-story retrofit?',
			a: 'Many do. West Hollywood’s Ordinance 17-1004 requires wood-frame buildings with soft, weak, or open-front ground floors, such as tuck-under parking, permitted before 1978 to be screened and retrofitted on a city schedule. Buyers will ask for your screening report, plans, permits, and sign-off, so gather them before you list.',
			links: [{ label: '925 N San Vicente Blvd case study', href: '/case-studies/925-n-san-vicente-blvd-west-hollywood-apartments/' }],
		},
	);
}
if (isSantaMonica) {
	faqs.push({
		q: 'What is Measure GS in Santa Monica?',
		a: 'Measure GS is Santa Monica’s transfer tax on sales of $8 million or more, in effect since March 1, 2023. At $8 million and up, the city tax is 5.6% of the entire sale price, compared with 0.6% from $5 million to just under $8 million and 0.3% below $5 million. LA County’s $1.10 per $1,000 is added on top. Measure ULA does not apply in Santa Monica because it is a separate city.',
	});
}

// Beverly Hills' own rules, matching the guide further down the page (see BeverlyHillsGuide.astro for sources).
if (isBeverlyHills) {
	faqs.push(
		{
			q: 'How much can landlords raise rent in Beverly Hills in 2026?',
			a: 'Under Beverly Hills’ Rent Stabilization Ordinance, the allowed increase for most units (Chapter 6) is 3.6%, effective in June 2026 and updated yearly. For older low-rent units (Chapter 5, where the tenant’s initial rent was $600 or less in a building built before September 20, 1978), it was 3.33% from June 12, 2026 and is updated every month. Confirm the current figure with the City of Beverly Hills.',
		},
		{
			q: 'Does Measure ULA apply to Beverly Hills apartment buildings?',
			a: 'No. Measure ULA applies only to property in the City of Los Angeles, and Beverly Hills is a separate city. Only five cities in LA County charge their own transfer tax, and Beverly Hills is not one of them, so a seller pays only LA County’s $1.10 per $1,000. On a $6 million sale that is $6,600, compared with $273,600 in combined transfer taxes for the same price in the City of LA.',
		},
		{
			q: 'Do Beverly Hills apartment buildings need a soft-story retrofit?',
			a: 'Some do. Beverly Hills has its own mandatory soft-story program, Ordinance 18-O-2767, adopted in December 2018 and in force since January 2019. It covers wood-frame buildings with weak or open ground floors, such as tuck-under parking, permitted before 1978, and the city sorts buildings into tiers by height and unit count. Buyers will ask for your notice, plans, permits, and sign-off, so gather them before you list.',
		},
		{
			q: 'Does SB 79 apply to Beverly Hills apartment buildings?',
			a: 'SB 79, the state transit-housing law, took effect July 1, 2026. Beverly Hills adopted its own alternative plan by urgency ordinance (26-O-2935), and California’s housing department has been reviewing it. What applies to a specific parcel is a question for the city, so confirm yours before you price a sale.',
		},
	);
}

// Santa Monica's own rules, matching the guide further down the page (see SantaMonicaGuide.astro for sources).
if (isSantaMonica) {
	faqs.push(
		{
			q: 'How much can landlords raise rent in Santa Monica in 2026?',
			a: 'For rent-controlled units, the Santa Monica Rent Control Board set the 2026 General Adjustment at 2.6%, with a $70 limit on the dollar increase, effective September 1, 2026. It was 2.3% (with a $60 limit) in 2025 and 3% (with a $76 limit) in 2024. Santa Monica’s rules are separate from the City of Los Angeles.',
		},
		{
			q: 'Can I reset the rent when a tenant moves out of a Santa Monica rent-controlled unit?',
			a: 'Usually, yes, if the tenant leaves voluntarily. State law (Costa-Hawkins) lets an owner set a new rent for the next tenant, and Santa Monica has followed it since 1999. Once the new tenant moves in, the unit is controlled again at the new rent. Confirm the details with the Santa Monica Rent Control Board or an attorney.',
		},
		{
			q: 'Is it cheaper to sell an apartment building in Santa Monica or in the City of Los Angeles?',
			a: 'Below $8 million, usually yes. On a $6 million sale, transfer taxes are about $42,600 in Santa Monica and $273,600 in the City of LA, where Measure ULA applies. At $8 million and up, Santa Monica’s Measure GS rate of 5.6% makes it costlier: on a $9 million sale, about $513,900 in Santa Monica versus $410,400 in the City of LA. These figures are before commissions and other closing costs.',
		},
		{
			q: 'Do Santa Monica apartment buildings need a seismic retrofit?',
			a: 'Some do. Santa Monica’s Seismic Retrofit Ordinance, adopted in March 2017, identified over 2,000 commercial and multifamily buildings as potentially vulnerable, most of them soft-story buildings with tuck-under parking. Owners on the city’s list receive an order to have the building analyzed by a licensed professional, and a building found non-compliant must be retrofitted on the city’s timeline. Being on the list is not a finding that a building is unsafe.',
		},
		{
			q: 'Does SB 79 apply to Santa Monica apartment buildings?',
			a: 'SB 79 took effect July 1, 2026 and sets minimum building standards within a half mile of transit stops, including four Metro E Line stops in Santa Monica. The city adopted an ordinance, effective August 27, 2026, that excludes six of its seven transit zones from SB 79 until 2030, and sites with designated historic resources are excluded too. The city’s map is approximate, so confirm your parcel with the city.',
		},
	);
}

if (sm.laOwnerGuide) {
	const ulaUnits = rsoPpu ? Math.ceil(5_400_000 / rsoPpu.median) : null;
	faqs.push(
		{
			q: `How much can landlords raise rent on rent-controlled apartments in ${shortName}?`,
			a: `Under the LA Rent Stabilization Ordinance, the allowable increase is 3% from July 1, 2026 through June 30, 2027. Rent can go up once every 12 months, with proper notice, and only if the building's registration with the LA Housing Department is current.`,
			links: [{ label: 'Selling with rent-controlled tenants', href: '/insights/selling-la-apartment-building-with-tenants-rent-control/' }],
		},
		{
			q: `Does Measure ULA apply to ${shortName} apartment buildings?`,
			a: `Yes. ${shortName} is in the City of Los Angeles, so sales above $5.4 million pay a 4% ULA tax on the entire price, and sales at $10.9 million or more pay 5.5%.${
				ulaUnits ? ` At ${shortName}'s 2026 median of ${formatPriceFull(rsoPpu!.median)} per unit for older buildings, a building of about ${ulaUnits} units or more is likely to cross the $5.4 million line.` : ''
			}`,
			links: [{ label: 'Measure ULA thresholds explained', href: '/insights/measure-ula-2026-thresholds-selling-la-apartment-building/' }],
		},
	);
}
// A question owners ask Google, answered from the LA Housing Department’s RSO Property Search page.
if (sm.laOwnerGuide) {
	faqs.push({
		q: `How do I find out if my ${shortName} apartment building is rent controlled?`,
		a: 'Look up your address on the City of Los Angeles’ ZIMAS site. Under the Housing section, the Rent Stabilization Ordinance (RSO) field says Yes if at least one unit in the building is covered, so a building can be only partly covered. Buildings first occupied on or before October 1, 1978 are generally covered, and newer buildings typically fall under the statewide AB 1482 cap. The LA Housing Department answers questions at (866) 557-7368.',
		links: [{ label: 'ZIMAS (City of LA zoning and RSO lookup)', href: 'https://zimas.lacity.org/' }],
	});
}

if (sm.slug === 'mid-wilshire') {
	faqs.push(
		{
			q: 'Which Metro subway stations are in Mid-Wilshire?',
			a: 'The Metro D Line extension opened Wilshire/La Brea, Wilshire/Fairfax, and Wilshire/La Cienega stations on May 8, 2026, connecting Mid-Wilshire directly to Koreatown and Downtown LA. Stations in Beverly Hills, Century City, and Westwood are projected to open in 2027.',
		},
		{
			q: 'Is Mid-Wilshire in a historic district?',
			a: 'Part of it is. The Miracle Mile Historic Preservation Overlay Zone (HPOZ), approved by the City Council in 2017, covers much of the area south of Wilshire between Fairfax and La Brea. Inside it, exterior changes and new construction go through design review. Check your parcel on the city’s ZIMAS site before you price a sale.',
		},
	);
}

// Neighborhood-specific questions (from src/data/neighborhoodLocal.ts), for neighborhoods that have a local section.
const local = neighborhoodLocal[sm.slug];
if (local?.faqs) faqs.push(...local.faqs);

if (closedHere.length > 0) {
	const top = closedHere.slice(0, 3);
	faqs.push({
		q: `What apartment buildings has Highlight sold in ${shortName}?`,
		a: `Highlight has closed ${closedHere.length === 1 ? 'a sale' : 'sales'} in ${shortName}${closedHere.length === 1 ? ':' : ', including'} ${joinList(top.map((c) => `${c.name} (${c.units ? `${c.units} units, ` : 'development site, '}${formatPrice(c.price)})`))}. Every closed sale is listed with its details on our closed sales page.`,
		links: [...top.map((c) => ({ label: c.name, href: `/closed-sales/${c.slug}/` })), { label: 'All closed sales', href: '/closed-sales/' }],
	});
}

faqs.push({
	q: `Why do investors buy apartment buildings in ${shortName}?`,
	a: `${[sm.region === shortName ? '' : `${shortName} is in ${sm.region}${sm.walkScore !== undefined ? ',' : '.'}`, sm.walkScore !== undefined ? `${sm.region === shortName ? `${shortName} has` : 'with'} a Walk Score of ${sm.walkScore} (${walkLabel})${sm.transitScore !== undefined ? ` and a Transit Score of ${sm.transitScore}` : ''}.` : ''].filter(Boolean).join(' ')} Transit includes ${sm.transit[0]}. Nearby employers and anchors include ${joinList(sm.employers)}.${sm.walkScore !== undefined && sm.walkScore >= 70 ? ' Walkable, transit-connected neighborhoods with local jobs tend to keep renter demand steady.' : ''}`.trim(),
});

faqs.push({
	q: `Are there apartment buildings for sale in ${shortName} right now?`,
	a:
		activeHere.length > 0
			? `Yes. We currently have ${joinList(activeHere.map((l) => `${l.name} (${l.units ? `${l.units} units` : 'development site'}${l.askingPrice ? `, ${formatPrice(l.askingPrice)}` : ''})`))} available in ${shortName}.`
			: `We do not have an active ${shortName} listing at the moment. Contact us and we will tell you about upcoming and off-market opportunities as they arise.`,
	links: activeHere.length > 0 ? activeHere.map((l) => ({ label: l.name, href: `/listings/${l.slug}/` })) : [{ label: 'All listings', href: '/listings/' }],
});

faqs.push({
	q: `What is my ${shortName} apartment building worth?`,
	a: `Start with our free property value calculator${rsoCap ? `, which prices your building using ${shortName}'s own 2026 sales` : `, which will tell you plainly when there are not enough ${shortName} sales for a reliable range`}. Then request a free Broker Opinion of Value for a number based on your actual rent roll, expenses, and condition.`,
	links: [
		{ label: 'Free property value calculator', href: '/property-value/' },
		{ label: 'Free Broker Opinion of Value', href: '/contact/?intent=bov' },
	],
});

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

// Neighborhoods that border each other, for the "nearby" links.
const nearbyMap: Record<string, string[]> = {
	koreatown: ['pico-union', 'westlake', 'east-hollywood', 'mid-wilshire'],
	'mid-wilshire': ['koreatown', 'west-hollywood', 'pico-union'],
	'pico-union': ['koreatown', 'westlake'],
	westlake: ['pico-union', 'koreatown', 'silver-lake'],
	'east-hollywood': ['silver-lake', 'koreatown'],
	'silver-lake': ['east-hollywood', 'westlake'],
	brentwood: ['santa-monica', 'west-hollywood', 'west-la'],
	'santa-monica': ['brentwood', 'west-hollywood', 'west-la'],
	'west-hollywood': ['mid-wilshire', 'santa-monica', 'brentwood', 'east-hollywood', 'beverly-hills'],
	'beverly-hills': ['west-hollywood', 'mid-wilshire', 'west-la'],
	'west-la': ['brentwood', 'santa-monica', 'beverly-hills'],
	'north-hollywood': ['van-nuys'],
	'van-nuys': ['north-hollywood'],
};
// Seller guides linked from every neighborhood page. Measure ULA and the LA rent control rules apply
// to the City of Los Angeles only, so Santa Monica and West Hollywood (separate cities) get the general ones.
const ownerGuideSlugs = [
	'how-to-sell-an-apartment-building-in-los-angeles-step-by-step',
	'how-to-value-an-apartment-building-in-los-angeles',
	'la-apartment-cap-rates-and-prices-by-neighborhood-2026',
	'should-i-sell-my-la-apartment-building',
	...(isOwnCity ? [] : ['selling-la-apartment-building-with-tenants-rent-control', 'measure-ula-2026-thresholds-selling-la-apartment-building']),
	'capital-gains-depreciation-recapture-selling-la-apartment-building',
	'how-to-choose-a-multifamily-broker-in-los-angeles',
];
const ownerGuides = ownerGuideSlugs.map((slug) => posts.find((p) => p.slug === slug)).filter((p): p is NonNullable<typeof p> => Boolean(p));

const nearby = (nearbyMap[sm.slug] ?? []).map((slug) => submarkets.find((x) => x.slug === slug)).filter(Boolean) as typeof submarkets;
---

<BaseLayout
	title={`${shortName} Multifamily Broker | Apartment Building Sales`.length <= 60 ? `${shortName} Multifamily Broker | Apartment Building Sales` : `${shortName} Apartment Building Sales`}
	description={sm.metaDescription ?? `${shortName} multifamily broker: real 2026 sales data, Highlight's closed sales and listings, and a free valuation for apartment owners.`}
	image={heroSale?.images?.[0]}
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
	<section class="page-hero" style={heroSale ? `--hero-img: url(${heroSale.images[0]})` : undefined}>
		<div class="container">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Submarkets', href: '/submarkets/' }, { label: sm.name }]} light />
			<span class="eyebrow">{sm.region}</span>
			<h1>{shortName} Multifamily Broker: Apartment Building Sales</h1>
			<p>{sm.overview}</p>
			<a href="/contact/?intent=bov" class="btn btn-gold">Get a Free Broker Opinion of Value in {sm.name}</a>
		</div>
	</section>

	<section class="section">
		<div class="container score-grid">
			{
				sm.walkScore !== undefined && (
					<div class="score-card">
						<span class="score-card__num">{sm.walkScore}</span>
						<span class="score-card__label">Walk Score</span>
						<span class="score-card__note">{sm.walkScoreLabel}</span>
					</div>
				)
			}
			{
				sm.transitScore !== undefined && (
					<div class="score-card">
						<span class="score-card__num">{sm.transitScore}</span>
						<span class="score-card__label">Transit Score</span>
					</div>
				)
			}
			{
				sm.bikeScore !== undefined && (
					<div class="score-card">
						<span class="score-card__num">{sm.bikeScore}</span>
						<span class="score-card__label">Bike Score</span>
					</div>
				)
			}
		</div>

		<div class="container detail-grid">
			<div>
				<h2>Transit Access</h2>
				<ul>
					{sm.transit.map((t) => <li>{t}</li>)}
				</ul>
			</div>
			<div>
				<h2>Local Retail</h2>
				<ul>
					{sm.retail.map((t) => <li>{t}</li>)}
				</ul>
			</div>
			<div>
				<h2>Major Employers</h2>
				<ul>
					{sm.employers.map((t) => <li>{t}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container sales-data">
			<span class="eyebrow">2026 Sales Data</span>
			<h2>{sm.name} Multifamily Sales So Far This Year</h2>
			<p class="sales-data__intro">
				{isWestHollywood
					? "Buildings first occupied before July 1, 1979 fall under West Hollywood's own rent control law and trade differently than newer buildings, so we break them out separately."
					: isSantaMonica
						? "Buildings built before 1978 are generally under rent control and trade differently than newer buildings, so we break them out separately."
						: "Buildings built before 1978 fall under the LA Rent Stabilization Ordinance (RSO) and trade differently than newer buildings under AB 1482, so we break them out separately."} Confirmed {sm.name} sales through {VALUATION_DATA_AS_OF}. Figures are shown only when there are enough sales to be meaningful.
			</p>
			<div class="sales-data__groups">
				{
					salesGroups.map((group) => (
						<div class="sales-data__group">
							<h3>{group.title}</h3>
							<dl>
								{group.rows.map((row) => (
									<div class="sales-data__stat">
										<dt class="sales-data__label">{row.label}</dt>
										<dd class="sales-data__num">{row.value}</dd>
										<dd class="sales-data__note">{row.note}</dd>
									</div>
								))}
							</dl>
						</div>
					))
				}
			</div>
			<p class="sales-data__cta">
				Curious what your own {sm.name} property could be worth? <a href="/property-value/">Try our free value calculator &rarr;</a>
			</p>
		</div>
	</section>

	{isWestHollywood && <WestHollywoodGuide />}
	{isBeverlyHills && <BeverlyHillsGuide />}
	{
		isSantaMonica && (
			<SantaMonicaGuide>
				<MeasureGsCliff slot="gs" />
			</SantaMonicaGuide>
		)
	}
	{sm.slug === 'mid-wilshire' && <MidWilshireLocal />}
	{local && <NeighborhoodLocal section={local} />}
	{sm.laOwnerGuide && <LaCityOwnerGuide sm={sm} />}

	{
		relatedListings.length > 0 && (
			<section class="section section-alt">
				<div class="container">
					<span class="eyebrow">Active Inventory</span>
					<h2>Available Listings in {sm.name}</h2>
					<div class="closing-grid">
						{relatedListings.map((listing) => (
							<a href={`/listings/${listing.slug}/`} class="closing-card">
								<span>
									{listing.name} <span class="closing-card__status">{listing.status.replace('-', ' ')}</span>
								</span>
								<span class="closing-card__meta">
									{listing.units ? `${listing.units} Units` : 'Development Site'}
									{listing.askingPrice ? ` · ${formatPrice(listing.askingPrice)}` : ' · Contact for Pricing'}
								</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		relatedClosings.length > 0 && (
			<section class="section">
				<div class="container">
					<span class="eyebrow">Track Record</span>
					<h2>Closed Sales in {sm.name}</h2>
					<div class="closing-grid">
						{relatedClosings.map((sale) => (
							<a href={`/closed-sales/${sale.slug}/`} class="closing-card">
								<span>{sale.name}</span>
								<span class="closing-card__meta">
									{sale.units ? `${sale.units} Units` : 'Development Site'} &middot; Sold for {formatPrice(sale.price)}
								</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		relatedCaseStudies.length > 0 && (
			<section class="section">
				<div class="container">
					<span class="eyebrow">Case Studies</span>
					<h2>{sm.name} Case Studies</h2>
					<div class="closing-grid">
						{relatedCaseStudies.map((cs) => (
							<a href={`/case-studies/${cs.slug}/`} class="closing-card">
								<span>{cs.title}</span>
								<span class="closing-card__meta">{cs.summary}</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		ownerGuides.length > 0 && (
			<section class="section">
				<div class="container">
					<span class="eyebrow">Guides for Owners</span>
					<h2>Thinking of Selling an Apartment Building in {shortName}?</h2>
					<div class="closing-grid">
						{ownerGuides.map((g) => (
							<a href={`/insights/${g.slug}/`} class="closing-card">
								<span>{g.title}</span>
								<span class="closing-card__meta">{g.description}</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section section-alt">
		<div class="container faq">
			<span class="eyebrow">Frequently Asked Questions</span>
			<h2>{shortName} Multifamily FAQs</h2>
			<div class="faq__list">
				{
					faqs.map((item) => (
						<details class="faq__item">
							<summary>{item.q}</summary>
							<p>{item.a}</p>
							{item.links && (
								<p class="faq__links">
									{item.links.map((l, i) => (
										<>
											{i > 0 && ' · '}
											<a href={l.href}>{l.label}</a>
										</>
									))}
								</p>
							)}
						</details>
					))
				}
			</div>
			{
				nearby.length > 0 && (
					<p class="faq__nearby">
						Nearby markets we serve:{' '}
						{nearby.map((n, i) => (
							<>
								{i > 0 && ', '}
								<a href={`/submarkets/${n.slug}/`}>{n.name.replace(/\s*\(.*\)/, '')}</a>
							</>
						))}
					</p>
				)
			}
		</div>
	</section>

	<section class="section">
		<div class="container">
			<BOVForm heading={`Own an Apartment Building in ${sm.name}?`} subheading="Get a free, confidential Broker Opinion of Value." />
		</div>
	</section>
</BaseLayout>

