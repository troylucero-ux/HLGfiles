---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';
---

<BaseLayout
	title="Insights | LA Multifamily Market Resources"
	description="LA multifamily market insights from Highlight Real Estate Group: legislative updates, submarket trends, and guidance for apartment building owners."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Insights</span>
			<h1>LA Multifamily Market Insights</h1>
			<p>Legislative updates, submarket trends, and practical guidance for apartment building owners across Los Angeles.</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			{
				posts.length === 0 ? (
					<div class="empty-state">
						<h2>New Insights Coming Soon</h2>
						<p>
							We're building out our library of LA multifamily market insights, including coverage of rent stabilization ordinance (RSO)
							updates and Measure ULA. Check back soon, or <a href="/contact/">reach out directly</a> with a question.
						</p>
					</div>
				) : (
					<div class="post-grid">
						{posts.map((post) => (
							<a href={`/insights/${post.slug}/`} class="post-card">
								<span class="post-card__date">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
								<h2>{post.title}</h2>
								<p>{post.description}</p>
							</a>
						))}
					</div>
				)
			}
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		background: var(--paper-alt);
		padding-block: 3rem;
		border-bottom: 1px solid var(--border);
	}

	.page-hero p {
		max-width: 700px;
	}

	.empty-state {
		max-width: 640px;
		background: var(--paper-alt);
		border-top: 3px solid var(--gold);
		border-radius: 1px;
		padding: 2.75rem;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.75rem;
	}

	.post-card {
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 1.75rem;
		color: var(--ink);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.post-card:hover {
		border-color: var(--gold);
		transform: translateY(-2px);
	}

	.post-card__date {
		font-size: 0.75rem;
		color: var(--ink-light);
		text-transform: uppercase;
	}
</style>
