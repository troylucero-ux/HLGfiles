---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts } from '../../data/posts';
---

<BaseLayout
	title="LA Multifamily Market Insights | Highlight Multifamily Group"
	description="LA multifamily market insights from Highlight Multifamily Group: legislative updates, submarket trends, and guidance for apartment building owners."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Insights</span>
			<h1>LA Multifamily Market Insights</h1>
			<p>Legislative updates, submarket trends, and practical guidance for apartment building owners across Los Angeles.</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			{
				posts.length === 0 ? (
					<div class="empty-state">
						<h2>New Insights Coming Soon</h2>
						<p>
							We're building out our library of LA multifamily market insights, including coverage of rent stabilization ordinance (RSO)
							updates and Measure ULA. Check back soon, or <a href="/contact/">reach out directly</a> with a question.
						</p>
					</div>
				) : (
					<div class="post-grid">
						{posts.map((post) => (
							<a href={`/insights/${post.slug}/`} class="post-card">
								{post.image && <img class="post-card__image" src={post.image.src} alt={post.image.alt} width={post.image.width} height={post.image.height} loading="lazy" />}
								<div class="post-card__body">
									<span class="post-card__date">{new Date(`${post.date}T00:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</span>
									<h2>{post.title}</h2>
									<p>{post.description}</p>
									<span class="post-card__cta">Read the article &rarr;</span>
								</div>
							</a>
						))}
					</div>
				)
			}
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		background: var(--paper-alt);
		padding-block: 3rem;
		border-bottom: 1px solid var(--border);
	}

	.page-hero p {
		max-width: 700px;
	}

	.empty-state {
		max-width: 640px;
		background: var(--paper-alt);
		border-top: 3px solid var(--gold);
		border-radius: 1px;
		padding: 2.75rem;
	}

	.post-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		max-width: 980px;
	}

	.post-card {
		display: grid;
		grid-template-columns: 320px 1fr;
		align-items: stretch;
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		overflow: hidden;
		color: var(--ink);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.post-card:hover {
		border-color: var(--gold);
		transform: translateY(-2px);
		text-decoration: none;
	}

	.post-card__image {
		display: block;
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-right: 1px solid var(--border);
	}

	.post-card__body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 1.75rem 2rem;
	}

	.post-card__body h2 {
		font-size: 1.45rem;
		margin: 0.35rem 0 0.6rem;
	}

	.post-card__body p {
		margin: 0 0 1rem;
		color: var(--ink-soft);
	}

	.post-card__date {
		font-size: 0.75rem;
		color: var(--ink-light);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.post-card__cta {
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--navy);
	}

	@media (max-width: 700px) {
		.post-card {
			grid-template-columns: 1fr;
		}

		.post-card__image {
			border-right: 0;
			border-bottom: 1px solid var(--border);
		}

		.post-card__body {
			padding: 1.25rem 1.5rem 1.5rem;
		}
	}
</style>
