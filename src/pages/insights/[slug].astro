---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BOVForm from '../../components/BOVForm.astro';
import ExchangeTimeline from '../../components/ExchangeTimeline.astro';
import CpiRentCapTable from '../../components/CpiRentCapTable.astro';
import { posts } from '../../data/posts';
import { site } from '../../data/site';

export function getStaticPaths() {
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;

// Paragraphs are plain text, with [link text](/internal-path/) supported for internal links.
const linkPattern = /\[([^\]]+)\]\((\/[^)\s]*)\)/g;
function toParts(paragraph: string) {
	const parts: { text: string; href?: string }[] = [];
	let last = 0;
	for (const m of paragraph.matchAll(linkPattern)) {
		if (m.index! > last) parts.push({ text: paragraph.slice(last, m.index) });
		parts.push({ text: m[1], href: m[2] });
		last = m.index! + m[0].length;
	}
	if (last < paragraph.length) parts.push({ text: paragraph.slice(last) });
	return parts;
}
// Appending a time avoids the date being parsed as UTC midnight, which can display as the
// previous day in timezones behind UTC.
const dateFormatted = new Date(`${post.date}T00:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: post.title,
	description: post.description,
	datePublished: post.date,
	...(post.image ? { image: `${site.url}${post.image.src}` } : {}),
	author: {
		'@type': 'Organization',
		name: site.name,
	},
	publisher: {
		'@type': 'Organization',
		name: site.name,
	},
};
---

<BaseLayout title={post.seoTitle ?? post.title} description={post.description} image={post.image?.src}>
	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

	<article class="section">
		<div class="container post-detail">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Insights', href: '/insights/' }, { label: post.title }]} />
			<span class="eyebrow">Insights</span>
			<h1>{post.title}</h1>
			<p class="post-detail__date">{dateFormatted}</p>
			{post.image && <img class="post-detail__image" src={post.image.src} alt={post.image.alt} width={post.image.width} height={post.image.height} loading="eager" />}

			<div class="post-detail__body">
				{
					post.sections.map((s) => (
						<>
							<h2>{s.heading}</h2>
							{s.paragraphs.map((p) => (
								<p>{toParts(p).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</p>
							))}
							{s.heading === 'How a 1031 Exchange Makes the Move Tax-Deferred' && <ExchangeTimeline />}
							{s.heading === 'The New Maximum, Effective August 1, 2026' && <CpiRentCapTable />}
						</>
					))
				}
			</div>

			<div class="post-detail__links">
				<a href="/insights/" class="btn btn-outline">
					More Insights
				</a>
				<a href="/contact/?intent=bov" class="btn btn-gold">
					Get a Free Broker Opinion of Value
				</a>
			</div>
		</div>
	</article>

	<section class="section section-alt">
		<div class="container">
			<BOVForm />
		</div>
	</section>
</BaseLayout>

<style>
	.post-detail {
		max-width: 760px;
	}

	.post-detail__image {
		width: 100%;
		height: auto;
		border: 1px solid var(--border);
		border-radius: 2px;
		margin: 0 0 2rem;
	}

	.post-detail__date {
		color: var(--ink-light);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-top: -0.5rem;
	}

	.post-detail__body {
		font-size: 1.05rem;
		line-height: 1.75;
		margin-top: 2rem;
	}

	.post-detail__body h2 {
		margin-top: 2.25rem;
		font-size: 1.5rem;
	}

	.post-detail__links {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin: 2.5rem 0 0;
	}
</style>
