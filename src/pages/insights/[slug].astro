---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BOVForm from '../../components/BOVForm.astro';
import ExchangeTimeline from '../../components/ExchangeTimeline.astro';
import CpiRentCapTable from '../../components/CpiRentCapTable.astro';
import UlaThresholdTable from '../../components/UlaThresholdTable.astro';
import SubmarketStatsTable from '../../components/SubmarketStatsTable.astro';
import DepreciationRecaptureExample from '../../components/DepreciationRecaptureExample.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import { posts, relatedPostSlugs, postFaqs } from '../../data/posts';
import { site } from '../../data/site';
import { toParts, stripLinks } from '../../lib/inlineLinks';

export function getStaticPaths() {
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;

// Hand-picked onward reading for this article. Posts that are not live yet are skipped.
const related = (relatedPostSlugs[post.slug] ?? []).map((slug) => posts.find((p) => p.slug === slug)).filter((p): p is NonNullable<typeof p> => Boolean(p));

// Questions and answers shown at the end of the article and mirrored into FAQPage structured data.
const faqs = postFaqs[post.slug] ?? [];
const faqSchema = faqs.length
	? {
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: faqs.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: stripLinks(f.a) },
			})),
		}
	: null;

// Appending a time avoids the date being parsed as UTC midnight, which can display as the
// previous day in timezones behind UTC.
const dateFormatted = new Date(`${post.date}T00:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long' });

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: post.title,
	description: post.description,
	datePublished: post.date,
	...(post.image ? { image: `${site.url}${post.image.src}` } : {}),
	author: {
		'@type': 'Organization',
		name: site.name,
	},
	publisher: {
		'@type': 'Organization',
		name: site.name,
	},
};
---

<BaseLayout title={post.seoTitle ?? post.title} description={post.description} image={post.image?.src}>
	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />
	{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />}

	<article class="section">
		<div class="container post-detail">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Insights', href: '/insights/' }, { label: post.title }]} />
			<span class="eyebrow">Insights</span>
			<h1>{post.title}</h1>
			<p class="post-detail__date">{dateFormatted}</p>
			{post.image && <img class="post-detail__image" src={post.image.src} alt={post.image.alt} width={post.image.width} height={post.image.height} loading="eager" />}

			<div class="post-detail__body">
				{
					post.sections.map((s) => (
						<>
							<h2>{s.heading}</h2>
							{s.paragraphs.map((p) => (
								<p>{toParts(p).map((part) => (part.href ? (part.href.startsWith('http') ? <a href={part.href} target="_blank" rel="noopener noreferrer">{part.text}</a> : <a href={part.href}>{part.text}</a>) : part.text))}</p>
							))}
							{s.heading === 'How a 1031 Exchange Makes the Move Tax-Deferred' && <ExchangeTimeline />}
							{s.heading === 'The New Maximum, Effective August 1, 2026' && <CpiRentCapTable />}
							{s.heading === 'Why a Price Just Over the Line Costs So Much' && <UlaThresholdTable />}
							{s.heading === 'Pre-1978 (RSO) Buildings by Neighborhood' && <SubmarketStatsTable group="rso" />}
							{s.heading === 'Newer Buildings (1978 and Later)' && <SubmarketStatsTable group="post1978" />}
							{s.heading === 'Depreciation Recapture' && <DepreciationRecaptureExample />}
						</>
					))
				}
			</div>

				{faqs.length > 0 && <ArticleFaq faqs={faqs} />}

			{
				related.length > 0 && (
					<aside class="related" aria-labelledby="related-heading">
						<h2 id="related-heading">Related Reading</h2>
						<ul class="related__list">
							{related.map((r) => (
								<li>
									<a href={`/insights/${r.slug}/`}>{r.title}</a>
									<span>{r.description}</span>
								</li>
							))}
						</ul>
						<p class="related__explore">
							Explore more: <a href="/property-value/">Free Property Value Calculator</a> · <a href="/closed-sales/">Our Closed Sales</a> · <a href="/submarkets/">LA Submarkets</a> · <a href="/1031-exchanges/">1031 Exchanges</a>
						</p>
					</aside>
				)
			}

			<div class="post-detail__links">
				<a href="/insights/" class="btn btn-outline">
					More Insights
				</a>
				<a href="/contact/?intent=bov" class="btn btn-gold">
					Get a Free Broker Opinion of Value
				</a>
			</div>
		</div>
	</article>

	<section class="section section-alt">
		<div class="container">
			<BOVForm />
		</div>
	</section>
</BaseLayout>

<style>
	.post-detail {
		max-width: 760px;
	}

	.post-detail__image {
		width: 100%;
		height: auto;
		border: 1px solid var(--border);
		border-radius: 2px;
		margin: 0 0 2rem;
	}

	.post-detail__date {
		color: var(--ink-light);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-top: -0.5rem;
	}

	.post-detail__body {
		font-size: 1.05rem;
		line-height: 1.75;
		margin-top: 2rem;
	}

	.post-detail__body h2 {
		margin-top: 2.25rem;
		font-size: 1.5rem;
	}

	.related {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}

	.related h2 {
		font-size: 1.25rem;
		margin: 0 0 1rem;
	}

	.related__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
	}

	.related__list li {
		display: grid;
		gap: 0.2rem;
	}

	.related__list a {
		font-weight: 600;
	}

	.related__list span {
		color: var(--ink-light);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.related__explore {
		margin-top: 1.5rem;
		font-size: 0.95rem;
		font-weight: 600;
	}

	.post-detail__links {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin: 2.5rem 0 0;
	}
</style>
