---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BOVForm from '../../components/BOVForm.astro';
import OMGateForm from '../../components/OMGateForm.astro';
import YouTubeFacade from '../../components/YouTubeFacade.astro';
import { listings } from '../../data/listings';
import { site, team } from '../../data/site';
import { youtubeMeta } from '../../data/youtubeMeta';
import { formatPrice, formatPriceFull } from '../../lib/format';

export function getStaticPaths() {
	return listings.map((listing) => ({
		params: { slug: listing.slug },
		props: { listing },
	}));
}

const { listing } = Astro.props;

const statusLabels: Record<string, string> = {
	active: 'Active',
	pending: 'Pending',
	'in-escrow': 'In Escrow',
	'off-market': 'Off-Market',
};

const fullListingTitle = `${listing.name}, ${listing.city} | ${listing.units ?? ''}-Unit Apartment For Sale`;
// Drop the city when it would push the title past what Google displays.
const seoTitle = fullListingTitle.length <= 60 ? fullListingTitle : `${listing.name} | ${listing.units ?? ''}-Unit Apartment For Sale`;

const seoDescription = `${listing.units ?? ''}-unit apartment building for sale in ${listing.city}, ${listing.state} at ${
	listing.askingPrice ? formatPriceFull(listing.askingPrice) : 'a price available upon request'
}${listing.capRate ? `, ${listing.capRate}% cap rate` : ''}. ${listing.description}`.slice(0, 158);

const otherActive = listings.filter((l) => l.slug !== listing.slug && (l.status === 'active' || l.status === 'in-escrow')).slice(0, 4);

const gallery = (listing.gallery ?? []).map((g) => ({
	...g,
	full: `/images/listings/${listing.slug}/gallery/${g.file}.webp`,
	thumb: `/images/listings/${listing.slug}/gallery/${g.file}-thumb.webp`,
}));

// Only show a count tile when the number is meaningful (5 or more); a car-oriented block shows just the
// closest-places list instead of a row of zeros. OpenStreetMap coverage is uneven, so small counts undersell.
const walkTiles = listing.walk
	? [
			{ n: listing.walk.dining, label: 'restaurants, cafes and bars within a half mile' },
			{ n: listing.walk.grocery, label: 'grocery and convenience stores within 0.6 mile' },
			{ n: listing.walk.parks, label: 'parks, gardens and playgrounds within 0.6 mile' },
			{ n: listing.walk.bus, label: 'bus stops within a quarter mile' },
		].filter((t) => t.n >= 5)
	: [];

const listingTeam = team.filter((t) => ['josh-kaplan', 'troy-lucero'].includes(t.slug));
const mapAddress = `${listing.name}, ${listing.city}, ${listing.state} ${listing.zip}`;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapAddress)}&output=embed`;
const hasOmGate = Boolean(listing.omGate);
const omLink = hasOmGate
	? '#offering-memorandum'
	: `/contact/?intent=om&property=${encodeURIComponent(`${listing.name}, ${listing.city}, ${listing.state}`)}`;
const omLabel = hasOmGate ? 'Download Offering Memorandum' : 'Request Offering Memorandum';

const listingUrl = `${site.url}/listings/${listing.slug}/`;
const schema = {
	'@context': 'https://schema.org',
	'@type': 'RealEstateListing',
	name: listing.name,
	description: listing.description,
	url: listingUrl,
	...(listing.image ? { image: new URL(listing.image, site.url).toString() } : {}),
	address: {
		'@type': 'PostalAddress',
		streetAddress: listing.name,
		addressLocality: listing.city,
		addressRegion: listing.state,
		postalCode: listing.zip,
		addressCountry: 'US',
	},
	...(listing.units ? { numberOfRooms: listing.units } : {}),
	...(listing.sqft ? { floorSize: { '@type': 'QuantitativeValue', value: listing.sqft, unitCode: 'FTK' } } : {}),
	// Only assert an Offer while the property is genuinely available — an in-escrow or off-market
	// listing shouldn't claim "InStock" availability in structured data.
	...(listing.askingPrice && (listing.status === 'active' || listing.status === 'pending')
		? {
				offers: {
					'@type': 'Offer',
					price: listing.askingPrice,
					priceCurrency: 'USD',
					availability: 'https://schema.org/InStock',
					url: listingUrl,
				},
			}
		: {}),
};

// uploadDate and duration come from src/data/youtubeMeta.ts (read from each video's YouTube page).
const videoSchema = listing.youtubeId
	? {
			'@context': 'https://schema.org',
			'@type': 'VideoObject',
			name: `${listing.name} Video Tour`,
			description: listing.description,
			thumbnailUrl: `https://img.youtube.com/vi/${listing.youtubeId}/hqdefault.jpg`,
			embedUrl: `https://www.youtube-nocookie.com/embed/${listing.youtubeId}`,
			...youtubeMeta[listing.youtubeId],
		}
	: null;
---

<BaseLayout title={seoTitle} description={seoDescription} image={listing.image} hideStickyCta>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	{videoSchema && <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />}

	<header class="lhero" style={listing.image ? `--hero-image:url('${listing.image}')` : undefined}>
		<div class="container lhero__inner">
			<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Listings', href: '/listings/' }, { label: listing.name }]} />
			<span class={`lhero__status lhero__status--${listing.status}`}>{statusLabels[listing.status]}</span>
			<h1>{listing.name}</h1>
			<p class="lhero__location">
				{listing.city}, {listing.state} {listing.zip}
			</p>
			<p class="lhero__credit">Presented by Highlight Multifamily Group | {site.brokerage}</p>
			<div class="lhero__cta">
				<a href={omLink} class="btn btn-light">{omLabel}</a>
				<a href="#listing-team" class="btn btn-outline-light">Contact Listing Team</a>
			</div>
		</div>
	</header>

	<div class="ltop" id="ltop">
		<div class="container ltop__inner">
			<span class="ltop__addr">{listing.name}, {listing.city}, {listing.state} {listing.zip}</span>
			<a href={omLink} class="ltop__btn">{omLabel.replace('Offering Memorandum', 'OM')}</a>
		</div>
	</div>

	<section class="lstats" aria-label="Key facts">
		<div class="container">
			<dl class="lstats__grid">
				<div>
					<dt>List Price</dt>
					<dd>{listing.askingPrice ? formatPrice(listing.askingPrice) : 'Contact for Pricing'}</dd>
				</div>
				{
					listing.capRate && (
						<div>
							<dt>Current Cap Rate</dt>
							<dd>{listing.capRate}%</dd>
						</div>
					)
				}
				{
					listing.units && (
						<div>
							<dt>Units</dt>
							<dd>{listing.units}</dd>
						</div>
					)
				}
				{
					listing.grm && (
						<div>
							<dt>Current GRM</dt>
							<dd>{listing.grm}</dd>
						</div>
					)
				}
				{
					listing.pricePerUnit && (
						<div>
							<dt>Price Per Unit</dt>
							<dd>{formatPriceFull(listing.pricePerUnit)}</dd>
						</div>
					)
				}
				{
					listing.pricePerSqft && (
						<div>
							<dt>Price Per SF</dt>
							<dd>${listing.pricePerSqft}</dd>
						</div>
					)
				}
				{
					listing.sqft && (
						<div>
							<dt>Building Size</dt>
							<dd>{listing.sqft.toLocaleString()} SF</dd>
						</div>
					)
				}
				{
					listing.yearBuilt && (
						<div>
							<dt>Year Built</dt>
							<dd>{listing.yearBuilt}</dd>
						</div>
					)
				}
				{
					listing.zoning && (
						<div>
							<dt>Zoning</dt>
							<dd>{listing.zoning}</dd>
						</div>
					)
				}
			</dl>
		</div>
	</section>

	<article class="section">
		<div class="container listing-detail">
			{listing.youtubeId && <YouTubeFacade youtubeId={listing.youtubeId} title={`${listing.name} Video Tour`} />}

			<div class="listing-detail__body">
				<h2>Investment Overview</h2>
				<p>{listing.description}</p>

				{
					listing.highlights && listing.highlights.length > 0 && (
						<>
							<h2>Investment Highlights</h2>
							<ul class="listing-detail__highlights">
								{listing.highlights.map((h) => (
									<li>{h}</li>
								))}
							</ul>
						</>
					)
				}
			</div>
		</div>
	</article>

	{
			gallery.length > 0 && (
				<section class="section section-alt lphotos" aria-label="Photo tour">
					<div class="container">
						<div class="lphotos__head">
							<h2>Photo Tour</h2>
							<button type="button" class="lphotos__all" data-open-photo="0">
								<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
									<path d="M3 8V3h5M17 8V3h-5M3 12v5h5M17 12v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								Browse all {gallery.length} photos
							</button>
						</div>
						<p class="lphotos__sub">
							{listing.name}, {listing.city}, {listing.state} {listing.zip}
						</p>
						<ul class="lmosaic" role="list">
							{gallery.slice(0, 5).map((g, i) => (
								<li class={`lmosaic__tile${i === 0 ? ' lmosaic__tile--lead' : ''}`}>
									<button type="button" data-open-photo={i} aria-label={`Open photo: ${g.caption}`}>
										<img
											src={i === 0 ? g.full : g.thumb}
											alt={`${listing.name}, ${listing.city}: ${g.caption}`}
											width={i === 0 ? 1600 : 640}
											height={i === 0 ? 1200 : 440}
											loading="lazy"
										/>
										<span class="lmosaic__shade" aria-hidden="true" />
										<span class="lmosaic__cap">{g.caption}</span>
										<span class="lmosaic__zoom" aria-hidden="true">
											<svg viewBox="0 0 20 20" width="18" height="18">
												<path d="M3 8V3h5M17 8V3h-5M3 12v5h5M17 12v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</span>
										{i === 4 && gallery.length > 5 && <span class="lmosaic__more">+{gallery.length - 5} photos</span>}
									</button>
								</li>
							))}
						</ul>
						<script type="application/json" id="lphotos-data" set:html={JSON.stringify(gallery.map((g) => ({ full: g.full, thumb: g.thumb, caption: g.caption })))} />
					</div>
				</section>
			)
	}

	<section class="section">
		<div class="container llocation">
			<div>
				<h2>Location{listing.neighborhood ? `: ${listing.neighborhood}` : ''}</h2>
				<p>
					{listing.name}, {listing.city}, {listing.state} {listing.zip}
				</p>
				{
					listing.nearby && listing.nearby.length > 0 && (
						<>
							<h3>Nearby</h3>
							<ul class="llocation__nearby">
								{listing.nearby.map((n) => (
									<li>{n}</li>
								))}
							</ul>
						</>
					)
				}
				{
					listing.submarket && (
						<a href={`/submarkets/${listing.submarket}/`} class="btn btn-outline">
							Explore the {listing.submarket.replace(/-/g, ' ')} Submarket
						</a>
					)
				}
			</div>
			<iframe
				class="llocation__map"
				title={`Map of ${listing.name}`}
				src={mapSrc}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"></iframe>
		</div>

		{
			listing.walk && (
				<div class="container lwalk">
					<h3>Walking Distance</h3>
					{walkTiles.length > 0 && (
						<ul class="lwalk__tiles" role="list">
							{walkTiles.map((t) => (
								<li>
									<span class="lwalk__num">{t.n}</span>
									<span class="lwalk__label">{t.label}</span>
								</li>
							))}
						</ul>
					)}
					{listing.walk.closest.length > 0 && (
						<ul class="lwalk__closest" role="list">
							{listing.walk.closest.map((c) => (
								<li class={`lwalk__${c.kind}`}>
									<span>{c.label}</span>
									<strong>{c.minutes} min walk</strong>
								</li>
							))}
						</ul>
					)}
					<p class="lwalk__note">
						Counts and walking times are approximate (straight-line distance at 3 mph), from OpenStreetMap contributors, {listing.walk.asOf}.
					</p>
				</div>
			)
		}
	</section>

	<section class="section section-alt">
		<div class="container listing-detail">
			{
				hasOmGate ? (
					<OMGateForm property={listing.slug} propertyName={listing.name} />
				) : (
					<div class="listing-detail__links">
						<a href={omLink} class="btn btn-gold">
							{omLabel}
						</a>
					</div>
				)
			}
		</div>
	</section>

	<section class="section" id="listing-team">
		<div class="container">
			<h2>Your Listing Team</h2>
			<p class="lteam__sub">Call or email either of us directly. Showings are by appointment only.</p>
			<div class="lteam">
				{
					listingTeam.map((t) => (
						<div class="lteam__card">
							<img src={t.headshot} alt={t.name} width="96" height="96" loading="lazy" />
							<div>
								<h3>{t.name}</h3>
								<p class="lteam__title">
									{t.title}, {site.brokerage}
								</p>
								<p>
									<a href={`tel:+1${t.phone.replace(/\D/g, '')}`}>{t.phone}</a>
									<br />
									<a href={`mailto:${t.email}`}>{t.email}</a>
								</p>
								<p class="lteam__dre">DRE {t.dre}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="lnext">
		<div class="container lnext__inner">
			<div>
				<h2>Ready to See It?</h2>
				<p>Read the Offering Memorandum, then call us to set up a tour.</p>
			</div>
			<a href={omLink} class="btn btn-light">{omLabel}</a>
		</div>
	</section>

	{
		otherActive.length > 0 && (
			<section class="section">
				<div class="container">
					<h2>More Listings</h2>
					<ul class="lmore" role="list">
						{otherActive.map((l) => (
							<li>
								<a href={`/listings/${l.slug}/`}>
									{l.image && <img src={l.image} alt={`${l.name}, ${l.city}`} width="480" height="320" loading="lazy" />}
									<span class="lmore__name">{l.name}</span>
									<span class="lmore__meta">
										{l.units ? `${l.units} units` : ''}
										{l.units && l.askingPrice ? ' | ' : ''}
										{l.askingPrice ? formatPrice(l.askingPrice) : ''}
										{l.status === 'in-escrow' ? ' | In Escrow' : ''}
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section class="section section-alt">
		<div class="container">
			<BOVForm heading="Thinking About Selling?" subheading="Get a free, confidential Broker Opinion of Value." />
		</div>
	</section>

	<div class="lbar" role="region" aria-label="Contact the listing team">
		<a class="btn btn-outline" href={`tel:+1${site.callPhone.replace(/\D/g, '')}`}>Call</a>
		<a class="btn btn-gold" href={omLink}>{hasOmGate ? 'Download OM' : 'Request OM'}</a>
	</div>

	<dialog class="lview" aria-label="Photo viewer">
		<div class="lview__top">
			<span class="lview__count" aria-live="polite"></span>
			<button type="button" class="lview__close" aria-label="Close photo viewer">Close</button>
		</div>
		<div class="lview__stage">
			<button type="button" class="lview__nav lview__nav--prev" aria-label="Previous photo">&#8249;</button>
			<button type="button" class="lview__photo" aria-label="Next photo">
				<img alt="" />
			</button>
			<button type="button" class="lview__nav lview__nav--next" aria-label="Next photo">&#8250;</button>
		</div>
		<p class="lview__cap"></p>
		<div class="lview__strip" role="list"></div>
	</dialog>
</BaseLayout>

<script>
	// Slim address + "Download OM" bar that slides in under the site header once the hero has scrolled away.
	const topBar = document.getElementById('ltop');
	const heroEl = document.querySelector('.lhero');
	if (topBar && heroEl) {
		const siteHeader = document.querySelector('header');
		const placeBar = () => {
			const pos = siteHeader ? getComputedStyle(siteHeader).position : 'static';
			const stuck = pos === 'sticky' || pos === 'fixed';
			topBar.style.top = stuck && siteHeader ? `${siteHeader.getBoundingClientRect().height}px` : '0px';
		};
		placeBar();
		window.addEventListener('resize', placeBar);
		new IntersectionObserver(
			([entry]) => {
				placeBar();
				topBar.classList.toggle('ltop--show', !entry.isIntersecting && entry.boundingClientRect.top < 0);
			},
			{ threshold: 0 }
		).observe(heroEl);
	}

	// Photo viewer: click a tile to open, then click the photo (or use the arrows, the thumbnails, the
	// keyboard arrow keys, or swipe) to move through the set.
	const viewer = document.querySelector<HTMLDialogElement>('.lview');
	const dataEl = document.getElementById('lphotos-data');
	if (viewer && dataEl) {
		const photos: { full: string; thumb: string; caption: string }[] = JSON.parse(dataEl.textContent || '[]');
		const mainImg = viewer.querySelector<HTMLImageElement>('.lview__photo img')!;
		const capEl = viewer.querySelector<HTMLElement>('.lview__cap')!;
		const countEl = viewer.querySelector<HTMLElement>('.lview__count')!;
		const strip = viewer.querySelector<HTMLElement>('.lview__strip')!;
		let current = 0;

		photos.forEach((p, i) => {
			const b = document.createElement('button');
			b.type = 'button';
			b.className = 'lview__thumb';
			b.setAttribute('aria-label', `Show photo ${i + 1}: ${p.caption}`);
			const t = document.createElement('img');
			t.src = p.thumb;
			t.alt = '';
			t.loading = 'lazy';
			b.appendChild(t);
			b.addEventListener('click', () => show(i));
			strip.appendChild(b);
		});

		const show = (i: number) => {
			current = (i + photos.length) % photos.length;
			const p = photos[current];
			mainImg.classList.remove('lview__img--in');
			mainImg.src = p.full;
			mainImg.alt = p.caption;
			void mainImg.offsetWidth; // restart the fade-in
			mainImg.classList.add('lview__img--in');
			capEl.textContent = p.caption;
			countEl.textContent = `${current + 1} / ${photos.length}`;
			strip.querySelectorAll('.lview__thumb').forEach((el, idx) => {
				el.classList.toggle('is-active', idx === current);
				if (idx === current) (el as HTMLElement).scrollIntoView({ block: 'nearest', inline: 'center' });
			});
			// Warm the next and previous photos so stepping through feels instant.
			[current + 1, current - 1].forEach((n) => {
				const pre = new Image();
				pre.src = photos[(n + photos.length) % photos.length].full;
			});
		};

		document.querySelectorAll<HTMLElement>('[data-open-photo]').forEach((el) => {
			el.addEventListener('click', () => {
				show(Number(el.dataset.openPhoto) || 0);
				viewer.showModal();
			});
		});
		viewer.querySelector('.lview__photo')!.addEventListener('click', () => show(current + 1));
		viewer.querySelector('.lview__nav--next')!.addEventListener('click', () => show(current + 1));
		viewer.querySelector('.lview__nav--prev')!.addEventListener('click', () => show(current - 1));
		viewer.querySelector('.lview__close')!.addEventListener('click', () => viewer.close());
		viewer.addEventListener('click', (e) => {
			if (e.target === viewer) viewer.close();
		});
		viewer.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') show(current + 1);
			if (e.key === 'ArrowLeft') show(current - 1);
		});
		let touchX = 0;
		viewer.addEventListener('touchstart', (e) => (touchX = e.changedTouches[0].clientX), { passive: true });
		viewer.addEventListener('touchend', (e) => {
			const dx = e.changedTouches[0].clientX - touchX;
			if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
		});
	}
</script>

<style>
	.lhero {
		position: relative;
		color: #fff;
		background: linear-gradient(180deg, rgb(12 46 80 / 0.55), rgb(12 46 80 / 0.88)), var(--hero-image, none) center / cover no-repeat, var(--navy-dark);
		padding-block: clamp(2.5rem, 7vw, 5.5rem);
		min-height: 420px;
		display: flex;
		align-items: flex-end;
	}

	.lhero__inner {
		width: 100%;
	}

	.lhero :global(.breadcrumbs),
	.lhero :global(.breadcrumbs a) {
		color: rgb(255 255 255 / 0.85);
	}

	.lhero h1 {
		color: #fff;
		margin: 0.4rem 0 0.25rem;
	}

	.lhero__status {
		display: inline-block;
		text-transform: uppercase;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		background: var(--navy);
		color: #fff;
		padding: 0.3rem 0.75rem;
		border-radius: 1px;
		margin-top: 1rem;
	}

	.lhero__status--in-escrow {
		background: var(--gold);
		color: var(--navy-dark);
	}

	.lhero__location {
		font-weight: 600;
		margin: 0;
	}

	.lhero__credit {
		margin: 0.4rem 0 1.5rem;
		color: rgb(255 255 255 / 0.85);
		font-size: 0.95rem;
	}

	.lhero__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	/* Buttons for use on the navy hero and the navy "Next Step" band (the site's .btn-gold is navy). */
	.btn-light {
		background: #fff;
		color: var(--navy-dark);
		border-color: #fff;
	}

	.btn-light:hover {
		background: var(--gold-light);
		border-color: var(--gold-light);
		color: var(--navy-dark);
	}

	.btn-outline-light {
		background: transparent;
		color: #fff;
		border-color: rgb(255 255 255 / 0.85);
	}

	.btn-outline-light:hover {
		background: rgb(255 255 255 / 0.14);
		color: #fff;
	}

