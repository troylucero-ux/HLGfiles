---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BOVForm from '../../components/BOVForm.astro';
import BuyerListForm from '../../components/BuyerListForm.astro';
import { listings } from '../../data/listings';
import { closings } from '../../data/closings';
import { formatPrice, formatPriceFull } from '../../lib/format';

const labels: Record<string, string> = { active: 'Available', pending: 'Pending', 'in-escrow': 'In escrow', 'off-market': 'Off market' };

// Available (and pending) first, in-escrow last. Within each group the order in listings.ts is kept, newest first.
const shown = listings.filter((l) => l.status !== 'off-market');
const rank = (s: string) => (s === 'in-escrow' ? 1 : 0);
const sorted = [...shown].sort((a, b) => rank(a.status) - rank(b.status));
const availableCount = shown.filter((l) => l.status !== 'in-escrow').length;
const escrowCount = shown.filter((l) => l.status === 'in-escrow').length;

// "New" for 21 days after a listing's listedOn date.
const isNew = (d?: string) => Boolean(d) && Date.now() - new Date(d as string).getTime() < 21 * 864e5;

// Most recent closing with a full date.
const recent = [...closings].filter((c) => (c.soldDate ?? '').length === 10).sort((a, b) => (b.soldDate as string).localeCompare(a.soldDate as string))[0];

const itemList = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	itemListElement: sorted.map((l, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		url: `https://highlightreg.com/listings/${l.slug}/`,
		name: `${l.name}, ${l.city}, ${l.state}`,
	})),
};
---

<BaseLayout
	title="LA Apartment Buildings for Sale | Highlight Multifamily Group"
	description="Apartment buildings for sale in the Los Angeles area from Highlight Multifamily Group: units, cap rate, price per unit, photos and instant offering memorandum downloads."
>
	<section class="page-hero">
		<div class="container">
			<span class="eyebrow">Listings</span>
			<h1>LA Apartment Buildings for Sale</h1>
			<p>
				{
					shown.length === 0
						? 'Multifamily opportunities from Highlight Multifamily Group across the Los Angeles area.'
						: `${availableCount} available now${escrowCount ? `, ${escrowCount} in escrow` : ''}. Multifamily opportunities from Highlight Multifamily Group across the Los Angeles area.`
				}
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			{
				shown.length === 0 ? (
					<div class="empty-state">
						<h2>No Active Listings Right Now</h2>
						<p>
							We don't have any properties actively on the market at this moment. Many of our best deals move off-market, so join the buyer list below or
							contact us directly to hear about opportunities before they're publicly listed, or browse our <a href="/closed-sales/">closed sales</a> to see
							the kind of properties we work with.
						</p>
						<a href="/contact/" class="btn btn-navy">Get in Touch</a>
					</div>
				) : (
					<>
						{escrowCount > 0 && (
							<div class="filters" role="group" aria-label="Filter listings by status">
								<button type="button" class="filter is-on" data-filter="all" aria-pressed="true">All ({shown.length})</button>
								<button type="button" class="filter" data-filter="available" aria-pressed="false">Available ({availableCount})</button>
								<button type="button" class="filter" data-filter="in-escrow" aria-pressed="false">In escrow ({escrowCount})</button>
							</div>
						)}
						<div class="listings-grid">
							{sorted.map((listing) => {
								const stats = [
									listing.units ? `${listing.units} units` : '',
									listing.capRate ? `${listing.capRate}% cap` : '',
									listing.pricePerUnit ? `${formatPriceFull(listing.pricePerUnit)}/unit` : '',
								].filter(Boolean);
								const escrow = listing.status === 'in-escrow';
								return (
									<a href={`/listings/${listing.slug}/`} class={escrow ? 'listing-card listing-card--escrow' : 'listing-card'} data-status={escrow ? 'in-escrow' : 'available'}>
										<div class="listing-card__media">
											{listing.image && (
												<img
													class="listing-card__image"
													src={listing.image}
													alt={`${listing.name}, ${listing.city}, ${listing.state}, apartment building for sale`}
													width="400"
													height="260"
													loading="lazy"
												/>
											)}
											{isNew(listing.listedOn) && !escrow && <span class="listing-card__new">New</span>}
											<span class={`listing-card__status listing-card__status--${listing.status}`}>{labels[listing.status]}</span>
										</div>
										<div class="listing-card__body">
											<h2>{listing.name}</h2>
											<p class="listing-card__location">
												{listing.city}, {listing.state} {listing.zip}
											</p>
											{stats.length > 0 && (
												<ul class="listing-card__stats" role="list">
													{stats.map((s) => (
														<li>{s}</li>
													))}
												</ul>
											)}
											<p class="listing-card__price">{listing.askingPrice ? formatPrice(listing.askingPrice) : 'Contact for Pricing'}</p>
											<p class="listing-card__cta">{escrow ? 'In escrow: view details' : 'View details and offering memorandum'}</p>
										</div>
									</a>
								);
							})}
						</div>
					</>
				)
			}
		</div>
	</section>

	<section class="section buyer-section">
		<div class="container">
			<BuyerListForm />
			{
				recent && (
					<p class="recent">
						Recently closed: <a href={`/closed-sales/${recent.slug}/`}>{recent.name}, {recent.city}</a>. <a href="/closed-sales/">See all closed sales</a>
					</p>
				)
			}
		</div>
	</section>

	<section class="section section-alt">
		<div class="container">
			<BOVForm heading="Thinking About Selling?" subheading="Get a free, confidential Broker Opinion of Value." />
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify(itemList)} />
</BaseLayout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
	const cards = document.querySelectorAll<HTMLElement>('.listing-card');
	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const f = btn.dataset.filter;
			buttons.forEach((b) => {
				const on = b === btn;
				b.classList.toggle('is-on', on);
				b.setAttribute('aria-pressed', String(on));
			});
			cards.forEach((c) => {
				c.hidden = !(f === 'all' || c.dataset.status === f);
			});
		});
	});
</script>

<style>
	.page-hero {
		background: var(--paper-alt);
		padding-block: 3rem;
		border-bottom: 1px solid var(--border);
	}

	.empty-state {
		max-width: 640px;
		background: var(--paper-alt);
		border-top: 3px solid var(--gold);
		border-radius: 1px;
		padding: 2.75rem;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 1.5rem;
	}

	.filter {
		font-family: var(--font-sans);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--navy-dark);
		background: #fff;
		border: 1px solid var(--gold);
		border-radius: 999px;
		padding: 0.45rem 1.05rem;
		cursor: pointer;
	}

	.filter.is-on {
		background: var(--navy-dark);
		color: #fff;
		border-color: var(--navy-dark);
	}

	.listings-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.75rem;
	}

	.listing-card {
		background: var(--paper);
		border: 1px solid var(--border);
		border-radius: 2px;
		display: block;
		color: var(--ink);
		overflow: hidden;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}

	.listing-card[hidden] {
		display: none;
	}

	.listing-card:hover {
		border-color: var(--gold);
		box-shadow: 0 18px 40px -26px rgba(12, 46, 80, 0.35);
		transform: translateY(-2px);
		text-decoration: none;
	}

	.listing-card__media {
		position: relative;
	}

	.listing-card__image {
		display: block;
		width: 100%;
		height: 200px;
		object-fit: cover;
	}

	.listing-card--escrow .listing-card__image {
		opacity: 0.7;
		filter: saturate(0.7);
	}

	.listing-card__status,
	.listing-card__new {
		position: absolute;
		top: 0.7rem;
		text-transform: uppercase;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		padding: 0.28rem 0.65rem;
		border-radius: 1px;
	}

	.listing-card__status {
		right: 0.7rem;
		background: #eaf3de;
		color: #27500a;
	}

	.listing-card__status--in-escrow {
		background: #faeeda;
		color: #633806;
	}

	.listing-card__new {
		left: 0.7rem;
		background: var(--gold);
		color: var(--navy-dark);
	}

	.listing-card__body {
		padding: 1.25rem 1.5rem 1.5rem;
	}

	.listing-card h2 {
		font-size: 1.2rem;
		margin: 0 0 0.2rem;
	}

	.listing-card__location {
		margin: 0 0 0.8rem;
		font-size: 0.9rem;
		color: var(--ink-light);
	}

	.listing-card__stats {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.9rem;
		margin: 0 0 0.8rem;
		padding: 0.55rem 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--navy-dark);
	}

	.listing-card__price {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--navy-dark);
		margin: 0 0 0.35rem;
	}

	.listing-card__cta {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--navy);
	}

	.buyer-section {
		padding-top: 0;
	}

	.recent {
		margin: 1.1rem 0 0;
		font-size: 0.92rem;
		color: var(--ink-light);
	}
</style>
